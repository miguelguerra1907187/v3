        Esperar-Pantalla 'F2_DespuesNota1' $fotoNota
        Asegurar-Edge
        $fotoLista = Foto (Get-ZonaDebajo 'Intra_Nota2')
        ClickXY 'Intra_Nota2'
        Esperar-Pantalla 'F3_DespuesNota2' $fotoLista
        Asegurar-Edge
        Teclas 'i'
