            $cell.BorderBrush = B $C.KeyBorder
            $cell.Opacity = 0.25
            [void]$top.Children.Add((New-Keycap ([string]($i + 1)) '' 12))
            [void]$inner.Children.Add($top)
        }

        $cell.Child = $inner
        [System.Windows.Controls.Grid]::SetRow($cell, [int](($rows - 1) - [Math]::Floor($i / 3)))
        [System.Windows.Controls.Grid]::SetColumn($cell, [int]($i % 3))
        [void]$grid.Children.Add($cell)
    }

    $keys = if ($script:LM_Multi) {
        @('1-9','mark','Enter','done','Arrows','move','Esc','back','Del','close')
    } else {
