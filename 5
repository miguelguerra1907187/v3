        $BandaEtiqueta.Child.Text = '{0} of {1}{2}' -f ($script:BandaIdx + 1), $g.Filas.Count, $mas
        # a la derecha de la banda; si no cabe, a la izquierda
        $xDer = [Math]::Max($p[2], $p[4]) + 8
        $BandaEtiqueta.Measure((New-Object System.Windows.Size ([double]::PositiveInfinity), ([double]::PositiveInfinity)))
        if ((Banda-Dip $xDer) + $BandaEtiqueta.DesiredSize.Width + 4 -gt $BandaWinV.Width) {
            $xIzq = [Math]::Min($p[0], $p[6]) - 8 - ($BandaEtiqueta.DesiredSize.Width / $script:BandaEsc)
            Banda-Poner $BandaEtiqueta $xIzq (($p[1] + $p[7]) / 2)
        } else {
            Banda-Poner $BandaEtiqueta $xDer (($p[3] + $p[5]) / 2)
        }
    }

    function Banda-Ocultar {
        $BandaPoli.Visibility = 'Hidden'
        $BandaEtiqueta.Visibility = 'Hidden'
    }

    $BandaTAviso = New-Object System.Windows.Threading.DispatcherTimer
    $BandaTAviso.Add_Tick({ $BandaAvisoB.Visibility = 'Hidden'; $BandaTAviso.Stop() })
    function Banda-Aviso([string]$texto, [double]$xPx, [double]$yPx, [int]$ms = 1800, [switch]$Rojo) {
        $BandaAvisoB.Background = B $(if ($Rojo) { '#E6B3261E' } else { '#E6202428' })
        $BandaAvisoB.Child.Text = $texto
        Banda-Poner $BandaAvisoB ($xPx + 14) $yPx
        $BandaTAviso.Stop()
        $BandaTAviso.Interval = [TimeSpan]::FromMilliseconds($ms)
        $BandaTAviso.Start()
    }

    function Banda-Foto { [BandaWin]::Capturar($script:BandaGris, $script:BandaW, $script:BandaH) }

    function Banda-Iniciar {
        $m = [BandaWin]::Mouse()
        Banda-Ocultar
        $BandaAvisoB.Visibility = 'Hidden'
        $BandaWinV.Dispatcher.Invoke([Action]{ }, [System.Windows.Threading.DispatcherPriority]::Render)
        Start-Sleep -Milliseconds 40
        Banda-Foto
        $g = New-Object BandaGuia
        if (-not $g.Calibrar($script:BandaGris, $script:BandaW, $script:BandaH, $m[0], $m[1])) {
            Banda-Aviso 'No weight found under the mouse' $m[0] $m[1] -Rojo
            return
        }
        $script:BandaGuia = $g
        $script:BandaIdx = 0
        $script:BandaEstado = 'on'
        Banda-Mostrar
        $BandaTSeguir.Start()
        # 3 s para marcar (si quieres) la ultima fila con otro toque
        $script:BandaFinHasta = (Get-Date).AddSeconds(3)
        $p = $g.Esquinas(0)
        Banda-Aviso 'Optional: Right Shift on the LAST weight' ([Math]::Max($p[2], $p[4])) (($p[5] + $p[7]) / 2 + 26) 3000
    }

    # 2o toque: el mouse sobre el peso de la ULTIMA fila
    function Banda-MarcarFinal {
        $m = [BandaWin]::Mouse()
        [void](Banda-SeguirAhora)                     # por si bajaste la hoja antes del 2o toque
        $r = $script:BandaGuia.FijarFinal($m[0], $m[1])
        if ($r -eq 0) { Banda-Apagar; return }        # el mismo primer peso = apagar
        if ($r -lt 0) { Banda-Aviso 'No weight found under the mouse' $m[0] $m[1] -Rojo; return }
        $script:BandaFinHasta = [DateTime]::MinValue
        if ($script:BandaIdx -ge $script:BandaGuia.Filas.Count) { $script:BandaIdx = $script:BandaGuia.Filas.Count - 1 }
        if ($script:BandaEstado -eq 'pend') { $script:BandaEstado = 'on' }
        Banda-Mostrar
        $p = $script:BandaGuia.Esquinas($r)
        Banda-Aviso ('Last row set: {0} rows' -f $script:BandaGuia.Filas.Count) ([Math]::Max($p[2], $p[4])) (($p[3] + $p[5]) / 2) 1800
    }

    function Banda-Apagar {
        if (-not $script:BandaListo) { return }
        $script:BandaEstado = 'off'
        $script:BandaFinHasta = [DateTime]::MinValue
        $BandaTSeguir.Stop()
        Banda-Ocultar
        $BandaAvisoB.Visibility = 'Hidden'
    }

    # Revisa ya si la hoja se movio o si ya se ven mas filas
    function Banda-SeguirAhora {
        Banda-Foto
        return $script:BandaGuia.Seguir($script:BandaGris)
    }

    function Banda-EsperarScroll {
        $script:BandaEstado = 'pend'
        $script:BandaIdx = $script:BandaGuia.Filas.Count
        $p = $script:BandaGuia.Esquinas($script:BandaGuia.Filas.Count - 1)
        Banda-Ocultar
        # (a la derecha de la tabla: que no salga en la foto donde se buscan las filas nuevas)
        Banda-Aviso 'Scroll down for more rows' ([Math]::Max($p[2], $p[4]) - 6) $p[5] 2500
    }

    function Banda-Siguiente {
        $g = $script:BandaGuia
        if ($script:BandaEstado -eq 'pend') {
            [void](Banda-SeguirAhora)
            if ($script:BandaIdx -lt $g.Filas.Count) { $script:BandaEstado = 'on'; Banda-Mostrar } else { Banda-EsperarScroll }
            return
        }
        if ($script:BandaIdx + 1 -lt $g.Filas.Count) { $script:BandaIdx++; Banda-Mostrar; return }
        [void](Banda-SeguirAhora)                     # a lo mejor ya se ven mas filas
        if ($script:BandaIdx + 1 -lt $g.Filas.Count) { $script:BandaIdx++; Banda-Mostrar; return }
        if ($g.HayMas) { Banda-EsperarScroll; return }
        $n = $g.Filas.Count
        $p = $g.Esquinas($n - 1)
        Banda-Apagar
        Banda-Aviso ('Done: {0} rows' -f $n) ([Math]::Max($p[2], $p[4])) $p[5] 2000
    }

    function Banda-Anterior {
        if ($script:BandaEstado -eq 'pend') {
            $script:BandaIdx = $script:BandaGuia.Filas.Count - 1
            $script:BandaEstado = 'on'
            Banda-Mostrar
            return
        }
        if ($script:BandaIdx -gt 0) { $script:BandaIdx--; Banda-Mostrar }
    }

    # Lo llama el timer de teclas del menu (cada 20 ms) con el Enter que ya leyo
    function Banda-Teclas([bool]$enEdge) {
        try {
            $toque  = [BandaWin]::ToqueShiftDerecho()
            $arriba = [BandaWin]::FlechaArriba()
            # menu abierto (la ventana, no el estado: despues de una nota el estado
            # se queda en 'done' con el menu cerrado) o motor corriendo: no se usa
            if ($Win.Visibility -eq 'Visible' -or $script:MotorCorriendo -or $script:EsperandoGuardar) {
                if ($script:BandaEstado -ne 'off') { Banda-Apagar }
                if ($toque) { $m = [BandaWin]::Mouse(); Banda-Aviso 'Band: wait until the Force Menu finishes' $m[0] $m[1] 1800 }
                return
            }
            if ($toque) {
                if (-not $script:BandaActivo) {
                    $acentoPrevio = $script:WatermarkAccent
                    $script:WatermarkAccent = $C.Dim
                    Show-Watermark 'BAND' 'BAND IS OFF (OPEN THE MENU AND TURN IT ON)' 1500
                    $script:WatermarkAccent = $acentoPrevio
                    return
                }
                if ($script:BandaEstado -eq 'off') { Banda-Iniciar }
                elseif ((Get-Date) -lt $script:BandaFinHasta -and -not $script:BandaGuia.Final) { Banda-MarcarFinal }
                else { Banda-Apagar }
                return
            }
            if ($script:BandaEstado -eq 'off') { return }
            if ($enEdge) { Banda-Siguiente }
            if ($arriba) { Banda-Anterior }
        } catch {
            $m = [BandaWin]::Mouse()
            Banda-Aviso ('Band error: ' + $_.Exception.Message) $m[0] $m[1] 4000 -Rojo
        }
    }

    # Scroll: cada medio segundo mientras la banda esta prendida
    $BandaTSeguir = New-Object System.Windows.Threading.DispatcherTimer
    $BandaTSeguir.Interval = [TimeSpan]::FromMilliseconds(500)
    $BandaTSeguir.Add_Tick({
        try {
            if ($script:BandaEstado -eq 'off') { $BandaTSeguir.Stop(); return }
            $script:BandaTicks++
            if ($script:BandaTicks % 4 -eq 0 -and $script:BandaHwnd -ne [IntPtr]::Zero) { [BandaWin]::AlFrente($script:BandaHwnd) }
            $cambio = Banda-SeguirAhora
            if ($script:BandaEstado -eq 'pend') {
                if ($script:BandaIdx -lt $script:BandaGuia.Filas.Count) { $script:BandaEstado = 'on'; $BandaAvisoB.Visibility = 'Hidden'; Banda-Mostrar }
            } elseif ($cambio) {
                Banda-Mostrar
            }
        } catch { }
    })

    $BandaWinV.Show()
    $bandaSrc = [System.Windows.PresentationSource]::FromVisual($BandaWinV)
    if ($bandaSrc) { $script:BandaEsc = $bandaSrc.CompositionTarget.TransformFromDevice.M11 }
}

# Switch BAND: prende / apaga el Shift derecho de la banda
function Set-BandaActivo([bool]$on) {
    $script:BandaActivo = $on
    if (-not $on) { Banda-Apagar }
    if ($script:SwBandaTxt) {
        $col = if (-not $script:BandaListo) { $C.Dim } elseif ($on) { '#E3B341' } else { $C.Dim }
        $script:SwBandaTxt.Text = if ($on -and $script:BandaListo) { 'BAND ON' } else { 'BAND OFF' }
        $script:SwBandaTxt.Foreground = B $col
        $script:SwBandaBtn.BorderBrush = B $col
        $script:SwBandaBtn.Background  = B (Get-Soft $col)
    }
    if ($on -and -not $script:BandaListo) {
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        Show-Watermark 'BAND' ('BAND NOT AVAILABLE: ' + $script:BandaMotivo) 3000
        $script:WatermarkAccent = $acentoPrevio
    }
    Paso ("Switch banda: " + $(if ($on) { 'ON' } else { 'OFF' }))
}

# ===================== SWITCH AUDIT (ON / OFF) =====================
# Botoncito chico abajo a la derecha, SOLO se ve con el menu abierto.
# Click = prende / apaga Ctrl izq + Abajo. Arranca APAGADO ($AuditPrendidoAlInicio).
function Set-AuditActivo([bool]$on) {
    $script:AuditActivo = $on
    if ($script:SwAuditTxt) {
        $col = if ($on) { '#3FB950' } else { $C.Dim }
        $script:SwAuditTxt.Text = if ($on) { 'AUDIT ON' } else { 'AUDIT OFF' }
        $script:SwAuditTxt.Foreground = B $col
        $script:SwAuditBtn.BorderBrush = B $col
        $script:SwAuditBtn.Background  = B (Get-Soft $col)
    }
    Paso ("Switch audit: " + $(if ($on) { 'ON' } else { 'OFF' }))
}

if ($UsarBotonesMotor) {
    $SwAudit = New-Object System.Windows.Window
    $SwAudit.WindowStyle        = 'None'
    $SwAudit.AllowsTransparency = $true
    $SwAudit.Background         = 'Transparent'
    $SwAudit.Topmost            = $true
    $SwAudit.ShowInTaskbar      = $false
    $SwAudit.ShowActivated      = $false
    $SwAudit.ResizeMode         = 'NoResize'
    $SwAudit.SizeToContent      = 'WidthAndHeight'
    $SwAudit.Add_SourceInitialized({
        param($s, $e)
        $h = (New-Object System.Windows.Interop.WindowInteropHelper($SwAudit)).Handle
        [LocalKeyState]::HideFromAltTab($h)
        try { [Motor]::NoActivate($h) } catch { }      # darle click no le quita el foco al ERP
    })

    $swBorde = New-Object System.Windows.Controls.Border
    $swBorde.Background      = B '#E616191D'
    $swBorde.BorderBrush     = B $C.KeyBorder
    $swBorde.BorderThickness = '1'
    $swBorde.CornerRadius    = '6'
    $swBorde.Padding         = '2,2,2,2'
    $swBorde.Cursor          = 'SizeAll'
    $swBorde.Add_MouseLeftButtonDown({ param($s, $e) if ($e.OriginalSource -eq $s) { try { $SwAudit.DragMove() } catch { } } })

    $script:SwAuditBtn = New-Object System.Windows.Controls.Border
    $script:SwAuditBtn.BorderThickness = '1'
    $script:SwAuditBtn.CornerRadius    = '4'
    $script:SwAuditBtn.Padding         = '5,1,5,1'
    $script:SwAuditBtn.Cursor          = 'Hand'
    $script:SwAuditTxt = New-Text 'AUDIT OFF' 9 $C.Dim 'Bold'
    $script:SwAuditTxt.HorizontalAlignment = 'Center'
    $script:SwAuditBtn.Child = $script:SwAuditTxt
    $script:SwAuditBtn.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        Set-AuditActivo (-not $script:AuditActivo)
    })
    # Boton BAND (banda breakdown), junto al de AUDIT
    $script:SwBandaBtn = New-Object System.Windows.Controls.Border
    $script:SwBandaBtn.BorderThickness = '1'
    $script:SwBandaBtn.CornerRadius    = '4'
    $script:SwBandaBtn.Padding         = '5,1,5,1'
    $script:SwBandaBtn.Margin          = '3,0,0,0'
    $script:SwBandaBtn.Cursor          = 'Hand'
    $script:SwBandaTxt = New-Text 'BAND OFF' 9 $C.Dim 'Bold'
    $script:SwBandaTxt.HorizontalAlignment = 'Center'
    $script:SwBandaBtn.Child = $script:SwBandaTxt
    $script:SwBandaBtn.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        Set-BandaActivo (-not $script:BandaActivo)
    })
    $swFila = New-Object System.Windows.Controls.StackPanel
    $swFila.Orientation = 'Horizontal'
    [void]$swFila.Children.Add($script:SwAuditBtn)
    [void]$swFila.Children.Add($script:SwBandaBtn)
    $swBorde.Child = $swFila
    $SwAudit.Content = $swBorde

    $SwAudit.Add_Loaded({
        param($s, $e)
        $wa = [System.Windows.SystemParameters]::WorkArea
        $SwAudit.Left = $wa.Right  - $SwAudit.ActualWidth  - 16
        $SwAudit.Top  = $wa.Bottom - $SwAudit.ActualHeight - 16
    })
    Set-AuditActivo $AuditPrendidoAlInicio
    Set-BandaActivo $script:BandaActivo
    $SwAudit.Show()
    $SwAudit.Visibility = 'Hidden'

    # Solo se ve mientras el menu esta abierto (no tapa la pantalla)
    $script:SwAuditTimer = New-Object System.Windows.Threading.DispatcherTimer
    $script:SwAuditTimer.Interval = [TimeSpan]::FromMilliseconds(150)
    $script:SwAuditTimer.Add_Tick({
        $quiero = if ($Win.Visibility -eq 'Visible') { 'Visible' } else { 'Hidden' }
        if ($SwAudit.Visibility -ne $quiero) { $SwAudit.Visibility = $quiero }
    })
    $script:SwAuditTimer.Start()
}



