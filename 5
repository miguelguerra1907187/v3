}


# ============ ESPERAS QUE AVANZAN EN CUANTO LA PAGINA ESTA LISTA ============
# Los valores de la tabla $Global:ForceT son el MAXIMO: si se detecta que ya
# esta listo, sigue antes. Si no se puede detectar, espera el maximo (igual
# que antes), asi que nunca tarda mas que con la espera fija.
$script:RelojMotor     = [System.Diagnostics.Stopwatch]::StartNew()
$script:TEnterBusqueda = -1

# ============ DETECCION POR COLOR DE PANTALLA (velocidad 4) ============
# Para las esperas de Edge que eran fijas (cargas de pagina, abrir la nota,
# abrir la lista): toma una "foto" de la zona ANTES del click / Enter y sigue
# en cuanto la pantalla CAMBIO y despues se quedo QUIETA un rato (ya termino
# de cargar / dibujarse).
#   - Nunca espera MAS que el valor de la tabla (si no detecta, espera eso).
#   - Nunca sigue ANTES del minimo de cada paso ($Global:ColorMin).
#   - Solo lee pixeles de la pantalla (como una captura); no guarda nada.
# $Global:UsarColor = $false -> todo vuelve a esperas fijas (como la 5).
$Global:UsarColor     = $true
$Global:ColorPaso     = 6        # 1 de cada 6 pixeles (en X y en Y)
$Global:ColorQuieto   = 0.0015   # menos de 0.15 % distinto entre 2 fotos = quieto (20q: como la 4; la 3 tenia 0.25 %)
$Global:ColorQuietoMs = 200      # cuanto tiempo quieto para darlo por listo
$Global:ColorIgual    = 0.001    # menos de 0.1 % distinto contra ANTES del Enter = quedo igual (!)
$Global:ColorMin = @{            # minimo (ms) de cada paso aunque detecte antes
    E1_CargaIntra      = 350     # cuenta desde el Enter de la busqueda
    E6_CargaIntraVieja = 300     # despues de E5 (420 fijo)
    F1_FocoEdge        = 400     # cuenta desde el Enter de la busqueda
    F2_DespuesNota1    = 450     # 20q: como la 4 (la 3 tenia 400 y a veces daba click en Type antes de tiempo)
    F3_DespuesNota2    = 350     # 20q: como la 4 (la 3 tenia 300)
}
$Global:ColorCambio = @{         # que parte de la zona tiene que cambiar (0.01 = 1 %)
    E1_CargaIntra      = 0.003    # en la 4 no detectaba con 1 % (el PRO nuevo cambia poco)
    E6_CargaIntraVieja = 0.004    # 20p: era 2 %. Si la vieja carga rapido (dentro de E5) solo
                                  # cambia el PRO del buscador (~0.8 %) y esperaba 2 s de mas
    F1_FocoEdge        = 0.003
    F2_DespuesNota1    = 0.005
    F3_DespuesNota2    = 0.03
}
# Si el color NO detecto la carga al llegar al maximo de la tabla, sigue
# vigilando hasta estos ms EXTRA (solo cuando seguir sin que cargue rompe
# la secuencia). Si carga antes, sigue en ese momento. En el resumen: "1350*+"
$Global:ColorExtra = @{
    E6_CargaIntraVieja = 2000    # 20o: una vez no cargo a tiempo y el PRO no se escribio
}
# Revisa que el PRO SI quedo escrito en el buscador de la intra vieja: parte
# del buscador que tiene que cambiar al escribirlo. Si no, click y escribe otra vez.
$Global:ColorPROescrito = 0.006   # 0.6 %
$script:FotoBusqueda = $null

function Test-ColorDisponible {
    if (-not $Global:UsarColor) { return $false }
    return [bool]([Motor].GetMethod('Zona'))     # motor viejo cargado en esta consola -> no
}
# Zona de Edge: la ventana al frente SIN la parte de arriba (pestanas,
# direccion y el buscador de intra, donde parpadea el cursor)
function Get-ZonaEdge {
    $r = $null
    try { $r = [Motor]::RectAlFrente() } catch { $r = $null }
    if ($null -eq $r) { return $null }
    $pb = Get-XY 'Edge_Busqueda1'
    $x = $r[0] + 8
    $y = [Math]::Max($r[1] + 8, $pb[1] + 25)
    $w = ($r[2] - 8) - $x
    $h = ($r[3] - 8) - $y
    if ($w -lt 100 -or $h -lt 100) { return $null }
    return @($x, $y, $w, $h)
}
# Zona debajo de un punto (donde se despliega la lista del tipo de nota)
# Zona alrededor de un punto (dx, dy = esquina desde el punto)
function Get-ZonaPunto([string]$nombre, [int]$dx, [int]$dy, [int]$w, [int]$h) {
    $p = Get-XY $nombre
    return @([Math]::Max(0, $p[0] + $dx), [Math]::Max(0, $p[1] + $dy), $w, $h)
}
# Zona vacia (casi toda de un solo color): pagina en blanco / sin dibujar todavia
$Global:ColorVacio = 0.985
function Test-ZonaVacia($px) {
    if (-not [Motor].GetMethod('Uniforme')) { return $false }
    try { return ([Motor]::Uniforme($px) -ge $Global:ColorVacio) } catch { return $false }
}
function Get-ZonaDebajo([string]$nombre) {
    $p = Get-XY $nombre
    return @(($p[0] - 60), ($p[1] + 12), 420, 260)
}
function Foto($zona) {
    if ($null -eq $zona -or -not (Test-ColorDisponible)) { return $null }
    try { return @{ Z = $zona; Px = [Motor]::Zona($zona[0], $zona[1], $zona[2], $zona[3], $Global:ColorPaso) } }
    catch { return $null }
}

# Espera a que la pantalla cambie (contra la foto $antes) y se quede quieta.
# $yaMs = ms que ya pasaron (para las esperas que cuentan desde el Enter).
# En el resumen: "520*" = listo a los 520 ms; "520*!" = la pagina quedo
# IGUAL que antes del Enter (posible PRO anterior).
function Esperar-Pantalla([string]$k, $antes, [int]$yaMs = 0) {
    $max = [int]$Global:ForceT[$k]
    $extra = if ($Global:ColorExtra -and $Global:ColorExtra.Contains($k)) { [int]$Global:ColorExtra[$k] } else { 0 }
    $tope = $max + $extra             # con foto: vigila hasta el tope; sin foto: solo el maximo
    $min = if ($Global:ColorMin.Contains($k)) { [int]$Global:ColorMin[$k] } else { 0 }
    $umbral = if ($Global:ColorCambio.Contains($k)) { [double]$Global:ColorCambio[$k] } else { 0.01 }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $tCambio = -1; $tQuieto = -1; $prev = $null
    $maxDif = 0.0; $ultMov = 0.0        # para el log: cuanto cambio / cuanto se volvio a mover
    $vacia = $false
    if ($null -ne $antes) {
        while (($yaMs + $sw.ElapsedMilliseconds) -lt $tope) {
            $px = $null
            try { $px = [Motor]::Zona($antes.Z[0], $antes.Z[1], $antes.Z[2], $antes.Z[3], $Global:ColorPaso) } catch { $px = $null }
            if ($null -eq $px) { $tope = $max; break }
            $t = $yaMs + $sw.ElapsedMilliseconds
            $dAntes = [Motor]::Diferencia($antes.Px, $px)
            if ($dAntes -gt $maxDif) { $maxDif = $dAntes }
            if ($tCambio -lt 0) {
                if ($dAntes -ge $umbral) { $tCambio = $t }
            } else {
                $mov = [Motor]::Diferencia($prev, $px)
                if ($mov -le $Global:ColorQuieto) {
                    if ($tQuieto -lt 0) { $tQuieto = $t }
                    if (($t - $tQuieto) -ge $Global:ColorQuietoMs -and $t -ge $min -and (Test-ZonaVacia $px)) {
                        $vacia = $true; $tQuieto = -1     # quieta pero en blanco: todavia no carga
                    } elseif (($t - $tQuieto) -ge $Global:ColorQuietoMs -and $t -ge $min) {
                        $igual = ($dAntes -lt $Global:ColorIgual)
                        LogT ("  espera {0}: LISTO a los {1} ms (cambio a {2} ms, {3:0.00} %, max {4}){5}" -f $k, $t, $tCambio, ($dAntes * 100), $max, $(if ($igual) { '  OJO: quedo igual que antes' } else { '' }))
                        P $k ('{0}*{1}{2}' -f $t, $(if ($t -gt $max) { '+' } else { '' }), $(if ($igual) { '!' } else { '' }))
                        return
                    }
                } else { $tQuieto = -1; $ultMov = $mov }    # se volvio a mover
            }
            $prev = $px
            Start-Sleep -Milliseconds 30
        }
    }
    # No se detecto (o no hay foto): espera lo que falte del maximo, como antes
    if ($null -eq $antes) { $tope = $max }
    $falta = $tope - $yaMs - $sw.ElapsedMilliseconds
    if ($falta -gt 0) { Start-Sleep -Milliseconds $falta }
    $como = if ($null -eq $antes) { 'sin foto' }
            elseif ($tCambio -lt 0) { 'no cambio: lo mas {0:0.00} %, pide {1:0.00} %' -f ($maxDif * 100), ($umbral * 100) }
            elseif ($vacia) { 'cambio a {0} ms pero se veia VACIA (en blanco)' -f $tCambio }
            else { 'cambio a {0} ms, no se quedo quieta: se movia {1:0.00} %, quieto es <= {2:0.00} %' -f $tCambio, ($ultMov * 100), ($Global:ColorQuieto * 100) }
    LogT ("  espera {0}: {1} ms completos ({2})" -f $k, $tope, $como)
    P $k $(if ($tope -gt $max) { "$tope+" } else { $max })
}

# Carga despues del Enter de la busqueda: por color si se puede; si no (o si
# ya paso el maximo), como antes (EsperarDesdeBusqueda)
function EsperarCargaBusqueda([string]$k, [int]$minMs = 0) {
    if ((Test-ColorDisponible) -and $null -ne $script:FotoBusqueda -and $script:TEnterBusqueda -ge 0) {
        $ya = $script:RelojMotor.ElapsedMilliseconds - $script:TEnterBusqueda
        if ($ya -lt [int]$Global:ForceT[$k]) { Esperar-Pantalla $k $script:FotoBusqueda $ya; return }
    }
    EsperarDesdeBusqueda $k $minMs
}

# Espera de carga contada desde el Enter de la ultima busqueda en intra:
# si ya paso ese tiempo (por ejemplo mientras se revisaba la busqueda o
# mientras escribias la terminal), no espera de mas. Minimo $minMs.
function EsperarDesdeBusqueda([string]$k, [int]$minMs = 0) {
    $max = [int]$Global:ForceT[$k]
    $ya = 0
    if ($script:TEnterBusqueda -ge 0) { $ya = $script:RelojMotor.ElapsedMilliseconds - $script:TEnterBusqueda }
    $falta = [Math]::Max($minMs, $max - $ya)
    LogT ("  espera {0} = {1} ms (ya pasaron {2} ms desde la busqueda, espero {3} ms)" -f $k, $max, $ya, $falta)
    P $k $falta
    if ($falta -gt 0) { Start-Sleep -Milliseconds $falta }
}

# Si Edge ya no esta al frente (algo le robo el foco), lo regresa
function Asegurar-Edge {
    if ([Motor]::ProcesoAlFrente() -ne 'msedge') {
        Paso "Foco perdido (al frente: $([Motor]::ProcesoAlFrente())) -> regreso a Edge"
        Traer-Edge
        Esperar 200
    }
}

# Tecla o combinacion "de mano" para el Escritorio Remoto (scan code + pausas).
# Si en esta consola sigue cargado un motor viejo (sin ComboLenta), usa SendKeys.
function TeclaMano([int]$mod, [int]$vk, [bool]$ext, [string]$enSendKeys, [int]$holdMs = $Global:TeclaManoMs) {
    Paso "Tecla de mano: $enSendKeys"
    if ([Motor].GetMethod('ComboLenta')) { [Motor]::ComboLenta([byte]$mod, [byte]$vk, $ext, $holdMs) }
    else { Teclas $enSendKeys }
}

# PRO lookup
# Copia el PRO de la bill abierta en el ERP (doble click, Shift+End, Ctrl+C)
# Espera a que llegue al portapapeles y reintenta 1 vez. Devuelve el PRO.
function Copiar-PRO {
    param([switch]$MediaBill)    # -MediaBill: lookup a media bill (no cuenta para el aviso de mismo PRO)
    $F = $Global:ForceT
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    $script:UltPortaMs = -1
    Traer-ERP $F.C1_FocoERP 'C1_FocoERP' | Out-Null
    $pro = ''
    for ($intento = 1; $intento -le 3 -and -not $pro; $intento++) {
        if ($intento -gt 1) {
            # Reintento: cuando falla es porque NO se selecciono el PRO (no
            # porque el ERP este ocupado), asi que el 2o intento va de inmediato.
            # El 3o espera un poco por si acaso.
            if ($intento -ge 3) { Esperar 300 }
            Traer-ERP $F.C1_FocoERP 'C1_FocoERP' | Out-Null
        }
        Paso "PRO intento $intento de 3"
        try { [System.Windows.Forms.Clipboard]::Clear() } catch {}
        DobleClickXY 'ERP_CampoPRO'
        if ($intento -eq 1) {
            EsperarT 'C2_DespuesDobleClick'
            # 1er intento: Inicio + Shift+Fin + Ctrl+C con teclas "de mano" cortas
            # (con SendKeys rapido fallaba 1 de cada 3 y el reintento costaba ~1.3 s)
            TeclaMano 0 0x24 $true '{HOME}' $Global:TeclaMano1Ms
            Esperar 40
            TeclaMano 0x10 0x23 $true '+{END}' $Global:TeclaMano1Ms
            EsperarT 'C3_DespuesShiftEnd'
            TeclaMano 0x11 0x43 $false '^c' $Global:TeclaMano1Ms
            $pro = Esperar-Portapapeles $Global:EsperaPRO1ms
        } else {
            # Reintento: cuando falla, el cursor queda en el campo pero NO se
            # selecciona nada. Vuelve a seleccionar TODO el campo con teclas
            # "de mano": Inicio y luego Shift+Fin, y copia. Como el Inicio ya
            # pone el cursor al principio, despues del doble click basta 150 ms.
            # El 3er intento espera 150 ms mas en cada paso.
            $extra = if ($intento -ge 3) { 150 } else { 0 }
            Esperar (150 + $extra)
            Paso 'Reintento: selecciona todo el campo otra vez (Inicio + Shift+Fin)'
            TeclaMano 0 0x24 $true '{HOME}'
            Esperar 80
            TeclaMano 0x10 0x23 $true '+{END}'
            EsperarT 'C3_DespuesShiftEnd'
            Esperar $extra
            TeclaMano 0x11 0x43 $false '^c'
            $pro = Esperar-Portapapeles $(if ($intento -ge 3) { $Global:EsperaPROms } else { 1000 })
        }
        # Sin filtro de formato: el PRO puede venir con guiones (xxx-xxxxxx-x)
        # y con cualquier numero de digitos. Solo tiene que haber algo copiado.
    }
    Teclas '{HOME}'                   # quita la seleccion del PRO
    # Alt+C = cierra la parte del PRO (tambien en el lookup a media bill: si
    # se queda abierta y le picas sin querer, se reinicia toda la bill)
    Teclas '%c'
    EsperarT 'C4_DespuesAltC'
    if (-not $pro) {
        P 'C_intentos' '3!'
        P 'C_llego' 'no'
        throw "The PRO was not copied after 3 tries. Check that the bill is open and saved."
    }
    Paso "PRO copiado ($($pro.Length) caracteres)"
    # Solo AVISA si es el mismo PRO que la bill anterior (no lo bloquea)
    if (-not $MediaBill) {
        $script:MismoPRO = [bool]($script:PROAnterior -and $pro -eq $script:PROAnterior)
        if ($script:MismoPRO) { Paso 'AVISO: es el mismo PRO que la bill anterior' }
        $script:PROAnterior = $pro             # solo en memoria
    }
    P 'C_intentos' $(if ($intento - 1 -gt 1) { "$($intento - 1)!" } else { $intento - 1 })
    P 'C_llego' $(if ($script:UltPortaMs -ge 0) { $script:UltPortaMs } else { '?' })
    return $pro
}

# Pega el PRO en el primer buscador de intra y le da Enter (pasos 1-2)
# Mueve el mouse al punto, espera (como si lo pasaras por encima) y da click
function MoverEsperarClick([string]$nombre, [string]$kHover, [string]$kDespues) {
    $p = Get-XY $nombre
    Paso "Mover a $nombre ($($p[0]),$($p[1])) y esperar"
    [Motor]::SetCursorPos($p[0], $p[1]) | Out-Null
    EsperarT $kHover
    ClickXY $nombre
    EsperarT $kDespues
}

# Desde el resultado de la intra normal: ir a la intra vieja y buscar el PRO
# (pasos 3-5). Lo usan PRO F2 y la nota intra de F1.
function Ir-IntraVieja {
    $F = $Global:ForceT
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    # Espera a que cargue, pone el mouse encima,
    # espera y LUEGO da click (algunos menus se abren al pasar el mouse)
    EsperarCargaBusqueda 'E1_CargaIntra'
    MoverEsperarClick 'Edge_Nav1' 'E2_HoverNav1' 'E3_DespuesNav1'
    # 2o click: foto antes del click; E5 se queda fijo (NO BAJAR) y E6 (carga
    # de la intra vieja) sigue en cuanto la pagina cambio y se quedo quieta
    $p = Get-XY 'Edge_Nav2'
    Paso "Mover a Edge_Nav2 ($($p[0]),$($p[1])) y esperar"
    [Motor]::SetCursorPos($p[0], $p[1]) | Out-Null
    EsperarT 'E4_HoverNav2'
    # Foto SOLO de la zona del buscador viejo (106,696): sigue cuando ESA parte
    # ya cambio, se quedo quieta y no esta vacia (antes era toda la pantalla y
    # se adelantaba con la pagina a medio cargar)
    $fotoVieja = Foto (Get-ZonaPunto 'Edge_Busqueda2' -100 -60 500 120)
    ClickXY 'Edge_Nav2'
    EsperarT 'E5_DespuesNav2'
    Esperar-Pantalla 'E6_CargaIntraVieja' $fotoVieja
    # Click en el buscador viejo y escribe el PRO. Revisa por color que SI se
    # escribio (la foto se toma despues del Ctrl+A: si el click no agarro el
    # buscador, escribir no cambia nada). Si no se ve, click y escribe otra vez.
    $escrito = $false
    for ($vez = 1; $vez -le 2 -and -not $escrito; $vez++) {
        if ($vez -gt 1) {
            Paso 'El PRO no se ve en el buscador viejo: click y escribir otra vez'
            Esperar 300
        }
        ClickXY 'Edge_Busqueda2'
        EsperarT 'E7_DespuesClickBusca'
        # Vuelve a poner el PRO en el portapapeles por si algo lo cambio
        if (-not $Global:IntraTeclear -and $script:UltimoPRO) { try { [System.Windows.Forms.Clipboard]::SetText($script:UltimoPRO) } catch {} ; EsperarT 'E8_PROalPortapapeles' }
        Teclas '^a'                       # reemplaza lo que hubiera en el buscador
        $antesPRO = Foto-Buscador 'Edge_Busqueda2'
        Escribir-PRO
        EsperarT 'E9_DespuesPegarPRO'
        $escrito = Test-PROescrito $antesPRO 'buscador viejo'
    }
    P 'E_intentos' $(if (-not $escrito) { 'no!' } elseif ($vez -gt 2) { '2!' } else { '1' })
    Enter-Busqueda 'intra vieja' 'Edge_Busqueda2'
    $script:EdgeEnIntra = 'vieja'
}

# Foto chiquita de un buscador (paso 2 = mas fina, para ver el texto)
function Foto-Buscador([string]$punto) {
    if (-not (Test-ColorDisponible)) { return $null }
    $z = Get-ZonaPunto $punto -110 -12 360 24
    try { return @{ Z = $z; Px = [Motor]::Zona($z[0], $z[1], $z[2], $z[3], 2) } } catch { return $null }
}
# True si el buscador cambio desde la foto (= el PRO si se escribio).
# Sin color no se puede revisar: lo da por bueno (como antes).
function Test-PROescrito($antes, [string]$donde) {
    if ($null -eq $antes) { return $true }
    $px = $null
    try { $px = [Motor]::Zona($antes.Z[0], $antes.Z[1], $antes.Z[2], $antes.Z[3], 2) } catch { return $true }
    $d = [Motor]::Diferencia($antes.Px, $px)
    $ok = ($d -ge $Global:ColorPROescrito)
    LogT ("  PRO en {3}: cambio {0:0.00} % (pide {1:0.00} %) -> {2}" -f ($d * 100), ($Global:ColorPROescrito * 100), $(if ($ok) { 'SI se escribio' } else { 'NO se ve' }), $donde)
    return $ok
}

# Pone el PRO en el buscador de la intra TECLEADO (cada tecla le llega a la
# pagina y si registra el PRO nuevo; con Ctrl+V a veces la pagina buscaba el
# PRO anterior, aunque hiciera la animacion de buscar).
# $Global:IntraTeclear = $false -> vuelve a pegarlo con Ctrl+V como antes.
# (No se escribe el PRO en el log: solo cuantos caracteres)
$Global:IntraTeclear = $true
function Escribir-PRO {
    $pro = $script:UltimoPRO
    if ($Global:IntraTeclear -and $pro) {
        $esc = -join ($pro.ToCharArray() | ForEach-Object {
            if ('+^%~(){}[]'.Contains([string]$_)) { '{' + $_ + '}' } else { [string]$_ } })
        Paso "Tecleando el PRO en el buscador ($($pro.Length) caracteres)"
        [System.Windows.Forms.SendKeys]::SendWait($esc)
    } else {
        Teclas '^v'
    }
}

function Buscar-PRO-Intra {
    $F = $Global:ForceT
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    Traer-Edge
    EsperarT 'D1_FocoEdge'
    # Igual que en la intra vieja: escribe el PRO tecleado y revisa por color
    # que SI quedo en el buscador. Si no se ve, click y escribe otra vez.
    $escrito = $false
    for ($vez = 1; $vez -le 2 -and -not $escrito; $vez++) {
        if ($vez -gt 1) {
            Paso 'El PRO no se ve en el buscador de la intra: click y escribir otra vez'
            Esperar 300
            Asegurar-Edge
        }
        ClickXY 'Edge_Busqueda1'
        EsperarT 'D2_DespuesClickBusca'
        # Selecciona lo que ya hubiera en el buscador (PRO anterior) para que
        # lo escrito lo reemplace en vez de quedar al lado
        Teclas '^a'
        # Aqui el buscador puede traer el PRO anterior: 40 ms para que se pinte
        # la seleccion y la foto la incluya (si es el mismo PRO, igual se ve el cambio)
        Esperar 40
        $antesPRO = Foto-Buscador 'Edge_Busqueda1'
        Escribir-PRO
        EsperarT 'D3_DespuesPegarPRO'
        $escrito = Test-PROescrito $antesPRO 'buscador de la intra'
    }
    P 'D_intentos' $(if (-not $escrito) { 'no!' } elseif ($vez -gt 2) { '2!' } else { '1' })
    Enter-Busqueda 'intra normal' 'Edge_Busqueda1'
}

