# Se llama desde Finish-Notes: recuerda la ultima nota ERP y la de intra
function Set-NotasBotones([string]$intra, [string]$erp, [bool]$pendingHold, [string]$terminal = '') {
    # Que PRO lookup usar:
    #   - F2 (haz)               -> el original (las 2 intras)
    #   - F1 que lleva HOLD (cons) -> tambien el original, como F2
    #   - F1 sin hold            -> el de F1 (solo intra)
    if ($script:CurrentForce -eq 'haz') {
        $script:UltimoForce = 'haz'
    } elseif ($script:CurrentForce -eq 'f1') {
        $conHold = $pendingHold -or [bool]$terminal
        if (-not $conHold) { try { $conHold = [bool](Test-NeedsHold) } catch { } }
        $script:UltimoForce = if ($conHold) { 'haz' } else { 'f1' }
    } else {
        $script:UltimoForce = ''
    }

    # Nota nueva = se olvida la anterior (para no pegar la de otra bill)
    if ($erp -and ($script:CurrentForce -eq 'f1' -or $script:CurrentForce -eq 'haz')) {
        $script:BtnErp   = $erp.ToUpper()
        $script:BtnForce = if ($script:CurrentForce -eq 'f1') { 'FORCE1' } else { 'FORCE2' }
    } else {
        $script:BtnErp = ''; $script:BtnForce = ''
    }
    if ($terminal) {
        # Paso de terminal de la MISMA nota: si la nota ERP ya se pego, no se vuelve a ofrecer
        if ($script:BtnErp -and $script:BtnErp -eq $script:ErpYaPegada) { $script:BtnErp = ''; $script:BtnForce = '' }
    } else {
        $script:ErpYaPegada = ''      # nota nueva
    }
    if ($pendingHold) { $script:BtnIntra = '' }        # falta la terminal
    elseif ($intra)   { $script:BtnIntra = $intra.ToUpper() }
}

# Ejecuta UNA accion del motor. Devuelve $true si salio bien.
# (no revisa si el motor esta ocupado; eso lo hace quien la llama con Test-MotorListo)
function Run-Accion([string]$accion) {
    $ok = $false
    switch ($accion) {
        'pro1'  { $ok = Invoke-ProLookupF1 }
        'pro'   { $ok = Invoke-ProLookup }
        'erp'   { $ok = Invoke-NotaERP -Force $script:BtnForce -Nota $script:BtnErp }
        'intra' { $ok = Invoke-NotaIntra -Nota $script:BtnIntra }
    }
    if ($ok) {
        # Cada nota se pega UNA vez; para volver a pegarla, sacala del
        # historial (3/4/5 en la pantalla inicial) y se vuelve a cargar.
        if ($accion -eq 'erp')   { $script:ErpYaPegada = $script:BtnErp; $script:BtnErp = ''; $script:BtnForce = '' }
        if ($accion -eq 'intra') { $script:BtnIntra = '' }
        # Sin avisos de "PRO buscado" etc.: solo VERIFY AND SAVE al pegar una nota
        if ($accion -eq 'erp' -or $accion -eq 'intra') { Show-Verificar }
    }
    return [bool]$ok
}

function Test-MotorListo {
    if ($script:MotorCorriendo) { return $false }
