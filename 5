function Close-Menu {
    $script:Basket.Clear()
    $script:CurrentForce = $null
    $script:PendingHold  = $false
    $script:State = 'hidden'
    $Win.Visibility = 'Hidden'
    if ($script:PrevForegroundHwnd -ne [IntPtr]::Zero) {
        [LocalKeyState]::ForceForeground($script:PrevForegroundHwnd)
        $script:PrevForegroundHwnd = [IntPtr]::Zero
    }
}

function Set-MenuFocus {
    $hwnd = (New-Object System.Windows.Interop.WindowInteropHelper($Win)).Handle

    [LocalKeyState]::HideFromAltTab($hwnd)
    [LocalKeyState]::ForceForeground($hwnd)
    $Win.Activate() | Out-Null
    $Win.Focus() | Out-Null
    [System.Windows.Input.Keyboard]::Focus($Win) | Out-Null
}

function Open-Menu {
    if ($Win.Visibility -eq 'Visible') { return }
    Hide-Watermark
    Save-PrevForeground
    $Win.Visibility = 'Visible'
    Set-MenuFocus
    Show-Nivel1

    $retry = New-Object System.Windows.Threading.DispatcherTimer
    $retry.Interval = [TimeSpan]::FromMilliseconds(120)
    $retry.Add_Tick({
        param($s, $e)
        $s.Stop()
        if ($Win.Visibility -eq 'Visible') { Set-MenuFocus }
    })
    $retry.Start()
}

function Key-Nivel1([string]$k) {
    if ($k -match '^(Left|D1|NumPad1)$')  { Select-Nivel1 'f1';  return }
    if ($k -match '^(Right|D2|NumPad2)$') { Select-Nivel1 'haz'; return }
    if ($k -match '^(D3|NumPad3)$' -and $script:History.Count -ge 1) { Copy-FromHistory 0; return }
    if ($k -match '^(D4|NumPad4)$' -and $script:History.Count -ge 2) { Copy-FromHistory 1; return }
    if ($k -match '^(D5|NumPad5)$' -and $script:History.Count -ge 3) { Copy-FromHistory 2; return }
    if ($k -eq 'P') { Close-MenuParaBoton; Medir-Punto; return }   # medir coordenada (5 s)
    if ($k -eq 'M') { Enter-UpperTool; return }
    if ($k -eq 'Escape') { Close-Menu }
}

function Key-Done([string]$k) {
    if ($k -match '^(D1|NumPad1)$') {
        $script:NoteIdx = 0
        Set-Clip $script:LastCopied
        if ($script:NotePair.Count -eq 2) { Draw-Done }
        return
    }
    if ($k -match '^(D2|NumPad2)$' -and $script:NotePair.Count -eq 2) {
        $script:NoteIdx = 1
        Set-Clip $script:NotePair[1]
        Draw-Done
        return
    }

}

function Handle-KeyDown {
    param($s, $e)
    if ($script:State -eq 'hidden') { return }
    $k = $e.Key.ToString()

    if ($script:State -eq 'freetext') {
        if ($k -eq 'Return' -or $k -eq 'Enter' -or $k -eq 'Escape' -or $k -eq 'Home') {
            $e.Handled = $true
            try { Key-FreeText $k } catch { Show-Flag "Free text ($k)" $_.Exception.Message }
        }
        return
    }

    if ($script:State -eq 'upper') {
        if ($k -eq 'Escape' -or $k -eq 'Home') {
            $e.Handled = $true
            try { Show-Nivel1 } catch { Show-Flag 'Tool M' $_.Exception.Message }
        }
        return
    }

    $e.Handled = $true

    try {
        switch ($script:State) {
            'nivel1'   { Key-Nivel1 $k }
            'list'     { Key-List $k }
            'confirm'  { Key-Confirm $k }
            'terminal' { Key-Terminal $k }
            'done'     { Key-Done $k }
        }
    } catch { Show-Flag "Key $k on screen $($script:State)" $_.Exception.Message }
}

$Win.Add_KeyDown({ param($s, $e) Handle-KeyDown $s $e })

$VK_DELETE = 0x2E
$VK_INSERT = 0x2D

$script:DelArmed = $true
$script:InsArmed = $true
$script:RePagArmed = $true
$script:AuditArmed = $true
$hotkeyTimer = New-Object System.Windows.Threading.DispatcherTimer
$hotkeyTimer.Interval = [TimeSpan]::FromMilliseconds(20)   # 20 ms: no se pierde un Enter rapido
$hotkeyTimer.Add_Tick({
    $del = ([LocalKeyState]::GetAsyncKeyState($VK_DELETE) -band 0x8000) -ne 0
    $ins = ([LocalKeyState]::GetAsyncKeyState($VK_INSERT) -band 0x8000) -ne 0
    $delEdge = $del -and $script:DelArmed
    $insEdge = $ins -and $script:InsArmed
    $script:DelArmed = -not $del
    $script:InsArmed = -not $ins
    $mods = @(0x10, 0x11, 0x12) | Where-Object { ([LocalKeyState]::GetAsyncKeyState($_) -band 0x8000) -ne 0 }
    # Ctrl (izq) + Flecha abajo = secuencia audit (sin Shift/Alt)
    $auK = (([LocalKeyState]::GetAsyncKeyState(0xA2) -band 0x8000) -ne 0) -and
           (([LocalKeyState]::GetAsyncKeyState(0x28) -band 0x8000) -ne 0)
    $auEdge = $auK -and $script:AuditArmed
    $script:AuditArmed = -not $auK
    $sinShiftAlt = -not ((([LocalKeyState]::GetAsyncKeyState(0x10) -band 0x8000) -ne 0) -or
                         (([LocalKeyState]::GetAsyncKeyState(0x12) -band 0x8000) -ne 0))
    if ($auEdge -and $sinShiftAlt -and -not $script:AuditActivo) {
        # Switch AUDIT apagado: no hace nada (solo avisa)
        $script:AuditArmed = $false
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        Show-Watermark 'AUDIT' 'AUDIT IS OFF (OPEN THE MENU AND TURN IT ON)' 1500
        $script:WatermarkAccent = $acentoPrevio
        return
    }
    if ($auEdge -and $sinShiftAlt -and $UsarBotonesMotor -and $script:State -eq 'hidden' -and -not $script:MotorCorriendo) {
        # Espera a que sueltes el Ctrl (si no, el Esc saldria como Ctrl+Esc)
        $t = 0
        while ((([LocalKeyState]::GetAsyncKeyState(0xA2) -band 0x8000) -ne 0) -and $t -lt 2000) { Start-Sleep -Milliseconds 20; $t += 20 }
        if ((([LocalKeyState]::GetAsyncKeyState(0xA2) -band 0x8000) -ne 0)) { Show-Flag 'Audit' 'release Ctrl to start'; return }
        if (-not $script:MotorOK) { Show-Flag 'Audit' $script:MotorError; return }
        Banda-Apagar
        $script:MotorCorriendo = $true
        try { Hide-Watermark; Invoke-SecuenciaAudit | Out-Null }
        catch { Show-Flag 'Audit' $_.Exception.Message }
        finally { $script:MotorCorriendo = $false; $script:AuditArmed = $false }
        return
    }
    # Ctrl + Insert = solo PRO lookup F1 / Ctrl + RePag = solo PRO lookup F2 (sin notas)
    $ctrlK = ([LocalKeyState]::GetAsyncKeyState(0x11) -band 0x8000) -ne 0
    $repag = ([LocalKeyState]::GetAsyncKeyState(0x21) -band 0x8000) -ne 0
    $repagEdge = $repag -and $script:RePagArmed
    $script:RePagArmed = -not $repag
    $f1Edge = $insEdge -and $ctrlK
    $f2Edge = $repagEdge -and $ctrlK
    if (($f1Edge -or $f2Edge) -and $sinShiftAlt -and $UsarBotonesMotor -and $script:State -eq 'hidden' -and
        -not $script:MotorCorriendo -and -not $script:EsperandoGuardar -and -not $script:AutoTrasTerminal) {
        # Espera a que sueltes el Ctrl (si no, el doble click / Shift+Fin / Ctrl+C
        # del PRO saldrian con Ctrl apretado)
        $t = 0
        while ((([LocalKeyState]::GetAsyncKeyState(0x11) -band 0x8000) -ne 0) -and $t -lt 2000) { Start-Sleep -Milliseconds 20; $t += 20 }
        if ((([LocalKeyState]::GetAsyncKeyState(0x11) -band 0x8000) -ne 0)) { Show-Flag 'PRO lookup' 'release Ctrl to start'; return }
        if (-not $script:MotorOK) { Show-Flag 'PRO lookup' $script:MotorError; return }
        Banda-Apagar
        Invoke-SoloPRO $f2Edge
        $script:InsArmed = $false
        $script:RePagArmed = $false
        return
    }
    # Flujo automatico: esperando a que guardes la nota ERP
    # 0x8001 = apretada ahorita O apretada desde la ultima revision (no se pierde un toque rapido)
    $oK = ([LocalKeyState]::GetAsyncKeyState(0x4F) -band 0x8001) -ne 0     # tecla O
    $oEdge = $oK -and $script:OArmed
    $script:OArmed = -not $oK
    $enK = ([LocalKeyState]::GetAsyncKeyState(0x0D) -band 0x8001) -ne 0    # Enter (normal o del numpad)
    $enEdge = $enK -and $script:EnterArmed
    $script:EnterArmed = -not $enK
    # Banda breakdown: Shift derecho / Enter / Flecha arriba
    Banda-Teclas $enEdge
    if ($script:EsperandoGuardar -and $script:State -eq 'hidden') {
        $altK = ([LocalKeyState]::GetAsyncKeyState(0x12) -band 0x8001) -ne 0
        try {
            if ($oEdge -and $altK) {
                Paso 'Flujo auto: Alt+O detectado (guardaste)'
                Usuario-Fin 'Alt+O detectado'
                Start-FlujoFase2 $Global:ForceT.B1_DespuesGuardar
                return
            }
            # Enter solo (sin Ctrl/Shift/Alt; Ctrl+Enter es LAMP PARTS) tambien cuenta como guardar
            if ($enEdge -and -not $mods) {
                Paso 'Flujo auto: Enter detectado (guardaste)'
                Usuario-Fin 'Enter detectado'
                Start-FlujoFase2 $Global:ForceT.B1_DespuesGuardar
                return
            }
            if ($delEdge) {
                Stop-FlujoAuto 'canceled with Del'
                return
            }
            if ((Get-Date) -gt $script:EsperaLimite) {
                Stop-FlujoAuto ("not saved within $($Global:EsperaMaxGuardarMin) min")
            }
        } catch { Stop-FlujoAuto $_.Exception.Message }
    }
    if ($script:State -eq 'upper') { return }
    if (-not ($delEdge -or $insEdge)) { return }

    try {
        if ($delEdge) {
            if ($script:State -eq 'hidden') { Open-Menu } else { $script:AutoTrasTerminal = $false; Close-Menu }
        }
        if ($insEdge -and -not $ctrlK -and $script:PendingHold -and $script:State -eq 'done') {
            Hide-Watermark
            if ($script:State -eq 'hidden') {
                Save-PrevForeground
                $Win.Visibility = 'Visible'
                Set-MenuFocus
            }
            Enter-Terminal
        } elseif ($insEdge -and -not $ctrlK -and $script:State -eq 'done') {
            if ($script:NotePair.Count -eq 2) {
                $script:NoteIdx = 1 - $script:NoteIdx
                Set-Clip $script:NotePair[$script:NoteIdx]
                Show-Watermark $(if ($script:NoteIdx -eq 0) { 'INTRA' } else { 'ERP' })
                if ($script:State -eq 'done') { Draw-Done }
            } elseif ($script:LastCopied) {
                Set-Clip $script:LastCopied
            }
        }
    } catch {
        Show-Flag $(if ($delEdge) { 'Del' } else { 'Insert' }) $_.Exception.Message
    }
})
$hotkeyTimer.Start()

