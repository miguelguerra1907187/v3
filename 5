function Enter-IssueMenu {
    $script:CurrentIssue = $null
    $script:PendientesIssue = $null
    $labels = @(Get-Issues | ForEach-Object { $_.Label })
    Enter-List $labels ($script:CurrentForce -eq 'haz') 'issue'
