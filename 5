    $WatermarkWin.Visibility = 'Visible'
    $script:WatermarkTimer.Stop()
    if ($ms -gt 0) {                      # 0 = se queda hasta que otro aviso la cambie
        $script:WatermarkTimer.Interval = [TimeSpan]::FromMilliseconds($ms)
        $script:WatermarkTimer.Start()
    }
}

# Avisos del flujo (en ingles, solo los que piden algo al usuario):
#   rojo  WAIT   / DON'T MOVE      -> el motor esta trabajando, no toques nada
#   verde ENTER  / PRESS ENTER     -> acepta la nota ERP (Enter o Alt+O)
#   verde VERIFY / VERIFY AND SAVE -> revisa y guarda a mano
function Show-Aviso([string]$ghost, [string]$label, [string]$color, [int]$ms) {
    $acentoPrevio = $script:WatermarkAccent
    $script:WatermarkAccent = $color
    Show-Watermark $ghost $label $ms
    $script:WatermarkAccent = $acentoPrevio
}
function Show-NoMover   { Show-Aviso 'WAIT'   "DON'T MOVE"      '#E5484D' 0 }
function Show-Enter     { Show-Aviso 'ENTER'  'PRESS ENTER'     '#3FB950' 0 }
function Show-Verificar {
    if ($script:MismoPRO) {
        # Mismo PRO que la bill anterior: aviso naranja, dura mas
        Show-Aviso 'CHECK' 'SAME PRO AS THE LAST BILL - VERIFY AND SAVE' '#F29F05' 8000
    } else {
        Show-Aviso 'VERIFY' 'VERIFY AND SAVE' '#3FB950' 5000
    }
}
# Tiempo de F1/F2 abajo del VERIFY (solo si el VERIFY / CHECK sigue en pantalla)
function Show-TiempoFlujo([string]$tipo, [double]$seg) {
    if ($WatermarkWin.Visibility -ne 'Visible') { return }
    if ($script:WatermarkGhost.Text -ne 'VERIFY' -and $script:WatermarkGhost.Text -ne 'CHECK') { return }
    $script:WatermarkTiempo.Text = ('{0} OK IN {1:0.0} S' -f $tipo, $seg)
    $script:WatermarkTiempoBox.Visibility = 'Visible'
}

# Quita el DON'T MOVE si quedo puesto (por ejemplo si algo fallo)
function Hide-NoMover {
    if ($script:WatermarkGhost.Text -eq 'WAIT') { Hide-Watermark }
}

function Hide-Watermark {
    $script:WatermarkTimer.Stop()
    $WatermarkWin.Visibility = 'Hidden'
}

function Show-Flag([string]$donde, [string]$que) {
    $msg = Trunc ($donde + ': ' + $que) 90
    $script:LastError = (Get-Date -Format 'HH:mm') + ' ' + $msg
    try {
        $script:WatermarkGhost.Text = 'ERROR'
        $script:WatermarkGhost.Foreground = B '#E5484D'
        $script:WatermarkPill.BorderBrush = B '#E5484D'
        $script:WatermarkLabel.Text = $msg.ToUpper()
        $script:WatermarkTiempoBox.Visibility = 'Collapsed'
        $WatermarkWin.Visibility = 'Visible'
        $script:WatermarkTimer.Stop()
        $script:WatermarkTimer.Interval = [TimeSpan]::FromMilliseconds(8000)
        $script:WatermarkTimer.Start()
    } catch { }
}


