# ----------------------------- basicos ---------------------------------
function Esperar([int]$ms = $Global:PausaMs) { Start-Sleep -Milliseconds $ms }
function Teclas([string]$k) { Paso "Teclas: $k"; [System.Windows.Forms.SendKeys]::SendWait($k) }
# --------------------------- coordenadas -------------------------------
# Se lee del archivo solo la 1a vez y cuando el archivo cambia (antes se
# leia en cada click, ~2 veces por click).
$script:CoordsCache = $null
$script:CoordsFecha = [datetime]::MinValue
function Leer-MisCoords {
    if (-not [System.IO.File]::Exists($Global:ArchivoCoords)) { $script:CoordsCache = $null; return @{} }
    $fecha = [System.IO.File]::GetLastWriteTimeUtc($Global:ArchivoCoords)
    if ($null -ne $script:CoordsCache -and $fecha -eq $script:CoordsFecha) { return $script:CoordsCache.Clone() }
    $r = @{}
    foreach ($l in [System.IO.File]::ReadAllLines($Global:ArchivoCoords)) {
        if ($l -match '^\s*(\w+)\s*=\s*(-?\d+)\s*,\s*(-?\d+)') {
            $r[$Matches[1]] = @([int]$Matches[2], [int]$Matches[3])
        }
    }
    $script:CoordsCache = $r
    $script:CoordsFecha = $fecha
    return $r.Clone()
}

# Devuelve @(X,Y): el mio si existe (y esta activado), si no el de la lista base
function Get-XY([string]$nombre) {
    if ($Global:Coord -eq 1) {
        $m = Leer-MisCoords
        if ($m.ContainsKey($nombre)) { return $m[$nombre] }
    }
    return $Global:Puntos[$nombre].XY
}

function DobleClickXY([string]$nombre) {
    $p = Get-XY $nombre
    Paso "Doble click $nombre en $($p[0]),$($p[1])"
    [Motor]::DoubleClick($p[0], $p[1])
}

# Espera hasta que haya texto en el portapapeles (max $ms). Devuelve el texto o ''
function Esperar-Portapapeles([int]$ms) {
    $t = 0
    while ($t -lt $ms) {
        $txt = ''
        try { $txt = [System.Windows.Forms.Clipboard]::GetText() } catch {}
        if ($txt -and $txt.Trim()) {
            Paso "Portapapeles listo a los $t ms"
            $script:UltPortaMs = $t
            return $txt.Trim()
        }
        Start-Sleep -Milliseconds 25           # revisa cada 25 ms (antes 100)
        $t += 25
    }
    Paso "Portapapeles vacio despues de $ms ms"
    return ''
}

function ClickXY([string]$nombre) {
    if (-not $Global:Puntos.Contains($nombre)) { throw "Unknown point: $nombre" }
    $p = Get-XY $nombre
    $fuente = 'base'
    if ($Global:Coord -eq 1 -and (Leer-MisCoords).ContainsKey($nombre)) { $fuente = 'mia' }
    Paso "Click $nombre en $($p[0]),$($p[1]) ($fuente)"
    [Motor]::Click($p[0], $p[1])
}

function Get-VentanaERP {
    Get-Process -Name mstsc -ErrorAction SilentlyContinue |
        Where-Object { $_.MainWindowTitle -like "*$Global:ERP_Titulo1*" -and
                       $_.MainWindowTitle -like "*$Global:ERP_Titulo2*" } |
        Select-Object -First 1
}
function Get-VentanaEdge {
    Get-Process -Name msedge -ErrorAction SilentlyContinue |
        Where-Object { $_.MainWindowHandle -ne [IntPtr]::Zero } |
        Select-Object -First 1
}

function Traer-ERP([int]$esperaMs = $Global:EsperaFocoERPms, [string]$clave = '', [switch]$Siempre) {
    Paso "Buscando ventana del ERP ('$Global:ERP_Titulo1' + '$Global:ERP_Titulo2')"
    $e = Get-VentanaERP
    if (-not $e) {
        $hay = (Get-Process -Name mstsc -ErrorAction SilentlyContinue | ForEach-Object { $_.MainWindowTitle }) -join ' | '
        if (-not $hay) { $hay = 'none' }
        throw "ERP window not found. Open remote desktops: $hay"
    }
    Paso "ERP encontrado: $($e.MainWindowTitle)"
    Paso 'Trayendo ERP al frente'
    $yaAlFrente = ([Motor]::GetForegroundWindow() -eq $e.MainWindowHandle)
    $ok = [Motor]::Traer($e.MainWindowHandle, 3)
    if (-not $ok -and [Motor]::ProcesoAlFrente() -eq 'mstsc') { $ok = $true }
    if (-not $ok) { throw "The ERP did not come to the front (in front: $([Motor]::ProcesoAlFrente()))." }
    if ($yaAlFrente -and -not $Siempre) {
        # Ya tenia el foco desde antes: no hace falta esperar
        Paso 'ERP ya estaba al frente (sin espera)'
        if ($clave) { P $clave '0' }
        return $e
    }
    Paso "ERP al frente: OK (espera foco $esperaMs ms)"
    if ($clave) { P $clave $esperaMs }
    # El Escritorio Remoto tarda en aceptar clicks/teclas despues de recibir el foco
    Esperar $esperaMs
    return $e
}
function Traer-Edge {
    # Si Edge YA esta al frente, no se toca nada (ni se minimiza el ERP)
    if ([Motor]::ProcesoAlFrente() -eq 'msedge') { Paso 'Edge ya estaba al frente: OK'; Esperar 200; return }
    $e = Get-VentanaERP
    if ($e) { Paso 'Minimizando ERP'; [Motor]::ShowWindow($e.MainWindowHandle, 6) | Out-Null; EsperarT 'D0_MinimizaERP' }
    Paso 'Buscando ventana de Edge'
    $w = Get-VentanaEdge
    if (-not $w) { throw 'Microsoft Edge (msedge) is not open.' }
    Paso "Edge encontrado: $($w.MainWindowTitle)"
    $ok = [Motor]::Traer($w.MainWindowHandle, 0)
    # Edge tiene varias ventanas internas: si la que quedo al frente es de Edge, cuenta como OK
    if (-not $ok -and [Motor]::ProcesoAlFrente() -eq 'msedge') { $ok = $true }
    if (-not $ok) { throw "Edge did not come to the front (in front: $([Motor]::ProcesoAlFrente()))." }
    Paso 'Edge al frente: OK'
}

# --------------------- secuencia AUDIT (Ctrl izq + Abajo) ---------------------
# ===== TIEMPOS DE LA SECUENCIA AUDIT (Ctrl izq + Abajo), en milisegundos =====
# Todo a la mitad (~0.5 s menos que la build 14f). T11 y T12 van al mismo
# tiempo que llega lo copiado de mypc: bajarlas solo ahorra si mypc es rapido.
# Si algun paso falla, subele solo a ese (de 50 en 50).
# Al terminar sale arriba "AUDIT OK en X.X s" para que midas.
$Global:AuditT = [ordered]@{
    T01_AntesEsc     = 10    # 1. al soltar el Ctrl, antes del Esc en el ERP
    T02_TeclaEsc     = 30    #    cuanto se deja apretado el Esc
    T03_DespuesEsc   = 30    # 2. despues del Esc (que el ERP salga de la bill)
    T04_FocoMyPC     = 50    # 3. al pasar a mypc, antes de teclear
    T05_AntesDer     = 25    # 4. espera extra antes de la flecha Derecha
    T06_TeclaExcel   = 20    #    cuanto se deja apretada cada tecla del Excel de mypc
    T07_DespuesDer   = 25    # 5. despues de Derecha (escribe la 1a letra)
    T08_DespuesO     = 25    # 6. despues de la o (autorrellena)
    T09_DespuesAbajo = 25    # 7. despues de Abajo (confirma)
    T10_DespuesIzq   = 25    # 8. despues de Izquierda (siguiente en lista), antes de copiar
    T11_FocoERP      = 100   # 9. al regresar al ERP, antes del click
    T12_DespuesClick = 60    # 10. despues del click en 1185,545
    T13_DespuesPegar = 30    # 11. despues de pegar, antes del Enter
}
# (lo copiado se espera solo: hasta 3 s, sigue en cuanto llega)

# $true = TECLEA en el ERP lo copiado del Excel de mypc (rapido).
# $false = lo pega con Ctrl+V (el ERP tarda ~2 s en pedir el portapapeles
#          al Escritorio Remoto antes de pegar).
$Global:AuditTeclear = $true

# Se mueve entre el ERP y el Escritorio Remoto "mypc" (Excel).
$Global:MyPC_Titulo = 'mypc'

# ERP: Esc (sale de la bill) > mypc (Excel): Der (1a letra) > o (autorrellena) > Abajo (confirma) > Izq (sig. en lista)
#   > copiar > ERP: click 1185,545 > pegar > Enter
# Ventanas del ERP y de mypc guardadas (buscarlas con Get-Process tarda;
# solo se vuelven a buscar si la ventana guardada ya no existe)
$script:AuditHwnd = @{ ERP = [IntPtr]::Zero; MyPC = [IntPtr]::Zero }

function Get-AuditHwnds {
    $okE = $script:AuditHwnd.ERP  -ne [IntPtr]::Zero -and [LocalKeyState]::IsWindow($script:AuditHwnd.ERP)
    $okM = $script:AuditHwnd.MyPC -ne [IntPtr]::Zero -and [LocalKeyState]::IsWindow($script:AuditHwnd.MyPC)
    if ($okE -and $okM) { return }
    Paso 'Audit: buscando ventanas ERP y mypc'
    foreach ($p in @(Get-Process -Name mstsc -ErrorAction SilentlyContinue)) {
        $t = $p.MainWindowTitle
        if ($t -like "*$Global:ERP_Titulo1*" -and $t -like "*$Global:ERP_Titulo2*") { $script:AuditHwnd.ERP = $p.MainWindowHandle }
        elseif ($t -like "$Global:MyPC_Titulo*") { $script:AuditHwnd.MyPC = $p.MainWindowHandle }
    }
    if ($script:AuditHwnd.ERP  -eq [IntPtr]::Zero) { throw 'ERP window (TS Applications) not found.' }
    if ($script:AuditHwnd.MyPC -eq [IntPtr]::Zero) { throw "Window '$Global:MyPC_Titulo' (Remote Desktop) not found." }
}

function Traer-AuditHwnd([string]$cual, [int]$esperaMs) {
    $h = $script:AuditHwnd[$cual]
    $ok = [Motor]::Traer($h, 3)
    if (-not $ok -and [Motor]::ProcesoAlFrente() -eq 'mstsc') { $ok = $true }
    if (-not $ok) { $script:AuditHwnd[$cual] = [IntPtr]::Zero; throw "$cual did not come to the front (in front: $([Motor]::ProcesoAlFrente()))." }
    Paso "$cual al frente"
    Esperar $esperaMs
}

function Invoke-SecuenciaAudit {
    $propio = ($null -eq $Global:LogBuffer)    # si un F1/F2 ya tiene buffer, se usa ese
    if ($propio) { $Global:LogBuffer = New-Object System.Collections.ArrayList }
    try { return (Invoke-SecuenciaAuditPasos) }
    finally {
        # Escribe el log de la audit de un jalon al final
        Vaciar-LogMotor
        if ($propio) { $Global:LogBuffer = $null }
    }
}

function Invoke-SecuenciaAuditPasos {
    Paso '=== INICIO Secuencia audit ==='
    $T = $Global:AuditT
    $reloj = [System.Diagnostics.Stopwatch]::StartNew()
    try {
        Get-AuditHwnds
        # Esc para salir de la bill: siempre arrancas sobre el ERP con foco,
        # asi que va directo (sin traer ventanas: eso mandaba un Alt al ERP).
        # Teclas "de mano" (apretadas unos ms, con scan code) para el Escritorio Remoto.
        Esperar $T.T01_AntesEsc
        Paso 'Esc en la ventana actual (ERP)'
        [Motor]::TeclaLenta(0x1B, $T.T02_TeclaEsc)
        Esperar $T.T03_DespuesEsc
        Traer-AuditHwnd 'MyPC' $T.T04_FocoMyPC
        Esperar $T.T05_AntesDer
        Paso 'Excel: Der > o > Abajo > Izq'
        [Motor]::TeclaLenta(0x27, $T.T06_TeclaExcel); Esperar $T.T07_DespuesDer     # Derecha (1a letra)
        [Motor]::TeclaLenta(0x4F, $T.T06_TeclaExcel); Esperar $T.T08_DespuesO       # o (autorrellena)
        [Motor]::TeclaLenta(0x28, $T.T06_TeclaExcel); Esperar $T.T09_DespuesAbajo   # Abajo (confirma)
        [Motor]::TeclaLenta(0x25, $T.T06_TeclaExcel); Esperar $T.T10_DespuesIzq     # Izquierda (sig. en lista)
        try { [System.Windows.Forms.Clipboard]::Clear() } catch {}
        Teclas '^c'
        # No se espera a que llegue lo copiado aqui: mientras viaja desde mypc
        # se regresa al ERP y se da el click (como se hacia a mano). Se espera
        # solo justo antes de escribirlo, y casi siempre ya llego.
        $tCopia = $reloj.ElapsedMilliseconds
        Traer-AuditHwnd 'ERP' $T.T11_FocoERP
        Paso 'Click en 1185,545'
        [Motor]::Click(1185, 545); Esperar $T.T12_DespuesClick
        $txt = Esperar-Portapapeles 3000          # solo espera si todavia no llega
        Paso "Audit: lo copiado estuvo listo a los $($reloj.ElapsedMilliseconds - $tCopia) ms del Ctrl+C"
        if (-not $txt) { throw 'Nothing was copied from the mypc Excel (empty clipboard). Nothing was typed in the ERP.' }
        if ($Global:AuditTeclear) {
            # Escribe el texto (los simbolos especiales de SendKeys van entre llaves)
            $esc = -join ($txt.ToCharArray() | ForEach-Object {
                if ('+^%~(){}[]'.Contains([string]$_)) { '{' + $_ + '}' } else { [string]$_ } })
            Paso "Tecleando lo copiado ($($txt.Length) caracteres)"
            [System.Windows.Forms.SendKeys]::SendWait($esc)
        } else {
            Teclas '^v'
        }
        Esperar $T.T13_DespuesPegar
        Teclas '{ENTER}'
        $seg = '{0:0.0}' -f $reloj.Elapsed.TotalSeconds
        Paso "=== FIN Secuencia audit: OK en $seg s ==="
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = '#3FB950'
        Show-Watermark 'AUDIT' "AUDIT OK IN $seg S"
        $script:WatermarkAccent = $acentoPrevio
        return $true
    } catch { Fallo $_ 'Audit sequence'; return $false }
}

# Pega texto via portapapeles (mas confiable que teclearlo con SendKeys)
function Pegar([string]$texto, [int]$antesMs = 150) {
    Paso "Pegando texto ($($texto.Length) caracteres)"
    if (-not $texto) { throw 'The text to paste is empty.' }
    [System.Windows.Forms.Clipboard]::SetText($texto)
    Esperar $antesMs
    Teclas '^v'
}

# --------------------------- secuencias --------------------------------

# ===== TIEMPOS DE FORCE 1 / FORCE 2, en milisegundos =====
# VELOCIDAD 4 (build 20q) = los tiempos de la 4 (20e) + TODAS las mejoras
# hasta la 20p (1er intento del PRO de mano, intra vieja con color y espera
# extra, revision de PRO escrito, notas 20k-20n). Se regreso a la 4 porque la 3
# fallaba 1 de cada 10 al pegar la nota en la intra (~0.2-0.3 s mas por bill).
# Escala: 10 = 15j (la mas lenta), 9 = 15k, 8 = 15m, 7 = 15n, 6 = 17l,
# 5 = 20d, 4 = 20e / 20q (actual), 3 = 20p.
#   - COLOR (max = tabla): E1, E6, F1, F2, F3. Minimos en $Global:ColorMin
#   - NO se toca: B1, C2, C3, E5, E7 (NO BAJAR), D2, D3 (en revision), E3,
#     E9, G1, F4 y los 70 del portapapeles
# Columna derecha = valor de la velocidad 3 (20p), por referencia.
# Si un paso falla, regresa SOLO ese al valor de la derecha.
$Global:ForceT = [ordered]@{
    # --- A. NOTA ERP (al dar Enter en "revisar") ------------- vel 3
    A1_CierraMenu        = 100    # se cierra el menu antes de empezar      85
    A0_DespuesClickInicio = 110   # click en 110,217 (foco en el ERP)       95
    A2_FocoERP           = 130    # trae el ERP al frente                   110
    A3_AntesInstruc      = 130    # antes del click en 20,768               110
    A4_DespuesAltA       = 180    # click 20,768 + Alt+A, abre ventanita    155
    A5_DespuesFORCE      = 150    # escribe FORCE1 / FORCE2                 130
    A6_AntesPegarNota    = 70     # Tab y pega la nota ERP                  70
    # --- B. GUARDAS TU (Alt+O o Enter) ----------------------------
    B1_DespuesGuardar    = 520    # que el ERP guarde     (NO BAJAR)        520
    # --- C. COPIAR PRO (en el ERP) --------------------------------
