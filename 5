# Se llama despues de dar la terminal (Enter) en el flujo automatico
function Start-AutoTrasTerminal {
    if (-not $script:AutoTrasTerminal) { return }
    $script:AutoTrasTerminal = $false
    # Pequena espera para que el menu termine de cerrarse
    $t = New-Object System.Windows.Threading.DispatcherTimer
    Usuario-Fin 'terminal dada'
    LogT "  espera G1_TrasTerminal = $($Global:ForceT.G1_TrasTerminal) ms"
