    Paso ('Banda: no se pudo cargar: ' + $_.Exception.Message)
}

if ($script:BandaListo) {
    $script:BandaW = [BandaWin]::GetSystemMetrics(0)      # pixeles reales de la pantalla
    $script:BandaH = [BandaWin]::GetSystemMetrics(1)
    $script:BandaGris = New-Object byte[] ($script:BandaW * $script:BandaH)

    # Ventana de toda la pantalla, transparente, no recibe clicks
    $BandaWinV = New-Object System.Windows.Window
    $BandaWinV.WindowStyle        = 'None'
