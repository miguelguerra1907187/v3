        $pts = New-Object System.Windows.Media.PointCollection
        for ($i = 0; $i -lt 8; $i += 2) { $pts.Add((New-Object System.Windows.Point (Banda-Dip $p[$i]), (Banda-Dip $p[$i + 1]))) }
        $BandaPoli.Points = $pts
