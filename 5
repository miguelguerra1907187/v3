    }
    $BandaEtiqueta = Banda-NuevaEtiqueta '#F2FFD600' '#FF1E1E1E'     # "7 of 22"
    $BandaAvisoB   = Banda-NuevaEtiqueta '#E6202428' '#FFFFFFFF'     # avisos cortos

    $BandaWinV.Add_SourceInitialized({
        $script:BandaHwnd = (New-Object System.Windows.Interop.WindowInteropHelper($BandaWinV)).Handle
        [BandaWin]::Transparente($script:BandaHwnd)
    })

    function Banda-Dip([double]$px) { return $px * $script:BandaEsc }

    function Banda-Poner([System.Windows.Controls.Border]$b, [double]$xPx, [double]$yPx) {
        $b.Visibility = 'Visible'
        $b.Measure((New-Object System.Windows.Size ([double]::PositiveInfinity), ([double]::PositiveInfinity)))
        $ancho = $b.DesiredSize.Width; $alto = $b.DesiredSize.Height
        $x = Banda-Dip $xPx; $y = (Banda-Dip $yPx) - $alto / 2
        if ($x + $ancho -gt $BandaWinV.Width - 2) { $x = $BandaWinV.Width - $ancho - 2 }
        if ($x -lt 2) { $x = 2 }
