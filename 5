# Muestra en que paso fallo, el error y la linea del script
function Fallo($err, [string]$titulo = 'Motor') {
    $donde = $Global:UltimoPaso
    P 'fallo' $titulo
    $linea = $err.InvocationInfo.ScriptLineNumber
    $archivo = Split-Path -Leaf $err.InvocationInfo.ScriptName
    $txt = "FAILED AT STEP:`n  $donde`n`nERROR:`n  $($err.Exception.Message)`n`nFILE / LINE:`n  $archivo  line $linea`n`nNothing else was sent."
