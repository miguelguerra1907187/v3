try {
    if (-not ('BandaGuia' -as [type])) { Add-Type -TypeDefinition $BandaCodigoGuia }
    if (-not ('BandaWin' -as [type]))  { Add-Type -TypeDefinition $BandaCodigoWin -ReferencedAssemblies System.Drawing }
    # Si el programa aparte (abrir_banda.bat) esta abierto, esta se queda apagada (no dos bandas)
    $script:BandaMutex = New-Object System.Threading.Mutex($false, 'Local\BandaBreakdown_Miguel')
    if ($script:BandaMutex.WaitOne(0)) { $script:BandaListo = $true }
    else { $script:BandaMotivo = 'CLOSE abrir_banda.bat FIRST'; Paso 'Banda: el programa aparte (abrir_banda.bat) esta abierto; la del Force Menu queda apagada' }
} catch {
