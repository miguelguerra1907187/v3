function Show-Watermark([string]$tipo, [string]$label = '', [int]$ms = 3000) {
    $accent = if ($script:WatermarkAccent) { $script:WatermarkAccent } else { $C.F1 }
    $script:WatermarkGhost.Text = $tipo
    $script:WatermarkGhost.Foreground = B $accent
