    // ---- Foto de una zona de la pantalla (deteccion por color, velocidad 4) ----
    // Solo lee pixeles de la pantalla (como una captura), no guarda nada.
    [DllImport("gdi32.dll")] static extern IntPtr CreateCompatibleDC(IntPtr hdc);
    [DllImport("gdi32.dll")] static extern IntPtr CreateCompatibleBitmap(IntPtr hdc, int w, int h);
    [DllImport("gdi32.dll")] static extern IntPtr SelectObject(IntPtr hdc, IntPtr obj);
    [DllImport("gdi32.dll")] static extern bool BitBlt(IntPtr d, int x, int y, int w, int h, IntPtr s, int sx, int sy, uint rop);
    [DllImport("gdi32.dll")] static extern bool DeleteObject(IntPtr obj);
    [DllImport("gdi32.dll")] static extern bool DeleteDC(IntPtr hdc);
    [DllImport("gdi32.dll")] static extern int GetDIBits(IntPtr hdc, IntPtr bmp, uint start, uint lines, [Out] int[] bits, ref BMIH bi, uint usage);
    [StructLayout(LayoutKind.Sequential)] public struct BMIH {
        public uint biSize; public int biWidth; public int biHeight; public ushort biPlanes; public ushort biBitCount;
        public uint biCompression; public uint biSizeImage; public int biXPelsPerMeter; public int biYPelsPerMeter;
        public uint biClrUsed; public uint biClrImportant;
    }
    [StructLayout(LayoutKind.Sequential)] public struct RECT { public int Left; public int Top; public int Right; public int Bottom; }
    [DllImport("user32.dll")] static extern bool GetWindowRect(IntPtr h, out RECT r);
    // Rectangulo de la ventana al frente: izq, arriba, der, abajo
    public static int[] RectAlFrente() {
        RECT r;
        if (!GetWindowRect(GetForegroundWindow(), out r)) { return null; }
        return new int[] { r.Left, r.Top, r.Right, r.Bottom };
    }
    // Foto de la zona: 1 de cada 'paso' pixeles (en X y en Y), solo el color
    public static int[] Zona(int x, int y, int w, int h, int paso) {
        if (w <= 0 || h <= 0 || paso <= 0) { return new int[0]; }
        IntPtr scr = GetDC(IntPtr.Zero);
        IntPtr mem = CreateCompatibleDC(scr);
        IntPtr bmp = CreateCompatibleBitmap(scr, w, h);
        IntPtr old = SelectObject(mem, bmp);
        int[] todo = new int[w * h];
        try {
            BitBlt(mem, 0, 0, w, h, scr, x, y, 0x00CC0020);
            SelectObject(mem, old);
            BMIH bi = new BMIH();
            bi.biSize = (uint)Marshal.SizeOf(typeof(BMIH));
            bi.biWidth = w; bi.biHeight = -h; bi.biPlanes = 1; bi.biBitCount = 32; bi.biCompression = 0;
            GetDIBits(mem, bmp, 0, (uint)h, todo, ref bi, 0);
        } finally {
            DeleteObject(bmp);
            DeleteDC(mem);
            ReleaseDC(IntPtr.Zero, scr);
        }
        int nx = (w + paso - 1) / paso;
        int ny = (h + paso - 1) / paso;
        int[] r = new int[nx * ny];
        int k = 0;
        for (int yy = 0; yy < h; yy += paso) {
            for (int xx = 0; xx < w; xx += paso) { r[k++] = todo[yy * w + xx] & 0xFFFFFF; }
        }
        return r;
    }
    // Que parte (0 a 1) de los pixeles es distinta entre dos fotos (-1 = no se puede)
    public static double Diferencia(int[] a, int[] b) {
        if (a == null || b == null || a.Length == 0 || a.Length != b.Length) { return -1; }
        int n = 0;
        for (int i = 0; i < a.Length; i++) { if (a[i] != b[i]) { n++; } }
        return (double)n / a.Length;
    }
    // Que parte (0 a 1) de la foto es de UN solo color (1 = zona vacia / en blanco)
    public static double Uniforme(int[] a) {
        if (a == null || a.Length == 0) { return 1; }
        System.Collections.Generic.Dictionary<int, int> c = new System.Collections.Generic.Dictionary<int, int>();
        int mx = 0;
        for (int i = 0; i < a.Length; i++) {
            int n;
            c.TryGetValue(a[i], out n);
            n++;
            c[a[i]] = n;
            if (n > mx) { mx = n; }
        }
        return (double)mx / a.Length;
    }


    // Nombre del proceso de la ventana que tiene el foco (ej. msedge, mstsc)
    public static string ProcesoAlFrente() {
        uint pid;
        GetWindowThreadProcessId(GetForegroundWindow(), out pid);
        try { return System.Diagnostics.Process.GetProcessById((int)pid).ProcessName.ToLower(); }
        catch { return ""; }
    }

    // La ventana no roba el foco al darle click (WS_EX_NOACTIVATE)
    public static void NoActivate(IntPtr h) {
        SetWindowLong(h, -20, GetWindowLong(h, -20) | 0x08000000);
    }

    // Doble click real (los 2 clicks juntos, sin pausa en medio)
    // Tiempos parecidos a un doble click de mano (el Escritorio Remoto
    // a veces no reconoce clicks demasiado pegados)
    public static void DoubleClick(int x, int y) {
        SetCursorPos(x, y);
        System.Threading.Thread.Sleep(80);
        mouse_event(0x2, 0, 0, 0, UIntPtr.Zero);
        System.Threading.Thread.Sleep(25);
        mouse_event(0x4, 0, 0, 0, UIntPtr.Zero);
        System.Threading.Thread.Sleep(90);
        mouse_event(0x2, 0, 0, 0, UIntPtr.Zero);
        System.Threading.Thread.Sleep(25);
        mouse_event(0x4, 0, 0, 0, UIntPtr.Zero);
    }

    // Tecla "de mano": baja, la deja apretada unos ms y la suelta, con scan code
    // (el Escritorio Remoto a veces ignora teclas demasiado rapidas o sin scan code)
    [DllImport("user32.dll")] static extern uint MapVirtualKey(uint code, uint type);
    public static void TeclaLenta(byte vk, int holdMs) {
        byte sc = (byte)MapVirtualKey(vk, 0);
        keybd_event(vk, sc, 0, UIntPtr.Zero);
        System.Threading.Thread.Sleep(holdMs);
        keybd_event(vk, sc, 2, UIntPtr.Zero);
    }
    // Combinacion "de mano" (ej. Shift+Fin, Ctrl+C): aprieta el modificador, luego
    // la tecla, y suelta, con scan code y pausas. ext = tecla extendida (Inicio,
    // Fin): sin eso el Escritorio Remoto la tomaria como del teclado numerico.
    // mod = 0 si no lleva modificador.
    public static void ComboLenta(byte mod, byte vk, bool ext, int holdMs) {
        uint fx = ext ? 1u : 0u;
        byte sc = (byte)MapVirtualKey(vk, 0);
        byte smod = 0;
        if (mod != 0) {
            smod = (byte)MapVirtualKey(mod, 0);
            keybd_event(mod, smod, 0, UIntPtr.Zero);
            System.Threading.Thread.Sleep(holdMs);
        }
        keybd_event(vk, sc, fx, UIntPtr.Zero);
        System.Threading.Thread.Sleep(holdMs);
        keybd_event(vk, sc, fx | 2u, UIntPtr.Zero);
        if (mod != 0) {
            System.Threading.Thread.Sleep(holdMs);
            keybd_event(mod, smod, 2, UIntPtr.Zero);
        }
    }

    public static bool Traer(IntPtr h, int show) {
        // Si ya esta al frente no se hace nada (el Alt fantasma abriria el menu de la ventana)
        if (GetForegroundWindow() == h && !IsIconic(h)) { return true; }
        for (int i = 0; i < 2; i++) {
            // Tecla fantasma para que Windows deje cambiar de ventana. Antes era
            // Alt, pero el Alt le llegaba a la ventana que se iba (Excel se quedaba
            // en modo navegacion de teclado / el ERP abria su menu). Ctrl solo no hace nada.
            keybd_event(0x11, 0, 0, UIntPtr.Zero);
            keybd_event(0x11, 0, 2, UIntPtr.Zero);
            IntPtr fg = GetForegroundWindow();
            uint pid;
            uint fgT = GetWindowThreadProcessId(fg, out pid);
            uint me = GetCurrentThreadId();
            bool att = false;
            if (fgT != me) { att = AttachThreadInput(me, fgT, true); }
            if (IsIconic(h)) { ShowWindow(h, 9); }
            if (show != 0) { ShowWindow(h, show); }
            BringWindowToTop(h);
            SetForegroundWindow(h);
            if (att) { AttachThreadInput(me, fgT, false); }
            // Revisa cada 10 ms (max 250) en vez de esperar 250 fijos
            for (int w = 0; w < 25; w++) {
                if (GetForegroundWindow() == h) { return true; }
                System.Threading.Thread.Sleep(10);
            }
            if (GetForegroundWindow() == h) { return true; }
        }
        return false;
    }
