# Nota de force en el ERP
function Invoke-NotaERP {
    param([string]$Force, [string]$Nota)
    $F = $Global:ForceT
    Paso "=== INICIO Nota ERP ($Force) ==="
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    try {
        Traer-ERP $F.A2_FocoERP | Out-Null
        EsperarT 'A3_AntesInstruc'
        ClickXY 'ERP_Instrucciones'
        Teclas '%a'                     # Alt+A
        EsperarT 'A4_DespuesAltA'
        Teclas $Force                   # FORCE1 / FORCE2
        EsperarT 'A5_DespuesFORCE'
        Teclas '{TAB}'
        Pegar $Nota $F.A6_AntesPegarNota
        Paso '=== FIN Nota ERP: OK ==='
        return $true
    } catch {
        Fallo $_ 'ERP note'
        return $false
    }
}

# Nota informativa en intra
function Invoke-NotaIntra {
    param([string]$Nota)
    $F = $Global:ForceT
    Paso '=== INICIO Nota intra ==='
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    try {
        # F1: la nota se pone donde dejo Edge el PRO lookup F1 (intra normal).
        # NO se va a la intra vieja (eso solo es de F2).
        Traer-Edge
        # F1: carga del resultado, contada desde el Enter de la busqueda
        EsperarCargaBusqueda 'F1_FocoEdge' 150
        # F2 y F3 por COLOR: foto antes del click y sigue en cuanto la nota /
        # la lista aparecio y se quedo quieta (maximo = tabla, minimo = ColorMin)
        $fotoNota = Foto (Get-ZonaEdge)
