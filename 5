    $BandaWinV.Background         = 'Transparent'
    $BandaWinV.Topmost            = $true
    $BandaWinV.ShowInTaskbar      = $false
    $BandaWinV.ShowActivated      = $false
    $BandaWinV.ResizeMode         = 'NoResize'
    $BandaWinV.IsHitTestVisible   = $false
    $BandaWinV.Left = 0; $BandaWinV.Top = 0
    $BandaWinV.Width  = [System.Windows.SystemParameters]::PrimaryScreenWidth
    $BandaWinV.Height = [System.Windows.SystemParameters]::PrimaryScreenHeight
    $BandaCanvas = New-Object System.Windows.Controls.Canvas
    $BandaWinV.Content = $BandaCanvas

    $BandaPoli = New-Object System.Windows.Shapes.Polygon
    $BandaPoli.Fill = B '#55FFEB3B'                # amarillo, 33 %
    $BandaPoli.Stroke = B '#CCF9A825'
    $BandaPoli.StrokeThickness = 1
