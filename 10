        $script:RePagArmed = $false
        return
    }
    $oK = ([LocalKeyState]::GetAsyncKeyState(0x4F) -band 0x8001) -ne 0
    $oEdge = $oK -and $script:OArmed
    $script:OArmed = -not $oK
    $enK = ([LocalKeyState]::GetAsyncKeyState(0x0D) -band 0x8001) -ne 0
    $enEdge = $enK -and $script:EnterArmed
    $script:EnterArmed = -not $enK
