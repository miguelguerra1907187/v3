            $kp = [int]$script:FillManual.Peso; if ($kp -lt 0) { $kp = $g.ColumnaPeso() }
            $roles = @{ Peso = $kp; Pcs = [int]$script:FillManual.Pcs; Desc = [int]$script:FillManual.Desc; Clase = [int]$script:FillManual.Clase; Nmfc = [int]$script:FillManual.Nmfc }
            $a = Armar-Manual $g $script:FillCache $roles $script:FillOcr $script:FillAutoHu
            $script:FillInfo = "$($g.Filas.Count) rows | $($g.InfoSeparadores) | manual $($sw.ElapsedMilliseconds) ms"
            $enc = "FORCE MENU FILL (MANUAL) | $ScriptVersion | OCR $($script:OcrIdioma) | $($script:FillInfo) | angle $([Math]::Round($g.Grados, 2))"
            $script:FillReporte = Texto-Reporte $a.Filas $a.Res $enc
            Fill-Terminar $a.Res
        } catch {
            $script:FillFase = 'no'
            $script:FillReporte = 'FILL error: ' + $_.Exception.Message
            $script:BandaIdx = 0
            Banda-Mostrar
            Fill-AvisoFila ('FILL error: ' + $_.Exception.Message + ' - band only') 0 5000 -Rojo
        }
    }
    $BandaWinV.Show()
    $bandaSrc = [System.Windows.PresentationSource]::FromVisual($BandaWinV)
    if ($bandaSrc) { $script:BandaEsc = $bandaSrc.CompositionTarget.TransformFromDevice.M11 }
}
function Set-BandaActivo([bool]$on) {
    $script:BandaActivo = $on
    if (-not $on) { Banda-Apagar }
    if (-not $on -and $script:FillActivo) { Set-FillActivo $false }
    if ($script:SwBandaTxt) {
        $col = if (-not $script:BandaListo) { $C.Dim } elseif ($on) { '#E3B341' } else { $C.Dim }
        $script:SwBandaTxt.Text = if ($on -and $script:BandaListo) { 'BAND ON' } else { 'BAND OFF' }
        $script:SwBandaTxt.Foreground = B $col
        $script:SwBandaBtn.BorderBrush = B $col
        $script:SwBandaBtn.Background  = B (Get-Soft $col)
    }
    if ($on -and -not $script:BandaListo) {
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        Show-Watermark 'BAND' ('BAND NOT AVAILABLE: ' + $script:BandaMotivo) 3000
        $script:WatermarkAccent = $acentoPrevio
    }
    Paso ("Switch banda: " + $(if ($on) { 'ON' } else { 'OFF' }))
}
function Set-FillActivo([bool]$on) {
    $script:FillActivo = $on
    $listo = $script:BandaListo
    if ($on -and $listo) {
        if (-not $script:BandaActivo) { Set-BandaActivo $true }
        $listo = Ocr-Iniciar
    }
    if (-not $on -and $script:BandaEstado -ne 'off' -and $script:FillFase) { Banda-Apagar }
    if ($script:SwFillTxt) {
        $col = if (-not $listo) { $C.Dim } elseif ($on) { '#58A6FF' } else { $C.Dim }
        $script:SwFillTxt.Text = if ($on -and $listo) { 'FILL ON' } else { 'FILL OFF' }
        $script:SwFillTxt.Foreground = B $col
        $script:SwFillBtn.BorderBrush = B $col
        $script:SwFillBtn.Background  = B (Get-Soft $col)
    }
    if ($on -and -not $listo) {
        $script:FillActivo = $false
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        $mot = if (-not $script:BandaListo) { $script:BandaMotivo } else { 'WINDOWS OCR: ' + $script:OcrMotivo }
        Show-Watermark 'FILL' ('FILL NOT AVAILABLE: ' + $mot) 3500
        $script:WatermarkAccent = $acentoPrevio
    }
    Paso ("Switch fill: " + $(if ($script:FillActivo) { 'ON' } else { 'OFF' }))
}
function Set-AuditActivo([bool]$on) {
    $script:AuditActivo = $on
    if ($script:SwAuditTxt) {
        $col = if ($on) { '#3FB950' } else { $C.Dim }
        $script:SwAuditTxt.Text = if ($on) { 'AUDIT ON' } else { 'AUDIT OFF' }
        $script:SwAuditTxt.Foreground = B $col
        $script:SwAuditBtn.BorderBrush = B $col
        $script:SwAuditBtn.Background  = B (Get-Soft $col)
    }
    Paso ("Switch audit: " + $(if ($on) { 'ON' } else { 'OFF' }))
}
