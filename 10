                Save-PrevForeground
                $Win.Visibility = 'Visible'
                Set-MenuFocus
            }
            Enter-Terminal
        } elseif ($insEdge -and -not $ctrlK -and $script:State -eq 'done') {
            if ($script:NotePair.Count -eq 2) {
                $script:NoteIdx = 1 - $script:NoteIdx
                Set-Clip $script:NotePair[$script:NoteIdx]
                Show-Watermark $(if ($script:NoteIdx -eq 0) { 'INTRA' } else { 'ERP' })
                if ($script:State -eq 'done') { Draw-Done }
            } elseif ($script:LastCopied) {
                Set-Clip $script:LastCopied
            }
        }
    } catch {
        Show-Flag $(if ($delEdge) { 'Del' } else { 'Insert' }) $_.Exception.Message
    }
