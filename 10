function Esperar-Pantalla([string]$k, $antes, [int]$yaMs = 0) {
    $max = [int]$Global:ForceT[$k]
    $extra = if ($Global:ColorExtra -and $Global:ColorExtra.Contains($k)) { [int]$Global:ColorExtra[$k] } else { 0 }
    $tope = $max + $extra
    $min = if ($Global:ColorMin.Contains($k)) { [int]$Global:ColorMin[$k] } else { 0 }
    $umbral = if ($Global:ColorCambio.Contains($k)) { [double]$Global:ColorCambio[$k] } else { 0.01 }
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $tCambio = -1; $tQuieto = -1; $prev = $null
    $maxDif = 0.0; $ultMov = 0.0
    $vacia = $false
    if ($null -ne $antes) {
        while (($yaMs + $sw.ElapsedMilliseconds) -lt $tope) {
            $px = $null
            try { $px = [Motor]::Zona($antes.Z[0], $antes.Z[1], $antes.Z[2], $antes.Z[3], $Global:ColorPaso) } catch { $px = $null }
            if ($null -eq $px) { $tope = $max; break }
            $t = $yaMs + $sw.ElapsedMilliseconds
            $dAntes = [Motor]::Diferencia($antes.Px, $px)
            if ($dAntes -gt $maxDif) { $maxDif = $dAntes }
            if ($tCambio -lt 0) {
                if ($dAntes -ge $umbral) { $tCambio = $t }
            } else {
                $mov = [Motor]::Diferencia($prev, $px)
                if ($mov -le $Global:ColorQuieto) {
                    if ($tQuieto -lt 0) { $tQuieto = $t }
                    if (($t - $tQuieto) -ge $Global:ColorQuietoMs -and $t -ge $min -and (Test-ZonaVacia $px)) {
                        $vacia = $true; $tQuieto = -1
                    } elseif (($t - $tQuieto) -ge $Global:ColorQuietoMs -and $t -ge $min) {
                        $igual = ($dAntes -lt $Global:ColorIgual)
                        LogT ("  espera {0}: LISTO a los {1} ms (cambio a {2} ms, {3:0.00} %, max {4}){5}" -f $k, $t, $tCambio, ($dAntes * 100), $max, $(if ($igual) { '  OJO: quedo igual que antes' } else { '' }))
                        P $k ('{0}*{1}{2}' -f $t, $(if ($t -gt $max) { '+' } else { '' }), $(if ($igual) { '!' } else { '' }))
                        return
                    }
                } else { $tQuieto = -1; $ultMov = $mov }
            }
            $prev = $px
            Start-Sleep -Milliseconds 30
        }
    }
    if ($null -eq $antes) { $tope = $max }
    $falta = $tope - $yaMs - $sw.ElapsedMilliseconds
    if ($falta -gt 0) { Start-Sleep -Milliseconds $falta }
    $como = if ($null -eq $antes) { 'sin foto' }
            elseif ($tCambio -lt 0) { 'no cambio: lo mas {0:0.00} %, pide {1:0.00} %' -f ($maxDif * 100), ($umbral * 100) }
            elseif ($vacia) { 'cambio a {0} ms pero se veia VACIA (en blanco)' -f $tCambio }
            else { 'cambio a {0} ms, no se quedo quieta: se movia {1:0.00} %, quieto es <= {2:0.00} %' -f $tCambio, ($ultMov * 100), ($Global:ColorQuieto * 100) }
    LogT ("  espera {0}: {1} ms completos ({2})" -f $k, $tope, $como)
    P $k $(if ($tope -gt $max) { "$tope+" } else { $max })
}
function EsperarCargaBusqueda([string]$k, [int]$minMs = 0) {
    if ((Test-ColorDisponible) -and $null -ne $script:FotoBusqueda -and $script:TEnterBusqueda -ge 0) {
        $ya = $script:RelojMotor.ElapsedMilliseconds - $script:TEnterBusqueda
        if ($ya -lt [int]$Global:ForceT[$k]) { Esperar-Pantalla $k $script:FotoBusqueda $ya; return }
    }
    EsperarDesdeBusqueda $k $minMs
}
function EsperarDesdeBusqueda([string]$k, [int]$minMs = 0) {
    $max = [int]$Global:ForceT[$k]
    $ya = 0
    if ($script:TEnterBusqueda -ge 0) { $ya = $script:RelojMotor.ElapsedMilliseconds - $script:TEnterBusqueda }
    $falta = [Math]::Max($minMs, $max - $ya)
    LogT ("  espera {0} = {1} ms (ya pasaron {2} ms desde la busqueda, espero {3} ms)" -f $k, $max, $ya, $falta)
    P $k $falta
    if ($falta -gt 0) { Start-Sleep -Milliseconds $falta }
}
