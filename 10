            $script:FillRes = $a.Res
            $script:FillInfo = "$($g.Filas.Count) rows | $($g.InfoSeparadores) | $($sw.ElapsedMilliseconds) ms"
            $enc = "FORCE MENU FILL | $ScriptVersion | OCR $($script:OcrIdioma) | $($script:FillInfo) | angle $([Math]::Round($g.Grados, 2))"
            $script:FillReporte = Texto-Reporte $a.Filas $a.Res $enc
            Fill-Terminar $a.Res
        } catch {
            $script:FillFase = 'no'
            $script:FillReporte = 'FILL error: ' + $_.Exception.Message
            $script:BandaIdx = 0
            Banda-Mostrar
            Fill-AvisoFila ('FILL error: ' + $_.Exception.Message + ' - band only') 0 5000 -Rojo
