function Process-ListKey([string]$k) {
    $count = $script:LM_Options.Count
    if ($count -eq 0) { return $null }
    $shift = ([System.Windows.Input.Keyboard]::Modifiers -band [System.Windows.Input.ModifierKeys]::Shift) -ne 0
    $h = $script:LM_Highlight
    if ($k -eq 'Up')    { if ($h + 3 -lt $count) { $script:LM_Highlight = $h + 3 }; Draw-List; return $null }
    if ($k -eq 'Down')  { if ($h - 3 -ge 0)      { $script:LM_Highlight = $h - 3 }; Draw-List; return $null }
    if ($k -eq 'Right') { if (($h % 3) -lt 2 -and ($h + 1) -lt $count) { $script:LM_Highlight = $h + 1 }; Draw-List; return $null }
    if ($k -eq 'Left')  { if (($h % 3) -gt 0) { $script:LM_Highlight = $h - 1 }; Draw-List; return $null }
    if ($k -eq 'Tab' -and -not $shift) {
        $script:LM_Highlight = ($h + 1) % $count; Draw-List; return $null
    }
    if ($k -eq 'Tab' -and $shift) {
        $script:LM_Highlight = ($h - 1 + $count) % $count; Draw-List; return $null
    }
    if ($k -eq 'Space') {
        if ($script:LM_Multi) {
            if ($script:LM_Selected.Contains($script:LM_Highlight)) { [void]$script:LM_Selected.Remove($script:LM_Highlight) }
            else { [void]$script:LM_Selected.Add($script:LM_Highlight) }
            Draw-List
        }
        return $null
    }
    if ($k -eq 'Return' -or $k -eq 'Enter') {
        if ($script:LM_Multi) {
            if ($script:LM_Selected.Count -eq 0) { [void]$script:LM_Selected.Add($script:LM_Highlight) }
            return ,@($script:LM_Selected | Sort-Object | ForEach-Object { $script:LM_Options[$_] })
        }
        return $script:LM_Options[$script:LM_Highlight]
    }
    if ($k -eq 'Escape' -or $k -eq 'Home') { return 'BACK' }
    if ($k -match '^(D|NumPad)([1-9])$') {
        $n = [int]$Matches[2] - 1
        if ($n -lt $count) {
            if ($script:LM_Multi) {
                $script:LM_Highlight = $n
                if ($script:LM_Selected.Contains($n)) { [void]$script:LM_Selected.Remove($n) } else { [void]$script:LM_Selected.Add($n) }
                Draw-List
                return $null
            }
            return $script:LM_Options[$n]
        }
    }
    return $null
}
function Key-List([string]$k) {
    $result = Process-ListKey $k
    if ($null -eq $result) { return }
    if ($result -is [string] -and $result -eq 'BACK') {
        if ($script:ListCtx -eq 'issue') { Show-Nivel1 } else { Enter-IssueMenu }
        return
    }
    switch ($script:ListCtx) {
        'issue' {
            if ($result -is [array]) {
                $script:PendientesIssue = New-Object System.Collections.Generic.List[object]
                foreach ($lbl in $result) {
                    $iss = Get-Issues | Where-Object { $_.Label -eq $lbl } | Select-Object -First 1
                    if (-not $iss) { continue }
                    if ($iss.Sub -eq 'none') { Agregar-Fijo $iss.Tag }
                    else { $script:PendientesIssue.Add($iss) }
                }
                Siguiente-Pendiente
                return
            }
            $script:CurrentIssue = Get-Issues | Where-Object { $_.Label -eq $result } | Select-Object -First 1
            switch ($script:CurrentIssue.Sub) {
                'none'   { Agregar-Fijo $script:CurrentIssue.Tag; Enter-Confirm }
                'multi'  { Enter-List $script:CurrentIssue.SubList $true 'multi-tag' }
                'reason' { Enter-List $script:CurrentIssue.SubList $true 'issue-reason' }
                'pro'    { $lista = if ($script:CurrentIssue.SubList) { $script:CurrentIssue.SubList } else { $Campos }; Enter-List $lista $true 'pro-fields' }
                'text'   { Enter-FreeText $script:CurrentIssue }
            }
        }
        'multi-tag' {
            $full = $script:CurrentIssue.Full
            $tag  = $script:CurrentIssue.Tag
            if ($full -and ($result -contains $full)) { Agregar-Fijo $full }
            else {
                if ($result -contains 'invalid city') { Agregar-Fijo "invalid $tag city and zip per usps email it to tac" }
                else { Agregar-Issue $tag '-' $result }
            }
            Siguiente-Pendiente
        }
        'issue-reason' {
            $tagR = $script:CurrentIssue.Tag
            Agregar-Issue $tagR ' ' @($result | Where-Object { $_ -ne $tagR })
            Siguiente-Pendiente
        }
        'pro-fields' {
            Agregar-Issue $script:CurrentIssue.Tag ' ' $result
            Siguiente-Pendiente
        }
    }
}
function Agregar-Issue([string]$tag, [string]$sep, [string[]]$detalles) {
    $detalles = @($detalles | Where-Object { $_ })
    for ($i = 0; $i -lt $script:Basket.Count; $i++) {
        $b = $script:Basket[$i]
        if ($b -eq $tag) {
            if ($detalles.Count) { $script:Basket[$i] = $tag + $sep + ($detalles -join ',') }
            return
        }
        if ($b.StartsWith($tag + $sep)) {
            $ya = @($b.Substring(($tag + $sep).Length) -split ',')
            $nuevos = @($detalles | Where-Object { $ya -notcontains $_ })
            if ($nuevos.Count) { $script:Basket[$i] = $b + ',' + ($nuevos -join ',') }
            return
        }
    }
    if ($detalles.Count) { $script:Basket.Add($tag + $sep + ($detalles -join ',')) }
    else { $script:Basket.Add($tag) }
}
function Agregar-Fijo([string]$texto) {
    if (-not $script:Basket.Contains($texto)) { $script:Basket.Add($texto) }
}
$script:PendientesIssue = $null
function Siguiente-Pendiente {
    while ($script:PendientesIssue -and $script:PendientesIssue.Count -gt 0) {
        $iss = $script:PendientesIssue[0]
        $script:PendientesIssue.RemoveAt(0)
        $script:CurrentIssue = $iss
        switch ($iss.Sub) {
            'text'   { Enter-FreeText $iss; return }
            'reason' { Enter-List $iss.SubList $true 'issue-reason'; return }
            'multi'  { Enter-List $iss.SubList $true 'multi-tag'; return }
            'pro'    { $lista = if ($iss.SubList) { $iss.SubList } else { $Campos }; Enter-List $lista $true 'pro-fields'; return }
        }
    }
    Enter-Confirm
}
