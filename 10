        if ((([LocalKeyState]::GetAsyncKeyState(0x11) -band 0x8000) -ne 0)) { Show-Flag 'PRO lookup' 'release Ctrl to start'; return }
        if (-not $script:MotorOK) { Show-Flag 'PRO lookup' $script:MotorError; return }
        Banda-Apagar
