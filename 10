        if ($i -lt $count) {
            $hl  = ($i -eq $script:LM_Highlight)
            $sel = $script:LM_Multi -and $script:LM_Selected.Contains($i)
            $cell.Background  = if ($hl) { B (Get-Soft $accent) } else { B $C.Panel }
            $cell.BorderBrush = if ($hl -or $sel) { B $accent } else { B $C.KeyBorder }
            [void]$top.Children.Add((New-Keycap ([string]($i + 1)) $(if ($hl -or $sel) { $accent } else { '' }) 12))
            if ($sel) {
                $mk = New-Text $CHECK 14 $accent 'Bold'
