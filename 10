function Notas-DelFlujo($buf) {
    $n = New-Object System.Collections.Generic.List[string]
    if ($null -eq $buf) { return '' }
    foreach ($l in $buf) {
        $m = ([string]$l -replace '^\s*[\d\.,]+ s\s+', '').Trim()
        $x = $null
        if ($m -match '^espera (E6|F1|F2|F3)_\w+: (\d+) ms completos \((.+)\)$') { $x = "$($Matches[1]) no detecto ($($Matches[3]))" }
        elseif ($m -match '^espera ([A-Z]\d)_\w+: LISTO .*OJO') { $x = "$($Matches[1]) quedo igual que antes" }
        elseif ($m -match '^PRO intento ([23]) de 3') { $x = "copiar PRO: intento $($Matches[1])" }
        elseif ($m -match '^PRO en (.+): cambio ([\d\.,]+) %.*NO se ve') { $x = "PRO no se vio en $($Matches[1]) ($($Matches[2]) %)" }
        elseif ($m -match '^Foco perdido \(al frente: (\S*)\)') { $x = "foco perdido (al frente: $($Matches[1]))" }
        elseif ($m -match '^AVISO: es el mismo PRO') { $x = 'mismo PRO que la bill anterior' }
        elseif ($m -match '^ERROR en \[(.+?)\] -> (.+) \(\S+ linea \d+\)$') { $x = "ERROR en [$($Matches[1])]: $($Matches[2])" }
        elseif ($m -match '^Flujo auto detenido: (.+)$') { $x = "detenido: $($Matches[1])" }
        if ($x -and -not $n.Contains($x)) { $n.Add($x) }
    }
    $s = $n -join '; '
    if ($s.Length -gt 240) { $s = $s.Substring(0, 237) + '...' }
    return $s
}
