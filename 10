function Start-AutoTrasTerminal {
    if (-not $script:AutoTrasTerminal) { return }
    $script:AutoTrasTerminal = $false
    $t = New-Object System.Windows.Threading.DispatcherTimer
    Usuario-Fin 'terminal dada'
    LogT "  espera G1_TrasTerminal = $($Global:ForceT.G1_TrasTerminal) ms"
    P 'G1_TrasTerminal' $Global:ForceT.G1_TrasTerminal
    $t.Interval = [TimeSpan]::FromMilliseconds($Global:ForceT.G1_TrasTerminal)
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if (-not (Test-MotorListo)) { return }
        $script:MotorCorriendo = $true
        Show-NoMover
        try {
            if (Run-Accion 'intra') {
                if ($script:BtnErp) { Run-Accion 'erp' | Out-Null }
            }
        } catch {
            Show-Flag 'AUTO' $_.Exception.Message
        } finally {
            $script:MotorCorriendo = $false
            Hide-NoMover
            Cerrar-LogTiempos $(if ($script:WatermarkGhost.Text -eq 'VERIFY' -or $script:WatermarkGhost.Text -eq 'CHECK') { 'OK' } else { 'ERROR' })
        }
    })
