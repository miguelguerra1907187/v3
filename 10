            }
        } catch { Stop-FlujoAuto $_.Exception.Message }
    }
    if ($script:State -eq 'upper') { return }
    if (-not ($delEdge -or $insEdge)) { return }
    try {
        if ($delEdge) {
            if ($script:State -eq 'hidden') { Open-Menu } else { $script:AutoTrasTerminal = $false; Close-Menu }
