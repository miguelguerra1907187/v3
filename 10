        [void]$sb.AppendLine(('{0,2} {1,-5} {2}' -f ($i + 1), $t.Tipo, $cel))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('ERP LINES (what would be typed, in the Edit Details order; Tab between fields)')
    $fl = '{0,-3}{1,-7}{2,-9}{3,-10}{4,-9}{5,-11}{6,-40}{7,-8}{8,-12}{9}'
    [void]$sb.AppendLine(($fl -f '#', 'Pieces', 'Pkg Type', 'Qualifier', 'Q Pieces', 'Q Pkg Type', 'Description', 'Weight', 'Charge Type', 'NMFC'))
    foreach ($l in @($res.LineasHazmat)) {
        if ($l) { [void]$sb.AppendLine(($fl -f $l.N, $l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $l.Desc, $l.Weight, $l.Clase, $l.Nmfc) + "  <- row $($l.Fila) HAZMAT: you type it (first)") }
    }
    foreach ($l in $res.Lineas) {
        [void]$sb.AppendLine(($fl -f $l.N, $l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, (Campo-Ver $l 5 $l.Desc), $l.Weight, (Campo-Ver $l 7 $l.Clase), $l.Nmfc))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('CHECKS')
    foreach ($c in $res.Candados) {
        [void]$sb.AppendLine(('{0,-3} {1}' -f $c[0], $c[1]))
        if ($c.Count -gt 2 -and $c[2]) { [void]$sb.AppendLine(('                {0}' -f $c[2])) }
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($(if ($res.Bien) { 'RESULT: ALL CHECKS OK' } else { 'RESULT: NOT READY - see checks' }))
    return $sb.ToString()
}
function Textos-Por-Celda($celdas, $lineas) {
    $r = @{}
    foreach ($l in ($lineas | Sort-Object @{ e = { [Math]::Round($_.Y / 12) } }, X)) {
        $mejor = $null; $md = [double]::MaxValue
        foreach ($c in $celdas) {
            if ($c.Vacia) { continue }
            $d = if ($l.Y -lt $c.Y0) { $c.Y0 - $l.Y } elseif ($l.Y -gt $c.Y1) { $l.Y - $c.Y1 } else { 0 }
            if ($d -lt $md) { $md = $d; $mejor = $c }
        }
        if ($mejor -and $md -le 20) { $r[$mejor.Col] = (([string]$r[$mejor.Col]) + ' ' + $l.Texto).Trim() }
    }
    return $r
}
function Asignar-Lineas($celdas, $lineas) {
    $t = Textos-Por-Celda $celdas $lineas
    foreach ($c in $celdas) { if (-not $c.Vacia) { $c.Texto = [string]$t[$c.Col] } }
}
function Ocr-Celdas($cs, [int]$esc, [scriptblock]$ocr) {
    $lista = New-Object 'System.Collections.Generic.List[BandaCelda]'
    foreach ($c in $cs) { $lista.Add($c) }
    $w = 0; $h = 0; $e = 0
    $m = [BandaGuia]::Mosaico($lista, $esc, $script:OcrMaxDim, [ref]$w, [ref]$h, [ref]$e)
    return (Textos-Por-Celda $lista (& $ocr $m $w $h))
}
function Distancia([string]$a, [string]$b) {
    $n = $a.Length; $m = $b.Length
    if ($n -eq 0) { return $m }; if ($m -eq 0) { return $n }
    $prev = New-Object int[] ($m + 1); $cur = New-Object int[] ($m + 1)
    for ($j = 0; $j -le $m; $j++) { $prev[$j] = $j }
    for ($i = 1; $i -le $n; $i++) {
        $cur[0] = $i
        for ($j = 1; $j -le $m; $j++) {
            $cost = if ($a[$i - 1] -ceq $b[$j - 1]) { 0 } else { 1 }
            $cur[$j] = [Math]::Min([Math]::Min($prev[$j] + 1, $cur[$j - 1] + 1), $prev[$j - 1] + $cost)
        }
        $t = $prev; $prev = $cur; $cur = $t
    }
    return $prev[$m]
}
function Acuerdo([string]$a, [string]$b) {
    $na = ($a.ToUpper() -replace '\s', '').TrimEnd('.', ',', ';', ':')
    $nb = ($b.ToUpper() -replace '\s', '').TrimEnd('.', ',', ';', ':')
    if (-not $na -or -not $nb) { return $false }
    if ($na -ceq $nb) { return $true }
    if ($na -match '^[\d,\.]+$' -and $nb -match '^[\d,\.]+$') {
        $pa = Leer-Peso $na; $pb = Leer-Peso $nb
        return ($pa.Valor -ne $null -and $pa.Valor -eq $pb.Valor)
    }
    if ((Cuenta-Letras $na) -ge 8) { return ((Distancia $na $nb) -le [Math]::Max(1, [int]($na.Length / 12))) }
    return $false
}
function Filas-Para-Interpretar($todas) {
    $r = @()
    foreach ($cs in $todas) {
        $r += [pscustomobject]@{ Celdas = @($cs | ForEach-Object { [pscustomobject]@{ Col = $_.Col; Vacia = $_.Vacia; Texto = $_.Texto; Texto2 = $_.Texto2; Seguro = $_.Seguro; Glifos = $_.Glifos; Ancho = $_.U1 - $_.U0 } }) }
    }
    return ,$r
}
function Leer-Visibles($guia, $cache, [scriptblock]$ocr) {
    $nuevas = 0
    for ($i = 0; $i -lt $guia.Filas.Count; $i++) {
        $f = $guia.Filas[$i]
        $esUltimaMarcada = $guia.Final -and $i -eq $guia.Filas.Count - 1
        if ($cache.ContainsKey($i) -and [Math]::Abs($cache[$i].Top - $f.Top) -lt 1.5 -and [Math]::Abs($cache[$i].Bot - $f.Bot) -lt 1.5 -and $cache[$i].Fin -eq $esUltimaMarcada) { continue }
        if ((-not $f.Completa -and -not $esUltimaMarcada) -or -not $guia.FilaVisible($i)) { continue }
        $cs = $guia.Celdas($i)
        if ($cs.Count -eq 0) { continue }
        $esc = $guia.EscalaOcr()
        $a = Ocr-Celdas $cs $esc $ocr
        $b = Ocr-Celdas $cs ([Math]::Min(6, $esc + 1)) $ocr
        foreach ($c in $cs) {
            if ($c.Vacia) { continue }
            $ta = [string]$a[$c.Col]; $tb = [string]$b[$c.Col]
            $c.Texto = $ta; $c.Texto2 = $tb; $c.Seguro = $false
            if (Acuerdo $ta $tb) { $c.Seguro = $true; continue }
            $tc = [string](Ocr-Celdas @($c) ([Math]::Min(6, $esc + 2)) $ocr)[$c.Col]
            if (Acuerdo $tc $ta) { $c.Seguro = $true }
            elseif (Acuerdo $tc $tb) { $c.Texto = $tb; $c.Texto2 = $ta; $c.Seguro = $true }
            elseif (-not $ta -and $tc) { $c.Texto = $tc }
        }
        $cache[$i] = @{ Top = $f.Top; Bot = $f.Bot; Fin = $esUltimaMarcada; Celdas = $cs }
        $nuevas++
    }
    return $nuevas
}
function Releer-Dudosas($guia, $cache, $res, [scriptblock]$ocr) {
    $rol = $res.Roles; $n = 0
    foreach ($t in $res.Tipos) {
        $cs = $cache[$t.N - 1].Celdas
        $dudas = @()
        $usa = @('Peso')
        if ($t.Tipo -eq 'ITEM') { $usa += @('PkgQty', 'Clase', 'Nmfc', 'Desc') }
        if ($t.Tipo -eq 'TOTAL') { $usa += @('PkgQty', 'HuQty') }
        if ($t.Tipo -eq 'HU') { $usa += @('HuQty') }
        foreach ($nom in $usa) {
            $kv = $rol[$nom]
            if ($kv -lt 0) { continue }
            $k = if ($res.Filas) { [int]$res.Filas[$t.N - 1].Celdas[$kv].Col } else { $kv }
            if ($cs[$k].Vacia) { continue }
            $malo = -not $cs[$k].Seguro
            if ($nom -eq 'Peso' -and $t.Peso -eq $null) { $malo = $true }
            if ($nom -eq 'PkgQty' -and $t.QtyTexto -and -not ($t.Qty.Valor -is [int])) { $malo = $true }
            if ($nom -eq 'Clase' -and -not $t.Clase.Ok) { $malo = $true }
            if ($nom -eq 'Nmfc' -and -not $t.Nmfc.Ok) { $malo = $true }
            if ($malo -and $dudas -notcontains $k) { $dudas += $k }
        }
        foreach ($k in $dudas) {
            $c = $cs[$k]
            $esc = $guia.EscalaOcr()
            $tc = [string](Ocr-Celdas @($c) ([Math]::Min(6, $esc + 2)) $ocr)[$c.Col]
            $td = [string](Ocr-Celdas @($c) ([Math]::Min(7, $esc + 3)) $ocr)[$c.Col]
            if (Acuerdo $tc $td) {
                if ($tc -ne $c.Texto -or -not $c.Seguro) { $c.Texto2 = $c.Texto; $c.Texto = $tc; $c.Seguro = $true; $n++ }
            }
        }
    }
    return $n
}
function Leer-Encabezado($guia, [scriptblock]$ocr) {
    $r = @()
    $cs = $guia.CeldasEncabezado()
    if ($cs.Count -eq 0) { return ,$r }
    $t = Ocr-Celdas $cs ([Math]::Min(6, $guia.EscalaOcr())) $ocr
    foreach ($c in $cs) { $r += $(if ($c.Vacia) { '' } else { ([string]$t[$c.Col]).ToUpper() }) }
    return ,$r
}
function Armar-Resultado($guia, $cache, [int]$hasta, [scriptblock]$ocr, $encab = $null) {
    $faltan = @(); $todas = @()
    for ($i = 0; $i -le $hasta; $i++) { if ($cache.ContainsKey($i)) { $todas += ,$cache[$i].Celdas } else { $faltan += ($i + 1) } }
    if ($faltan.Count -gt 0) {
        $r = [ordered]@{ Lineas = @(); Candados = @(,@('NO', ('Rows not read (scroll them into view): ' + ($faltan -join ', ')))); Tipos = @(); Roles = @{}; Formato = ''; Hazmat = $false; Pintar = @(); Bien = $false }
        return @{ Filas = @(); Res = $r }
    }
    $filas = Filas-Para-Interpretar $todas
    $res = Interpretar $filas $guia.ColumnaPeso() $guia.AltoTexto $encab
    if (-not $res.Bien -and -not $res.Hazmat -and $ocr) {
        if ((Releer-Dudosas $guia $cache $res $ocr) -gt 0) {
            $filas = Filas-Para-Interpretar $todas
            $res = Interpretar $filas $guia.ColumnaPeso() $guia.AltoTexto $encab
        }
    }
    if ($res.Filas) { $filas = $res.Filas }
    return @{ Filas = $filas; Res = $res }
}
