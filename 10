    }
    $ctrlK = ([LocalKeyState]::GetAsyncKeyState(0x11) -band 0x8000) -ne 0
    $repag = ([LocalKeyState]::GetAsyncKeyState(0x21) -band 0x8000) -ne 0
    $repagEdge = $repag -and $script:RePagArmed
    $script:RePagArmed = -not $repag
