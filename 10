                [void]$top.Children.Add($mk)
            }
            [void]$inner.Children.Add($top)
            $lbl = New-Text $script:LM_Options[$i] 12.5 $(if ($sel) { $accent } else { $C.Text }) $(if ($hl -or $sel) { 'SemiBold' } else { 'Normal' })
