            elseif ($avisos) { Fill-AvisoFila "FILL ready${man} - CHECK THE ORANGE WARNINGS in the panel: click Pieces in the ERP, then Right Shift types this line" $script:BandaIdx 7000 }
            else { Fill-AvisoFila "FILL ready${man}: click Pieces in the ERP, then Right Shift types this line" $script:BandaIdx 6000 }
        } else {
            $script:FillFase = 'no'
            $script:BandaIdx = 0
            Banda-Mostrar
