$BandaCodigoGuia = @'
using System;
using System.Collections.Generic;
public class BandaFila {
    public double Top;
    public double Bot;
    public bool Completa;
}
public partial class BandaGuia {
    byte[] g; int W, H;
    public int T;
    public int TL;
    public int Fondo;
    public double S;
    public double Sv;
    public bool Final;
    public double Grados;
    public int Mx, My;
    public int UL, UR;
    public int XA, XB;
    public bool ModoLineas;
    public bool ColumnaConLineas;
    public int AltoTexto = 12;
    public double AltoFila = 24;
    public int RefIzq = -1, RefDer = -1;
    public double Off;
    public bool HayMas;
    public string Motivo = "";
    public List<BandaFila> Filas = new List<BandaFila>();
    const int K = 16;
    int firmaBase;
    List<int[]> firma = new List<int[]>();
    double U(double x, double y) { return x + Sv * (y - My); }
    public double VDe(double x, double y) { return V(x, y); }
    double V(double x, double y) { return y - S * (x - Mx); }
    void XY(double u, double v, out double x, out double y) {
        double d = 1 + S * Sv, a = u + Sv * My, b = v - S * Mx;
        x = (a - Sv * b) / d; y = (S * a + b) / d;
    }
    int Gris(double u, double v) {
        double x, y; XY(u, v - Off, out x, out y); y += Off;
        int xi = (int)Math.Round(x), yi = (int)Math.Round(y);
        if (xi < 0 || yi < 0 || xi >= W || yi >= H) return -1;
        return g[yi * W + xi];
    }
    bool Tinta(int x, int y) {
        if (x < 0 || y < 0 || x >= W || y >= H) return false;
        return g[y * W + x] < T;
    }
    public double[] Esquinas(int i) {
        BandaFila f = Filas[i];
        double[] r = new double[8]; double x, y;
        XY(XA, f.Top, out x, out y); r[0] = x; r[1] = y + Off;
        XY(XB, f.Top, out x, out y); r[2] = x; r[3] = y + Off;
        XY(XB, f.Bot, out x, out y); r[4] = x; r[5] = y + Off;
        XY(XA, f.Bot, out x, out y); r[6] = x; r[7] = y + Off;
        return r;
    }
    public bool Calibrar(byte[] gris, int w, int h, int mx, int my) {
        g = gris; W = w; H = h; Mx = mx; My = my; Off = 0; S = 0; Sv = 0; Grados = 0; Final = false;
        AjusteColumna = 0; InfoColumna = "";
        Filas.Clear(); firma.Clear(); Motivo = ""; HayMas = false;
        if (mx < 0 || my < 0 || mx >= w || my >= h) { Motivo = "mouse fuera de la pantalla"; return false; }
        Umbral();
        Angulo();
        Sv = S;
        if (!Columna()) return false;
        int[] tinta, tenue; bool[] valido; int va = My - 200;
        Perfil(va, H + 60, UL, UR, out tinta, out tenue, out valido);
        List<int[]> lineas = Lineas(tenue, valido, va, UR - UL + 1);
        int cerca = 0;
        foreach (int[] l in lineas) if (l[0] > My - 150 && l[0] < My + 600) cerca++;
        ModoLineas = cerca >= 3;
        bool hayMas;
        List<BandaFila> f = DetectarFilas(My, true, out hayMas);
        if (ModoLineas) {
            bool hm2; string mot = Motivo; ModoLineas = false; Motivo = "";
            List<BandaFila> ft = DetectarFilas(My, true, out hm2);
            if (ft.Count > f.Count) { f = ft; hayMas = hm2; } else { ModoLineas = true; Motivo = mot; }
        }
        if (f.Count == 0) { if (Motivo == "") Motivo = "no se encontro el peso"; return false; }
        Filas.AddRange(f);
        HayMas = hayMas;
        for (int vuelta = 0; vuelta < 3; vuelta++) {
            double antes = Sv;
            if (!AjustarColumna()) break;
            List<BandaFila> f2 = DetectarFilas(My, true, out hayMas);
            if (f2.Count < Filas.Count) { AjusteColumna -= Sv - antes; Sv = antes; break; }
            Filas.Clear(); Filas.AddRange(f2); HayMas = hayMas;
        }
        Ancho();
        Firma(true);
        return true;
    }
    public double AjusteColumna;
    public string InfoColumna = "";
    bool AjustarColumna() {
        List<double> vs = new List<double>(), iz = new List<double>(), de = new List<double>();
        int wd = UR - UL + 1;
        foreach (BandaFila f in Filas) {
            int va = (int)Math.Floor(f.Top + Off) - 2, vb = (int)Math.Ceiling(f.Bot + Off) + 2;
            int[] tinta, tenue; bool[] valido;
            Perfil(va, vb, UL, UR, out tinta, out tenue, out valido);
            List<int[]> ls = Lineas(tenue, valido, va, wd);
            List<int[]> ts = Textos(tinta, valido, va, wd, ls);
            if (ts.Count == 0) continue;
            int ua, ub; Extension(ts[0], out ua, out ub);
            if (ua > ub) continue;
            vs.Add((ts[0][0] + ts[0][1]) / 2.0); iz.Add(ua); de.Add(ub);
        }
        if (vs.Count < 3 || vs[vs.Count - 1] - vs[0] < AltoTexto * 6) { InfoColumna += " pocos(" + vs.Count + ")"; return false; }
        double ki, ri, kd, rd;
        RectaRobusta(vs, iz, out ki, out ri); RectaRobusta(vs, de, out kd, out rd);
        bool derecha = Dispersion(de) < Dispersion(iz) * 0.7 ? true : (Dispersion(iz) < Dispersion(de) * 0.7 ? false : rd < ri);
        double k = derecha ? kd : ki, res = derecha ? rd : ri;
        InfoColumna += string.Format(" n={0} k={1:0.0000} res={2:0.0} {3}", vs.Count, k, res, derecha ? "der" : "izq");
        if (res > Math.Max(2.0, AltoTexto * 0.25)) return false;
        if (Math.Abs(k) < 0.0008) return false;
        if (Math.Abs(k) * (vs[vs.Count - 1] - vs[0]) < 1.5) return false;
        double nuevo = Sv - k;
        if (Math.Abs(nuevo - S) > 0.06) return false;
        Sv = nuevo; AjusteColumna += -k;
        return true;
    }
    static double Dispersion(List<double> x) {
        List<double> c = new List<double>(x); c.Sort();
        int q = c.Count / 4;
        return c[c.Count - 1 - q] - c[q];
    }
    static void RectaRobusta(List<double> x0, List<double> y0, out double k, out double res) {
        List<double> x = new List<double>(x0), y = new List<double>(y0);
        Recta(x, y, out k, out res);
        int quitar = x.Count / 3;
        while (quitar-- > 0 && x.Count >= 4) {
            double mx = 0, my = 0; for (int i = 0; i < x.Count; i++) { mx += x[i]; my += y[i]; }
            mx /= x.Count; my /= x.Count;
            int peor = -1; double pd = 0;
            for (int i = 0; i < x.Count; i++) { double d = Math.Abs(y[i] - (my + k * (x[i] - mx))); if (d > pd) { pd = d; peor = i; } }
            if (pd <= 2.0) break;
            x.RemoveAt(peor); y.RemoveAt(peor);
            Recta(x, y, out k, out res);
        }
    }
    static void Recta(List<double> x, List<double> y, out double k, out double res) {
        int n = x.Count; double mx = 0, my = 0;
        for (int i = 0; i < n; i++) { mx += x[i]; my += y[i]; }
        mx /= n; my /= n;
        double sxy = 0, sxx = 0;
        for (int i = 0; i < n; i++) { sxy += (x[i] - mx) * (y[i] - my); sxx += (x[i] - mx) * (x[i] - mx); }
        k = sxx > 0 ? sxy / sxx : 0;
        double e = 0;
        for (int i = 0; i < n; i++) { double d = y[i] - (my + k * (x[i] - mx)); e += d * d; }
        res = Math.Sqrt(e / n);
    }
    public int FijarFinal(int mx, int my) {
        double vd = V(mx, my) - Off;
        int mejor = -1; double md = double.MaxValue;
        for (int i = 0; i < Filas.Count; i++) {
            BandaFila f = Filas[i];
            double d = vd < f.Top ? f.Top - vd : (vd > f.Bot ? vd - f.Bot : 0);
            if (d < md) { md = d; mejor = i; }
        }
        if (mejor < 0 || md > Math.Max(4, AltoFila * 0.3)) { Motivo = "no hay fila con peso bajo el mouse"; return -1; }
        if (mejor == 0) return 0;
        if (mejor + 1 < Filas.Count) Filas.RemoveRange(mejor + 1, Filas.Count - mejor - 1);
        Final = true; HayMas = false;
        return mejor;
    }
    void Umbral() {
        int[] hist = new int[256]; int n = 0;
        for (int y = Math.Max(0, My - 250); y < Math.Min(H, My + 450); y += 2)
            for (int x = Math.Max(0, Mx - 500); x < Math.Min(W, Mx + 500); x += 2) { hist[g[y * W + x]]++; n++; }
        int acum = 0, p90 = 255, p1 = 0, p40 = 255; bool hay1 = false, hay40 = false;
        for (int i = 0; i < 256; i++) {
            acum += hist[i];
            if (!hay1 && acum >= n * 0.01) { p1 = i; hay1 = true; }
            if (!hay40 && acum >= n * 0.40) { p40 = i; hay40 = true; }
            if (acum >= n * 0.90) { p90 = i; break; }
        }
        Fondo = p90;
        T = (int)(p1 + (p90 - p1) * 0.62);
        if (T > p90 - 28) T = p90 - 28;
        if (T < (int)(p90 * 0.45)) T = (int)(p90 * 0.45);
        if (T < 40) T = 40;
        int dispersion = p90 - p40;
        TL = p90 - Math.Max(22, Math.Max((int)((p90 - p1) * 0.2), (int)(dispersion * 1.3)));
        if (TL < T) TL = T;
    }
    void Angulo() {
        List<int> px = new List<int>(), py = new List<int>();
        for (int y = Math.Max(0, My - 90); y < Math.Min(H, My + 260); y += 2)
            for (int x = Math.Max(0, Mx - 450); x < Math.Min(W, Mx + 650); x += 2)
                if (y > 0 && g[y * W + x] < T && g[(y - 1) * W + x] >= T) { px.Add(x - Mx); py.Add(y); }
        if (px.Count < 80) { S = 0; Grados = 0; return; }
        double mejor = 0; double mejorA = 0;
        for (double a = -5.0; a <= 5.0001; a += 0.25) { double sc = Puntaje(px, py, a); if (sc > mejor) { mejor = sc; mejorA = a; } }
        double a0 = mejorA;
        for (double a = a0 - 0.25; a <= a0 + 0.2501; a += 0.025) { double sc = Puntaje(px, py, a); if (sc > mejor) { mejor = sc; mejorA = a; } }
        Grados = mejorA;
        S = Math.Tan(mejorA * Math.PI / 180.0);
    }
    double Puntaje(List<int> px, List<int> py, double grados) {
        double t = Math.Tan(grados * Math.PI / 180.0);
        int off = 800; int[] bins = new int[H + 1700];
        for (int i = 0; i < px.Count; i++) {
            int b = (int)Math.Round(py[i] - t * px[i]) + off;
            if (b >= 0 && b < bins.Length) bins[b]++;
        }
        int[] top = new int[6];
        for (int i = 0; i < bins.Length; i++) {
            int c = bins[i];
            if (c <= top[5]) continue;
            int k = 5; while (k > 0 && top[k - 1] < c) { top[k] = top[k - 1]; k--; }
            top[k] = c;
        }
        double s = 0; for (int i = 0; i < 6; i++) s += top[i];
        return s;
    }
    bool LineaVertical(int x, int y) {
        int si = 0, n = 0, solido = 0;
        for (int k = -28; k <= 28; k++) {
            int yy = y + k; int xx = (int)Math.Round(x - Sv * k);
            if (yy < 0 || yy >= H) continue;
            n++;
            if (Delgada(xx, yy)) si++;
            if (SolidoXY(xx, yy, 6, 0)) solido++;
        }
        return n >= 30 && si >= n * 0.6 && solido < n * 0.4;
    }
    bool Delgada(int x, int y) {
        if (y < 0 || y >= H) return false;
        int c = Tinta(x, y) ? x : (Tinta(x - 1, y) ? x - 1 : (Tinta(x + 1, y) ? x + 1 : -1));
        if (c < 0) return false;
        int l = c, r = c;
        while (l - 1 >= 0 && Tinta(l - 1, y) && c - l < 12) l--;
        while (r + 1 < W && Tinta(r + 1, y) && r - c < 12) r++;
        if (r - l + 1 > 10 || l - 3 < 0 || r + 3 >= W) return false;
        int nucleo = 255;
        for (int x2 = l; x2 <= r; x2++) { int p = g[y * W + x2]; if (p < nucleo) nucleo = p; }
        int a = g[y * W + l - 3], b = g[y * W + r + 3];
        return a >= T && b >= T && a - nucleo >= 40 && b - nucleo >= 40;
    }
    bool Oscuro(int x, int y) {
        if (x < 0 || y < 0 || x >= W || y >= H) return false;
        return g[y * W + x] < TL;
    }
    bool SolidoXY(int x, int y, int dx, int dy) {
        if (x - dx < 0 || y - dy < 0 || x + dx >= W || y + dy >= H || x < 0 || y < 0 || x >= W || y >= H) return false;
        int p = g[y * W + x], a = g[(y - dy) * W + x - dx], b = g[(y + dy) * W + x + dx];
        return p < TL && a < TL && b < TL && Math.Abs(a - p) < 30 && Math.Abs(b - p) < 30;
    }
    bool SolidoU(double u, double v, double du, double dv) {
        int p = Gris(u, v), a = Gris(u - du, v - dv), b = Gris(u + du, v + dv);
        if (p < 0 || a < 0 || b < 0) return false;
        return p < TL && a < TL && b < TL && Math.Abs(a - p) < 30 && Math.Abs(b - p) < 30;
    }
    bool OscuroU(double u, double v) { int p = Gris(u, v); return p >= 0 && p < TL; }
    bool TintaU(double u, double v) { int p = Gris(u, v); return p >= 0 && p < T; }
