    $pro = $script:UltimoPRO
    if ($Global:IntraTeclear -and $pro) {
        $esc = -join ($pro.ToCharArray() | ForEach-Object {
            if ('+^%~(){}[]'.Contains([string]$_)) { '{' + $_ + '}' } else { [string]$_ } })
        Paso "Tecleando el PRO en el buscador ($($pro.Length) caracteres)"
        [System.Windows.Forms.SendKeys]::SendWait($esc)
    } else {
        Teclas '^v'
    }
}
function Buscar-PRO-Intra {
    $F = $Global:ForceT
    $swParte = [System.Diagnostics.Stopwatch]::StartNew()
    Traer-Edge
    EsperarT 'D1_FocoEdge'
    $escrito = $false
    for ($vez = 1; $vez -le 2 -and -not $escrito; $vez++) {
        if ($vez -gt 1) {
            Paso 'El PRO no se ve en el buscador de la intra: click y escribir otra vez'
            Esperar 300
            Asegurar-Edge
        }
        ClickXY 'Edge_Busqueda1'
        EsperarT 'D2_DespuesClickBusca'
        Teclas '^a'
        Esperar 40
        $antesPRO = Foto-Buscador 'Edge_Busqueda1'
        Escribir-PRO
        EsperarT 'D3_DespuesPegarPRO'
        $escrito = Test-PROescrito $antesPRO 'buscador de la intra'
    }
    P 'D_intentos' $(if (-not $escrito) { 'no!' } elseif ($vez -gt 2) { '2!' } else { '1' })
    Enter-Busqueda 'intra normal' 'Edge_Busqueda1'
}
