    function Fill-SobreVentana($w, $m) {
        try {
            if (-not $w -or -not $w.IsVisible) { return $false }
            $e = $script:BandaEsc; if ($e -le 0) { $e = 1 }
            $x0 = $w.Left / $e; $y0 = $w.Top / $e; $x1 = ($w.Left + $w.ActualWidth) / $e; $y1 = ($w.Top + $w.ActualHeight) / $e
            return ($m[0] -ge $x0 -and $m[0] -le $x1 -and $m[1] -ge $y0 -and $m[1] -le $y1)
        } catch { return $false }
    }
    function Fill-ManualPintar {
        $pin = New-Object System.Collections.ArrayList
        $cols = @()
        foreach ($q in $script:FillPasos) { $k = [int]$script:FillManual[$q.Rol]; if ($k -ge 0) { $cols += ,@($k, $q.Color) } }
        foreach ($i in $script:FillCache.Keys) {
            $cs = $script:FillCache[$i].Celdas
            foreach ($kc in $cols) { $k = [int]$kc[0]; if ($k -ge 0 -and $k -lt $cs.Count -and -not $cs[$k].Vacia) { [void]$pin.Add(@{ Fila = [int]$i; Col = $k; Color = $kc[1] }) } }
        }
        $script:FillRes.Pintar = @($pin)
        Fill-Pintar
    }
    function Fill-ManualClick([int[]]$m) {
        if ((Fill-SobreVentana $FillPanel $m) -or (Fill-SobreVentana $WatermarkWin $m)) { return }
        $g = $script:BandaGuia
        $paso = $script:FillPasos[$script:FillPaso]
        [void](Banda-SeguirAhora)
        $k = $g.ColumnaEn($m[0], $m[1])
        if ($k -lt 0) { Banda-Aviso ('Click a cell of the table ({0})' -f $paso.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        $kp = if ([int]$script:FillManual.Peso -ge 0) { [int]$script:FillManual.Peso } else { $g.ColumnaPeso() }
        if ($paso.Rol -ne 'Peso' -and $k -eq $kp) { Banda-Aviso ('That is the WEIGHT column - click the {0} column' -f $paso.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        foreach ($q in $script:FillPasos) {
            if ($q.Rol -eq $paso.Rol -or [int]$script:FillManual[$q.Rol] -ne $k) { continue }
            $par = (@($q.Rol, $paso.Rol) | Sort-Object) -join ','
            if ($par -ne 'Desc,Pcs' -and $par -ne 'Clase,Nmfc') { Banda-Aviso ('That column is already {0}' -f $q.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        }
        $script:FillManual[$paso.Rol] = $k
        Fill-ManualSiguiente
    }
