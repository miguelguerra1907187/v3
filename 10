    $tipo = if ($dosIntras) { 'F2 (2 intras)' } else { 'F1 (intra normal)' }
    $propio = ($null -eq $Global:LogBuffer -and $Global:LogArchivo -eq 1)
    if ($propio) { $Global:LogBuffer = New-Object System.Collections.ArrayList }
    $script:MotorCorriendo = $true
    try {
        Hide-Watermark
        Show-NoMover
        Paso "=== INICIO PRO lookup sin notas: $tipo ==="
        $script:UltimoPRO = Copiar-PRO -MediaBill
        Buscar-PRO-Intra
