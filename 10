            $cell.Background  = B $C.Panel
            $cell.BorderBrush = B $C.KeyBorder
            $cell.Opacity = 0.25
            [void]$top.Children.Add((New-Keycap ([string]($i + 1)) '' 12))
            [void]$inner.Children.Add($top)
