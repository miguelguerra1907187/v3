    else { & $agregar 'NO' 'NMFC' ('not valid: ' + (($malN | ForEach-Object { ("row $($_.N) '$($_.Nmfc.Valor)' $($_.Nmfc.Duda)").Trim() }) -join ', ')) }
    if ($itemsHz.Count -gt 0) {
        $que = (($itemsHz | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ')
        & $agregar 'HZ' 'HAZMAT' ("$que  -> TYPE THEM YOURSELF FIRST (line 1 = $(if ($piezas) { $piezas } else { '?' }) pallets SKD STC); FILL types the rest with *")
    }
    if ($hzOtras.Count -gt 0) { & $agregar 'NO' 'HAZMAT' ('mark in a row that is not an item: ' + (($hzOtras | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ') + ' - check by hand') }
    if ($itemsHz.Count -eq 0 -and $hzOtras.Count -eq 0) { & $agregar 'OK' 'HAZMAT' 'none (no X in H.M., no UN/NA number)' }
    $malG = @()
    foreach ($q in $r.Tipos) {
        $tp = ($q.PesoTexto -replace '\s', ''); if ($tp -and $q.PesoGlifos -and $tp.Length -lt $q.PesoGlifos - 1) { $malG += "row $($q.N) weight '$tp' ($($q.PesoGlifos) marks)" }
        $tq = ($q.QtyTexto -replace '\s', ''); if ($tq -and $q.QtyGlifos -and $tq.Length -lt $q.QtyGlifos - 1) { $malG += "row $($q.N) qty '$tq' ($($q.QtyGlifos) marks)" }
    }
    if ($malG.Count -gt 0) { & $agregar 'i' 'INK MARKS' ('differ, check: ' + ($malG -join '; ')) }
    $fix = @($r.Tipos | Where-Object { $_.Qty.Cambio -and $_.QtyTexto } | ForEach-Object { "row $($_.N) qty '$($_.QtyTexto)'" })
    if ($fix.Count -gt 0) { & $agregar 'i' 'DIGITS' ('letters read as digits: ' + ($fix -join '; ')) }
    $dudas = @()
    $nombre = @{ Peso = 'weight'; Qty = 'qty'; Desc = 'description'; Nmfc = 'NMFC'; Clase = 'class'; HuQty = 'pallets' }
    $revisar = { param($q, [string[]]$campos)
        foreach ($cmp in $campos) {
            $k = $rol[$(if ($cmp -eq 'Qty') { 'PkgQty' } else { $cmp })]
            if ($k -lt 0 -or $q.Celdas[$k].Vacia) { continue }
            if (-not $q.('Seg' + $cmp)) { $script:dudasTmp += "row $($q.N) $($nombre[$cmp]) '$($q.Celdas[$k].Texto)' / '$($q.Celdas[$k].Texto2)'" }
        }
    }
    $script:dudasTmp = @()
    foreach ($it in $itemsFill) { & $revisar $it @('Peso', 'Qty', 'Nmfc') }
    foreach ($it in $itemsHz) { & $revisar $it @('Peso', 'Qty') }
    foreach ($q in $pallet) { & $revisar $q @('Peso', 'HuQty') }
    if ($total) { & $revisar $total @('Peso', 'Qty', 'HuQty') }
    $dudas = $script:dudasTmp
    if ($dudas.Count -eq 0) { & $agregar 'OK' 'READ TWICE' 'every value matched' }
    else { & $agregar 'NO' 'NOT SURE' ('two reads differ: ' + ($dudas -join '; ')) }
    $pin = New-Object System.Collections.ArrayList
    $poner = { param($q, [string]$cmp, [string]$color, [bool]$ok)
        $k = $rol[$(if ($cmp -eq 'Qty') { 'PkgQty' } else { $cmp })]
        if ($k -ge 0 -and $ok -and $q.('Seg' + $cmp) -and -not $q.Celdas[$k].Vacia) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = $q.Celdas[$k].Col; Color = $color }) }
    }
    foreach ($it in $items) {
        & $poner $it 'Qty' 'qty' ($it.Qty.Valor -is [int])
        & $poner $it 'Peso' 'peso' ($it.Peso -ne $null)
        if ($it.Hazmat) { continue }
        & $poner $it 'Desc' 'desc' ((Cuenta-Letras $it.Desc) -ge 3)
        & $poner $it 'Nmfc' 'nmfc' ($it.Nmfc.Ok)
        & $poner $it 'Clase' 'clase' ($it.Clase.Ok)
    }
    foreach ($q in $pallet) { & $poner $q 'Peso' 'pallet' ($q.Peso -ne $null); & $poner $q 'HuQty' 'pallet' ($q.HuQty.Valor -is [int]) }
    if ($palTexto -and $palTexto.Seguro) { [void]$pin.Add(@{ Fila = $total.N - 1; Col = $palTexto.Col; Color = 'pallet' }) }
    if ($total) {
        & $poner $total 'HuQty' 'pallet' ($total.HuQty.Valor -is [int])
        & $poner $total 'Qty' 'qty' ($total.Qty.Valor -is [int])
        & $poner $total 'Peso' 'peso' ($total.Peso -ne $null)
    }
    foreach ($q in @($r.Tipos | Where-Object { $_.Hazmat })) {
        [void]$pin.Add(@{ Fila = $q.N - 1; Col = -1; Color = 'hazmat' })
        if ($q.HazmatCol -ge 0) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = $q.HazmatCol; Color = 'hazmat' }) }
    }
    $r.Pintar = @($pin)
    $r.Candados = $c
    $r.Bien = -not ($c | Where-Object { $_[0] -ne 'OK' -and $_[0] -ne 'i' -and $_[0] -ne 'HZ' -and $_[0] -ne 'TY' })
    return $r
}
function Texto-Reporte($filas, $res, [string]$encabezado) {
