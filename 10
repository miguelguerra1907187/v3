        ultimo = UR;
        for (int u = UR + 6; u <= pDer && u - ultimo < 1200; u++) if (VerticalEn(u, vmi)) { vd = u; ultimo = u; u += 4; }
        int limIzq = vi >= 0 ? Math.Max(pIzq, vi - 15) : pIzq, limDer = vd >= 0 ? Math.Min(pDer, vd + 15) : pDer;
