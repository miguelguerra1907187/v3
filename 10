    }
    function Fill-TeclearLinea($l, [int]$desde = 0, [bool]$yaTab = $false) {
        $campos = @($l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $l.Desc, $l.Weight, $l.Clase, $l.Nmfc)
        $mano = @($l.Mano)
        $claseAlta = $false; $cv = 0
        if ([double]::TryParse([string]$l.Clase, [System.Globalization.NumberStyles]::Float, [System.Globalization.CultureInfo]::InvariantCulture, [ref]$cv) -and $cv -gt 300) { $claseAlta = $true }
        if ($desde -gt 0 -and -not $yaTab) {
            [System.Windows.Forms.SendKeys]::SendWait('{TAB}')
            Start-Sleep -Milliseconds $FillPausaTabMs
        }
        for ($i = $desde; $i -lt $campos.Count; $i++) {
            if ($mano -contains $i) { return $i }
            $v = ([string]$campos[$i]).Trim()
            if ($v) { [System.Windows.Forms.SendKeys]::SendWait((Fill-Escapar $v.ToLower())) }
            Start-Sleep -Milliseconds $FillPausaCampoMs
            if ($i -eq 7 -and $claseAlta -and $FillClaseAltaEnter) {
                Start-Sleep -Milliseconds $FillClaseAltaPausaMs
                [System.Windows.Forms.SendKeys]::SendWait('{ENTER}')
                Start-Sleep -Milliseconds $FillClaseAltaPausaMs
                try { [void][LocalKeyState]::GetAsyncKeyState(0x0D) } catch { }
            }
            if ($i -lt $campos.Count - 1) {
                [System.Windows.Forms.SendKeys]::SendWait('{TAB}')
                Start-Sleep -Milliseconds $FillPausaTabMs
            }
        }
        return -1
    }
    function Fill-Teclear {
        $l = $script:FillRes.Lineas[$script:FillK]
        if ($FillSoloEnERP -and [Motor]::ProcesoAlFrente() -ne 'mstsc') {
            $m = [BandaWin]::Mouse()
            Banda-Aviso 'FILL: click the Pieces field in the ERP first' $m[0] $m[1] 2500 -Rojo
            return
        }
        $BandaAvisoB.Visibility = 'Hidden'
        $para = Fill-TeclearLinea $l $script:FillCampo ($script:FillTabsTuyos -gt 0)
        $script:FillTabsTuyos = 0
        $que = if ($l.N -eq 'P') { 'Pallet line' } else { "Line $($l.N)" }
        if ($para -ge 0) {
            $script:FillCampo = $para + 1
            $script:BandaTecleo = $false
            $campo = if ($para -eq 5) { 'DESCRIPTION' } else { 'CLASS (Charge Type)' }
            $leido = if ($para -eq 5) { $l.DescLeida } else { $l.ClaseLeida }
            Banda-Mostrar
            Fill-PanelActualizar
            Fill-AvisoFila "$que - TYPE THE $campo yourself (read: '$leido'), then Right Shift types the rest" $script:BandaIdx 15000 -Rojo
            return
        }
        $script:FillCampo = 0
        $script:BandaTecleo = $true
        if ($l.N -eq '1' -and $l.Pkg -and -not $l.Pieces) { Fill-AvisoFila "$que typed: TYPE THE PALLETS in Pieces yourself, check it and press Enter" $script:BandaIdx 5000 -Rojo }
        else { Fill-AvisoFila "$que typed: check it and press Enter" $script:BandaIdx 2500 }
    }
