function Tabla-Ultimas($cols, $L) {
    $W = 8
    $enc = '{0,-16}{1,6}' -f 'paso', 'tabla'
    foreach ($c in $cols) { $enc += ('{0,' + $W + '}') -f $c['hora'] }
    $enc += '{0,9}' -f 'necesita'
    [void]$L.Add($enc)
    $enc = '{0,-16}{1,6}' -f 'fecha', ''
    foreach ($c in $cols) { $enc += ('{0,' + $W + '}') -f $c['fecha'] }
    [void]$L.Add($enc)
    [void]$L.Add(('-' * (22 + $W * $cols.Count + 9)))
    $oks = @($cols | Where-Object { $_['resultado'] -eq 'OK' })
    $ocultos = 0
    foreach ($par in $Global:OrdenPasos) {
        $k = $par[0]
        if ($k -in @('motor_s', 'resultado', 'fallo')) { continue }
        $hay = $false
        foreach ($c in $cols) { if ($c.Contains($k)) { $hay = $true } }
        if (-not $hay) { continue }
        $tab = if ($Global:ForceT.Contains($k)) { [string]$Global:ForceT[$k] } else { '' }
        $vals = @($cols | Where-Object { $_.Contains($k) } | ForEach-Object { [string]$_[$k] })
        if ($tab -and -not ($vals | Where-Object { $_ -ne $tab -and $_ -ne '0' })) { $ocultos++; continue }
        $fila = '{0,-16}{1,6}' -f $par[1], $tab
        foreach ($c in $cols) {
            $v = if ($c.Contains($k)) { [string]$c[$k] } else { '-' }
            if ($v.Length -gt ($W - 1)) { $v = $v.Substring(0, $W - 1) }
            $fila += ('{0,' + $W + '}') -f $v
        }
        $listos = @($oks | Where-Object { $_.Contains($k) -and ([string]$_[$k]) -match '\*' } | ForEach-Object { Num-De $_[$k] })
        $fila += if ($listos.Count) { '{0,9}' -f (($listos | Measure-Object -Maximum).Maximum) } else { '{0,9}' -f '' }
        [void]$L.Add($fila)
    }
    if ($ocultos) { [void]$L.Add(('({0} pasos fijos no se muestran: salieron igual a la tabla)' -f $ocultos)) }
    [void]$L.Add(('-' * (22 + $W * $cols.Count + 9)))
    foreach ($sec in $Global:SeccionesPasos.Keys) {
        $hay = $false
        $fila = '{0,-22}' -f ('= ' + $sec)
        foreach ($c in $cols) {
            $sum = 0; $alguno = $false
            foreach ($k in $Global:SeccionesPasos[$sec]) {
                if ($c.Contains($k)) { $n = Num-De ([string]$c[$k]); if ($null -ne $n) { $sum += $n; $alguno = $true } }
            }
            if ($alguno) { $hay = $true; $fila += ('{0,' + $W + '}') -f ([Math]::Round($sum)) } else { $fila += ('{0,' + $W + '}') -f '-' }
        }
        if ($hay) { [void]$L.Add($fila) }
    }
    $fila = '{0,-22}' -f '= otros (clicks/teclas)'
    foreach ($c in $cols) {
        $mot = Num-De ([string]$c['motor_s'])
        if ($null -eq $mot) { $fila += ('{0,' + $W + '}') -f '-'; continue }
        $sum = 0
        foreach ($sec in $Global:SeccionesPasos.Keys) { foreach ($k in $Global:SeccionesPasos[$sec]) { if ($c.Contains($k)) { $n = Num-De ([string]$c[$k]); if ($null -ne $n) { $sum += $n } } } }
        $fila += ('{0,' + $W + '}') -f ([Math]::Max(0, [Math]::Round($mot * 1000 - $sum)))
    }
    [void]$L.Add($fila)
    [void]$L.Add(('-' * (22 + $W * $cols.Count + 9)))
    foreach ($par in @(@('motor_s', 'MOTOR (s)'), @('resultado', 'RESULTADO'), @('fallo', 'FALLO EN'))) {
        $fila = '{0,-22}' -f $par[1]
        foreach ($c in $cols) {
            $v = if ($c.Contains($par[0])) { [string]$c[$par[0]] } else { '-' }
            if ($v.Length -gt ($W - 1)) { $v = $v.Substring(0, $W - 1) }
            $fila += ('{0,' + $W + '}') -f $v
        }
        [void]$L.Add($fila)
    }
}
