        $h = New-Text "On clipboard: $activo  (Insert switches)" 12 $accent 'SemiBold'
        $h.Margin = '0,4,0,0'
        [void]$body.Children.Add($h)
    } elseif ($script:PendingHold) {
        $h = New-Text 'On clipboard: ERP  (Insert = enter terminal and copy hold)' 12 $accent 'SemiBold'
        $h.Margin = '0,4,0,0'
        [void]$body.Children.Add($h)
    }
    if ($script:DoneMsg) {
        $m = New-Text $script:DoneMsg 12 $accent 'SemiBold'
        $m.Margin = '0,4,0,0'
        [void]$body.Children.Add($m)
    }

    $preview =
        if ($script:NotePair.Count -eq 2) {
            if ($script:NoteIdx -eq 0) { @("$([char]0x25B8) Intra / Hold", $script:DoneIntra, 'ERP', $script:DoneErp) }
            else                       { @('Intra / Hold', $script:DoneIntra, "$([char]0x25B8) ERP", $script:DoneErp) }
        } elseif ($script:DoneErp) { @('Intra and ERP note', $script:DoneIntra) }
        else                       { @('Intra (complete the reason)', $script:DoneIntra) }

    $doneKeys = New-Object System.Collections.Generic.List[string]
    $doneKeys.Add('1'); $doneKeys.Add($(if ($script:PendingHold) { 'copy erp' } else { 'copy intra/hold' }))
    if ($script:NotePair.Count -eq 2) {
        $doneKeys.Add('2'); $doneKeys.Add('copy erp')
        $doneKeys.Add('Insert'); $doneKeys.Add('switch')
    } elseif ($script:PendingHold) {
        $doneKeys.Add('Insert'); $doneKeys.Add('terminal / hold')
    }
    $doneKeys.Add('Del'); $doneKeys.Add('close')

    Show-Frame -crumb ((Get-ForceLabel) + $SEP + 'done') -body $body -preview $preview -keys $doneKeys.ToArray() -accent $accent
}

function Finish-Notes([string]$intra, [string]$erp, [bool]$addToHistory = $true, [string]$terminal = '', [bool]$pendingHold = $false, [bool]$quickClose = $false) {
    # Guarda las notas para los botones del motor (ERP / INTRA)
    try { Set-NotasBotones $intra $erp $pendingHold $terminal } catch { }
    $script:LastCopied  = $intra
    $script:PendingHold = $pendingHold
    if ($erp -and $intra -ne $erp) {
        $script:NotePair = @($intra, $erp)
        $script:NoteIdx  = 0
    } else {
        $script:NotePair = @()
    }
    $copiado = Set-Clip $intra
    if ($addToHistory) { Add-History $intra $erp $script:CurrentForce $terminal }

    $msg = ''
    if (-not $copiado) { $msg = 'Could not copy (clipboard busy) -- press 1 to retry' }

    $script:DoneIntra = $intra
    $script:DoneErp   = $erp
    $script:DoneMsg   = $msg
    $script:State     = 'done'

    # Se cierra solo al copiar (con o sin hold) para no estorbar la
    # pantalla. Si es un paso de hold (ERP o intra/hold), se prende la
    # marca de agua chica arriba al centro para saber cual nota quedo en
    # el portapapeles. Si el portapapeles fallo (hay mensaje),
    # se deja la pantalla "listo" para que el usuario vea el aviso.
    if ($quickClose -and $copiado -and -not $msg) {
        if (($pendingHold -or $terminal) -and -not $FlujoAutomatico) {
            $script:WatermarkAccent = Get-Accent
            Show-Watermark $(if ($pendingHold) { 'ERP' } else { 'INTRA' })
        }
        if ($pendingHold) {
            # Basket y CurrentForce se van a limpiar en Close-Menu -- se
            # guarda aparte lo que Enter-Terminal va a necesitar cuando el
            # usuario le de Insert mas tarde (con el overlay ya cerrado).
            $script:PendingErpNote = $erp
            $script:PendingForce   = $script:CurrentForce
        } else {
            $script:PendingErpNote = ''
            $script:PendingForce   = $null
        }
        Close-Menu
        if ($pendingHold) { $script:PendingHold = $true }
        return
    }

    Draw-Done

    if ($pendingHold) { return }

    $t = New-Object System.Windows.Threading.DispatcherTimer
    $t.Interval = [TimeSpan]::FromMilliseconds(30000)
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if ($script:State -eq 'done') { Close-Menu }
    })
    $t.Start()
}

function Copy-FromHistory([int]$idx) {
