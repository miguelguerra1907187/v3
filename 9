    function Fill-PanelOcultar { try { if ($FillPanel.IsVisible) { $FillPanel.Hide() } } catch { } }

    # ---- pintar cada dato leido (codigo de colores); sin pintar = no seguro ----
    $script:FillColores = [ordered]@{
        qty    = @('#FF9800', 'QTY')
        peso   = @('#2196F3', 'WEIGHT')
        desc   = @('#00BCD4', 'DESCRIPTION')
        nmfc   = @('#AB47BC', 'NMFC')
        clase  = @('#43A047', 'CLASS')
        pallet = @('#EC407A', 'PALLETS')
        hazmat = @('#F44336', 'HAZMAT')
    }
    $script:FillFmtLinea = '{0}{1,-3}{2,-7}{3,-9}{4,-10}{5,-9}{6,-11}{7,-39}{8,-8}{9,-12}{10}'
    $script:FillCajas = New-Object System.Collections.ArrayList
    function Fill-Despintar {
        foreach ($p in $script:FillCajas) { [void]$BandaCanvas.Children.Remove($p) }
        $script:FillCajas.Clear()
    }
    function Fill-Pintar {
        Fill-Despintar
        $res = $script:FillRes; $g = $script:BandaGuia
        if (-not $res -or -not $res.Pintar -or -not $g) { return }
        foreach ($q in $res.Pintar) {
            if ($q.Col -lt 0) {
                # toda la fila (hazmat: esa linea la haces tu)
                if ($q.Fila -lt 0 -or $q.Fila -ge $g.Filas.Count) { continue }
                $e = $g.Esquinas($q.Fila)
            } else {
                if (-not $script:FillCache.ContainsKey($q.Fila)) { continue }
                $c = $script:FillCache[$q.Fila].Celdas[$q.Col]
                if ($c.Vacia) { continue }
                $e = $g.CajaPantalla($c.TU0 - 3, $c.TU1 + 3, $c.TV0 - 3, $c.TV1 + 3)
            }
            $col = $script:FillColores[$q.Color][0]
            $pg = New-Object System.Windows.Shapes.Polygon
            $pts = New-Object System.Windows.Media.PointCollection
            for ($i = 0; $i -lt 8; $i += 2) { $pts.Add((New-Object System.Windows.Point (Banda-Dip $e[$i]), (Banda-Dip $e[$i + 1]))) }
            $pg.Points = $pts
            # (semi transparente: en las fotos para seguir el scroll no cuenta como tinta)
            $pg.Fill = B ('#40' + $col.Substring(1))
            $pg.Stroke = B ('#99' + $col.Substring(1))
            $pg.StrokeThickness = $(if ($q.Color -eq 'hazmat') { 2.5 } else { 1.5 })
            if ($q.Col -lt 0) { $pg.Fill = B ('#26' + $col.Substring(1)); $pg.Stroke = B ('#FF' + $col.Substring(1)) }
            $pg.IsHitTestVisible = $false
            [void]$BandaCanvas.Children.Add($pg)
            [void]$script:FillCajas.Add($pg)
        }
    }

    function Fill-Renglon([string]$t, [string]$col, [switch]$Negrita) {
        $r = New-Object System.Windows.Documents.Run $t
        $r.Foreground = B $col
        if ($Negrita) { $r.FontWeight = 'Bold' }
        [void]$script:FillCuerpo.Inlines.Add($r)
        [void]$script:FillCuerpo.Inlines.Add((New-Object System.Windows.Documents.LineBreak))
    }

    # renglon largo: se parte en varios (los de abajo con sangria, debajo del texto)
    function Fill-RenglonLargo([string]$t, [string]$col, [int]$ancho = 118, [int]$sangria = 16) {
        $primero = $true
        while ($t.Length -gt $ancho) {
            $corte = $t.LastIndexOf(' ', $ancho)
            if ($corte -le $sangria) { $corte = $ancho }
            Fill-Renglon $t.Substring(0, $corte) $col
            $t = (' ' * $sangria) + $t.Substring($corte).TrimStart()
            $primero = $false
        }
        Fill-Renglon $t $col
    }

    function Fill-PanelActualizar {
        $res = $script:FillRes
        if (-not $res) { return }
        if ($script:FillFase -eq 'columnas') { Fill-ManualPanel; return }
        $listo = $script:FillFase -eq 'listo'
        $avisos = [bool]($res.Candados | Where-Object { $_[0] -eq '??' -or $_[0] -eq 'TY' })
        $hz = @($res.LineasHazmat | Where-Object { $_ }).Count -gt 0
        $script:FillBtnManual.Visibility = $(if ($script:FillFase -eq 'no' -and $res.Tipos -and @($res.Tipos).Count -gt 0) { 'Visible' } else { 'Collapsed' })
        $man = if ($res.Manual) { ' (MANUAL)' } else { '' }
        $hzT = if ($hz) { ' - TYPE THE HAZMAT LINES (red) YOURSELF FIRST' } else { '' }
        $script:FillTitulo.Text = if ($listo -and $avisos) { "FILL READY$man$hzT - CHECK THE ORANGE WARNINGS - click Pieces in the ERP, Right Shift types the line marked >" }
                                  elseif ($listo) { "FILL READY$man$hzT - click Pieces in the ERP, Right Shift types the line marked >" }
                                  elseif ($res.Bien) { 'FILL' }
                                  elseif ($script:FillFase -eq 'no') { "FILL NOT READY$man - nothing will be typed (band only). PICK COLUMNS = point them out yourself" }
                                  else { "FILL NOT READY$man - nothing will be typed (band only)" }
        $script:FillTitulo.Foreground = B $(if ($listo -and $avisos) { '#FFD29922' } elseif ($listo -or $res.Bien) { '#FF3FB950' } else { '#FFF85149' })
        $script:FillCuerpo.Inlines.Clear()
        # (mismo orden que Edit Details del ERP: asi se teclea)
        $fmt = $script:FillFmtLinea
        Fill-Renglon ($fmt -f ' ', '#', 'Pieces', 'Pkg Type', 'Qualifier', 'Q Pieces', 'Q Pkg Type', 'Description', 'Weight', 'Charge Type', 'NMFC') '#FF8B949E'
        # hazmat: las haces tu PRIMERO (rojo; FILL no las teclea)
        foreach ($l in @($res.LineasHazmat | Where-Object { $_ })) {
            $d = [string]$l.Desc; if ($d.Length -gt 38) { $d = $d.Substring(0, 37) + '~' }
            Fill-Renglon ($fmt -f ' ', 'HZ', $l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $d, $l.Weight, $l.Clase, $l.Nmfc) '#FFF85149'
        }
        if ($hz) { Fill-Renglon '   (HZ = hazmat rows: you type them first; FILL types the lines below)' '#FFF85149' }
        for ($k = 0; $k -lt $res.Lineas.Count; $k++) {
            $l = $res.Lineas[$k]
            $d = [string]$l.Desc; if ($d.Length -gt 38) { $d = $d.Substring(0, 37) + '~' }
            $marca = if ($listo -and $k -eq $script:FillK) { '>' } else { ' ' }
            $col = if ($listo -and $k -lt $script:FillK) { '#FF8B949E' } elseif ($listo -and $k -eq $script:FillK) { '#FFFFD600' } else { '#FFE6EDF3' }
            $pz = if ($l.N -eq '1' -and $l.Pkg -and -not $l.Pieces) { '__' } else { $l.Pieces }      # (__ = los pallets los pones tu)
            if (@($l.Mano) -contains 5) { $d = Campo-Ver $l 5 ''; if ($d.Length -gt 38) { $d = $d.Substring(0, 37) + '~' } }
            if ($col -eq '#FFE6EDF3' -and @($l.Mano).Count -gt 0) { $col = '#FFD29922' }      # (naranja: trae un campo que escribes tu)
            Fill-Renglon ($fmt -f $marca, $l.N, $pz, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $d, $l.Weight, (Campo-Ver $l 7 $l.Clase), $l.Nmfc) $col -Negrita:($marca -eq '>')
        }
        Fill-Renglon '' '#FFE6EDF3'
        foreach ($c in $res.Candados) {
            $col = switch ($c[0]) { 'OK' { '#FF3FB950' } 'NO' { '#FFF85149' } '??' { '#FFD29922' } 'TY' { '#FFD29922' } 'HZ' { '#FFFF7B72' } default { '#FF8B949E' } }
            Fill-RenglonLargo ('{0,-3} {1}' -f $c[0], $c[1]) $col
        }
        # leyenda: cuadrito de color + nombre
        $cuadro = [string][char]0x25A0
        foreach ($k in $script:FillColores.Keys) {
            $r = New-Object System.Windows.Documents.Run ($cuadro + ' ' + $script:FillColores[$k][1] + '   ')
            $r.Foreground = B ('#FF' + $script:FillColores[$k][0].Substring(1))
            [void]$script:FillCuerpo.Inlines.Add($r)
        }
        [void]$script:FillCuerpo.Inlines.Add((New-Object System.Windows.Documents.LineBreak))
        Fill-Renglon 'Not painted on the bill = not sure (read twice and did not match, or not valid)' '#FF8B949E'
        Fill-Renglon ("FORMAT: $($res.Formato) | OCR $($script:OcrIdioma) | $($script:FillInfo)") '#FF6E7681'
    }

    function Fill-PanelMostrar {
        $script:FillBtnCopiar.Child.Text = 'COPY REPORT'
        Fill-PanelActualizar
        if (-not $FillPanel.IsVisible) { $FillPanel.Show() }
        if (-not $script:FillPanelPuesto) {
            $FillPanel.UpdateLayout()
            $wa = [System.Windows.SystemParameters]::WorkArea
            $FillPanel.Left = $wa.Right - $FillPanel.ActualWidth - 10
            $FillPanel.Top  = $wa.Bottom - $FillPanel.ActualHeight - 10
            $script:FillPanelPuesto = $true
        }
    }

    function Fill-AvisoFila([string]$texto, [int]$fila, [int]$ms, [switch]$Rojo) {
        $g = $script:BandaGuia
        if ($fila -lt 0 -or $fila -ge $g.Filas.Count) { $fila = 0 }
        $p = $g.Esquinas($fila)
        Banda-Aviso $texto ([Math]::Max($p[2], $p[4])) (($p[3] + $p[5]) / 2 + 26) $ms -Rojo:$Rojo
    }

    # banda solo con el borde (se ven los colores de los datos debajo)
    function Fill-BandaSuave {
        $BandaPoli.Fill = B '#1FFFEB3B'
        $BandaPoli.Stroke = B '#FFFFC107'
        $BandaPoli.StrokeThickness = 2
    }
    # colores normales de la banda (amarilla)
    function Fill-ColoresNormales {
        $BandaPoli.StrokeThickness = 1
        $BandaPoli.Fill = B '#55FFEB3B'
        $BandaPoli.Stroke = B '#CCF9A825'
        $BandaEtiqueta.Background = B '#F2FFD600'
        $BandaEtiqueta.Child.Foreground = B '#FF1E1E1E'
    }

    # 1er toque con FILL: lee lo que se ve y espera el toque en el ultimo peso
    function Fill-Empezar($g) {
        if (-not (Ocr-Iniciar)) {
            $script:FillFase = ''
            Fill-AvisoFila ('FILL: Windows OCR not available (' + $script:OcrMotivo + ') - band only') 0 5000 -Rojo
            return $false
        }
        try {
            $script:FillFase = 'marcar'; $script:FillCache = @{}; $script:FillRes = $null; $script:FillK = 0
            Banda-Ocultar
            $g.PrepararColumnas()
            Fill-AvisoFila 'FILL: reading...' 0 3000
            $BandaWinV.Dispatcher.Invoke([Action]{ }, [System.Windows.Threading.DispatcherPriority]::Render)
            $script:FillEncab = @()
            try { $script:FillEncab = Leer-Encabezado $g $script:FillOcr } catch { }
            [void](Leer-Visibles $g $script:FillCache $script:FillOcr)
            # (hazmat ya no para: esas filas se marcan en rojo al final y las haces tu)
            $script:BandaFinHasta = [DateTime]::MaxValue      # el siguiente toque = el ultimo peso
            Fill-AvisoFila 'FILL: now Right Shift on the GRAND TOTAL weight' 0 4000
            return $true
        } catch {
            $script:FillFase = ''
            Fill-AvisoFila ('FILL error: ' + $_.Exception.Message + ' - band only') 0 5000 -Rojo
            return $false
        }
    }

    # 2o toque con FILL: lee lo que falta, revisa los candados y prepara las lineas
    function Fill-Leer([int]$ultima) {
        $g = $script:BandaGuia
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        try {
            $BandaAvisoB.Visibility = 'Hidden'
            Banda-Ocultar
            $BandaWinV.Dispatcher.Invoke([Action]{ }, [System.Windows.Threading.DispatcherPriority]::Render)
            Start-Sleep -Milliseconds 40
            Banda-Foto
            [void]$g.Seguir($script:BandaGris)
            [void](Leer-Visibles $g $script:FillCache $script:FillOcr)
            $a = Armar-Resultado $g $script:FillCache ($g.Filas.Count - 1) $script:FillOcr $script:FillEncab
            $script:FillRes = $a.Res
            $script:FillInfo = "$($g.Filas.Count) rows | $($g.InfoSeparadores) | $($sw.ElapsedMilliseconds) ms"
            $enc = "FORCE MENU FILL | $ScriptVersion | OCR $($script:OcrIdioma) | $($script:FillInfo) | angle $([Math]::Round($g.Grados, 2))"
            $script:FillReporte = Texto-Reporte $a.Filas $a.Res $enc
            Fill-Terminar $a.Res
        } catch {
            $script:FillFase = 'no'
            $script:FillReporte = 'FILL error: ' + $_.Exception.Message
            $script:BandaIdx = 0
            Banda-Mostrar
            Fill-AvisoFila ('FILL error: ' + $_.Exception.Message + ' - band only') 0 5000 -Rojo
        }
    }

    # despues de leer (automatico o manual): listo para teclear, o no cuadro
    function Fill-Terminar($res) {
        $script:FillRes = $res
        $script:FillK = 0
        Fill-Pintar
        Fill-BandaSuave
        $man = if ($res.Manual) { ' (manual)' } else { '' }
        $hz = @($res.LineasHazmat | Where-Object { $_ }).Count -gt 0
        if ($res.Bien -and $res.Lineas.Count -gt 0) {
            $script:FillFase = 'listo'
            $script:BandaTecleo = $false
            Fill-IrALinea
            Fill-PanelMostrar
            $avisos = [bool]($res.Candados | Where-Object { $_[0] -eq '??' -or $_[0] -eq 'TY' })
            if ($hz) { Fill-AvisoFila "FILL ready${man}: TYPE THE HAZMAT LINES (red) YOURSELF FIRST, then click Pieces of the next line and Right Shift types this one" $script:BandaIdx 9000 -Rojo }
            elseif ($avisos) { Fill-AvisoFila "FILL ready${man} - CHECK THE ORANGE WARNINGS in the panel: click Pieces in the ERP, then Right Shift types this line" $script:BandaIdx 7000 }
            else { Fill-AvisoFila "FILL ready${man}: click Pieces in the ERP, then Right Shift types this line" $script:BandaIdx 6000 }
        } else {
            $script:FillFase = 'no'
            $script:BandaIdx = 0
            Banda-Mostrar
            Fill-PanelMostrar
            if (-not $res.Manual -and $res.Tipos -and @($res.Tipos).Count -gt 0) { Fill-AvisoFila 'FILL: checks failed - nothing will be typed (band only). In the panel: PICK COLUMNS to point them out' 0 6000 -Rojo }
            else { Fill-AvisoFila "FILL${man}: checks failed - nothing will be typed (band only)" 0 5000 -Rojo }
        }
    }

    # la banda en la fila de la linea que sigue
    $script:FillCampo = 0          # 0 = linea nueva; > 0 = sigue despues de un campo que escribiste tu
    $script:FillTabsTuyos = 0      # Tabs que diste tu mientras escribias ese campo
    function Fill-IrALinea {
        $script:FillCampo = 0; $script:FillTabsTuyos = 0
        $l = $script:FillRes.Lineas[$script:FillK]
        $i = [int]$l.Fila - 1
        if ($i -ge 0 -and $i -lt $script:BandaGuia.Filas.Count) { $script:BandaIdx = $i }
        Banda-Mostrar
        Fill-PanelActualizar
    }

    function Fill-Escapar([string]$t) {
        return (-join ($t.ToCharArray() | ForEach-Object { if ('+^%~(){}[]'.Contains([string]$_)) { '{' + $_ + '}' } else { [string]$_ } }))
    }

    # Teclea los campos de una linea con Tab entre ellos (sin Enter: lo das tu).
    # En minusculas: el ERP lo pone en mayusculas (y asi no se usa Shift).
    # $desde = campo donde sigue (despues de uno que escribiste tu); $yaTab = ya diste
    # Tab tu para salir de ese campo. Regresa el campo donde se paro para que lo
    # escribas tu (5 = descripcion, 7 = clase) o -1 si ya tecleo toda la linea.
    function Fill-TeclearLinea($l, [int]$desde = 0, [bool]$yaTab = $false) {
        $campos = @($l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $l.Desc, $l.Weight, $l.Clase, $l.Nmfc)
        $mano = @($l.Mano)
        $claseAlta = $false; $cv = 0
        if ([double]::TryParse([string]$l.Clase, [System.Globalization.NumberStyles]::Float, [System.Globalization.CultureInfo]::InvariantCulture, [ref]$cv) -and $cv -gt 300) { $claseAlta = $true }
        if ($desde -gt 0 -and -not $yaTab) {
            [System.Windows.Forms.SendKeys]::SendWait('{TAB}')       # sale del campo que escribiste
            Start-Sleep -Milliseconds $FillPausaTabMs
        }
        for ($i = $desde; $i -lt $campos.Count; $i++) {
            if ($mano -contains $i) { return $i }                      # este lo escribes tu
            $v = ([string]$campos[$i]).Trim()
            if ($v) { [System.Windows.Forms.SendKeys]::SendWait((Fill-Escapar $v.ToLower())) }
            Start-Sleep -Milliseconds $FillPausaCampoMs
            # clase arriba de 300 (400, 500): el ERP saca un aviso al escribirla; Enter lo cierra y sigue el Tab
            if ($i -eq 7 -and $claseAlta -and $FillClaseAltaEnter) {
                Start-Sleep -Milliseconds $FillClaseAltaPausaMs
                [System.Windows.Forms.SendKeys]::SendWait('{ENTER}')
                Start-Sleep -Milliseconds $FillClaseAltaPausaMs
                try { [void][LocalKeyState]::GetAsyncKeyState(0x0D) } catch { }     # (ese Enter no cuenta como "siguiente linea")
            }
            if ($i -lt $campos.Count - 1) {
                [System.Windows.Forms.SendKeys]::SendWait('{TAB}')
                Start-Sleep -Milliseconds $FillPausaTabMs
            }
        }
        return -1
    }

    # Shift derecho en FILL listo: teclea la linea de la banda
    function Fill-Teclear {
        $l = $script:FillRes.Lineas[$script:FillK]
        if ($FillSoloEnERP -and [Motor]::ProcesoAlFrente() -ne 'mstsc') {
            $m = [BandaWin]::Mouse()
            Banda-Aviso 'FILL: click the Pieces field in the ERP first' $m[0] $m[1] 2500 -Rojo
            return
        }
        $BandaAvisoB.Visibility = 'Hidden'
        $para = Fill-TeclearLinea $l $script:FillCampo ($script:FillTabsTuyos -gt 0)
        $script:FillTabsTuyos = 0
        $que = if ($l.N -eq 'P') { 'Pallet line' } else { "Line $($l.N)" }
        if ($para -ge 0) {
            # se paro en un campo que escribes tu (no se entendio): luego Shift derecho sigue
            $script:FillCampo = $para + 1
            $script:BandaTecleo = $false
            $campo = if ($para -eq 5) { 'DESCRIPTION' } else { 'CLASS (Charge Type)' }
            $leido = if ($para -eq 5) { $l.DescLeida } else { $l.ClaseLeida }
            Banda-Mostrar
            Fill-PanelActualizar
            Fill-AvisoFila "$que - TYPE THE $campo yourself (read: '$leido'), then Right Shift types the rest" $script:BandaIdx 15000 -Rojo
            return
        }
        $script:FillCampo = 0
        $script:BandaTecleo = $true          # el Enter que sigue cuenta: pasa a la siguiente linea
        if ($l.N -eq '1' -and $l.Pkg -and -not $l.Pieces) { Fill-AvisoFila "$que typed: TYPE THE PALLETS in Pieces yourself, check it and press Enter" $script:BandaIdx 5000 -Rojo }
        else { Fill-AvisoFila "$que typed: check it and press Enter" $script:BandaIdx 2500 }
    }

    # Enter (despues de teclear): la siguiente linea; al final se apaga
    function Fill-Avanzar {
        $n = $script:FillRes.Lineas.Count
        if ($script:FillK + 1 -ge $n) {
            $g = $script:BandaGuia; $p = $g.Esquinas($script:BandaIdx)
            Banda-Apagar
            Banda-Aviso ('FILL: breakdown done ({0} lines)' -f $n) ([Math]::Max($p[2], $p[4])) $p[5] 2500
            return
        }
        $script:FillK++
        Fill-IrALinea
    }
    function Fill-Regresar { if ($script:FillK -gt 0) { $script:FillK--; Fill-IrALinea } }

    # ===================== FILL MANUAL: tu senalas las columnas =====================
    # Sale cuando el automatico no cuadro (boton PICK COLUMNS del panel).
    # En el orden de Edit Details del ERP: Q Pieces, Description, Weight,
    # Class (Charge Type), NMFC. CLICK IZQUIERDO en una celda de la columna
    # (cualquier fila o su encabezado). Shift derecho = no hay esa columna
    # (el peso no se puede brincar). Flecha arriba = regresa una.
    # Aviso grande arriba (como el WAIT del Force Menu): MISSING COLUMN: ...
    $script:FillPasos = @(
        @{ Rol = 'Pcs';   Nombre = 'Q PIECES';            Color = 'qty';   Obligatoria = $false }
        @{ Rol = 'Desc';  Nombre = 'DESCRIPTION';         Color = 'desc';  Obligatoria = $false }
        @{ Rol = 'Peso';  Nombre = 'WEIGHT';              Color = 'peso';  Obligatoria = $true }
        @{ Rol = 'Clase'; Nombre = 'CLASS (CHARGE TYPE)'; Color = 'clase'; Obligatoria = $false }
        @{ Rol = 'Nmfc';  Nombre = 'NMFC';                Color = 'nmfc';  Obligatoria = $false }
    )
    $script:FillPaso = 0
    $script:FillManual = @{}
    $script:FillAutoHu = -1

    function Fill-ManualEmpezar {
        $res = $script:FillRes
        if ($script:FillFase -ne 'no' -or -not $res -or -not $res.Tipos -or @($res.Tipos).Count -eq 0) { return }
        if ($script:BandaEstado -eq 'off' -or -not $script:BandaGuia) {
            $script:FillBtnManual.Visibility = 'Collapsed'
            $m = Fill-Mouse
            Banda-Aviso 'FILL: the band is off - start again (Right Shift on the first weight)' $m[0] $m[1] 3500 -Rojo
            return
        }
        # (la columna de handling units que vio el automatico: pista para los pallets;
        #  si ya es un intento manual se queda la que se habia guardado)
        if (-not $res.Manual) {
            $script:FillAutoHu = -1
            try {
                if ($res.Roles -and ($res.Roles.Keys -contains 'HuQty')) {
                    $kv = [int]$res.Roles['HuQty']
                    if ($kv -ge 0 -and $res.Filas -and @($res.Filas).Count -gt 0) { $kv = [int]$res.Filas[0].Celdas[$kv].Col }
                    $script:FillAutoHu = $kv
                }
            } catch { $script:FillAutoHu = -1 }
        }
        $script:FillFase = 'columnas'
        $script:FillPaso = 0
        $script:FillManual = @{ Pcs = -2; Desc = -2; Peso = -2; Clase = -2; Nmfc = -2 }     # -2 = falta, -1 = no hay
        $script:FillBtnManual.Visibility = 'Collapsed'
        $BandaAvisoB.Visibility = 'Hidden'
        Fill-ManualPintar
        $script:BandaIdx = 0
        Banda-Mostrar
        Fill-PanelMostrar
        Fill-ManualAviso
    }

    # numero de la columna como se ve (solo cuentan las columnas que traen algo)
    function Fill-ManualNum([int]$k) {
        $n = 0
        for ($j = 0; $j -le $k; $j++) {
            foreach ($i in $script:FillCache.Keys) { $c = $script:FillCache[$i].Celdas[$j]; if ($c -and -not $c.Vacia) { $n++; break } }
        }
        return $n
    }

    # texto de ejemplo de una columna (la primera celda con algo que no sea el total)
    function Fill-ManualEjemplo([int]$k) {
        foreach ($i in ($script:FillCache.Keys | Sort-Object)) {
            $c = $script:FillCache[$i].Celdas[$k]
            if ($c -and -not $c.Vacia -and $c.Texto -and $c.Texto -notmatch '(?i)TOTAL') { $t = [string]$c.Texto; if ($t.Length -gt 24) { $t = $t.Substring(0, 23) + '~' }; return $t }
        }
        return ''
    }

    function Fill-ManualPanel {
        $script:FillBtnManual.Visibility = 'Collapsed'
        $paso = $script:FillPasos[[Math]::Min($script:FillPaso, $script:FillPasos.Count - 1)]
        $script:FillTitulo.Text = 'PICK COLUMNS ({0} of {1}): LEFT CLICK a cell of the {2} column' -f ($script:FillPaso + 1), $script:FillPasos.Count, $paso.Nombre
        $script:FillTitulo.Foreground = B '#FF58A6FF'
        $script:FillCuerpo.Inlines.Clear()
        Fill-Renglon '  (same order as Edit Details; Pieces = pallets come from the TOTAL row)' '#FF8B949E'
        for ($j = 0; $j -lt $script:FillPasos.Count; $j++) {
            $q = $script:FillPasos[$j]; $k = [int]$script:FillManual[$q.Rol]
            $marca = if ($j -eq $script:FillPaso) { '>' } else { ' ' }
            $que = if ($k -ge 0) { "column {0,-3} '{1}'" -f (Fill-ManualNum $k), (Fill-ManualEjemplo $k) } elseif ($k -eq -1) { 'none' } elseif ($j -eq $script:FillPaso) { '<- LEFT CLICK it' } else { '' }
            $col = if ($j -eq $script:FillPaso) { '#FFFFD600' } elseif ($k -ge 0) { '#FF' + $script:FillColores[$q.Color][0].Substring(1) } else { '#FF8B949E' }
            Fill-Renglon ('{0} {1,-20} {2}' -f $marca, $q.Nombre, $que) $col -Negrita:($marca -eq '>')
        }
        Fill-Renglon '' '#FFE6EDF3'
        Fill-Renglon 'LEFT CLICK = pick that column   RIGHT SHIFT = there is none (not for WEIGHT)   UP ARROW = back   CLOSE = cancel' '#FF8B949E'
        Fill-Renglon 'Only rows with a weight are typed. Line 1: pallets SKD (STC only if it has Q pieces); next lines: *.' '#FF8B949E'
    }

    function Fill-Mouse { return [BandaWin]::Mouse() }
    # aviso grande arriba (el mismo del Force Menu): que columna falta
    function Fill-ManualAviso {
        $paso = $script:FillPasos[$script:FillPaso]
        $extra = if ($paso.Obligatoria) { 'UP = BACK' } else { 'RIGHT SHIFT = NONE  |  UP = BACK' }
        Show-Aviso 'PICK' ("{0} OF {1}  MISSING COLUMN: {2}`nLEFT CLICK ON IT  |  {3}" -f ($script:FillPaso + 1), $script:FillPasos.Count, $paso.Nombre, $extra) '#58A6FF' 0
    }
    function Fill-ManualQuitarAviso { try { if ($script:WatermarkGhost.Text -eq 'PICK') { Hide-Watermark } } catch { } }

    # el mouse esta sobre esta ventana (panel o aviso)? (esos clicks no escogen columna)
    function Fill-SobreVentana($w, $m) {
        try {
            if (-not $w -or -not $w.IsVisible) { return $false }
            $e = $script:BandaEsc; if ($e -le 0) { $e = 1 }
            $x0 = $w.Left / $e; $y0 = $w.Top / $e; $x1 = ($w.Left + $w.ActualWidth) / $e; $y1 = ($w.Top + $w.ActualHeight) / $e
            return ($m[0] -ge $x0 -and $m[0] -le $x1 -and $m[1] -ge $y0 -and $m[1] -le $y1)
        } catch { return $false }
    }

    # pinta las columnas que ya escogiste (cada una con su color)
    function Fill-ManualPintar {
        $pin = New-Object System.Collections.ArrayList
        $cols = @()
        foreach ($q in $script:FillPasos) { $k = [int]$script:FillManual[$q.Rol]; if ($k -ge 0) { $cols += ,@($k, $q.Color) } }
        foreach ($i in $script:FillCache.Keys) {
            $cs = $script:FillCache[$i].Celdas
            foreach ($kc in $cols) { $k = [int]$kc[0]; if ($k -ge 0 -and $k -lt $cs.Count -and -not $cs[$k].Vacia) { [void]$pin.Add(@{ Fila = [int]$i; Col = $k; Color = $kc[1] }) } }
        }
        $script:FillRes.Pintar = @($pin)
        Fill-Pintar
    }

    # click izquierdo mientras escoges: la columna donde diste click
    function Fill-ManualClick([int[]]$m) {
        if ((Fill-SobreVentana $FillPanel $m) -or (Fill-SobreVentana $WatermarkWin $m)) { return }
        $g = $script:BandaGuia
        $paso = $script:FillPasos[$script:FillPaso]
        [void](Banda-SeguirAhora)                       # (por si bajaste la hoja)
        $k = $g.ColumnaEn($m[0], $m[1])
        if ($k -lt 0) { Banda-Aviso ('Click a cell of the table ({0})' -f $paso.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        # el peso: el que escogiste, o el de la banda si todavia no llegas a ese paso
        $kp = if ([int]$script:FillManual.Peso -ge 0) { [int]$script:FillManual.Peso } else { $g.ColumnaPeso() }
        if ($paso.Rol -ne 'Peso' -and $k -eq $kp) { Banda-Aviso ('That is the WEIGHT column - click the {0} column' -f $paso.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        foreach ($q in $script:FillPasos) {
            if ($q.Rol -eq $paso.Rol -or [int]$script:FillManual[$q.Rol] -ne $k) { continue }
            # (piezas+descripcion o NMFC+clase si pueden venir juntas en una columna)
            $par = (@($q.Rol, $paso.Rol) | Sort-Object) -join ','
            if ($par -ne 'Desc,Pcs' -and $par -ne 'Clase,Nmfc') { Banda-Aviso ('That column is already {0}' -f $q.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        }
        $script:FillManual[$paso.Rol] = $k
        Fill-ManualSiguiente
    }
    # Shift derecho: no hay esa columna (el peso si tiene que estar)
    function Fill-ManualSaltar {
        $paso = $script:FillPasos[$script:FillPaso]
        if ($paso.Obligatoria) { $m = Fill-Mouse; Banda-Aviso ('{0} is required: LEFT CLICK it' -f $paso.Nombre) $m[0] $m[1] 3000 -Rojo; return }
        $script:FillManual[$paso.Rol] = -1
        Fill-ManualSiguiente
    }
    # flecha arriba: regresa un paso
    function Fill-ManualAtras {
        if ($script:FillPaso -le 0) { return }
        $script:FillPaso--
        $script:FillManual[$script:FillPasos[$script:FillPaso].Rol] = -2
        Fill-ManualPintar
        Fill-PanelActualizar
        Fill-ManualAviso
    }
    function Fill-ManualSiguiente {
        $script:FillPaso++
        Fill-ManualPintar
        if ($script:FillPaso -ge $script:FillPasos.Count) { Fill-ManualLeer; return }
        Fill-PanelActualizar
        Fill-ManualAviso
    }

    # ya estan todas: interpreta con esas columnas (no vuelve a tomar fotos)
    function Fill-ManualLeer {
        $g = $script:BandaGuia
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        Fill-ManualQuitarAviso
        try {
            $BandaAvisoB.Visibility = 'Hidden'
            $kp = [int]$script:FillManual.Peso; if ($kp -lt 0) { $kp = $g.ColumnaPeso() }
            $roles = @{ Peso = $kp; Pcs = [int]$script:FillManual.Pcs; Desc = [int]$script:FillManual.Desc; Clase = [int]$script:FillManual.Clase; Nmfc = [int]$script:FillManual.Nmfc }
            $a = Armar-Manual $g $script:FillCache $roles $script:FillOcr $script:FillAutoHu
            $script:FillInfo = "$($g.Filas.Count) rows | $($g.InfoSeparadores) | manual $($sw.ElapsedMilliseconds) ms"
            $enc = "FORCE MENU FILL (MANUAL) | $ScriptVersion | OCR $($script:OcrIdioma) | $($script:FillInfo) | angle $([Math]::Round($g.Grados, 2))"
            $script:FillReporte = Texto-Reporte $a.Filas $a.Res $enc
            Fill-Terminar $a.Res
        } catch {
            $script:FillFase = 'no'
            $script:FillReporte = 'FILL error: ' + $_.Exception.Message
            $script:BandaIdx = 0
            Banda-Mostrar
            Fill-AvisoFila ('FILL error: ' + $_.Exception.Message + ' - band only') 0 5000 -Rojo
        }
    }

    $BandaWinV.Show()
    $bandaSrc = [System.Windows.PresentationSource]::FromVisual($BandaWinV)
    if ($bandaSrc) { $script:BandaEsc = $bandaSrc.CompositionTarget.TransformFromDevice.M11 }
}

# Switch BAND: prende / apaga el Shift derecho de la banda
function Set-BandaActivo([bool]$on) {
    $script:BandaActivo = $on
    if (-not $on) { Banda-Apagar }
    if (-not $on -and $script:FillActivo) { Set-FillActivo $false }
    if ($script:SwBandaTxt) {
        $col = if (-not $script:BandaListo) { $C.Dim } elseif ($on) { '#E3B341' } else { $C.Dim }
        $script:SwBandaTxt.Text = if ($on -and $script:BandaListo) { 'BAND ON' } else { 'BAND OFF' }
        $script:SwBandaTxt.Foreground = B $col
        $script:SwBandaBtn.BorderBrush = B $col
        $script:SwBandaBtn.Background  = B (Get-Soft $col)
    }
    if ($on -and -not $script:BandaListo) {
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        Show-Watermark 'BAND' ('BAND NOT AVAILABLE: ' + $script:BandaMotivo) 3000
        $script:WatermarkAccent = $acentoPrevio
    }
    Paso ("Switch banda: " + $(if ($on) { 'ON' } else { 'OFF' }))
}

# Switch FILL: llenado del breakdown con OCR (necesita la banda prendida)
function Set-FillActivo([bool]$on) {
    $script:FillActivo = $on
    $listo = $script:BandaListo
    if ($on -and $listo) {
        if (-not $script:BandaActivo) { Set-BandaActivo $true }
        $listo = Ocr-Iniciar
    }
    if (-not $on -and $script:BandaEstado -ne 'off' -and $script:FillFase) { Banda-Apagar }
    if ($script:SwFillTxt) {
        $col = if (-not $listo) { $C.Dim } elseif ($on) { '#58A6FF' } else { $C.Dim }
        $script:SwFillTxt.Text = if ($on -and $listo) { 'FILL ON' } else { 'FILL OFF' }
        $script:SwFillTxt.Foreground = B $col
        $script:SwFillBtn.BorderBrush = B $col
        $script:SwFillBtn.Background  = B (Get-Soft $col)
    }
    if ($on -and -not $listo) {
        $script:FillActivo = $false
        $acentoPrevio = $script:WatermarkAccent
        $script:WatermarkAccent = $C.Dim
        $mot = if (-not $script:BandaListo) { $script:BandaMotivo } else { 'WINDOWS OCR: ' + $script:OcrMotivo }
        Show-Watermark 'FILL' ('FILL NOT AVAILABLE: ' + $mot) 3500
        $script:WatermarkAccent = $acentoPrevio
    }
    Paso ("Switch fill: " + $(if ($script:FillActivo) { 'ON' } else { 'OFF' }))
}

# ===================== SWITCH AUDIT (ON / OFF) =====================
# Botoncito chico abajo a la derecha, SOLO se ve con el menu abierto.
# Click = prende / apaga Ctrl izq + Abajo. Arranca APAGADO ($AuditPrendidoAlInicio).
function Set-AuditActivo([bool]$on) {
    $script:AuditActivo = $on
    if ($script:SwAuditTxt) {
        $col = if ($on) { '#3FB950' } else { $C.Dim }
        $script:SwAuditTxt.Text = if ($on) { 'AUDIT ON' } else { 'AUDIT OFF' }
        $script:SwAuditTxt.Foreground = B $col
        $script:SwAuditBtn.BorderBrush = B $col
        $script:SwAuditBtn.Background  = B (Get-Soft $col)
    }
    Paso ("Switch audit: " + $(if ($on) { 'ON' } else { 'OFF' }))
}

if ($UsarBotonesMotor) {
