# ======================= INTERPRETAR LO QUE LEYO EL OCR =======================
# Entrada: filas con sus celdas (misma cantidad de columnas en todas) y la
# columna del peso. Salida: lineas para el ERP y candados. Nada se guarda.

$script:ClasesNmfc = @('50','55','60','65','70','77.5','85','92.5','100','110','125','150','175','200','250','300','400','500')

# Numero con las confusiones tipicas del OCR (O->0, l->1, S->5...)
function Num-Limpio([string]$t) {
    $s = ($t -replace '\s', '')
    $s = $s.Trim('|', '[', ']', '!', '(', ')', '{', '}', '/', '\')      # (restos de las rayas de la tabla en las orillas)
    $o = $s
    $s = $s -replace '[OoQD]', '0' -replace '[Il\|!\]\[]', '1' -replace '[Ss]', '5' -replace 'B', '8' -replace '[Zz]', '2'
    return @{ Texto = $s; Cambio = ($s -cne $o) }
}

# Peso: "1,002" -> 1002   (null si no es numero)
function Leer-Peso([string]$t) {
    if ($t -notmatch '\d') { return @{ Valor = $null; Cambio = $false } }      # ("|" o "l" sueltos no son un 1)
    $t = $t -replace '(?i)\s*(LBS?|KGS?|#)\.?\s*$', ''          # "181 LBS" -> 181
    $n = Num-Limpio $t
    $s = $n.Texto
    if ($s -match '^\d{1,3}\.\d{3}$') { $s = $s -replace '\.', '' }        # "1.732" = 1,732 (punto en lugar de coma)
    $s = $s -replace ',', ''
    if ($s -match '^\d+$') { return @{ Valor = [int]$s; Cambio = $n.Cambio } }
    if ($s -match '^(\d+)\.(\d+)$') { return @{ Valor = [double]$s; Cambio = $n.Cambio } }
    return @{ Valor = $null; Cambio = $n.Cambio }
}

# Cantidad: "6.000" -> 6, "160.000" -> 160
function Leer-Qty([string]$t) {
    if ($t -notmatch '\d') { return @{ Valor = $null; Texto = ''; Cambio = $false } }
    if ($t -match '^\s*([\d,\.OoIl]+)\s*[A-Za-z]{1,8}\.?\s*$') { $t = $matches[1] }   # "6 CTN" -> 6
    $n = Num-Limpio $t
    $s = $n.Texto -replace ',', ''
    if ($s -match '^\d+$') { return @{ Valor = [int]$s; Texto = $s; Cambio = $n.Cambio } }
    if ($s -match '^(\d+)\.(\d+)$') {
        $ent = $matches[1]; $dec = $matches[2]
        if ($dec -match '^0+$') { return @{ Valor = [int]$ent; Texto = $ent; Cambio = $n.Cambio } }
        return @{ Valor = [double]$s; Texto = $s; Cambio = $n.Cambio }
    }
    return @{ Valor = $null; Texto = ''; Cambio = $n.Cambio }
}

# Clase: tiene que ser una de las 18 de la NMFC
function Leer-Clase([string]$t) {
    if ($t -notmatch '\d') { return @{ Valor = ''; Ok = $false } }
    $t = $t -replace '(?i)^\s*(CLASS|CL)\.?\s*', '' -replace '(?i)\s*CL\.?\s*$', ''     # "65", "65CL", "CL 65" -> 65
    $n = Num-Limpio $t
    $s = $n.Texto.TrimEnd('.', ',')
    if ($s -match '^\d+(\.\d)?$' -and $script:ClasesNmfc -contains $s) { return @{ Valor = $s; Ok = $true } }
    return @{ Valor = $s; Ok = $false }
}

# NMFC: 48580S10 / 48580s10 / 15600.7 / 15600-7  ->  48580s10, 15600s7
function Leer-Nmfc([string]$t) {
    $s = ($t.ToUpper() -replace '\s', '').Trim('.', ',', ';', ':')
    if (-not $s) { return @{ Valor = ''; Ok = $false; Duda = '' } }
    $s = $s -replace '[\.\-_/]', 'S'
    if ($s -match '^([0-9OQIL]{4,6})(S([0-9OQIL]{1,2}))?$') {
        $item = $matches[1] -replace '[OQ]', '0' -replace '[IL]', '1'
        $sub = $matches[3]
        if ($sub) { $sub = $sub -replace '[OQ]', '0' -replace '[IL]', '1'; return @{ Valor = "${item}s$sub"; Ok = $true; Duda = '' } }
        return @{ Valor = $item; Ok = $true; Duda = '' }
    }
    if ($s -match '^\d{6,8}$') { return @{ Valor = $s; Ok = $false; Duda = 'S read as 5?' } }
    return @{ Valor = $s; Ok = $false; Duda = '' }
}

# Numero de material peligroso: UN1993, UN 1993, NA-1993 (el OCR puede leer
# 1 como I/l y 0 como O). Regresa el texto encontrado o ''.
function Texto-Hazmat([string]$t) {
    foreach ($m in [regex]::Matches($t, '(?i)(?<![A-Z])(UN|NA)\s*[-#:]?\s*([0-9IlO|]{4})(?![0-9])')) {
        $dig = ([regex]::Matches($m.Groups[2].Value, '\d')).Count
        if ($dig -ge 3) { return ($m.Groups[1].Value.ToUpper() + ($m.Groups[2].Value -replace '[Il|]', '1' -replace 'O', '0')) }
    }
    return ''
}
# Busca UN/NA en lo que ya se leyo (cache de filas). Regresa @{ Fila (0..); Texto } o $null
function Buscar-Hazmat($cache) {
    foreach ($i in ($cache.Keys | Sort-Object)) {
        foreach ($c in $cache[$i].Celdas) {
            if ($c.Vacia -or -not $c.Texto) { continue }
            $h = Texto-Hazmat $c.Texto
            if ($h) { return @{ Fila = [int]$i; Texto = $h; Col = $c.Col } }
        }
    }
    return $null
}

# Palabras de los encabezados (pista para saber que es cada columna)
$script:PalabrasRol = [ordered]@{
    Clase = '\bCLASS\b|\bCLS\b|FREIGHT\s*CL'
    Nmfc  = 'NMFC|N\.M\.F\.C|\bITEM\s*(NO|#)'
    Desc  = 'DESCRIPTION|COMMODITY|ARTICLES|\bDESC\b|PRODUCT'
    Peso  = 'WEIGHT|\bWT\b|\bLBS\b|GROSS'
    HM    = '^\s*H\.?\s*M\.?\s*$|\bHM\b|\bH\.M\.|HAZ'
    Qty   = '\bQTY\b|QUANTITY|COUNT|PIECES|\bPCS\b|PKGS|CARTONS|CTNS|\bUNITS\b|SKIDS|PALLETS|PLTS'
    Tipo  = '\bTYPE\b|\bUOM\b'
    HU    = 'HANDLING|\bH\.?U\.?\b|PALLET|\bPLT|SKID'
    Pkg   = 'PACKAGE|\bPKG|PIECE|\bPCS\b|CARTON|\bCTN|CASES'
}
# Numero de pallets / de piezas con su palabra ("TOTAL 3 PLTS 2,460 CTN")
$script:PalabrasPallet = '(?i)(?<![\d,\.])(\d{1,3})\s*(PLTS?|PALLETS?|PALLE|SKIDS?|SKDS?|HU|H/U|HANDLING\s*UNITS?)\b'
$script:PalabrasPiezas = '(?i)(?<![\d,\.])(\d[\d,]*)\s*(CTNS?|CARTONS?|PCS|PIECES?|PKGS?|PACKAGES?|CASES?|CS|BOXE?S?|BX|UNITS?|BAGS?|DRUMS?|ROLLS?|TOTES?|CRATES?|PAILS?)\b'
# Descripcion que en realidad es el peso del pallet (va al final como PALLET WEIGHT)
$script:DescPallet = '(?i)^\W*(PALLETS?|SKIDS?|PLTS?)(\s*(WEIGHT|WT|WGT|WEIGH|WEIGTH))?\W*$|PALLETS?\s*(WEIGHT|WT|WGT|WEIGTH)|\bTARE\b'
$script:TiposPaquete = '^(CS|CSE|CASES?|CTN?S?|CARTONS?|PLTS?|PALLETS?|PALLE|SKIDS?|SKD|BOX|BOXES|BX|DRUMS?|DR|BAGS?|PCS?|PIECES?|PKGS?|PACKAGES?|ROLLS?|RL|TOTES?|CRATES?|BUNDLES?|BDLS?|EA|EACH|UNITS?|GAYLORDS?|CYL|PAILS?|JUGS?|KEGS?|TUBES?|LOOSE)\.?$'
# Formatos conocidos: si el encabezado trae todas estas palabras, es ese formato.
# (los que mas se repiten; se agregan con fotos de cada uno)
$script:FillFormatos = @(
    @{ Nombre = 'VICS (GOJO)'; Palabras = @('HANDLING', 'PACKAGE', 'WEIGHT', 'NMFC', 'CLASS') }
)

function Cuenta-Letras([string]$t) { return ([regex]::Matches($t, '[A-Za-z]')).Count }
function Es-Numerico([string]$t) { $s = ($t -replace '\s', ''); return ($s.Length -gt 0 -and ($s -replace '[0-9\.,]', '').Length -le [Math]::Max(0, [int]($s.Length / 4))) }

# Que es cada columna. Por contenido, sin importar el orden:
#   clase = valores de las 18 clases; NMFC = 4-6 numeros con S/./- y sub;
#   descripcion = muchas letras; cantidad = numeros (6.000, 160, "6 CTN");
#   tipo = CS, CTN, PLT...; H.M. = columna angosta vacia o con X.
# El encabezado (si se leyo) suma puntos: CLASS, NMFC, DESCRIPTION, QTY...
# Handling units vs paquetes: por el encabezado, o la cantidad que viene en
# los renglones con descripcion es la de paquetes.
function Roles-Columnas($filas, [int]$colPeso, [int]$altoTexto, $encab) {
    $nCol = $filas[0].Celdas.Count
    $enc = @(for ($k = 0; $k -lt $nCol; $k++) { if ($encab -and $k -lt $encab.Count) { [string]$encab[$k] } else { '' } })
    $todoEnc = ($enc -join ' ')
    $formato = 'generic'
    foreach ($fm in $script:FillFormatos) {
        $todas = $true
        foreach ($w in $fm.Palabras) { if ($todoEnc -notmatch [regex]::Escape($w)) { $todas = $false; break } }
        if ($todas) { $formato = $fm.Nombre; break }
    }
    $tiene = { param([int]$k, [string]$r) $enc[$k] -and ($enc[$k] -match $script:PalabrasRol[$r]) }
    # renglones con descripcion (para saber cual cantidad es la de paquetes)
    $letrasCol = @(for ($k = 0; $k -lt $nCol; $k++) { $l = 0; foreach ($f in $filas) { if (-not $f.Celdas[$k].Vacia) { $l += Cuenta-Letras ([string]$f.Celdas[$k].Texto) } }; $l })
    $info = @()
    for ($k = 0; $k -lt $nCol; $k++) {
        $no = 0; $cl = 0; $nmS = 0; $nm6 = 0; $qty = 0; $tipo = 0; $equis = 0; $letras = 0; $sumaLetras = 0
        foreach ($f in $filas) {
            if ($f.Celdas[$k].Vacia) { continue }
            $t = ([string]$f.Celdas[$k].Texto).Trim()
            if (-not $t) { continue }
            if ($t -match '(?i)\bTOTALS?\b') { continue }        # (el renglon de total no dice que es la columna)
            if ($t -notmatch '[A-Za-z0-9]' -or $t -match '^[\|\[\]Il!i:;\.,\-_~]{1,2}$') { continue }   # (restos de una raya)
            $no++
            $nl = Cuenta-Letras $t; $sumaLetras += $nl
            if ((Leer-Clase $t).Ok) { $cl++ }
            $n = Leer-Nmfc $t
            if ($n.Ok -and $t -match '\d{4}' -and $t -match '(?i)[S\.\-]\s*\d') { $nmS++ } elseif ($t -match '^\s*\d{5,6}\s*$') { $nm6++ }
            $q = Leer-Qty $t
            if ($q.Valor -ne $null -and -not ($t -match '(?i)\d{4,}\s*S\s*\d')) { $qty++ }
            if (($t -replace '[^A-Za-z]', '') -and ($t.ToUpper().Trim() -match $script:TiposPaquete)) { $tipo++ }
            if ($t -match '^\s*[Xx]{1,2}\s*$') { $equis++ }
        }
        $info += [pscustomobject]@{ K = $k; No = $no; Clase = $cl; NmfcS = $nmS; Nmfc6 = $nm6; Qty = $qty; Tipo = $tipo; X = $equis
            Letras = $(if ($no) { $sumaLetras / $no } else { 0 }); Ancho = $filas[0].Celdas[$k].Ancho; Usada = ($k -eq $colPeso) }
    }
    $frac = { param($c, [string]$campo) if ($c.No -gt 0) { $c.$campo / $c.No } else { 0 } }
    # renglon de total: la columna cuya suma da lo que dice el total es de cantidades
    $iTot = -1
    for ($i = 0; $i -lt $filas.Count; $i++) { foreach ($cc in $filas[$i].Celdas) { if (-not $cc.Vacia -and ([string]$cc.Texto) -match '(?i)\bTOTALS?\b') { $iTot = $i } } }
    foreach ($c in $info) {
        $c | Add-Member -NotePropertyName EsSuma -NotePropertyValue $false
        if ($iTot -lt 0 -or $filas[$iTot].Celdas[$c.K].Vacia) { continue }
        $tv = (Leer-Qty ([string]$filas[$iTot].Celdas[$c.K].Texto)).Valor
        if ($tv -eq $null -or $tv -eq 0) { continue }
        $sm = 0; $n = 0
        for ($i = 0; $i -lt $filas.Count; $i++) { if ($i -eq $iTot -or $filas[$i].Celdas[$c.K].Vacia) { continue }; $v = (Leer-Qty ([string]$filas[$i].Celdas[$c.K].Texto)).Valor; if ($v -ne $null) { $sm += $v; $n++ } }
        if ($n -ge 2 -and $sm -eq $tv) { $c.EsSuma = $true }
    }
    $rol = @{ Peso = $colPeso; HM = -1; Desc = -1; Nmfc = -1; Clase = -1; PkgQty = -1; PkgTipo = -1; HuQty = -1; HuTipo = -1 }
    $usada = @{}; $usada[$colPeso] = $true
    $libres = { @($info | Where-Object { -not $usada.ContainsKey($_.K) -and $_.No -gt 0 }) }
    $tomar = { param([string]$r, $c) if ($c -and $rol[$r] -lt 0) { $rol[$r] = $c.K; $usada[$c.K] = $true } }
    $script:RolesComo = @()        # (para el reporte: como se encontro cada una)
    $anota = { param([string]$r, [string]$como) if ($rol[$r] -ge 0) { $script:RolesComo += "$r=$como" } }

    # ---- 1) por lo que trae (solo si es claro: un solo candidato) ----
    $c = @(& $libres | Where-Object { (& $frac $_ 'Clase') -ge 0.8 -and -not $_.EsSuma })
    if ($c.Count -eq 1) { & $tomar 'Clase' $c[0]; & $anota 'Clase' 'content' }
    $c = @(& $libres | Where-Object { ((& $frac $_ 'NmfcS') -ge 0.6 -or (& $frac $_ 'Nmfc6') -ge 0.8) -and -not $_.EsSuma })
    if ($c.Count -eq 1) { & $tomar 'Nmfc' $c[0]; & $anota 'Nmfc' 'content' }
    $c = @(& $libres | Where-Object { $_.Letras -ge 8 } | Sort-Object Letras -Descending)
    if ($c.Count -eq 1 -or ($c.Count -gt 1 -and $c[0].Letras -ge 1.5 * $c[1].Letras)) { & $tomar 'Desc' $c[0]; & $anota 'Desc' 'content' }

    # ---- 2) por el encabezado (lo que falto o quedo empatado) ----
    foreach ($r in @('Clase', 'Nmfc', 'Desc')) {
        if ($rol[$r] -ge 0) { continue }
        $c = @($info | Where-Object { -not $usada.ContainsKey($_.K) -and (& $tiene $_.K $r) })
        # (y que lo que trae no lo contradiga)
        if ($r -eq 'Clase') { $c = @($c | Where-Object { $_.No -eq 0 -or (& $frac $_ 'Clase') -ge 0.5 }) }
        if ($r -eq 'Nmfc')  { $c = @($c | Where-Object { $_.No -eq 0 -or ((& $frac $_ 'NmfcS') + (& $frac $_ 'Nmfc6')) -ge 0.5 }) }
        if ($r -eq 'Desc')  { $c = @($c | Where-Object { $_.Letras -ge 3 }) }
        if ($c.Count -ge 1) { & $tomar $r $c[0]; & $anota $r 'label' }
    }

    # ---- 3) por descarte (lo que todavia falte) ----
    if ($rol.Clase -lt 0) {
        $c = @(& $libres | Where-Object { (& $frac $_ 'Clase') -ge 0.5 -and -not $_.EsSuma } | Sort-Object @{ e = { & $frac $_ 'Clase' } } -Descending)
        if ($c.Count -ge 1) { & $tomar 'Clase' $c[0]; & $anota 'Clase' 'elimination' }
    }
    if ($rol.Nmfc -lt 0) {
        $c = @(& $libres | Where-Object { ((& $frac $_ 'NmfcS') + (& $frac $_ 'Nmfc6')) -ge 0.5 } | Sort-Object @{ e = { (& $frac $_ 'NmfcS') + (& $frac $_ 'Nmfc6') } } -Descending)
        if ($c.Count -ge 1) { & $tomar 'Nmfc' $c[0]; & $anota 'Nmfc' 'elimination' }
    }
    if ($rol.Desc -lt 0) {
        $c = @(& $libres | Where-Object { $_.Letras -ge 4 -and (& $frac $_ 'Tipo') -lt 0.6 } | Sort-Object Letras -Descending)
        if ($c.Count -ge 1) { & $tomar 'Desc' $c[0]; & $anota 'Desc' 'elimination' }
    }

    # ---- H.M.: angosta, vacia o con X (o el encabezado lo dice) ----
    $hm = $null
    $angostas = @($info | Where-Object { -not $usada.ContainsKey($_.K) -and $_.Ancho -lt [Math]::Max(18, $altoTexto * 3.2) -and ($_.No -eq 0 -or $_.X -eq $_.No) })
    $hm = $angostas | Where-Object { & $tiene $_.K 'HM' } | Select-Object -First 1
    if (-not $hm) { $hm = $angostas | Where-Object { $_.X -gt 0 } | Select-Object -First 1 }
    if (-not $hm) { $hm = $angostas | Where-Object { $_.K -gt $colPeso } | Sort-Object K | Select-Object -First 1 }
    if ($hm) { $rol.HM = $hm.K; $usada[$hm.K] = $true }

    # ---- cantidades y tipos ----
    $qtys = @(& $libres | Where-Object { ((& $frac $_ 'Qty') -ge 0.6 -or (& $tiene $_.K 'Qty')) -and -not (& $tiene $_.K 'Tipo') })
    foreach ($q in $qtys) { $usada[$q.K] = $true }
    $tipos = @(& $libres | Where-Object { (& $frac $_ 'Tipo') -ge 0.6 -or (& $tiene $_.K 'Tipo') })
    foreach ($t in $tipos) { $usada[$t.K] = $true }
    # en cuantos renglones con descripcion trae algo cada columna
    $de = if ($rol.Desc -ge 0) { $rol.Desc } else { -1 }
    $conDesc = { param([int]$k) $n = 0; if ($de -ge 0) { foreach ($f in $filas) { if (-not $f.Celdas[$de].Vacia -and -not $f.Celdas[$k].Vacia -and ([string]$f.Celdas[$de].Texto) -notmatch '(?i)\bTOTAL') { $n++ } } }; $n }
    $sumaCol = { param([int]$k) $s = 0; foreach ($f in $filas) { if (-not $f.Celdas[$k].Vacia) { $q = Leer-Qty ([string]$f.Celdas[$k].Texto); if ($q.Valor -ne $null) { $s += $q.Valor } } }; $s }
    $pq = $null; $hq = $null
    # 1) encabezado: HANDLING / PALLET / SKID = pallets; PACKAGE / PIECES / CARTON = paquetes
    $porEnc = @($qtys | Where-Object { (& $tiene $_.K 'Pkg') -and -not (& $tiene $_.K 'HU') })
    $porEncHu = @($qtys | Where-Object { (& $tiene $_.K 'HU') -and -not (& $tiene $_.K 'Pkg') })
    if ($porEnc.Count -eq 1) { $pq = $porEnc[0] }
    if ($porEncHu.Count -eq 1) { $hq = $porEncHu[0] }
    # 2) lo que trae: paquetes = la que viene en los renglones con descripcion; pallets = el numero mas chico
    if (-not $pq) { $pq = $qtys | Where-Object { $_ -ne $hq } | Sort-Object @{ e = { & $conDesc $_.K } }, @{ e = { & $sumaCol $_.K } } -Descending | Select-Object -First 1 }
    if (-not $hq) { $hq = $qtys | Where-Object { $_ -ne $pq } | Sort-Object @{ e = { & $sumaCol $_.K } } | Select-Object -First 1 }
    # sin encabezado que lo diga: si los "pallets" son mas que las "cajas" en los mismos renglones, estan al reves
    if ($pq -and $hq -and $porEnc.Count -ne 1 -and $porEncHu.Count -ne 1) {
        $mas = 0; $menos = 0
        foreach ($f in $filas) {
            if ($f.Celdas[$pq.K].Vacia -or $f.Celdas[$hq.K].Vacia) { continue }
            $a = (Leer-Qty ([string]$f.Celdas[$pq.K].Texto)).Valor; $b = (Leer-Qty ([string]$f.Celdas[$hq.K].Texto)).Valor
            if ($a -eq $null -or $b -eq $null) { continue }
            if ($b -gt $a) { $mas++ } elseif ($b -lt $a) { $menos++ }
        }
        if ($mas -gt $menos) { $t = $pq; $pq = $hq; $hq = $t }
    }
    # 3) descarte: si no hay columna de cantidad, una columna libre con puros numeros
    if (-not $pq) {
        $c = @(& $libres | Where-Object { (& $frac $_ 'Qty') -ge 0.5 })
        if ($c.Count -eq 1) { $pq = $c[0]; $usada[$pq.K] = $true }
    }
    # tipos: el que viene en los renglones con descripcion es el de paquetes
    $pt = $null; $ht = $null
    if ($tipos.Count -eq 1) { if ($hq -and $pq -and [Math]::Abs($tipos[0].K - $hq.K) -lt [Math]::Abs($tipos[0].K - $pq.K) -and (& $conDesc $tipos[0].K) -eq 0) { $ht = $tipos[0] } else { $pt = $tipos[0] } }
    elseif ($tipos.Count -ge 2) {
        $ord = @($tipos | Sort-Object @{ e = { & $conDesc $_.K } } -Descending)
        $pt = $ord[0]; $ht = $ord[1]
    }
    if ($pq) { $rol.PkgQty = $pq.K }; if ($hq) { $rol.HuQty = $hq.K }
    if ($pt) { $rol.PkgTipo = $pt.K }; if ($ht) { $rol.HuTipo = $ht.K }
    return @{ Rol = $rol; Formato = $formato }
}

# Columnas que traen "cantidad TIPO descripcion" juntas (tablas sin rayas con
# columnas pegadas): se parten en 3 columnas virtuales. Col = la columna real
# (para pintar).
function Partir-Celdas($filas) {
    $nCol = $filas[0].Celdas.Count
    $patron = '^\s*(\d[\d,\.]*)\s+([A-Za-z]{1,9}\.?)\s+(.{2,})$'
    $partir = @()
    for ($k = 0; $k -lt $nCol; $k++) {
        $no = 0; $si = 0
        foreach ($f in $filas) {
            $c = $f.Celdas[$k]; if ($c.Vacia -or -not $c.Texto) { continue }
            $no++
            if ($c.Texto -match $patron) { $m2 = $matches[2]; if ($m2.ToUpper() -match $script:TiposPaquete) { $si++ } }
        }
        if ($no -ge 2 -and $si -ge [Math]::Ceiling($no * 0.6)) { $partir += $k }
    }
    if ($partir.Count -eq 0) { return $filas }
    $r = @()
    foreach ($f in $filas) {
        $nuevas = @()
        for ($k = 0; $k -lt $nCol; $k++) {
            $c = $f.Celdas[$k]
            if ($partir -notcontains $k) { $nuevas += $c; continue }
            $q = ''; $t = ''; $d = [string]$c.Texto; $q2 = ''; $t2 = ''; $d2 = [string]$c.Texto2
            if (-not $c.Vacia -and $c.Texto -match $patron) {
                $m1 = $matches[1]; $m2 = $matches[2]; $m3 = $matches[3]      # (antes de otro -match)
                if ($m2.ToUpper() -match $script:TiposPaquete) { $q = $m1; $t = $m2; $d = $m3 }
            }
            if (-not $c.Vacia -and $c.Texto2 -match $patron) { $q2 = $matches[1]; $t2 = $matches[2]; $d2 = $matches[3] }
            $hecho = { param($tx, $tx2, [int]$ancho) [pscustomobject]@{ Col = $c.Col; Vacia = (-not $tx); Texto = $tx; Texto2 = $tx2; Seguro = $c.Seguro; Glifos = 0; Ancho = $ancho } }
            $nuevas += (& $hecho $q $q2 60)
            $nuevas += (& $hecho $t $t2 60)
            $nuevas += (& $hecho $d $d2 $c.Ancho)
        }
        $r += [pscustomobject]@{ Celdas = $nuevas }
    }
    return ,$r
}

# NMFC y clase en la misma celda: "48580-2 / 55", "48580/2/55", "45980 / 125",
# "116030-2/92.5" (o al reves "55 / 48580-2"). La clase va al final (o al
# principio), tiene que ser una de las 18; lo demas es el NMFC (con su sub).
# Asi la diagonal del sub (48580/2) no se confunde con la que separa.
function Separar-NmfcClase([string]$t) {
    $s = ($t -replace '\s+', ' ').Trim().Trim('|', '[', ']')
    $pn = '[0-9OQIl]{4,6}(?:\s*[\.\-_/]\s*[0-9OQIl]{1,2})?'
    $pc = '(?:CL(?:ASS)?\.?\s*)?\d{2,3}(?:\.\d)?(?:\s*CL)?'
    $sep = '\s*(?:[/\|,;]|\s)\s*'
    foreach ($orden in 1, 2) {
        $re = if ($orden -eq 1) { "^(?<n>$pn)$sep(?<c>$pc)$" } else { "^(?<c>$pc)$sep(?<n>$pn)$" }
        if ($s -match $re) {
            $n = $matches['n']; $c = $matches['c']
            if ((Leer-Nmfc $n).Ok -and (Leer-Clase $c).Ok) { return @{ Ok = $true; Nmfc = $n.Trim(); Clase = $c.Trim() } }
        }
    }
    return @{ Ok = $false; Nmfc = ''; Clase = '' }
}

# Columna "NMFC / CLASS" (las dos en una celda): se parte en 2 columnas
# virtuales (Col = la real, para pintar)
function Partir-NmfcClase($filas) {
    $nCol = $filas[0].Celdas.Count
    $partir = @()
    for ($k = 0; $k -lt $nCol; $k++) {
        $no = 0; $si = 0
        foreach ($f in $filas) {
            $c = $f.Celdas[$k]; if ($c.Vacia -or -not $c.Texto -or ([string]$c.Texto) -match '(?i)TOTAL') { continue }
            $no++
            if ((Separar-NmfcClase ([string]$c.Texto)).Ok) { $si++ }
        }
        if ($si -ge 1 -and $si -ge [Math]::Ceiling($no * 0.6)) { $partir += $k }
    }
    if ($partir.Count -eq 0) { return ,$filas }
    $partes = { param([string]$t)
        $a = Separar-NmfcClase $t
        if ($a.Ok) { return @($a.Nmfc, $a.Clase) }
        if ((Leer-Clase $t).Ok -and ($t -replace '\D', '').Length -le 3) { return @('', $t) }
        return @($t, '')
    }
    $r = @()
    foreach ($f in $filas) {
        $nuevas = @()
        for ($k = 0; $k -lt $nCol; $k++) {
            $c = $f.Celdas[$k]
            if ($partir -notcontains $k) { $nuevas += $c; continue }
            $p1 = if ($c.Vacia) { @('', '') } else { & $partes ([string]$c.Texto) }
            $p2 = if ($c.Vacia) { @('', '') } else { & $partes ([string]$c.Texto2) }
            foreach ($j in 0, 1) {
                $nuevas += [pscustomobject]@{ Col = $c.Col; Vacia = (-not $p1[$j]); Texto = $p1[$j]; Texto2 = $p2[$j]; Seguro = $c.Seguro; Glifos = 0; Ancho = $c.Ancho }
            }
        }
        $r += [pscustomobject]@{ Celdas = $nuevas }
    }
    return ,$r
}

# 22208 -> "22,208" (sin depender del idioma de Windows)
function Fmt-Num($v) {
    if ($v -eq $null) { return '?' }
    $inv = [System.Globalization.CultureInfo]::InvariantCulture
    $d = [double]$v
    if ($d -ne [Math]::Floor($d)) { return $d.ToString('#,0.##', $inv) }
    return $d.ToString('#,0', $inv)
}

function Lineas-Txt([int]$n) { if ($n -eq 1) { return '1 line' } else { return "$n lines" } }

# Lineas para el ERP (orden de Edit Details). Linea 1: pallets | SKD | STC (solo
# si trae piezas); las demas: * siempre; sin piezas no va CTN. $todasConAsterisco =
# la linea 1 ya la hiciste tu (hazmat primero). Al final la del pallet.
# Sin clase = znoclass; sin descripcion = no desc. Clase o descripcion que no se
# entendio (ClaseEstado / DescEstado = 'mano'): ese campo lo escribes tu (Mano =
# numero de campo: 5 = descripcion, 7 = clase; FILL se para ahi).
function Lineas-ERP($its, $piezas, [bool]$todasConAsterisco, $pallet, $pesoPallet) {
    $r = @(); $k = 0
    foreach ($it in $its) {
        $k++
        $qt = if ($it.QtyTexto -match '\d' -and $it.Qty.Valor -ne $null) { "$($it.Qty.Texto)" } else { '' }
        $mano = @()
        $cl = if ($it.Clase.Ok) { $it.Clase.Valor } else { "$($it.Clase.Valor)" }
        if ($it.ClaseEstado -eq 'vacia') { $cl = 'znoclass' } elseif ($it.ClaseEstado -eq 'mano') { $mano += 7 }
        $de = $it.Desc
        if ($it.DescEstado -eq 'vacia') { $de = 'no desc' } elseif ($it.DescEstado -eq 'mano') { $mano += 5 }
        $l = [ordered]@{ N = "$k"; Pieces = ''; Pkg = ''; Qual = '*'; QPcs = $qt; QPkg = $(if ($qt) { 'CTN' } else { '' }); Desc = $de
                         Weight = "$($it.Peso)"; Clase = $cl; Nmfc = $(if ($it.Nmfc.Ok) { $it.Nmfc.Valor } else { "$($it.Nmfc.Valor)" }); Fila = $it.N
                         Mano = @($mano | Sort-Object); ClaseLeida = "$($it.ClaseTexto)"; DescLeida = "$($it.Desc)" }
        if ($k -eq 1 -and -not $todasConAsterisco) { $l.Pieces = $(if ($piezas) { "$piezas" } else { '' }); $l.Pkg = 'SKD'; $l.Qual = $(if ($qt) { 'STC' } else { '' }) }
        $r += [pscustomobject]$l
    }
    if ($pesoPallet -gt 0) {
        $r += [pscustomobject][ordered]@{ N = 'P'; Pieces = ''; Pkg = ''; Qual = ''; QPcs = ''; QPkg = ''; Desc = ''; Weight = "$pesoPallet"; Clase = 'PALLET'; Nmfc = ''; Fila = $pallet[0].N; Mano = @(); ClaseLeida = ''; DescLeida = '' }
    }
    return $r
}

# Candados de clase y descripcion (comun auto/manual)
function Candados-ClaseDesc($its, [scriptblock]$agregar, [bool]$hayClase = $true, [bool]$hayDesc = $true) {
    $lista = { param($q, [string]$que) (($q | ForEach-Object { $t = [string]$_.$que; if ($t) { "row $($_.N) '$t'" } else { "row $($_.N)" } }) -join ', ') }
    if (-not $hayClase) { & $agregar 'i' 'CLASS' 'no class column: ZNOCLASS in every line' }
    else {
        $cv = @($its | Where-Object { $_.ClaseEstado -eq 'vacia' }); $cm = @($its | Where-Object { $_.ClaseEstado -eq 'mano' })
        if ($cm.Count -gt 0) { & $agregar 'TY' 'CLASS' ('not read: ' + (& $lista $cm 'ClaseTexto') + '  -> YOU TYPE IT when FILL stops there, then Right Shift') }
        if ($cv.Count -gt 0) { & $agregar 'i' 'CLASS' ('empty in ' + (($cv | ForEach-Object { "row $($_.N)" }) -join ', ') + '  -> ZNOCLASS') }
        if ($cm.Count -eq 0 -and $cv.Count -eq 0) { & $agregar 'OK' 'CLASS' 'all valid' }
    }
    if (-not $hayDesc) { & $agregar 'i' 'DESCRIPTION' 'no description column: NO DESC in every line' }
    else {
        $dv = @($its | Where-Object { $_.DescEstado -eq 'vacia' }); $dm = @($its | Where-Object { $_.DescEstado -eq 'mano' })
        if ($dm.Count -gt 0) { & $agregar 'TY' 'DESCRIPTION' ('not sure: ' + (& $lista $dm 'Desc') + '  -> YOU TYPE IT when FILL stops there, then Right Shift') }
        if ($dv.Count -gt 0) { & $agregar 'i' 'DESCRIPTION' ('empty in ' + (($dv | ForEach-Object { "row $($_.N)" }) -join ', ') + '  -> NO DESC') }
    }
}

# Como se ve un campo en el panel / reporte: (YOU) = lo escribes tu
function Campo-Ver($l, [int]$i, [string]$v) {
    if (@($l.Mano) -contains $i) { if ($i -eq 5) { return ('(YOU) ' + $l.DescLeida) } else { return '(YOU)' } }
    return $v
}

# filas: @( @{ Celdas = @( @{ Col; Vacia; Texto; Glifos; Ancho } ... ) } ... )
function Interpretar($filas, [int]$colPeso, [int]$altoTexto, $encab = $null) {
    $r = [ordered]@{ Lineas = @(); LineasHazmat = @(); Candados = @(); Tipos = @(); Roles = @{}; Formato = ''; Como = ''; Filas = $null; Hazmat = $false; HazmatFila = 0; HazmatTexto = ''; HazmatCol = -1; Pintar = @(); Bien = $false }
    if (-not $filas -or $filas.Count -eq 0 -or $colPeso -lt 0) { $r.Candados = @(,@('NO', 'Nothing was read')); return $r }
    $nCol = $filas[0].Celdas.Count
    $txt = { param($f, $k) if ($k -ge 0 -and $k -lt $f.Celdas.Count -and -not $f.Celdas[$k].Vacia) { [string]$f.Celdas[$k].Texto } else { '' } }
    # la celda tiene tinta y las lecturas coincidieron
    $seg = { param($f, $k) $k -ge 0 -and $k -lt $f.Celdas.Count -and -not $f.Celdas[$k].Vacia -and $f.Celdas[$k].Seguro }

    # ---- que es cada columna: por lo que trae (y el encabezado de pista) ----
    $nAntes = $filas[0].Celdas.Count
    $filas = Partir-Celdas $filas
    $filas = Partir-NmfcClase $filas
    if ($filas[0].Celdas.Count -ne $nAntes) {
        # la columna del peso se recorre si se partio alguna columna a su izquierda
        for ($k = 0; $k -lt $filas[0].Celdas.Count; $k++) { if ($filas[0].Celdas[$k].Col -eq $colPeso -and $filas[0].Celdas[$k].Ancho -ne 60) { $colPeso = $k; break } }
        $encab = $null      # (el encabezado ya no coincide columna por columna)
    }
    $r.Filas = $filas
    $rc = Roles-Columnas $filas $colPeso $altoTexto $encab
    $rol = $rc.Rol
    $r.Formato = $rc.Formato
    $r.Como = ($script:RolesComo -join ', ')
    $r.Roles = $rol

    # ---- tipo de cada fila ----
    $items = @(); $hus = @(); $total = $null
    for ($i = 0; $i -lt $filas.Count; $i++) {
        $f = $filas[$i]
        $todo = (($f.Celdas | Where-Object { -not $_.Vacia } | ForEach-Object { $_.Texto }) -join ' ')
        $p = Leer-Peso (& $txt $f $rol.Peso)
        $d = (& $txt $f $rol.Desc)
        $n = Leer-Nmfc (& $txt $f $rol.Nmfc)
        $c = Leer-Clase (& $txt $f $rol.Clase)
        $fila = [pscustomobject]@{ N = $i + 1; Tipo = '?'; Peso = $p.Valor; PesoTexto = (& $txt $f $rol.Peso); PesoGlifos = $(if ($rol.Peso -ge 0) { $f.Celdas[$rol.Peso].Glifos } else { 0 })
            Qty = (Leer-Qty (& $txt $f $rol.PkgQty)); QtyTexto = (& $txt $f $rol.PkgQty); QtyGlifos = $(if ($rol.PkgQty -ge 0) { $f.Celdas[$rol.PkgQty].Glifos } else { 0 })
            Desc = $d.ToUpper().Trim(); Nmfc = $n; Clase = $c; HuQty = (Leer-Qty (& $txt $f $rol.HuQty)); HuTipo = (& $txt $f $rol.HuTipo)
            HM = (& $txt $f $rol.HM); Todo = $todo; EsPalletDesc = $false; Hazmat = $false; HazmatTexto = ''; HazmatCol = -1
            ClaseTexto = (& $txt $f $rol.Clase); ClaseEstado = 'ok'; DescEstado = 'ok'
            SegPeso = (& $seg $f $rol.Peso); SegQty = (& $seg $f $rol.PkgQty); SegDesc = (& $seg $f $rol.Desc)
            SegNmfc = (& $seg $f $rol.Nmfc); SegClase = (& $seg $f $rol.Clase); SegHuQty = (& $seg $f $rol.HuQty); Celdas = $f.Celdas }
        # renglon de mercancia = trae cantidad de paquetes, descripcion, NMFC o clase
        if ($todo -match '(?i)\bTOTAL') { $fila.Tipo = 'TOTAL'; $total = $fila }
        elseif ($d -match $script:DescPallet -and -not ($n.Ok -and $n.Valor) -and -not $c.Ok) {
            # descripcion PALLET / PALLET WEIGHT = renglon del peso del pallet (si trae cantidad, son los pallets)
            $fila.Tipo = 'HU'; $fila.EsPalletDesc = $true
            if (-not $fila.HuQty.Valor -and $fila.Qty.Valor -is [int]) { $fila.HuQty = $fila.Qty }
            $hus += $fila
        }
        elseif ($fila.QtyTexto -or (Cuenta-Letras $d) -ge 3 -or ($n.Ok -and $n.Valor) -or $c.Ok) { $fila.Tipo = 'ITEM'; $items += $fila }
        else { $fila.Tipo = 'HU'; $hus += $fila }
        # hazmat de ESTA fila: X en H.M. (o X sola en una columna angosta) o numero UN/NA
        $un = Texto-Hazmat $todo
        $xc = $null
        foreach ($cc in $f.Celdas) { if (-not $cc.Vacia -and $cc.Ancho -lt [Math]::Max(18, $altoTexto * 3.2) -and ([string]$cc.Texto) -match '^\s*[Xx]{1,2}\s*$') { $xc = $cc; break } }
        if ($fila.HM -match '(?i)x') { $fila.Hazmat = $true; $fila.HazmatTexto = 'X in H.M.'; $fila.HazmatCol = $f.Celdas[$rol.HM].Col }
        elseif ($xc) { $fila.Hazmat = $true; $fila.HazmatTexto = 'X in H.M.'; $fila.HazmatCol = $xc.Col }
        elseif ($un) {
            $fila.Hazmat = $true; $fila.HazmatTexto = $un
            foreach ($cc in $f.Celdas) { if (-not $cc.Vacia -and (Texto-Hazmat ([string]$cc.Texto))) { $fila.HazmatCol = $cc.Col; break } }
        }
        if ($fila.Hazmat -and -not $r.Hazmat) { $r.Hazmat = $true; $r.HazmatFila = $fila.N; $r.HazmatTexto = $fila.HazmatTexto; $r.HazmatCol = $fila.HazmatCol }
        $r.Tipos += $fila
    }
    # sin la palabra TOTAL: la ultima fila es el total si su peso = suma de las demas
    if (-not $total -and $r.Tipos.Count -ge 3) {
        $u = $r.Tipos[$r.Tipos.Count - 1]
        $suma = 0; foreach ($q in $r.Tipos) { if ($q -ne $u -and $q.Peso) { $suma += $q.Peso } }
        if ($u.Peso -and $u.Peso -eq $suma) { $u.Tipo = 'TOTAL'; $total = $u; $items = @($items | Where-Object { $_ -ne $u }); $hus = @($hus | Where-Object { $_ -ne $u }) }
    }
    $pallet = @($hus | Where-Object { $_.Peso -and $_.Peso -gt 0 })
    $palletRaro = @($pallet | Where-Object { (Cuenta-Letras $_.HuTipo) -lt 2 -and -not $_.EsPalletDesc })
    $pesoPallet = 0; foreach ($q in $pallet) { $pesoPallet += $q.Peso }
    # hazmat: esas lineas las haces tu PRIMERO (con la linea 1: pallets SKD STC);
    # FILL las marca en rojo y teclea las demas, todas con *
    $itemsHz = @($items | Where-Object { $_.Hazmat })
    $itemsFill = @($items | Where-Object { -not $_.Hazmat })
    $hzOtras = @($r.Tipos | Where-Object { $_.Hazmat -and $_.Tipo -ne 'ITEM' })
    # pallets (Pieces de la linea 1): del total, si no de las filas de handling units
    $piezas = $null
    $huItems = 0; foreach ($q in $items) { if ($q.HuQty.Valor -is [int]) { $huItems += $q.HuQty.Valor } }
    if ($total -and $total.HuQty.Valor) { $piezas = $total.HuQty.Valor }
    elseif ($pallet.Count -gt 0) { $s = 0; foreach ($q in $pallet) { if ($q.HuQty.Valor) { $s += $q.HuQty.Valor } }; if ($s -gt 0) { $piezas = $s } }
    elseif ($huItems -gt 0) { $piezas = $huItems }
    # si no: "TOTAL 3 PLTS" / "2 PALLETS" escrito en el renglon de total
    $palTexto = $null
    if (-not $piezas -and $total) {
        foreach ($cc in $total.Celdas) {
            if ($cc.Vacia -or ([string]$cc.Texto) -notmatch $script:PalabrasPallet) { continue }
            $v = [int]$matches[1]
            if ($v -gt 0) { $piezas = $v; $palTexto = $cc; break }
        }
    }

    # clase / descripcion: vacia (znoclass / no desc), bien, o la escribes tu (no se entendio)
    foreach ($it in $items) {
        $it.ClaseEstado = if (-not ([string]$it.ClaseTexto).Trim()) { 'vacia' } elseif ($it.Clase.Ok -and $it.SegClase) { 'ok' } else { 'mano' }
        $it.DescEstado = if (-not $it.Desc) { 'vacia' } elseif ($it.SegDesc -and (Cuenta-Letras $it.Desc) -ge 2) { 'ok' } else { 'mano' }
    }

    # ---- lineas del ERP ----
    $r.Lineas = @(Lineas-ERP $itemsFill $piezas ($itemsHz.Count -gt 0) $pallet $pesoPallet)
    $r.LineasHazmat = @(Lineas-ERP $itemsHz $piezas $false @() 0 | ForEach-Object { $_.N = 'HZ'; $_ })

    # ---- candados ----  (OK = bien, NO = mal, ?? = no se pudo revisar, i = solo aviso, HZ = hazmat: las haces tu,
    #                      TY = ese campo lo escribes tu cuando FILL llegue ahi)
    $c = New-Object System.Collections.ArrayList
    $agregar = { param($e, $etq, $t, $det = '') [void]$c.Add(@($e, ('{0,-11} {1}' -f $etq, $t), [string]$det)) }
    if ($r.Formato -eq 'generic' -and $script:FillSoloConocidos) { & $agregar 'NO' 'FORMAT' 'not in the list (FILL only for known formats)' }
    $faltan = @(); foreach ($nombreRol in @('PkgQty', 'Desc', 'Clase', 'Nmfc')) { if ($rol[$nombreRol] -lt 0) { $faltan += @{ Desc = 'description'; Nmfc = 'NMFC'; Clase = 'class'; PkgQty = 'Q pieces' }[$nombreRol] } }
    if ($faltan.Count -gt 0) { & $agregar 'NO' 'COLUMNS' ('not found: ' + ($faltan -join ', ') + '  (PICK COLUMNS to point them out)') }
    if ($items.Count -eq 0) { & $agregar 'NO' 'ROWS' 'no item rows found' }
    elseif ($r.Lineas.Count -eq 0) { & $agregar 'NO' 'ROWS' 'nothing to type (all item rows are hazmat)' }
    # pesos: todas las filas de mercancia (tambien las hazmat) + pallet = GRAND TOTAL
    $sumaP = 0; $faltaPeso = $false
    foreach ($it in $items) { if ($it.Peso -ne $null) { $sumaP += $it.Peso } else { $faltaPeso = $true } }
    $detalle = 'weights: ' + (($items | ForEach-Object { if ($_.Peso -ne $null) { Fmt-Num $_.Peso } else { '?' } }) -join ' + ')
    if ($pesoPallet -gt 0) { $detalle += " + pallet $(Fmt-Num $pesoPallet)" }
    $sumaTodo = $sumaP + $pesoPallet
    $cuenta = (Lineas-Txt $items.Count) + $(if ($pesoPallet -gt 0) { " + pallet $(Fmt-Num $pesoPallet)" } else { '' }) + " = $(Fmt-Num $sumaTodo)"
    if (-not $total -or $total.Peso -eq $null) { & $agregar '??' 'WEIGHTS' "$cuenta  |  NO GRAND TOTAL (not checked)" $detalle }
    elseif (-not $faltaPeso -and $sumaTodo -eq $total.Peso) { & $agregar 'OK' 'WEIGHTS' "$cuenta  |  total $(Fmt-Num $total.Peso)" $detalle }
    else {
        $dif = $total.Peso - $sumaTodo
        $extra = if ($pesoPallet -eq 0 -and $dif -gt 0) { '  (pallet weight row above the first row? start on the FIRST weight of the table)' } else { '' }
        & $agregar 'NO' 'WEIGHTS' "$cuenta  |  total $(Fmt-Num $total.Peso)  |  DIFF $(Fmt-Num $dif)$extra" $detalle
    }
    $sumaQ = 0; $faltaQ = $false
    # (celda de piezas vacia = esa linea no trae piezas; con algo que no es numero = falta)
    foreach ($it in $items) { if ($it.Qty.Valor -ne $null -and $it.Qty.Valor -is [int]) { $sumaQ += $it.Qty.Valor } elseif ($it.QtyTexto) { $faltaQ = $true } }
    $detQ = 'pieces: ' + (($items | ForEach-Object { if ($_.Qty.Valor -ne $null) { Fmt-Num $_.Qty.Valor } elseif ($_.QtyTexto) { '?' } else { '-' } }) -join ' + ')
    # total de piezas: su columna, o "431 CTN" escrito en el renglon de total
    $totQ = $null
    if ($total) {
        $totQ = $total.Qty.Valor
        if ($totQ -eq $null) { foreach ($cc in $total.Celdas) { if (-not $cc.Vacia -and ([string]$cc.Texto) -match $script:PalabrasPiezas) { $totQ = [int]($matches[1] -replace ',', ''); break } } }
    }
    $cuentaQ = "$(Lineas-Txt $items.Count) = $(Fmt-Num $sumaQ)" + $(if ($faltaQ) { ' (+ ? not read)' } else { '' })
    if ($totQ -eq $null) { & $agregar '??' 'PIECES' "$cuentaQ  |  no total to check" $detQ }
    elseif (-not $faltaQ -and $sumaQ -eq $totQ) { & $agregar 'OK' 'PIECES' "$cuentaQ  |  total $(Fmt-Num $totQ)" $detQ }
    else { & $agregar 'NO' 'PIECES' "$cuentaQ  |  total $(Fmt-Num $totQ)  |  DIFF $(Fmt-Num ($totQ - $sumaQ))" $detQ }
    # pallets: el renglon de total y el de handling units tienen que decir lo mismo
    $huSuma = 0; foreach ($q in $pallet) { if ($q.HuQty.Valor) { $huSuma += $q.HuQty.Valor } }
    if ($huSuma -eq 0) { $huSuma = $huItems }          # (formatos con pallets por renglon)
    if (-not $piezas) { & $agregar 'NO' 'PALLETS' 'not found (Pieces of line 1)' }
    elseif ($total -and $total.HuQty.Valor -and $huSuma -gt 0 -and $huSuma -ne $total.HuQty.Valor) { & $agregar 'NO' 'PALLETS' "total row says $($total.HuQty.Valor), handling unit rows say $huSuma" }
    elseif ($total -and $total.HuQty.Valor -and $huSuma -gt 0) { & $agregar 'OK' 'PALLETS' "$piezas  (total row = handling unit rows)" }
    elseif ($total -and $total.HuQty.Valor -and $total.SegHuQty) { & $agregar 'OK' 'PALLETS' "$piezas  (total row, read twice)" }
    elseif ($palTexto -and $palTexto.Seguro) { & $agregar 'OK' 'PALLETS' "$piezas  (total row '$($palTexto.Texto)', read twice)" }
    elseif ($palTexto) { & $agregar 'NO' 'PALLETS' "not sure ('$($palTexto.Texto)' / '$($palTexto.Texto2)')" }
    else { & $agregar '??' 'PALLETS' "$piezas  (only one place to check)" }
    if ($pallet.Count -gt 1) { & $agregar 'NO' 'PALLET ROW' ("more than one: " + (($pallet | ForEach-Object { "row $($_.N) = $(Fmt-Num $_.Peso)" }) -join ', ')) }
    if ($palletRaro.Count -gt 0) { & $agregar 'NO' 'PALLET ROW' ("without a type: " + (($palletRaro | ForEach-Object { "row $($_.N)" }) -join ', ')) }
    # clase, NMFC y descripcion: solo de las lineas que teclea FILL (las hazmat las haces tu)
    Candados-ClaseDesc $itemsFill $agregar
    $malN = @($itemsFill | Where-Object { -not $_.Nmfc.Ok })
    if ($malN.Count -eq 0) { & $agregar 'OK' 'NMFC' 'all valid format' }
    else { & $agregar 'NO' 'NMFC' ('not valid: ' + (($malN | ForEach-Object { ("row $($_.N) '$($_.Nmfc.Valor)' $($_.Nmfc.Duda)").Trim() }) -join ', ')) }
    if ($itemsHz.Count -gt 0) {
        $que = (($itemsHz | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ')
        & $agregar 'HZ' 'HAZMAT' ("$que  -> TYPE THEM YOURSELF FIRST (line 1 = $(if ($piezas) { $piezas } else { '?' }) pallets SKD STC); FILL types the rest with *")
    }
    if ($hzOtras.Count -gt 0) { & $agregar 'NO' 'HAZMAT' ('mark in a row that is not an item: ' + (($hzOtras | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ') + ' - check by hand') }
    if ($itemsHz.Count -eq 0 -and $hzOtras.Count -eq 0) { & $agregar 'OK' 'HAZMAT' 'none (no X in H.M., no UN/NA number)' }
    # manchas de tinta contra caracteres leidos (solo aviso: el escaneo borroso junta o parte letras)
    $malG = @()
    foreach ($q in $r.Tipos) {
        $tp = ($q.PesoTexto -replace '\s', ''); if ($tp -and $q.PesoGlifos -and $tp.Length -lt $q.PesoGlifos - 1) { $malG += "row $($q.N) weight '$tp' ($($q.PesoGlifos) marks)" }
        $tq = ($q.QtyTexto -replace '\s', ''); if ($tq -and $q.QtyGlifos -and $tq.Length -lt $q.QtyGlifos - 1) { $malG += "row $($q.N) qty '$tq' ($($q.QtyGlifos) marks)" }
    }
    if ($malG.Count -gt 0) { & $agregar 'i' 'INK MARKS' ('differ, check: ' + ($malG -join '; ')) }
    $fix = @($r.Tipos | Where-Object { $_.Qty.Cambio -and $_.QtyTexto } | ForEach-Object { "row $($_.N) qty '$($_.QtyTexto)'" })
    if ($fix.Count -gt 0) { & $agregar 'i' 'DIGITS' ('letters read as digits: ' + ($fix -join '; ')) }
    # cada dato que se usa se leyo 2 veces y coincidio
    $dudas = @()
    $nombre = @{ Peso = 'weight'; Qty = 'qty'; Desc = 'description'; Nmfc = 'NMFC'; Clase = 'class'; HuQty = 'pallets' }
    $revisar = { param($q, [string[]]$campos)
        foreach ($cmp in $campos) {
            $k = $rol[$(if ($cmp -eq 'Qty') { 'PkgQty' } else { $cmp })]
            if ($k -lt 0 -or $q.Celdas[$k].Vacia) { continue }
            if (-not $q.('Seg' + $cmp)) { $script:dudasTmp += "row $($q.N) $($nombre[$cmp]) '$($q.Celdas[$k].Texto)' / '$($q.Celdas[$k].Texto2)'" }
        }
    }
    $script:dudasTmp = @()
    foreach ($it in $itemsFill) { & $revisar $it @('Peso', 'Qty', 'Nmfc') }      # (clase y descripcion dudosas: las escribes tu)
    foreach ($it in $itemsHz) { & $revisar $it @('Peso', 'Qty') }
    foreach ($q in $pallet) { & $revisar $q @('Peso', 'HuQty') }
    if ($total) { & $revisar $total @('Peso', 'Qty', 'HuQty') }
    $dudas = $script:dudasTmp
    if ($dudas.Count -eq 0) { & $agregar 'OK' 'READ TWICE' 'every value matched' }
    else { & $agregar 'NO' 'NOT SURE' ('two reads differ: ' + ($dudas -join '; ')) }

    # que se pinta (solo lo seguro y valido): fila (desde 0), columna, color.
    # Col -1 = toda la fila (hazmat)
    $pin = New-Object System.Collections.ArrayList
    $poner = { param($q, [string]$cmp, [string]$color, [bool]$ok)
        $k = $rol[$(if ($cmp -eq 'Qty') { 'PkgQty' } else { $cmp })]
        if ($k -ge 0 -and $ok -and $q.('Seg' + $cmp) -and -not $q.Celdas[$k].Vacia) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = $q.Celdas[$k].Col; Color = $color }) }
    }
    foreach ($it in $items) {
        & $poner $it 'Qty' 'qty' ($it.Qty.Valor -is [int])
        & $poner $it 'Peso' 'peso' ($it.Peso -ne $null)
        if ($it.Hazmat) { continue }
        & $poner $it 'Desc' 'desc' ((Cuenta-Letras $it.Desc) -ge 3)
        & $poner $it 'Nmfc' 'nmfc' ($it.Nmfc.Ok)
        & $poner $it 'Clase' 'clase' ($it.Clase.Ok)
    }
    foreach ($q in $pallet) { & $poner $q 'Peso' 'pallet' ($q.Peso -ne $null); & $poner $q 'HuQty' 'pallet' ($q.HuQty.Valor -is [int]) }
    if ($palTexto -and $palTexto.Seguro) { [void]$pin.Add(@{ Fila = $total.N - 1; Col = $palTexto.Col; Color = 'pallet' }) }
    if ($total) {
        & $poner $total 'HuQty' 'pallet' ($total.HuQty.Valor -is [int])
        & $poner $total 'Qty' 'qty' ($total.Qty.Valor -is [int])
        & $poner $total 'Peso' 'peso' ($total.Peso -ne $null)
    }
    foreach ($q in @($r.Tipos | Where-Object { $_.Hazmat })) {
        [void]$pin.Add(@{ Fila = $q.N - 1; Col = -1; Color = 'hazmat' })
        if ($q.HazmatCol -ge 0) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = $q.HazmatCol; Color = 'hazmat' }) }
    }
    $r.Pintar = @($pin)
    $r.Candados = $c
    $r.Bien = -not ($c | Where-Object { $_[0] -ne 'OK' -and $_[0] -ne 'i' -and $_[0] -ne 'HZ' -and $_[0] -ne 'TY' })
    return $r
}

# Texto del reporte (para la ventana y para copiar)
function Texto-Reporte($filas, $res, [string]$encabezado) {
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.AppendLine($encabezado)
    [void]$sb.AppendLine("FORMAT: $($res.Formato)   COLUMNS FOUND BY: $($res.Como)")
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('READ (columns left to right; {n} = ink marks; ? = the two reads differ)')
    $rolDe = @{}
    foreach ($k in $res.Roles.Keys) { if ($res.Roles[$k] -ge 0) { $rolDe[[int]$res.Roles[$k]] = $k } }
    $nc = if ($filas -and $filas.Count -gt 0) { $filas[0].Celdas.Count } else { 0 }
    $cab = @(); for ($k = 0; $k -lt $nc; $k++) { $cab += $(if ($rolDe.ContainsKey($k)) { $rolDe[$k] } else { '-' }) }
    [void]$sb.AppendLine(('      ' + ($cab -join ' | ')))
    for ($i = 0; $i -lt $filas.Count; $i++) {
        $t = $res.Tipos[$i]
        $cel = ($filas[$i].Celdas | ForEach-Object { if ($_.Vacia) { '' } elseif ($_.Seguro) { "$($_.Texto){$($_.Glifos)}" } else { "$($_.Texto)?[2nd: $($_.Texto2)]{$($_.Glifos)}" } }) -join ' | '
        [void]$sb.AppendLine(('{0,2} {1,-5} {2}' -f ($i + 1), $t.Tipo, $cel))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('ERP LINES (what would be typed, in the Edit Details order; Tab between fields)')
    $fl = '{0,-3}{1,-7}{2,-9}{3,-10}{4,-9}{5,-11}{6,-40}{7,-8}{8,-12}{9}'
    [void]$sb.AppendLine(($fl -f '#', 'Pieces', 'Pkg Type', 'Qualifier', 'Q Pieces', 'Q Pkg Type', 'Description', 'Weight', 'Charge Type', 'NMFC'))
    foreach ($l in @($res.LineasHazmat)) {
        if ($l) { [void]$sb.AppendLine(($fl -f $l.N, $l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, $l.Desc, $l.Weight, $l.Clase, $l.Nmfc) + "  <- row $($l.Fila) HAZMAT: you type it (first)") }
    }
    foreach ($l in $res.Lineas) {
        [void]$sb.AppendLine(($fl -f $l.N, $l.Pieces, $l.Pkg, $l.Qual, $l.QPcs, $l.QPkg, (Campo-Ver $l 5 $l.Desc), $l.Weight, (Campo-Ver $l 7 $l.Clase), $l.Nmfc))
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('CHECKS')
    foreach ($c in $res.Candados) {
        [void]$sb.AppendLine(('{0,-3} {1}' -f $c[0], $c[1]))
        if ($c.Count -gt 2 -and $c[2]) { [void]$sb.AppendLine(('                {0}' -f $c[2])) }
    }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine($(if ($res.Bien) { 'RESULT: ALL CHECKS OK' } else { 'RESULT: NOT READY - see checks' }))
    return $sb.ToString()
}

# Lineas del OCR (texto + centro y/x en el mosaico) -> texto de cada celda
# (regresa @{ columna -> texto }; no cambia las celdas)
function Textos-Por-Celda($celdas, $lineas) {
    $r = @{}
    foreach ($l in ($lineas | Sort-Object @{ e = { [Math]::Round($_.Y / 12) } }, X)) {
        $mejor = $null; $md = [double]::MaxValue
        foreach ($c in $celdas) {
            if ($c.Vacia) { continue }
            $d = if ($l.Y -lt $c.Y0) { $c.Y0 - $l.Y } elseif ($l.Y -gt $c.Y1) { $l.Y - $c.Y1 } else { 0 }
            if ($d -lt $md) { $md = $d; $mejor = $c }
        }
        if ($mejor -and $md -le 20) { $r[$mejor.Col] = (([string]$r[$mejor.Col]) + ' ' + $l.Texto).Trim() }
    }
    return $r
}
# Version vieja (pruebas): pone el texto en las celdas
function Asignar-Lineas($celdas, $lineas) {
    $t = Textos-Por-Celda $celdas $lineas
    foreach ($c in $celdas) { if (-not $c.Vacia) { $c.Texto = [string]$t[$c.Col] } }
}

# Lee un grupo de celdas (mosaico a la escala dada) -> @{ columna -> texto }
function Ocr-Celdas($cs, [int]$esc, [scriptblock]$ocr) {
    $lista = New-Object 'System.Collections.Generic.List[BandaCelda]'
    foreach ($c in $cs) { $lista.Add($c) }
    $w = 0; $h = 0; $e = 0
    $m = [BandaGuia]::Mosaico($lista, $esc, $script:OcrMaxDim, [ref]$w, [ref]$h, [ref]$e)
    return (Textos-Por-Celda $lista (& $ocr $m $w $h))
}

# Distancia de edicion (letras distintas) entre dos textos
function Distancia([string]$a, [string]$b) {
    $n = $a.Length; $m = $b.Length
    if ($n -eq 0) { return $m }; if ($m -eq 0) { return $n }
    $prev = New-Object int[] ($m + 1); $cur = New-Object int[] ($m + 1)
    for ($j = 0; $j -le $m; $j++) { $prev[$j] = $j }
    for ($i = 1; $i -le $n; $i++) {
        $cur[0] = $i
        for ($j = 1; $j -le $m; $j++) {
            $cost = if ($a[$i - 1] -ceq $b[$j - 1]) { 0 } else { 1 }
            $cur[$j] = [Math]::Min([Math]::Min($prev[$j] + 1, $cur[$j - 1] + 1), $prev[$j - 1] + $cost)
        }
        $t = $prev; $prev = $cur; $cur = $t
    }
    return $prev[$m]
}

# Las dos lecturas dicen lo mismo? Numeros y codigos: exactamente igual.
# Texto largo (descripcion): casi igual (1 letra de diferencia por cada 12).
function Acuerdo([string]$a, [string]$b) {
    $na = ($a.ToUpper() -replace '\s', '').TrimEnd('.', ',', ';', ':')
    $nb = ($b.ToUpper() -replace '\s', '').TrimEnd('.', ',', ';', ':')
    if (-not $na -or -not $nb) { return $false }
    if ($na -ceq $nb) { return $true }
    if ($na -match '^[\d,\.]+$' -and $nb -match '^[\d,\.]+$') {
        $pa = Leer-Peso $na; $pb = Leer-Peso $nb
        return ($pa.Valor -ne $null -and $pa.Valor -eq $pb.Valor)
    }
    if ((Cuenta-Letras $na) -ge 8) { return ((Distancia $na $nb) -le [Math]::Max(1, [int]($na.Length / 12))) }
    return $false
}

# Celdas de C# -> filas para Interpretar
function Filas-Para-Interpretar($todas) {
    $r = @()
    foreach ($cs in $todas) {
        $r += [pscustomobject]@{ Celdas = @($cs | ForEach-Object { [pscustomobject]@{ Col = $_.Col; Vacia = $_.Vacia; Texto = $_.Texto; Texto2 = $_.Texto2; Seguro = $_.Seguro; Glifos = $_.Glifos; Ancho = $_.U1 - $_.U0 } }) }
    }
    return ,$r
}

# ======================= LEER CON EL OCR (cache por fila) =======================
# $ocr = scriptblock { param([byte[]]$gris, [int]$w, [int]$h) ... } que regresa
# lineas @{ Texto; Y; X } (Y/X = centro/izquierda en la imagen). Asi el mismo
# codigo sirve con el OCR de Windows y en las pruebas.
# Cada fila se lee DOS veces (a dos tamanos). Si una celda no coincide, se lee
# sola una tercera vez; se queda lo que digan 2 de 3. Si no, no es segura.
function Leer-Visibles($guia, $cache, [scriptblock]$ocr) {
    $nuevas = 0
    for ($i = 0; $i -lt $guia.Filas.Count; $i++) {
        $f = $guia.Filas[$i]
        $esUltimaMarcada = $guia.Final -and $i -eq $guia.Filas.Count - 1
        if ($cache.ContainsKey($i) -and [Math]::Abs($cache[$i].Top - $f.Top) -lt 1.5 -and [Math]::Abs($cache[$i].Bot - $f.Bot) -lt 1.5 -and $cache[$i].Fin -eq $esUltimaMarcada) { continue }
        if ((-not $f.Completa -and -not $esUltimaMarcada) -or -not $guia.FilaVisible($i)) { continue }
        $cs = $guia.Celdas($i)
        if ($cs.Count -eq 0) { continue }
        $esc = $guia.EscalaOcr()
        $a = Ocr-Celdas $cs $esc $ocr
        $b = Ocr-Celdas $cs ([Math]::Min(6, $esc + 1)) $ocr
        foreach ($c in $cs) {
            if ($c.Vacia) { continue }
            $ta = [string]$a[$c.Col]; $tb = [string]$b[$c.Col]
            $c.Texto = $ta; $c.Texto2 = $tb; $c.Seguro = $false
            if (Acuerdo $ta $tb) { $c.Seguro = $true; continue }
            $tc = [string](Ocr-Celdas @($c) ([Math]::Min(6, $esc + 2)) $ocr)[$c.Col]
            if (Acuerdo $tc $ta) { $c.Seguro = $true }
            elseif (Acuerdo $tc $tb) { $c.Texto = $tb; $c.Texto2 = $ta; $c.Seguro = $true }
            elseif (-not $ta -and $tc) { $c.Texto = $tc }
        }
        $cache[$i] = @{ Top = $f.Top; Bot = $f.Bot; Fin = $esUltimaMarcada; Celdas = $cs }
        $nuevas++
    }
    return $nuevas
}

# Lo que no se entendio (o no es seguro) se vuelve a leer solo y mas grande,
# DOS veces: se queda si las dos lecturas coinciden.
function Releer-Dudosas($guia, $cache, $res, [scriptblock]$ocr) {
    $rol = $res.Roles; $n = 0
    foreach ($t in $res.Tipos) {
        $cs = $cache[$t.N - 1].Celdas
        $dudas = @()
        $usa = @('Peso')
        if ($t.Tipo -eq 'ITEM') { $usa += @('PkgQty', 'Clase', 'Nmfc', 'Desc') }
        if ($t.Tipo -eq 'TOTAL') { $usa += @('PkgQty', 'HuQty') }
        if ($t.Tipo -eq 'HU') { $usa += @('HuQty') }
        foreach ($nom in $usa) {
            $kv = $rol[$nom]
            if ($kv -lt 0) { continue }
            # (si se partieron columnas, el rol apunta a la columna virtual: se usa la real)
            $k = if ($res.Filas) { [int]$res.Filas[$t.N - 1].Celdas[$kv].Col } else { $kv }
            if ($cs[$k].Vacia) { continue }
            $malo = -not $cs[$k].Seguro
            if ($nom -eq 'Peso' -and $t.Peso -eq $null) { $malo = $true }
            if ($nom -eq 'PkgQty' -and $t.QtyTexto -and -not ($t.Qty.Valor -is [int])) { $malo = $true }
            if ($nom -eq 'Clase' -and -not $t.Clase.Ok) { $malo = $true }
            if ($nom -eq 'Nmfc' -and -not $t.Nmfc.Ok) { $malo = $true }
            if ($malo -and $dudas -notcontains $k) { $dudas += $k }
        }
        foreach ($k in $dudas) {
            $c = $cs[$k]
            $esc = $guia.EscalaOcr()
            $tc = [string](Ocr-Celdas @($c) ([Math]::Min(6, $esc + 2)) $ocr)[$c.Col]
            $td = [string](Ocr-Celdas @($c) ([Math]::Min(7, $esc + 3)) $ocr)[$c.Col]
            if (Acuerdo $tc $td) {
                if ($tc -ne $c.Texto -or -not $c.Seguro) { $c.Texto2 = $c.Texto; $c.Texto = $tc; $c.Seguro = $true; $n++ }
            }
        }
    }
    return $n
}

# Lee el encabezado de la tabla (una vez): texto por columna, en mayusculas
function Leer-Encabezado($guia, [scriptblock]$ocr) {
    $r = @()
    $cs = $guia.CeldasEncabezado()
    if ($cs.Count -eq 0) { return ,$r }
    $t = Ocr-Celdas $cs ([Math]::Min(6, $guia.EscalaOcr())) $ocr
    foreach ($c in $cs) { $r += $(if ($c.Vacia) { '' } else { ([string]$t[$c.Col]).ToUpper() }) }
    return ,$r
}

# Junta las filas 0..$hasta (todas tienen que estar leidas) e interpreta
function Armar-Resultado($guia, $cache, [int]$hasta, [scriptblock]$ocr, $encab = $null) {
    $faltan = @(); $todas = @()
    for ($i = 0; $i -le $hasta; $i++) { if ($cache.ContainsKey($i)) { $todas += ,$cache[$i].Celdas } else { $faltan += ($i + 1) } }
    if ($faltan.Count -gt 0) {
        $r = [ordered]@{ Lineas = @(); Candados = @(,@('NO', ('Rows not read (scroll them into view): ' + ($faltan -join ', ')))); Tipos = @(); Roles = @{}; Formato = ''; Hazmat = $false; Pintar = @(); Bien = $false }
        return @{ Filas = @(); Res = $r }
    }
    $filas = Filas-Para-Interpretar $todas
    $res = Interpretar $filas $guia.ColumnaPeso() $guia.AltoTexto $encab
    if (-not $res.Bien -and -not $res.Hazmat -and $ocr) {
        if ((Releer-Dudosas $guia $cache $res $ocr) -gt 0) {
            $filas = Filas-Para-Interpretar $todas
            $res = Interpretar $filas $guia.ColumnaPeso() $guia.AltoTexto $encab
        }
    }
    if ($res.Filas) { $filas = $res.Filas }
    return @{ Filas = $filas; Res = $res }
}

# ======================= MODO MANUAL (columnas escogidas a mano) =======================
# Cuando el automatico no cuadra, tu senalas las columnas: piezas, descripcion,
# clase y NMFC (el peso ya se sabe por el primer toque). -1 = no hay esa columna.
# Solo cuentan las filas con peso. Pallets (Pieces de la linea 1): del renglon
# de total. Linea 1: pallets SKD (STC si trae piezas); las demas: * siempre.
# Sin renglon de total si teclea, pero con aviso (??) de que no se revisaron los pesos.

function Interpretar-Manual($filas, $roles, [int]$altoTexto, [int]$huAuto = -1) {
    $r = [ordered]@{ Lineas = @(); LineasHazmat = @(); Candados = @(); Tipos = @(); Roles = @{}; Formato = 'MANUAL'; Como = ''; Filas = $filas; Hazmat = $false; HazmatFila = 0; HazmatTexto = ''; HazmatCol = -1; Pintar = @(); Bien = $false; Manual = $true; Dudas = @() }
    if (-not $filas -or $filas.Count -eq 0 -or $roles.Peso -lt 0) { $r.Candados = @(,@('NO', 'Nothing was read', '')); return $r }
    $rp = [int]$roles.Peso; $rq = [int]$roles.Pcs; $rd = [int]$roles.Desc; $rc = [int]$roles.Clase; $rn = [int]$roles.Nmfc
    $r.Roles = [ordered]@{ Peso = $rp; PkgQty = $rq; Desc = $rd; Clase = $rc; Nmfc = $rn }
    # (numero de columna como se ve: solo cuentan las columnas que traen algo)
    $conAlgo = @(for ($k = 0; $k -lt $filas[0].Celdas.Count; $k++) { $hay = $false; foreach ($f in $filas) { if ($k -lt $f.Celdas.Count -and -not $f.Celdas[$k].Vacia) { $hay = $true; break } }; if ($hay) { $k } })
    $nomCol = { param([int]$k) if ($k -ge 0) { $n = @($conAlgo | Where-Object { $_ -le $k }).Count; "col $n" } else { 'none' } }
    $r.Como = "picked by hand: pieces=$(& $nomCol $rq), description=$(& $nomCol $rd), class=$(& $nomCol $rc), NMFC=$(& $nomCol $rn), weight=$(& $nomCol $rp)"
    $juntaQD = $rq -ge 0 -and $rq -eq $rd           # piezas y descripcion en la misma columna ("6 CTN SOAP")
    $juntaCN = $rc -ge 0 -and $rc -eq $rn           # NMFC y clase en la misma columna ("48580-2 / 55")
    $cel = { param($f, [int]$k) if ($k -ge 0 -and $k -lt $f.Celdas.Count -and -not $f.Celdas[$k].Vacia) { $f.Celdas[$k] } else { $null } }
    $tx = { param($c) if ($c) { ([string]$c.Texto).Trim() } else { '' } }

    # ---- cada fila: lo de las columnas escogidas ----
    $filasM = @()
    for ($i = 0; $i -lt $filas.Count; $i++) {
        $f = $filas[$i]
        $todo = (($f.Celdas | Where-Object { -not $_.Vacia } | ForEach-Object { $_.Texto }) -join ' ')
        $cp = & $cel $f $rp; $pT = & $tx $cp; $p = Leer-Peso $pT
        $cq = & $cel $f $rq; $cd = & $cel $f $rd
        $qT = ''; $dT = ''
        if ($juntaQD) {
            $t = & $tx $cq
            if ($t -match '^\s*(\d[\d,\.]*)\s+(.+)$') {
                $q1 = $matches[1]; $resto = $matches[2]
                if ($resto -match '^([A-Za-z]{1,9}\.?)\s+(.{2,})$') { $m1 = $matches[1]; $m2 = $matches[2]; if ($m1.ToUpper() -match $script:TiposPaquete) { $resto = $m2 } }
                $qT = $q1; $dT = $resto
            } else { $dT = $t }
        } else { $qT = & $tx $cq; $dT = & $tx $cd }
        $cc = & $cel $f $rc; $cn = & $cel $f $rn
        $clT = & $tx $cc; $nmT = & $tx $cn
        if ($juntaCN) {
            $sp = Separar-NmfcClase $clT
            if ($sp.Ok) { $nmT = $sp.Nmfc; $clT = $sp.Clase }
            else {
                $toks = @(($clT -split '[\s/\|;]+') | Where-Object { $_ })
                $nmT = ''; $c2 = ''
                foreach ($tk in $toks) { if (-not $nmT -and $tk -match '\d{4}' -and (Leer-Nmfc $tk).Ok) { $nmT = $tk } }
                foreach ($tk in $toks) { if ($tk -ne $nmT -and (Leer-Clase $tk).Ok) { $c2 = $tk } }
                $clT = $c2
            }
        }
        $fila = [pscustomobject]@{ N = $i + 1; Tipo = '?'; Peso = $p.Valor; PesoTexto = $pT; Qty = (Leer-Qty $qT); QtyTexto = $qT; Desc = $dT.ToUpper().Trim()
            Clase = (Leer-Clase $clT); ClaseTexto = $clT; Nmfc = (Leer-Nmfc $nmT); NmfcTexto = $nmT; Todo = $todo; Celdas = $f.Celdas
            CPeso = $cp; CQty = $cq; CDesc = $cd; CClase = $cc; CNmfc = $cn; ClaseEstado = 'ok'; DescEstado = 'ok' }
        $hayDato = ($qT -match '\d') -or ((Cuenta-Letras $dT) -ge 2) -or ($clT -match '\d') -or ($nmT -match '\d')
        $esPalletDesc = $dT -and $dT -match $script:DescPallet -and -not ($clT -match '\d') -and -not ($nmT -match '\d')
        $conTotal = $todo -match '(?i)\b(GRAND\s*)?TOTALS?\b'
        if (-not $cp) { $fila.Tipo = '-' }                          # sin peso: no cuenta
        elseif ($p.Valor -eq $null) { $fila.Tipo = 'ERR' }          # tiene peso pero no se entendio
        elseif ($conTotal -and $i -eq $filas.Count - 1) { $fila.Tipo = 'TOTAL' }
        elseif ($conTotal) { $fila.Tipo = 'SUB' }                   # subtotal: no se teclea
        elseif ($p.Valor -eq 0) { $fila.Tipo = '-' }
        elseif (-not $hayDato -or $esPalletDesc) { $fila.Tipo = 'PALLET' }
        else { $fila.Tipo = 'ITEM' }
        # hazmat de ESTA fila (X sola en una columna angosta o numero UN/NA): se marca y se brinca
        $fila | Add-Member -NotePropertyName Hazmat -NotePropertyValue $false
        $fila | Add-Member -NotePropertyName HazmatTexto -NotePropertyValue ''
        $fila | Add-Member -NotePropertyName HazmatCol -NotePropertyValue -1
        $un = Texto-Hazmat $todo
        $xc = $null
        foreach ($c0 in $f.Celdas) { if (-not $c0.Vacia -and $c0.Ancho -lt [Math]::Max(18, $altoTexto * 3.2) -and ([string]$c0.Texto) -match '^\s*[Xx]{1,2}\s*$') { $xc = $c0; break } }
        if ($xc) { $fila.Hazmat = $true; $fila.HazmatTexto = 'X in H.M.'; $fila.HazmatCol = $xc.Col }
        elseif ($un) {
            $fila.Hazmat = $true; $fila.HazmatTexto = $un
            foreach ($c0 in $f.Celdas) { if (-not $c0.Vacia -and (Texto-Hazmat ([string]$c0.Texto))) { $fila.HazmatCol = $c0.Col; break } }
        }
        if ($fila.Hazmat -and -not $r.Hazmat) { $r.Hazmat = $true; $r.HazmatFila = $i + 1; $r.HazmatTexto = $fila.HazmatTexto; $r.HazmatCol = $fila.HazmatCol }
        $filasM += $fila
    }
    # sin la palabra TOTAL: la ultima fila es el total si su peso = la suma de las demas
    $total = $filasM | Where-Object { $_.Tipo -eq 'TOTAL' } | Select-Object -First 1
    if (-not $total) {
        $conPeso = @($filasM | Where-Object { $_.Tipo -eq 'ITEM' -or $_.Tipo -eq 'PALLET' })
        if ($conPeso.Count -ge 3) {
            $u = $conPeso[$conPeso.Count - 1]
            $s = 0; foreach ($q in $conPeso) { if ($q -ne $u) { $s += $q.Peso } }
            if ($u.N -eq $filas.Count -and $u.Peso -eq $s) { $u.Tipo = 'TOTAL'; $total = $u }
        }
    }
    $items  = @($filasM | Where-Object { $_.Tipo -eq 'ITEM' })
    $pallet = @($filasM | Where-Object { $_.Tipo -eq 'PALLET' })
    $pesoPallet = 0; foreach ($q in $pallet) { $pesoPallet += $q.Peso }

    # ---- piezas del total ----
    $totQ = $null; $totQCelda = $null
    if ($total -and $rq -ge 0) {
        if (-not $juntaQD) { if ($total.CQty) { $totQ = $total.Qty.Valor; $totQCelda = $total.CQty } }
        elseif ($total.CQty -and ([string]$total.CQty.Texto) -match $script:PalabrasPiezas) { $totQ = [int]($matches[1] -replace ',', ''); $totQCelda = $total.CQty }
    }
    # ---- pallets (Pieces de la linea 1): del renglon de total ----
    #  1) numero con PLT/PALLET/SKID  2) la columna de handling units del automatico
    #  3) el entero mas chico del renglon (sin el peso ni las piezas)
    $piezas = $null; $palCelda = $null; $palDe = ''
    $buscarPal = { param($q, [string]$de, [bool]$conPcs = $false)
        $cand = @()
        for ($k = 0; $k -lt $q.Celdas.Count; $k++) {
            $c0 = $q.Celdas[$k]
            if ($c0.Vacia -or $k -eq $rp -or ($k -eq $rq -and -not $juntaQD -and -not $conPcs)) { continue }
            $cand += [pscustomobject]@{ K = $k; C = $c0; T = ([string]$c0.Texto) }
        }
        $junto = ($cand | ForEach-Object { $_.T }) -join ' '
        if ($junto -match $script:PalabrasPallet) {
            $v = [int]$matches[1]; $dc = $null
            foreach ($cc0 in $cand) { if ($cc0.T -match "(?<![\d,\.])$v(?![\d,\.])") { $dc = $cc0.C; break } }
            if ($v -gt 0) { return @{ V = $v; C = $dc; De = $de; Q = $q } }
        }
        if ($huAuto -ge 0) {
            $h = $cand | Where-Object { $_.K -eq $huAuto } | Select-Object -First 1
            if ($h) { $v = (Leer-Qty $h.T).Valor; if ($v -is [int] -and $v -gt 0) { return @{ V = $v; C = $h.C; De = $de; Q = $q } } }
        }
        $min = $null; $mc = $null
        foreach ($cc0 in $cand) {
            foreach ($m in [regex]::Matches($cc0.T, '(?<![\d,\.])\d{1,3}(?![\d,\.])')) { $v = [int]$m.Value; if ($v -gt 0 -and ($min -eq $null -or $v -lt $min)) { $min = $v; $mc = $cc0.C } }
        }
        if ($min) { return @{ V = $min; C = $mc; De = $de; Q = $q } }
        return $null
    }
    $bp = $null
    if ($total) { $bp = & $buscarPal $total 'total row' }
    if (-not $bp) { foreach ($q in $pallet) { $bp = & $buscarPal $q "row $($q.N)" $true; if ($bp) { break } } }
    $palFila = $null
    if ($bp) { $piezas = $bp.V; $palCelda = $bp.C; $palDe = $bp.De; $palFila = $bp.Q }

    # clase / descripcion: vacia (znoclass / no desc), bien, o la escribes tu
    foreach ($it in $items) {
        $it.ClaseEstado = if ($rc -lt 0 -or -not $it.CClase) { 'vacia' } elseif ($it.Clase.Ok -and $it.CClase.Seguro) { 'ok' } else { 'mano' }
        $cdes = if ($juntaQD) { $it.CQty } else { $it.CDesc }
        $it.DescEstado = if ($rd -lt 0 -or -not $cdes -or -not $it.Desc) { 'vacia' } elseif ($cdes.Seguro -and (Cuenta-Letras $it.Desc) -ge 2) { 'ok' } else { 'mano' }
    }
    # hazmat: las haces tu primero; FILL las marca y teclea las demas con *
    $itemsHz = @($items | Where-Object { $_.Hazmat })
    $itemsFill = @($items | Where-Object { -not $_.Hazmat })
    $hzOtras = @($filasM | Where-Object { $_.Hazmat -and $_.Tipo -ne 'ITEM' })

    # ---- lineas del ERP ----
    $r.Lineas = @(Lineas-ERP $itemsFill $piezas ($itemsHz.Count -gt 0) $pallet $pesoPallet)
    $r.LineasHazmat = @(Lineas-ERP $itemsHz $piezas $false @() 0 | ForEach-Object { $_.N = 'HZ'; $_ })

    # ---- candados ----  (en manual: ?? = aviso naranja, SI se puede teclear; NO = no teclea)
    $c = New-Object System.Collections.ArrayList
    $agregar = { param($e, $etq, $t, $det = '') [void]$c.Add(@($e, ('{0,-11} {1}' -f $etq, $t), [string]$det)) }
    & $agregar 'i' 'MANUAL' $r.Como
    if ($items.Count -eq 0) { & $agregar 'NO' 'ROWS' 'no rows with a weight to type' }
    elseif ($r.Lineas.Count -eq 0) { & $agregar 'NO' 'ROWS' 'nothing to type (all item rows are hazmat)' }
    $err = @($filasM | Where-Object { $_.Tipo -eq 'ERR' })
    if ($err.Count -gt 0) { & $agregar 'NO' 'WEIGHT' ('not read in row ' + (($err | ForEach-Object { "$($_.N) '$($_.PesoTexto)'" }) -join ', ')) }
    $sub = @($filasM | Where-Object { $_.Tipo -eq 'SUB' })
    if ($sub.Count -gt 0) { & $agregar 'i' 'SUBTOTAL' ('rows not typed: ' + (($sub | ForEach-Object { $_.N }) -join ', ')) }
    $sinPeso = @($filasM | Where-Object { $_.Tipo -eq '-' })
    if ($sinPeso.Count -gt 0) { & $agregar 'i' 'NO WEIGHT' ('rows not typed (no weight or 0): ' + (($sinPeso | ForEach-Object { $_.N }) -join ', ')) }
    $sumaP = 0; foreach ($it in $items) { $sumaP += $it.Peso }
    $detalle = 'weights: ' + (($items | ForEach-Object { Fmt-Num $_.Peso }) -join ' + ')
    if ($pesoPallet -gt 0) { $detalle += " + pallet $(Fmt-Num $pesoPallet)" }
    $sumaTodo = $sumaP + $pesoPallet
    $cuenta = (Lineas-Txt $items.Count) + $(if ($pesoPallet -gt 0) { " + pallet $(Fmt-Num $pesoPallet)" } else { '' }) + " = $(Fmt-Num $sumaTodo)"
    if (-not $total) { & $agregar '??' 'WEIGHTS' "$cuenta  |  NO TOTAL ROW (not checked)" $detalle }
    elseif ($sumaTodo -eq $total.Peso) { & $agregar 'OK' 'WEIGHTS' "$cuenta  |  total $(Fmt-Num $total.Peso)" $detalle }
    else { & $agregar 'NO' 'WEIGHTS' "$cuenta  |  total $(Fmt-Num $total.Peso)  |  DIFF $(Fmt-Num ($total.Peso - $sumaTodo))" $detalle }
    if ($rq -lt 0) { & $agregar 'i' 'PIECES' 'no pieces column: no STC, Q Pieces and Q Package Type empty' }
    else {
        $malQ = @($items | Where-Object { $_.QtyTexto -match '\d' -and -not ($_.Qty.Valor -is [int]) })
        if ($malQ.Count -gt 0) { & $agregar 'NO' 'PIECES' ('not valid: ' + (($malQ | ForEach-Object { "row $($_.N) '$($_.QtyTexto)'" }) -join ', ')) }
        $sumaQ = 0; foreach ($it in $items) { if ($it.Qty.Valor -is [int]) { $sumaQ += $it.Qty.Valor } }
        $detQ = 'pieces: ' + (($items | ForEach-Object { if ($_.Qty.Valor -is [int]) { Fmt-Num $_.Qty.Valor } else { '-' } }) -join ' + ')
        $cuentaQ = "$(Lineas-Txt $items.Count) = $(Fmt-Num $sumaQ)"
        if (-not $total) { & $agregar '??' 'PIECES' "$cuentaQ  |  no total row" $detQ }
        elseif ($totQ -eq $null) { & $agregar '??' 'PIECES' "$cuentaQ  |  the total row has no pieces to check" $detQ }
        elseif ($sumaQ -eq $totQ) { & $agregar 'OK' 'PIECES' "$cuentaQ  |  total $(Fmt-Num $totQ)" $detQ }
        else { & $agregar 'NO' 'PIECES' "$cuentaQ  |  total $(Fmt-Num $totQ)  |  DIFF $(Fmt-Num ($totQ - $sumaQ))" $detQ }
    }
    if ($piezas) {
        if ($palCelda -and -not $palCelda.Seguro) { & $agregar 'NO' 'PALLETS' "not sure ('$($palCelda.Texto)' / '$($palCelda.Texto2)')" }
        elseif ($total) { & $agregar 'OK' 'PALLETS' "$piezas  ($palDe)" }
        else { & $agregar '??' 'PALLETS' "$piezas  ($palDe, no total row to check)" }
    } else { & $agregar '??' 'PALLETS' 'not found in the total row: TYPE THEM YOURSELF in Pieces (line 1)' }
    if ($pallet.Count -gt 1) { & $agregar 'NO' 'PALLET ROW' ("more than one: " + (($pallet | ForEach-Object { "row $($_.N) = $(Fmt-Num $_.Peso)" }) -join ', ')) }
    Candados-ClaseDesc $itemsFill $agregar ($rc -ge 0) ($rd -ge 0)
    if ($rn -lt 0) { & $agregar '??' 'NMFC' 'no NMFC column: NMFC left empty' }
    else {
        $malN = @($itemsFill | Where-Object { -not $_.Nmfc.Ok })
        if ($malN.Count -eq 0) { & $agregar 'OK' 'NMFC' 'all valid format' }
        else { & $agregar 'NO' 'NMFC' ('not valid: ' + (($malN | ForEach-Object { ("row $($_.N) '$($_.NmfcTexto)' $($_.Nmfc.Duda)").Trim() }) -join ', ')) }
    }
    if ($itemsHz.Count -gt 0) {
        $que = (($itemsHz | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ')
        & $agregar 'HZ' 'HAZMAT' ("$que  -> TYPE THEM YOURSELF FIRST (line 1 = $(if ($piezas) { $piezas } else { '?' }) pallets SKD STC); FILL types the rest with *")
    }
    if ($hzOtras.Count -gt 0) { & $agregar 'NO' 'HAZMAT' ('mark in a row that is not an item: ' + (($hzOtras | ForEach-Object { "row $($_.N) ($($_.HazmatTexto))" }) -join ', ') + ' - check by hand') }
    if ($itemsHz.Count -eq 0 -and $hzOtras.Count -eq 0) { & $agregar 'OK' 'HAZMAT' 'none (no X in H.M., no UN/NA number)' }
    # cada dato que se usa se leyo 2 veces y coincidio
    $dudas = @(); $pares = @()
    $revisar = { param($q, $celda, [string]$que, [bool]$valido)
        if (-not $celda) { return }
        if (-not $celda.Seguro -or -not $valido) {
            if (-not $celda.Seguro) { $script:dudasTmp += "row $($q.N) $que '$($celda.Texto)' / '$($celda.Texto2)'" }
            $script:paresTmp += ,@(($q.N - 1), [int]$celda.Col)
        }
    }
    $script:dudasTmp = @(); $script:paresTmp = @()
    foreach ($it in $items) {
        & $revisar $it $it.CPeso 'weight' ($it.Peso -ne $null)
        if ($rq -ge 0 -and -not ($juntaQD -and $it.Hazmat)) { & $revisar $it $it.CQty $(if ($juntaQD) { 'pieces/description' } else { 'pieces' }) ((-not ($it.QtyTexto -match '\d')) -or ($it.Qty.Valor -is [int])) }
        if ($it.Hazmat) { continue }        # (descripcion, clase y NMFC de las hazmat no se usan)
        # (clase y descripcion dudosas: se releen mas grandes; si no, las escribes tu)
        if ($it.DescEstado -eq 'mano') { $cdes = if ($juntaQD) { $it.CQty } else { $it.CDesc }; if ($cdes) { $script:paresTmp += ,@(($it.N - 1), [int]$cdes.Col) } }
        if ($it.ClaseEstado -eq 'mano' -and $it.CClase -and -not $juntaCN) { $script:paresTmp += ,@(($it.N - 1), [int]$it.CClase.Col) }
        if ($juntaCN) { & $revisar $it $it.CClase 'NMFC/class' ($it.Nmfc.Ok) }
        elseif ($rn -ge 0) { & $revisar $it $it.CNmfc 'NMFC' ($it.Nmfc.Ok) }
    }
    foreach ($q in $pallet) { & $revisar $q $q.CPeso 'pallet weight' $true }
    foreach ($q in $err) { & $revisar $q $q.CPeso 'weight' $false }
    if ($total) { & $revisar $total $total.CPeso 'total weight' $true; if ($totQCelda) { & $revisar $total $totQCelda 'total pieces' $true } }
    if ($palCelda -and $palFila) { & $revisar $palFila $palCelda 'pallets' $true }
    $dudas = $script:dudasTmp; $r.Dudas = $script:paresTmp
    if ($dudas.Count -eq 0) { & $agregar 'OK' 'READ TWICE' 'every value matched' }
    else { & $agregar 'NO' 'NOT SURE' ('two reads differ: ' + ($dudas -join '; ')) }

    # ---- que se pinta (solo lo seguro y valido; Col -1 = toda la fila) ----
    $pin = New-Object System.Collections.ArrayList
    $poner = { param($q, $celda, [string]$color, [bool]$ok) if ($celda -and $ok -and $celda.Seguro) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = [int]$celda.Col; Color = $color }) } }
    foreach ($it in $items) {
        & $poner $it $it.CPeso 'peso' $true
        if (-not $juntaQD) { & $poner $it $it.CQty 'qty' ($it.Qty.Valor -is [int]) }
        if ($it.Hazmat) { continue }
        if (-not $juntaQD) { & $poner $it $it.CDesc 'desc' ((Cuenta-Letras $it.Desc) -ge 2) }
        else { & $poner $it $it.CQty 'desc' ((Cuenta-Letras $it.Desc) -ge 2) }
        if (-not $juntaCN) { & $poner $it $it.CClase 'clase' ($it.Clase.Ok); & $poner $it $it.CNmfc 'nmfc' ($it.Nmfc.Ok) }
        else { & $poner $it $it.CClase 'nmfc' ($it.Clase.Ok -and $it.Nmfc.Ok) }
    }
    foreach ($q in $pallet) { & $poner $q $q.CPeso 'pallet' $true }
    if ($total) {
        & $poner $total $total.CPeso 'peso' $true
        if ($totQCelda -and -not $juntaQD) { & $poner $total $totQCelda 'qty' $true }
    }
    if ($palCelda -and $palFila) { & $poner $palFila $palCelda 'pallet' $true }
    foreach ($q in @($filasM | Where-Object { $_.Hazmat })) {
        [void]$pin.Add(@{ Fila = $q.N - 1; Col = -1; Color = 'hazmat' })
        if ($q.HazmatCol -ge 0) { [void]$pin.Add(@{ Fila = $q.N - 1; Col = $q.HazmatCol; Color = 'hazmat' }) }
    }
    $r.Pintar = @($pin)
    $r.Tipos = $filasM
    $r.Candados = $c
    $r.Bien = -not ($c | Where-Object { $_[0] -eq 'NO' })
    return $r
}

# Vuelve a leer celdas sueltas (fila desde 0, columna) mas grandes, DOS veces:
# se queda si las dos lecturas coinciden.
function Releer-Pares($guia, $cache, $pares, [scriptblock]$ocr) {
    $n = 0; $vistos = @{}
    foreach ($pq in $pares) {
        $i = [int]$pq[0]; $k = [int]$pq[1]
        if ($vistos.ContainsKey("$i-$k") -or -not $cache.ContainsKey($i)) { continue }
        $vistos["$i-$k"] = $true
        $c = $cache[$i].Celdas[$k]
        if ($c.Vacia) { continue }
        $esc = $guia.EscalaOcr()
        $tc = [string](Ocr-Celdas @($c) ([Math]::Min(6, $esc + 2)) $ocr)[$c.Col]
        $td = [string](Ocr-Celdas @($c) ([Math]::Min(7, $esc + 3)) $ocr)[$c.Col]
        if (Acuerdo $tc $td) {
            if ($tc -ne $c.Texto -or -not $c.Seguro) { $c.Texto2 = $c.Texto; $c.Texto = $tc; $c.Seguro = $true; $n++ }
        }
    }
    return $n
}

# Junta todas las filas leidas e interpreta con las columnas escogidas a mano
function Armar-Manual($guia, $cache, $roles, [scriptblock]$ocr, [int]$huAuto = -1) {
    $faltan = @(); $todas = @()
    for ($i = 0; $i -lt $guia.Filas.Count; $i++) { if ($cache.ContainsKey($i)) { $todas += ,$cache[$i].Celdas } else { $faltan += ($i + 1) } }
    if ($faltan.Count -gt 0) {
        $r = [ordered]@{ Lineas = @(); Candados = @(,@('NO', ('Rows not read (scroll them into view): ' + ($faltan -join ', ')))); Tipos = @(); Roles = @{}; Formato = 'MANUAL'; Como = ''; Hazmat = $false; Pintar = @(); Bien = $false; Manual = $true; Dudas = @() }
        return @{ Filas = @(); Res = $r }
    }
    $filas = Filas-Para-Interpretar $todas
    $res = Interpretar-Manual $filas $roles $guia.AltoTexto $huAuto
    if (-not $res.Bien -and -not $res.Hazmat -and $ocr -and $res.Dudas.Count -gt 0) {
        if ((Releer-Pares $guia $cache $res.Dudas $ocr) -gt 0) {
            $filas = Filas-Para-Interpretar $todas
            $res = Interpretar-Manual $filas $roles $guia.AltoTexto $huAuto
        }
    }
    return @{ Filas = $filas; Res = $res }
}

# ======================= OCR DE WINDOWS (el mismo de PowerToys) =======================
# Windows.Media.Ocr: viene con Windows, no se instala nada. Se carga la primera
# vez que se usa FILL. Todo en memoria: la imagen va directo al OCR, sin disco.
$script:OcrListo  = $false
$script:OcrMotivo = ''
$script:OcrIdioma = ''
$script:OcrMaxDim = 2600
$script:OcrModo   = 0          # 0 = imagen directa; 1 = PNG en memoria (respaldo)

function Ocr-Iniciar {
    if ($script:OcrListo) { return $true }
    try {
        Add-Type -AssemblyName System.Runtime.WindowsRuntime
        $null = [Windows.Media.Ocr.OcrEngine, Windows.Foundation, ContentType = WindowsRuntime]
        $null = [Windows.Media.Ocr.OcrResult, Windows.Foundation, ContentType = WindowsRuntime]
        $null = [Windows.Graphics.Imaging.SoftwareBitmap, Windows.Foundation, ContentType = WindowsRuntime]
        $null = [Windows.Graphics.Imaging.BitmapPixelFormat, Windows.Foundation, ContentType = WindowsRuntime]
        $null = [Windows.Graphics.Imaging.BitmapAlphaMode, Windows.Foundation, ContentType = WindowsRuntime]
        $null = [Windows.Graphics.Imaging.BitmapDecoder, Windows.Foundation, ContentType = WindowsRuntime]
        $script:OcrAsTask = [System.WindowsRuntimeSystemExtensions].GetMethods() | Where-Object {
            $_.Name -eq 'AsTask' -and $_.GetParameters().Count -eq 1 -and $_.GetParameters()[0].ParameterType.Name -eq 'IAsyncOperation`1' } | Select-Object -First 1
        if (-not $script:OcrAsTask) { throw 'AsTask not found' }
        # ingles si esta (los bills vienen en ingles); si no, el idioma de Windows
        $motor = $null
        foreach ($l in [Windows.Media.Ocr.OcrEngine]::AvailableRecognizerLanguages) {
            if ($l.LanguageTag -like 'en*') { $motor = [Windows.Media.Ocr.OcrEngine]::TryCreateFromLanguage($l); if ($motor) { break } }
        }
        if (-not $motor) { $motor = [Windows.Media.Ocr.OcrEngine]::TryCreateFromUserProfileLanguages() }
        if (-not $motor) { throw 'no OCR language installed in Windows' }
        $script:OcrMotor  = $motor
        $script:OcrIdioma = [string]$motor.RecognizerLanguage.LanguageTag
        try { $script:OcrMaxDim = [int][Windows.Media.Ocr.OcrEngine]::MaxImageDimension } catch { }
        if ($script:OcrMaxDim -lt 500) { $script:OcrMaxDim = 2600 }
        $script:OcrListo = $true
        Paso "OCR listo ($($script:OcrIdioma), max $($script:OcrMaxDim) px)"
    } catch {
        $script:OcrMotivo = $_.Exception.Message
        Paso ('OCR no disponible: ' + $script:OcrMotivo)
    }
    return $script:OcrListo
}

function Ocr-Esperar($op, [type]$tipo) {
    $t = $script:OcrAsTask.MakeGenericMethod($tipo).Invoke($null, @($op))
    [void]$t.Wait(-1)
    return $t.Result
}

# gris (8 bits) -> SoftwareBitmap
function Ocr-Bitmap([byte[]]$gris, [int]$w, [int]$h) {
    $bgra = [BandaGuia]::Bgra($gris)
    if ($script:OcrModo -eq 0) {
        try {
            $buf = [System.Runtime.InteropServices.WindowsRuntime.WindowsRuntimeBufferExtensions]::AsBuffer($bgra)
            return [Windows.Graphics.Imaging.SoftwareBitmap]::CreateCopyFromBuffer($buf, [Windows.Graphics.Imaging.BitmapPixelFormat]::Bgra8, $w, $h, [Windows.Graphics.Imaging.BitmapAlphaMode]::Premultiplied)
        } catch {
            $script:OcrModo = 1
            Paso ('OCR: imagen directa no jalo, se usa PNG en memoria: ' + $_.Exception.Message)
        }
    }
    $bmp = New-Object System.Drawing.Bitmap $w, $h, ([System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
    try {
        $d = $bmp.LockBits((New-Object System.Drawing.Rectangle 0, 0, $w, $h), [System.Drawing.Imaging.ImageLockMode]::WriteOnly, $bmp.PixelFormat)
        for ($y = 0; $y -lt $h; $y++) {
            [System.Runtime.InteropServices.Marshal]::Copy($bgra, $y * $w * 4, [IntPtr]($d.Scan0.ToInt64() + [long]$y * $d.Stride), $w * 4)
        }
        $bmp.UnlockBits($d)
        $ms = New-Object System.IO.MemoryStream
        $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
    } finally { $bmp.Dispose() }
    $ms.Position = 0
    $ras = [System.IO.WindowsRuntimeStreamExtensions]::AsRandomAccessStream($ms)
    $dec = Ocr-Esperar ([Windows.Graphics.Imaging.BitmapDecoder]::CreateAsync($ras)) ([Windows.Graphics.Imaging.BitmapDecoder])
    return (Ocr-Esperar ($dec.GetSoftwareBitmapAsync()) ([Windows.Graphics.Imaging.SoftwareBitmap]))
}

# Lee una imagen: regresa las lineas @{ Texto; Y (centro); X (izquierda) }
function Ocr-Leer([byte[]]$gris, [int]$w, [int]$h) {
    $sb = Ocr-Bitmap $gris $w $h
    try {
        $res = Ocr-Esperar ($script:OcrMotor.RecognizeAsync($sb)) ([Windows.Media.Ocr.OcrResult])
    } finally { try { $sb.Dispose() } catch { } }
    $r = @()
    foreach ($l in $res.Lines) {
        $ws = @($l.Words)
        if ($ws.Count -eq 0) { continue }
        $ys = 0.0; $x0 = [double]::MaxValue
        foreach ($wd in $ws) { $b = $wd.BoundingRect; $ys += $b.Y + $b.Height / 2; if ($b.X -lt $x0) { $x0 = $b.X } }
        $r += [pscustomobject]@{ Texto = [string]$l.Text; Y = $ys / $ws.Count; X = $x0 }
    }
    return $r
}

