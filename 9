$BandaCodigoGuia = @'
using System;
using System.Collections.Generic;

// Una fila del breakdown. Top/Bot en "v de la hoja" (v en pantalla menos Off).
public class BandaFila {
    public double Top;
    public double Bot;
    public bool Completa;      // false = se corta abajo (falta ver el final)
}

// Deteccion de filas por el PESO. Coordenadas giradas con la inclinacion del
// escaneo:  u = x + Sv*(y - My)  (constante en una linea vertical)
//           v = y - S*(x - Mx)   (constante en una linea horizontal)
// S = inclinacion de las filas, Sv = de las columnas (igual a S si la hoja
// solo esta girada; distinta si esta combada o la foto salio en perspectiva).
public partial class BandaGuia {
    byte[] g; int W, H;

    public int T;                 // umbral de tinta (gris < T = tinta)
    public int TL;                // umbral para LINEAS (mas claro: lineas finitas o tenues tambien cuentan)
    public int Fondo;             // gris del papel
    public double S;              // pendiente de las filas (tan del angulo)
    public double Sv;             // pendiente de las columnas (medida con los pesos)
    public bool Final;            // ya se marco la ultima fila (2o toque)
    public double Grados;
    public int Mx, My;            // donde estaba el mouse al calibrar
    public int UL, UR;            // columna del peso (u)
    public int XA, XB;            // ancho de la tabla (u) para la banda
    public bool ModoLineas;       // true = filas por las lineas de la tabla
    public bool ColumnaConLineas; // la columna del peso tiene lineas verticales
    public int AltoTexto = 12;
    public double AltoFila = 24;  // alto tipico de una fila de un renglon
    public int RefIzq = -1, RefDer = -1;   // donde empieza y acaba el texto del primer peso (u)
    public double Off;            // cuanto se movio la hoja (scroll) desde la calibracion
    public bool HayMas;           // puede haber mas filas abajo de lo que se ve
    public string Motivo = "";
    public List<BandaFila> Filas = new List<BandaFila>();

    // firma de la hoja para seguir el scroll (por renglon v de la hoja)
    const int K = 16;
    int firmaBase;
    List<int[]> firma = new List<int[]>();

    // ================= coordenadas =================
    double U(double x, double y) { return x + Sv * (y - My); }
    public double VDe(double x, double y) { return V(x, y); }
    double V(double x, double y) { return y - S * (x - Mx); }
    void XY(double u, double v, out double x, out double y) {
        double d = 1 + S * Sv, a = u + Sv * My, b = v - S * Mx;
        x = (a - Sv * b) / d; y = (S * a + b) / d;
    }
    // u = de la hoja; v = de la PANTALLA (v de la hoja + Off). El scroll mueve
    // la hoja en y, asi que la columna se busca en la x que tenia en la hoja.
    int Gris(double u, double v) {
        double x, y; XY(u, v - Off, out x, out y); y += Off;
        int xi = (int)Math.Round(x), yi = (int)Math.Round(y);
        if (xi < 0 || yi < 0 || xi >= W || yi >= H) return -1;
        return g[yi * W + xi];
    }
    bool Tinta(int x, int y) {
        if (x < 0 || y < 0 || x >= W || y >= H) return false;
        return g[y * W + x] < T;
    }

    // Esquinas de la banda de la fila i en pixeles de pantalla:
    // x0,y0 (arriba izq), x1,y1 (arriba der), x2,y2 (abajo der), x3,y3 (abajo izq)
    public double[] Esquinas(int i) {
        BandaFila f = Filas[i];
        double[] r = new double[8]; double x, y;
        XY(XA, f.Top, out x, out y); r[0] = x; r[1] = y + Off;
        XY(XB, f.Top, out x, out y); r[2] = x; r[3] = y + Off;
        XY(XB, f.Bot, out x, out y); r[4] = x; r[5] = y + Off;
        XY(XA, f.Bot, out x, out y); r[6] = x; r[7] = y + Off;
        return r;
    }

    // ================= calibracion =================
    public bool Calibrar(byte[] gris, int w, int h, int mx, int my) {
        g = gris; W = w; H = h; Mx = mx; My = my; Off = 0; S = 0; Sv = 0; Grados = 0; Final = false;
        AjusteColumna = 0; InfoColumna = "";
        Filas.Clear(); firma.Clear(); Motivo = ""; HayMas = false;
        if (mx < 0 || my < 0 || mx >= w || my >= h) { Motivo = "mouse fuera de la pantalla"; return false; }
        Umbral();
        Angulo();
        Sv = S;
        if (!Columna()) return false;

        // modo: lineas horizontales dentro de la columna del peso
        int[] tinta, tenue; bool[] valido; int va = My - 200;
        Perfil(va, H + 60, UL, UR, out tinta, out tenue, out valido);
        List<int[]> lineas = Lineas(tenue, valido, va, UR - UL + 1);
        int cerca = 0;
        foreach (int[] l in lineas) if (l[0] > My - 150 && l[0] < My + 600) cerca++;
        ModoLineas = cerca >= 3;

        bool hayMas;
        List<BandaFila> f = DetectarFilas(My, true, out hayMas);
        if (ModoLineas) {
            // hay lineas (encabezado, totales) pero no entre cada fila: si por
            // texto salen mas filas, la tabla no tiene rayas entre filas
            bool hm2; string mot = Motivo; ModoLineas = false; Motivo = "";
            List<BandaFila> ft = DetectarFilas(My, true, out hm2);
            if (ft.Count > f.Count) { f = ft; hayMas = hm2; } else { ModoLineas = true; Motivo = mot; }
        }
        if (f.Count == 0) { if (Motivo == "") Motivo = "no se encontro el peso"; return false; }
        Filas.AddRange(f);
        HayMas = hayMas;
        // la columna de los pesos dice cuanto esta inclinada la hoja de arriba a
        // abajo; si no coincide con las filas, se corrige y se vuelve a medir
        for (int vuelta = 0; vuelta < 3; vuelta++) {
            double antes = Sv;
            if (!AjustarColumna()) break;
            List<BandaFila> f2 = DetectarFilas(My, true, out hayMas);
            if (f2.Count < Filas.Count) { AjusteColumna -= Sv - antes; Sv = antes; break; }   // salio peor: se regresa
            Filas.Clear(); Filas.AddRange(f2); HayMas = hayMas;
        }
        Ancho();
        Firma(true);
        return true;
    }

    // Orillas del texto del peso de cada fila -> si los pesos estan alineados
    // (a la izquierda o a la derecha), la orilla tiene que quedar en la misma u.
    // Si se va recorriendo de arriba a abajo, la columna esta mas inclinada.
    public double AjusteColumna;  // cuanto se corrigio Sv en total
    public string InfoColumna = "";
    bool AjustarColumna() {
        List<double> vs = new List<double>(), iz = new List<double>(), de = new List<double>();
        int wd = UR - UL + 1;
        foreach (BandaFila f in Filas) {
            int va = (int)Math.Floor(f.Top + Off) - 2, vb = (int)Math.Ceiling(f.Bot + Off) + 2;
            int[] tinta, tenue; bool[] valido;
            Perfil(va, vb, UL, UR, out tinta, out tenue, out valido);
            List<int[]> ls = Lineas(tenue, valido, va, wd);
            List<int[]> ts = Textos(tinta, valido, va, wd, ls);
            if (ts.Count == 0) continue;
            int ua, ub; Extension(ts[0], out ua, out ub);
            if (ua > ub) continue;
            vs.Add((ts[0][0] + ts[0][1]) / 2.0); iz.Add(ua); de.Add(ub);
        }
        if (vs.Count < 3 || vs[vs.Count - 1] - vs[0] < AltoTexto * 6) { InfoColumna += " pocos(" + vs.Count + ")"; return false; }
        double ki, ri, kd, rd;
        RectaRobusta(vs, iz, out ki, out ri); RectaRobusta(vs, de, out kd, out rd);
        // la orilla alineada es la que menos cambia de fila a fila (los pesos
        // alineados a la derecha tienen la orilla izquierda en todos lados)
        bool derecha = Dispersion(de) < Dispersion(iz) * 0.7 ? true : (Dispersion(iz) < Dispersion(de) * 0.7 ? false : rd < ri);
        double k = derecha ? kd : ki, res = derecha ? rd : ri;
        InfoColumna += string.Format(" n={0} k={1:0.0000} res={2:0.0} {3}", vs.Count, k, res, derecha ? "der" : "izq");
        if (res > Math.Max(2.0, AltoTexto * 0.25)) return false;    // no estan alineados: no se toca
        if (Math.Abs(k) < 0.0008) return false;                     // ya esta bien (menos de 0.05 grados)
        if (Math.Abs(k) * (vs[vs.Count - 1] - vs[0]) < 1.5) return false;   // se recorre menos de 1.5 px: es ruido
        double nuevo = Sv - k;
        if (Math.Abs(nuevo - S) > 0.06) return false;               // demasiado distinto: mejor no
        Sv = nuevo; AjusteColumna += -k;
        return true;
    }
    static double Dispersion(List<double> x) {
        List<double> c = new List<double>(x); c.Sort();
        int q = c.Count / 4;
        return c[c.Count - 1 - q] - c[q];        // rango sin los extremos
    }
    // Igual, pero quita los puntos que se salen (una mancha junto al peso)
    static void RectaRobusta(List<double> x0, List<double> y0, out double k, out double res) {
        List<double> x = new List<double>(x0), y = new List<double>(y0);
        Recta(x, y, out k, out res);
        int quitar = x.Count / 3;
        while (quitar-- > 0 && x.Count >= 4) {
            double mx = 0, my = 0; for (int i = 0; i < x.Count; i++) { mx += x[i]; my += y[i]; }
            mx /= x.Count; my /= x.Count;
            int peor = -1; double pd = 0;
            for (int i = 0; i < x.Count; i++) { double d = Math.Abs(y[i] - (my + k * (x[i] - mx))); if (d > pd) { pd = d; peor = i; } }
            if (pd <= 2.0) break;
            x.RemoveAt(peor); y.RemoveAt(peor);
            Recta(x, y, out k, out res);
        }
    }
    // Recta y = a + k*x por minimos cuadrados; res = error tipico (px)
    static void Recta(List<double> x, List<double> y, out double k, out double res) {
        int n = x.Count; double mx = 0, my = 0;
        for (int i = 0; i < n; i++) { mx += x[i]; my += y[i]; }
        mx /= n; my /= n;
        double sxy = 0, sxx = 0;
        for (int i = 0; i < n; i++) { sxy += (x[i] - mx) * (y[i] - my); sxx += (x[i] - mx) * (x[i] - mx); }
        k = sxx > 0 ? sxy / sxx : 0;
        double e = 0;
        for (int i = 0; i < n; i++) { double d = y[i] - (my + k * (x[i] - mx)); e += d * d; }
        res = Math.Sqrt(e / n);
    }

    // 2o toque: el mouse sobre el peso de la ULTIMA fila. Devuelve el numero de
    // la fila (desde 0); 0 = es la primera (= apagar); -1 = no hay fila ahi.
    public int FijarFinal(int mx, int my) {
        double vd = V(mx, my) - Off;
        int mejor = -1; double md = double.MaxValue;
        for (int i = 0; i < Filas.Count; i++) {
            BandaFila f = Filas[i];
            double d = vd < f.Top ? f.Top - vd : (vd > f.Bot ? vd - f.Bot : 0);
            if (d < md) { md = d; mejor = i; }
        }
        if (mejor < 0 || md > Math.Max(4, AltoFila * 0.3)) { Motivo = "no hay fila con peso bajo el mouse"; return -1; }
        if (mejor == 0) return 0;
        if (mejor + 1 < Filas.Count) Filas.RemoveRange(mejor + 1, Filas.Count - mejor - 1);
        Final = true; HayMas = false;
        return mejor;
    }

    // Umbral de tinta segun el papel alrededor del mouse
    void Umbral() {
        int[] hist = new int[256]; int n = 0;
        for (int y = Math.Max(0, My - 250); y < Math.Min(H, My + 450); y += 2)
            for (int x = Math.Max(0, Mx - 500); x < Math.Min(W, Mx + 500); x += 2) { hist[g[y * W + x]]++; n++; }
        int acum = 0, p90 = 255, p1 = 0, p40 = 255; bool hay1 = false, hay40 = false;
        for (int i = 0; i < 256; i++) {
            acum += hist[i];
            if (!hay1 && acum >= n * 0.01) { p1 = i; hay1 = true; }
            if (!hay40 && acum >= n * 0.40) { p40 = i; hay40 = true; }
            if (acum >= n * 0.90) { p90 = i; break; }
        }
        Fondo = p90;
        // entre lo mas oscuro (tinta) y el papel: asi tambien agarra escaneos claros o borrosos
        T = (int)(p1 + (p90 - p1) * 0.62);
        if (T > p90 - 28) T = p90 - 28;
        if (T < (int)(p90 * 0.45)) T = (int)(p90 * 0.45);
        if (T < 40) T = 40;
        // lineas: lo que es claramente mas oscuro que el papel. Si el papel no es
        // parejo (sombras, foto de pantalla) se pide mas oscuro.
        int dispersion = p90 - p40;
        TL = p90 - Math.Max(22, Math.Max((int)((p90 - p1) * 0.2), (int)(dispersion * 1.3)));
        if (TL < T) TL = T;
    }

    // Angulo del escaneo: el que deja los renglones mas "parejos" (perfil horizontal)
    void Angulo() {
        List<int> px = new List<int>(), py = new List<int>();
        // solo cerca de la fila del mouse: una etiqueta pegada chueca o firmas mas
        // abajo no deben jalar el angulo
        for (int y = Math.Max(0, My - 90); y < Math.Min(H, My + 260); y += 2)
            for (int x = Math.Max(0, Mx - 450); x < Math.Min(W, Mx + 650); x += 2)
                // solo el borde de arriba de la tinta (asi una barra negra o un
                // pedazo cortado no pesa mas que una linea)
                if (y > 0 && g[y * W + x] < T && g[(y - 1) * W + x] >= T) { px.Add(x - Mx); py.Add(y); }
        if (px.Count < 80) { S = 0; Grados = 0; return; }
        double mejor = 0; double mejorA = 0;
        for (double a = -5.0; a <= 5.0001; a += 0.25) { double sc = Puntaje(px, py, a); if (sc > mejor) { mejor = sc; mejorA = a; } }
        double a0 = mejorA;
        for (double a = a0 - 0.25; a <= a0 + 0.2501; a += 0.025) { double sc = Puntaje(px, py, a); if (sc > mejor) { mejor = sc; mejorA = a; } }
        Grados = mejorA;
        S = Math.Tan(mejorA * Math.PI / 180.0);
    }
    double Puntaje(List<int> px, List<int> py, double grados) {
        double t = Math.Tan(grados * Math.PI / 180.0);
        int off = 800; int[] bins = new int[H + 1700];
        for (int i = 0; i < px.Count; i++) {
            int b = (int)Math.Round(py[i] - t * px[i]) + off;
            if (b >= 0 && b < bins.Length) bins[b]++;
        }
        // los 6 renglones mas llenos (lineas largas y renglones de texto): asi
        // muchos pedacitos cortos (manchas, cuadritos del jpg) no ganan
        int[] top = new int[6];
        for (int i = 0; i < bins.Length; i++) {
            int c = bins[i];
            if (c <= top[5]) continue;
            int k = 5; while (k > 0 && top[k - 1] < c) { top[k] = top[k - 1]; k--; }
            top[k] = c;
        }
        double s = 0; for (int i = 0; i < 6; i++) s += top[i];
        return s;
    }

    // Linea vertical en (x,y)? (sigue la inclinacion: dx/dy = -S)
    // (un bloque gris solido, como el fondo del visor, NO es linea)
    bool LineaVertical(int x, int y) {
        int si = 0, n = 0, solido = 0;
        for (int k = -28; k <= 28; k++) {
            int yy = y + k; int xx = (int)Math.Round(x - Sv * k);
            if (yy < 0 || yy >= H) continue;
            n++;
            if (Delgada(xx, yy)) si++;
            if (SolidoXY(xx, yy, 6, 0)) solido++;
        }
        return n >= 30 && si >= n * 0.6 && solido < n * 0.4;
    }
    // En este renglon hay una raya oscura DELGADA (hasta 10 px, como una linea
    // de la tabla aunque este con zoom) con papel a los dos lados. La orilla de un
    // bloque gris o el marco negro del escaner no cuentan.
    bool Delgada(int x, int y) {
        if (y < 0 || y >= H) return false;
        int c = Tinta(x, y) ? x : (Tinta(x - 1, y) ? x - 1 : (Tinta(x + 1, y) ? x + 1 : -1));
        if (c < 0) return false;
        int l = c, r = c;
        while (l - 1 >= 0 && Tinta(l - 1, y) && c - l < 12) l--;
        while (r + 1 < W && Tinta(r + 1, y) && r - c < 12) r++;
        if (r - l + 1 > 10 || l - 3 < 0 || r + 3 >= W) return false;
        int nucleo = 255;
        for (int x2 = l; x2 <= r; x2++) { int p = g[y * W + x2]; if (p < nucleo) nucleo = p; }
        int a = g[y * W + l - 3], b = g[y * W + r + 3];
        // a los lados ya no es tinta y es bastante mas claro que la raya
        return a >= T && b >= T && a - nucleo >= 40 && b - nucleo >= 40;
    }
    bool Oscuro(int x, int y) {
        if (x < 0 || y < 0 || x >= W || y >= H) return false;
        return g[y * W + x] < TL;
    }
    // Bloque oscuro PAREJO (fondo gris del visor): oscuro a los dos lados y del
    // mismo tono. Una linea sobre papel con manchas no cuenta como bloque.
    bool SolidoXY(int x, int y, int dx, int dy) {
        if (x - dx < 0 || y - dy < 0 || x + dx >= W || y + dy >= H || x < 0 || y < 0 || x >= W || y >= H) return false;
        int p = g[y * W + x], a = g[(y - dy) * W + x - dx], b = g[(y + dy) * W + x + dx];
        return p < TL && a < TL && b < TL && Math.Abs(a - p) < 30 && Math.Abs(b - p) < 30;
    }
    bool SolidoU(double u, double v, double du, double dv) {
        int p = Gris(u, v), a = Gris(u - du, v - dv), b = Gris(u + du, v + dv);
        if (p < 0 || a < 0 || b < 0) return false;
        return p < TL && a < TL && b < TL && Math.Abs(a - p) < 30 && Math.Abs(b - p) < 30;
    }
    bool OscuroU(double u, double v) { int p = Gris(u, v); return p >= 0 && p < TL; }
    bool TintaU(double u, double v) { int p = Gris(u, v); return p >= 0 && p < T; }

    // Columna del peso: entre las lineas verticales mas cercanas al mouse;
    // si no hay, alrededor del texto que esta bajo el mouse.
    bool Columna() {
        // 1) texto bajo el mouse (renglon del peso)
        int y0 = -1, y1 = -1;
        int[] fila = new int[61];
        for (int k = -30; k <= 30; k++) {
            int c = 0; double vv = My + k;
            for (int u = Mx - 60; u <= Mx + 60; u++) { int p = Gris(u, vv); if (p >= 0 && p < T) c++; }
            fila[k + 30] = c;
        }
        // renglon con tinta mas cercano al mouse
        int kc = -999;
        for (int d = 0; d <= 30 && kc == -999; d++) {
            if (fila[30 + d] > 0 && fila[30 + d] < 100) kc = d; else if (fila[30 - d] > 0 && fila[30 - d] < 100) kc = -d;
        }
        if (kc == -999) { Motivo = "no hay texto bajo el mouse"; return false; }
        y0 = kc; y1 = kc;
        while (y0 - 1 >= -30 && fila[y0 - 1 + 30] > 0 && fila[y0 - 1 + 30] < 100) y0--;
        while (y1 + 1 <= 30 && fila[y1 + 1 + 30] > 0 && fila[y1 + 1 + 30] < 100) y1++;
        int vTop = My + y0, vBot = My + y1;
        AltoTexto = Math.Max(6, vBot - vTop + 1);
        int vMid = (vTop + vBot) / 2;

        // 2) lineas verticales a los lados (cruzando el renglon del texto)
        int L = -1, R = -1;
        for (int d = 4; d <= 320 && L < 0; d++) { double x, y; XY(Mx - d, vMid, out x, out y); if (LineaVertical((int)Math.Round(x), (int)Math.Round(y))) L = Mx - d; }
        for (int d = 4; d <= 420 && R < 0; d++) { double x, y; XY(Mx + d, vMid, out x, out y); if (LineaVertical((int)Math.Round(x), (int)Math.Round(y))) R = Mx + d; }
        if (L >= 0 && R >= 0 && R - L >= 20 && R - L <= 500) {
            // salta el grosor de las lineas
            while (L < R && ColTinta(L + 1, vMid)) L++;
            while (R > L && ColTinta(R - 1, vMid)) R--;
            UL = L + 5; UR = R - 5; ColumnaConLineas = true;
            return UR - UL >= 10;
        }
        // 3) sin lineas: el texto del peso (con huecos de hasta 14 px entre palabras)
        ColumnaConLineas = false;
        int a = Mx, b = Mx, hueco = 0;
        for (int u = Mx; u >= Mx - 200; u--) { if (ColTexto(u, vTop, vBot)) { a = u; hueco = 0; } else if (++hueco > 14) break; }
        hueco = 0;
        for (int u = Mx; u <= Mx + 200; u++) { if (ColTexto(u, vTop, vBot)) { b = u; hueco = 0; } else if (++hueco > 14) break; }
        UL = a - 20; UR = b + 8;
        return true;
    }
    bool ColTinta(int u, int v) {
        int si = 0;
        for (int k = -10; k <= 10; k++) { int p = Gris(u, v + k); if (p >= 0 && p < T) si++; }
        return si >= 17;
    }
    bool ColTexto(int u, int vTop, int vBot) {
        for (int v = vTop; v <= vBot; v++) { int p = Gris(u, v); if (p >= 0 && p < T) return true; }
        return false;
    }

    // Perfil de tinta por renglon v dentro de [ua, ub]
    // (tenue = lo que es mas oscuro que el papel, para encontrar las lineas)
    void Perfil(int va, int vb, int ua, int ub, out int[] tinta, out int[] tenue, out bool[] valido) {
        int n = Math.Max(0, vb - va + 1), wd = ub - ua + 1;
        tinta = new int[n]; tenue = new int[n]; valido = new bool[n];
        for (int i = 0; i < n; i++) {
            int v = va + i, c = 0, ct = 0, ok = 0;
            for (int u = ua; u <= ub; u++) { int p = Gris(u, v); if (p < 0) continue; ok++; if (p < T) c++; if (p < TL) ct++; }
            tinta[i] = c; tenue[i] = ct; valido[i] = ok >= wd * 0.9;
        }
    }
    // Lineas horizontales: renglones con >= 50 % de tinta. Devuelve {a, b} (v)
    List<int[]> Lineas(int[] tinta, bool[] valido, int va, int wd) {
        List<int[]> r = new List<int[]>();
        int i = 0, n = tinta.Length;
        while (i < n) {
            if (valido[i] && tinta[i] >= wd * 0.5) {
                int j = i;
                while (j + 1 < n && valido[j + 1] && (tinta[j + 1] >= wd * 0.5 || (j + 2 < n && tinta[j + 2] >= wd * 0.5 && tinta[j + 1] >= wd * 0.2))) j++;
                r.Add(new int[] { va + i, va + j }); i = j + 1;
            } else i++;
        }
        return r;
    }
    // Renglones de texto (sin las lineas): {a, b} (v)
    List<int[]> Textos(int[] tinta, bool[] valido, int va, int wd, List<int[]> lineas) {
        int n = tinta.Length;
        bool[] esLinea = new bool[n];
        foreach (int[] l in lineas) for (int v = l[0] - 2; v <= l[1] + 2; v++) { int i = v - va; if (i >= 0 && i < n) esLinea[i] = true; }
        List<int[]> r = new List<int[]>();
        int k = 0;
        while (k < n) {
            if (valido[k] && !esLinea[k] && tinta[k] >= 2) {
                int j = k, hueco = 0, fin = k;
                while (j + 1 < n && valido[j + 1] && !esLinea[j + 1]) {
                    j++;
                    if (tinta[j] >= 2) { fin = j; hueco = 0; } else if (++hueco > 2) break;
                }
                int alto = fin - k + 1, suma = 0;
                for (int q = k; q <= fin; q++) suma += tinta[q];
                if (alto >= 3 && suma >= 6) r.Add(new int[] { va + k, va + fin });
                k = fin + 1;
            } else k++;
        }
        return r;
    }

    // ================= filas =================
    // vDesde = v en pantalla: al calibrar, donde esta el mouse; al seguir, el
    // top (en pantalla) de la primera fila que hay que volver a medir.
    List<BandaFila> DetectarFilas(int vDesde, bool calibrando, out bool hayMas) {
        hayMas = false;
        int va = vDesde - 200, wd = UR - UL + 1;
        int[] tinta, tenue; bool[] valido;
        Perfil(va, H + 60, UL, UR, out tinta, out tenue, out valido);
        List<int[]> lineas = Lineas(tenue, valido, va, wd);
        List<int[]> textos = Textos(tinta, valido, va, wd, lineas);
        int finValido = va - 1;
        for (int i = 0; i < valido.Length; i++) if (valido[i]) finValido = va + i;

        if (textos.Count > 0) {
            List<int> altos = new List<int>();
            foreach (int[] t in textos) altos.Add(t[1] - t[0] + 1);
            altos.Sort(); AltoTexto = Math.Max(6, altos[altos.Count / 2]);
            // un peso es un renglon de texto de alto normal: lo demas (bordes de
            // barras de scroll, manchas, bloques) no cuenta como peso
            List<int[]> buenos = new List<int[]>();
            foreach (int[] t in textos) { int a = t[1] - t[0] + 1; if (a >= AltoTexto * 0.45 && a <= AltoTexto * 2.6) buenos.Add(t); }
            textos = buenos;
        }
        // un peso queda alineado con el primero (a la izquierda, a la derecha o al centro)
        if (calibrando) {
            int[] t0 = TextoEn(textos, vDesde);
            if (t0 == null) { Motivo = "no se encontro el peso bajo el mouse"; return new List<BandaFila>(); }
            int ua, ub; Extension(t0, out ua, out ub); RefIzq = ua; RefDer = ub;
        }
        if (RefIzq >= 0) {
            int tol = Math.Max(10, (int)(AltoTexto * 0.7));
            List<int[]> alineados = new List<int[]>();
            foreach (int[] t in textos) {
                int ua, ub; Extension(t, out ua, out ub);
                if (ua > ub) continue;
                if (Math.Abs(ua - RefIzq) <= tol || Math.Abs(ub - RefDer) <= tol || Math.Abs((ua + ub) - (RefIzq + RefDer)) <= tol * 2) alineados.Add(t);
            }
            textos = alineados;
        }
        List<BandaFila> r = new List<BandaFila>();
        if (ModoLineas) FilasPorLineas(vDesde, calibrando, lineas, textos, finValido, r, out hayMas);
        else FilasPorTexto(vDesde, calibrando, textos, finValido, r, out hayMas);
        return r;
    }

    void FilasPorLineas(int vDesde, bool calibrando, List<int[]> lineas, List<int[]> textos, int finValido, List<BandaFila> r, out bool hayMas) {
        hayMas = false;
        // linea de arriba de la primera fila
        int i0 = -1;
        if (calibrando) {
            int[] tm = TextoEn(textos, vDesde);
            if (tm == null) return;
            int vRef = (tm[0] + tm[1]) / 2;
            for (int i = 0; i < lineas.Count; i++) if (lineas[i][1] < vRef) i0 = i;
            if (i0 >= 0 && vRef - lineas[i0][1] > AltoTexto * 6) i0 = -1;
        } else {
            int mejor = 9999;
            for (int i = 0; i < lineas.Count; i++) { int d = Math.Abs(lineas[i][1] + 1 - vDesde); if (d < mejor) { mejor = d; i0 = i; } }
            if (mejor > Math.Max(8, AltoTexto)) i0 = -1;
        }
        double top;
        int sig;
        if (i0 >= 0) { top = lineas[i0][1] + 1; sig = i0 + 1; }
        else {
            // sin linea arriba: empieza en el texto del peso
            int[] t = TextoEn(textos, vDesde);
            if (t == null) return;
            top = t[0] - 4; sig = 0;
            while (sig < lineas.Count && lineas[sig][0] <= t[0]) sig++;
        }
        List<double> altosUno = new List<double>();
        double maxAlto = Math.Max(AltoTexto * 9, 140);
        while (true) {
            if (sig >= lineas.Count) {
                // ya no hay linea abajo: fila cortada si tiene peso
                int[] t = PrimerTexto(textos, top, finValido);
                if (t != null && t[0] - top < maxAlto) {
                    BandaFila f = new BandaFila(); f.Top = top; f.Bot = finValido; f.Completa = false; r.Add(f);
                    hayMas = true;
                } else if (finValido - top < AltoFila * 1.5) hayMas = true;
                break;
            }
            int[] l = lineas[sig];
            double bot = l[0] - 1;
            if (bot - top > maxAlto) break;                        // hueco muy grande: se acabo la tabla
            if (l[1] - l[0] > 8 && r.Count > 0) break;             // barra gruesa: se acabo la tabla
            List<int[]> dentro = new List<int[]>();
            foreach (int[] t in textos) if (t[0] >= top - 1 && t[1] <= bot + 1) dentro.Add(t);
            if (dentro.Count > 0) {
                // dos pesos sin linea entre ellos: se parte la fila
                double ini = top;
                for (int k = 1; k < dentro.Count; k++) {
                    int hueco = dentro[k][0] - dentro[k - 1][1];
                    if (hueco >= Math.Max(5, AltoTexto * 0.9)) {
                        double corte = dentro[k - 1][1] + hueco / 2.0;
                        BandaFila p = new BandaFila(); p.Top = ini; p.Bot = corte; p.Completa = true; r.Add(p);
                        ini = corte + 1;
                    }
                }
                BandaFila f = new BandaFila(); f.Top = ini; f.Bot = bot; f.Completa = true; r.Add(f);
                if (dentro.Count == 1 && bot - ini < AltoTexto * 3) altosUno.Add(bot - ini + 1);
            }
            top = l[1] + 1; sig++;
            if (r.Count > 80) break;
        }
        if (altosUno.Count > 0) { altosUno.Sort(); AltoFila = altosUno[altosUno.Count / 2]; }
        // poco espacio abajo de la ultima fila: no se puede saber si se acabo la tabla
        if (r.Count > 0 && !hayMas && finValido - r[r.Count - 1].Bot < Math.Max(AltoFila * 3, 90)) hayMas = true;
    }

    void FilasPorTexto(int vDesde, bool calibrando, List<int[]> textos, int finValido, List<BandaFila> r, out bool hayMas) {
        hayMas = false;
        int k0 = -1;
        if (calibrando) {
            int mejor = 9999;
            for (int k = 0; k < textos.Count; k++) {
                int d = vDesde < textos[k][0] ? textos[k][0] - vDesde : (vDesde > textos[k][1] ? vDesde - textos[k][1] : 0);
                if (d < mejor) { mejor = d; k0 = k; }
            }
            if (mejor > AltoTexto * 1.5) k0 = -1;
        } else {
            int mejor = 9999;
            for (int k = 0; k < textos.Count; k++) { int d = Math.Abs(textos[k][0] - 4 - vDesde); if (d < mejor) { mejor = d; k0 = k; } }
            if (mejor > Math.Max(8, AltoTexto)) k0 = -1;
        }
        if (k0 < 0) return;
        double maxPaso = Math.Max(AltoTexto * 8, 120);
        List<double> pasos = new List<double>();
        for (int k = k0; k < textos.Count; k++) {
            double pad = 4;
            if (k > 0) pad = Math.Min(6, Math.Max(2, (textos[k][0] - textos[k - 1][1]) / 2.0));
            BandaFila f = new BandaFila(); f.Top = textos[k][0] - pad;
            if (k + 1 < textos.Count && textos[k + 1][0] - textos[k][0] <= maxPaso) {
                double padSig = Math.Min(6, Math.Max(2, (textos[k + 1][0] - textos[k][1]) / 2.0));
                f.Bot = textos[k + 1][0] - padSig - 1; f.Completa = true;
                pasos.Add(textos[k + 1][0] - textos[k][0]);
                r.Add(f);
            } else {
                double paso = AltoTexto * 2;
                if (pasos.Count > 0) { List<double> c = new List<double>(pasos); c.Sort(); paso = c[0]; }
                f.Bot = Math.Min(finValido, textos[k][0] - pad + paso - 1);
                f.Bot = Math.Min(f.Bot, f.Top + Math.Max(AltoTexto * 4, 60));     // nunca una banda gigante
                f.Completa = textos[k][1] + maxPaso < finValido;      // abajo se ve papel en blanco
                if (!f.Completa) hayMas = true;
                r.Add(f);
                break;
            }
            if (r.Count > 80) break;
        }
        if (pasos.Count > 0) { pasos.Sort(); AltoFila = pasos[0]; }
    }
    // Donde empieza y acaba (en u) la tinta de un renglon de texto dentro de la columna
    // Donde empieza y acaba (en u) el texto del peso: desde la tinta mas cercana
    // al centro de la columna, crece mientras haya letras (huecos chicos) y se
    // para en una linea vertical. Asi sale bien aunque el texto se salga un poco
    // de la columna (hoja combada).
    void Extension(int[] t, out int ua, out int ub) {
        ua = int.MaxValue; ub = int.MinValue;
        int lo = UL - 80, hi = UR + 80, n = hi - lo + 1, vMid = (t[0] + t[1]) / 2;
        int[] c = new int[n];                     // 0 = nada, 1 = letra, 2 = linea vertical
        int vFin = t[1];
        for (int i = 0; i < n; i++) {
            int u = lo + i, cuenta = 0;
            for (int v = t[0]; v <= vFin && cuenta < 2; v++) { int p = Gris(u, v); if (p >= 0 && p < T) cuenta++; }
            if (cuenta >= 2) c[i] = VerticalU(u, vMid) ? 2 : 1;       // (1 pixel suelto = mancha)
        }
        int centro = (UL + UR) / 2 - lo, semilla = -1;
        for (int d = 0; d <= (UR - UL) / 2 + 2 && semilla < 0; d++) {
            if (centro + d < n && c[centro + d] == 1) semilla = centro + d;
            else if (centro - d >= 0 && c[centro - d] == 1) semilla = centro - d;
        }
        if (semilla < 0) return;
        int hueco = Math.Max(7, AltoTexto);      // ("1,002" chico: la coma casi no tiene tinta)
        int a = semilla, b = semilla, h = 0;
        for (int i = semilla - 1; i >= 0; i--) { if (c[i] == 2) break; if (c[i] == 1) { a = i; h = 0; } else if (++h > hueco) break; }
        h = 0;
        for (int i = semilla + 1; i < n; i++) { if (c[i] == 2) break; if (c[i] == 1) { b = i; h = 0; } else if (++h > hueco) break; }
        ua = lo + a; ub = lo + b;
    }
    // Linea vertical en la columna u (tinta casi seguida 57 px alrededor de v)
    bool VerticalU(int u, int v) {
        int si = 0, n = 0, solido = 0;
        for (int k = -28; k <= 28; k++) {
            int p0 = Gris(u, v + k); if (p0 < 0) continue;
            n++;
            double x0, y0; XY(u, v + k - Off, out x0, out y0); y0 += Off;
            if (Delgada((int)Math.Round(x0), (int)Math.Round(y0))) si++;
            if (SolidoU(u, v + k, 6, 0)) solido++;
        }
        return n >= 30 && si >= n * 0.6 && solido < n * 0.4;
    }
    int[] TextoEn(List<int[]> textos, int v) {
        int[] mejor = null; int md = 9999;
        foreach (int[] t in textos) {
            int d = v < t[0] ? t[0] - v : (v > t[1] ? v - t[1] : 0);
            if (d < md) { md = d; mejor = t; }
        }
        return md <= AltoTexto * 1.5 ? mejor : null;
    }
    int[] PrimerTexto(List<int[]> textos, double desde, int hasta) {
        foreach (int[] t in textos) if (t[0] >= desde && t[1] <= hasta) return t;
        return null;
    }

    // Ancho de la banda = la tabla de orilla a orilla, sin salirse del papel:
    //  - las lineas de arriba y de abajo de la primera fila (aguantan huecos de
    //    hasta 30 px por sellos o lineas cortadas)
    //  - las lineas verticales de las orillas de la tabla
    //  - nunca entra al fondo gris del visor (bloque oscuro solido)
    public string InfoAncho = "";
    void Ancho() {
        double vTop = Filas.Count > 0 ? Filas[0].Top : My, vBot = Filas.Count > 0 ? Filas[0].Bot : My;
        double vm = (vTop + vBot) / 2;
        int pIzq = BordePapel(UL, vm, -1), pDer = BordePapel(UR, vm, 1);
        // primero las lineas verticales de las orillas (si hay, las lineas
        // horizontales no se siguen mas alla: asi no se brinca al ERP de al lado)
        int vi = -1, vd = -1, ultimo = UL, vmi = (int)Math.Round(vm);
        // (hasta 1200 px entre lineas: la columna de la descripcion puede ser muy ancha)
        for (int u = UL - 6; u >= pIzq && ultimo - u < 1200; u--) if (VerticalEn(u, vmi)) { vi = u; ultimo = u; u -= 4; }
        ultimo = UR;
        for (int u = UR + 6; u <= pDer && u - ultimo < 1200; u++) if (VerticalEn(u, vmi)) { vd = u; ultimo = u; u += 4; }
        int limIzq = vi >= 0 ? Math.Max(pIzq, vi - 15) : pIzq, limDer = vd >= 0 ? Math.Min(pDer, vd + 15) : pDer;
        InfoAncho = string.Format("papel {0}..{1} verticales {2}..{3}", pIzq, pDer, vi, vd);
        int a = int.MaxValue, b = int.MinValue;
        if (vi >= 0) a = vi;
        if (vd >= 0) b = vd;
        if (ModoLineas) {
            foreach (double v0 in new double[] { vTop - 2, vBot + 2 }) {
                int la = UL, lb = UR, hueco = 0; double v = v0;
                for (int u = UL; u >= limIzq; u--) { if (Linea(u, ref v)) { la = u; hueco = 0; } else if (++hueco > 30) break; }
                hueco = 0; v = v0;
                for (int u = UR; u <= limDer; u++) { if (Linea(u, ref v)) { lb = u; hueco = 0; } else if (++hueco > 30) break; }
                if (lb - la >= (UR - UL) * 2) { a = Math.Min(a, la); b = Math.Max(b, lb); }
            }
        }
        if (a == int.MaxValue || b == int.MinValue) {
            // tabla sin lineas: de la primera a la ultima letra de la fila
            int ta, tb; TextoFila(vTop, vBot, pIzq, pDer, out ta, out tb);
            if (a == int.MaxValue) a = ta - 10;
            if (b == int.MinValue) b = tb + 10;
        }
        XA = Math.Max(Math.Min(a, UL), pIzq);
        XB = Math.Min(Math.Max(b, UR), pDer);
        // que no se salga de la pantalla
        double x, y;
        XY(XA, vTop, out x, out y); if (x < 0) XA += (int)Math.Ceiling(-x);
        XY(XB, vTop, out x, out y); if (x > W - 1) XB -= (int)Math.Ceiling(x - (W - 1));
    }
    // Texto de la fila de un lado al otro: sigue mientras haya letras (huecos de
    // hasta 250 px entre columnas); se para en una linea larga (que no es texto,
    // por ejemplo las del ERP de al lado) o donde se acaba el papel.
    void TextoFila(double vTop, double vBot, int pIzq, int pDer, out int a, out int b) { TextoFila(vTop, vBot, pIzq, pDer, out a, out b, UL, UR); }
    // (desde = de donde empieza a buscar a cada lado; el lector lo usa para seguir
    //  mas alla de lo que ya se sabe que es la tabla)
    void TextoFila(double vTop, double vBot, int pIzq, int pDer, out int a, out int b, int desdeIzq, int desdeDer) {
        a = desdeIzq; b = desdeDer;
        for (int dir = -1; dir <= 1; dir += 2) {
            int hueco = 0, ultimo = dir < 0 ? desdeIzq : desdeDer, paso = 0;
            int[] corrida = new int[(int)(vBot - vTop) + 3];
            int[] antes = new int[62];                      // "ultimo" de hace 61 pasos
            for (int u = ultimo; dir < 0 ? u >= pIzq : u <= pDer; u += dir, paso++) {
                antes[paso % 62] = ultimo;
                bool hay = false, larga = false;
                bool[] col = new bool[corrida.Length];
                for (int i = 0; i < corrida.Length; i++) { col[i] = TintaU(u, vTop - 1 + i); if (col[i]) hay = true; }
                for (int i = 0; i < corrida.Length; i++) {
                    // (la linea puede ir un poco chueca: cuenta tambien el renglon de arriba y de abajo)
                    bool aqui = col[i] || (i > 0 && col[i - 1]) || (i + 1 < col.Length && col[i + 1]);
                    if (aqui) { if (++corrida[i] > 60) larga = true; } else corrida[i] = 0;
                }
                if (larga) { if (paso >= 61) ultimo = antes[(paso - 61) % 62]; break; }   // donde empezo la linea
                if (hay) { ultimo = u; hueco = 0; } else if (++hueco > 250) break;
            }
            if (dir < 0) a = ultimo; else b = ultimo;
        }
    }
    // Hasta donde llega el papel en el renglon v (desde u0 hacia dir): se para
    // donde empieza un bloque oscuro solido de 25 px (fondo gris del visor) o la pantalla
    int BordePapel(int u0, double v, int dir) {
        int corrida = 0, ultimoPapel = u0;
        for (int i = 0; i < 2200; i++) {
            int u = u0 + dir * i;
            int p = Gris(u, v);
            if (p < 0) break;
            // (mas alto que un renglon de texto: un numero grueso no es "bloque")
            bool solido = SolidoU(u, v, 0, Math.Max(7, AltoTexto + 4));
            if (solido) { if (++corrida >= 25) break; }
            else { corrida = 0; ultimoPapel = u; }
        }
        return ultimoPapel;
    }
    bool VerticalEn(int u, int v) {
        double x, y; XY(u, v, out x, out y);
        return LineaVertical((int)Math.Round(x), (int)Math.Round(y));
    }
    // Sigue la linea (si la hoja esta un poco combada, la linea sube o baja poco a
    // poco). Un bloque solido (oscuro arriba y abajo) no es linea.
    bool Linea(int u, ref double v) {
        int[] orden = { 0, -1, 1, -2, 2, 3, -3 };
        foreach (int k in orden) {
            int p = Gris(u, v + k);
            if (p >= 0 && p < TL) {
                if (SolidoU(u, v + k, 0, 7)) return false;
                v += k * 0.5; return true;
            }
        }
        return false;
    }

    // ================= seguir el scroll =================
    // Firma: por cada renglon v, la tinta en K pedazos a lo ancho de la tabla.
    // (en x de PANTALLA: el scroll no cambia la x, solo la v)
    int[][] FirmaPantalla(out int vBase) {
        // solo cerca de la columna del peso (seguro es la hoja, no el ERP)
        double x0, y0, x1, y1;
        XY(Math.Max(XA, UL - 300), My, out x0, out y0); XY(Math.Min(XB, UR + 600), My, out x1, out y1);
        int xs = Math.Max(0, (int)Math.Round(x0)), xe = Math.Min(W - 1, (int)Math.Round(x1));
        double inc = Math.Abs(S) * (xe - xs) + 2;
        vBase = (int)Math.Floor(-inc);
        int n = H + 2 * (int)Math.Ceiling(inc) + 2;
        int[][] r = new int[n][];
        double ancho = (xe - xs + 1) / (double)K;
        if (ancho < 1) return r;
        for (int i = 0; i < n; i++) {
            int v = vBase + i, ok = 0, tot = 0;
            int[] c = new int[K];
            for (int x = xs; x <= xe; x += 2) {
                tot++;
                int y = (int)Math.Round(v + S * (x - Mx));
                if (y < 0 || y >= H) continue; ok++;
                if (g[y * W + x] < T) { int k = (int)((x - xs) / ancho); if (k >= K) k = K - 1; c[k]++; }
            }
            r[i] = ok >= tot * 0.95 ? c : null;
        }
        return r;
    }
    void Firma(bool nueva) {
        int vb; int[][] f = FirmaPantalla(out vb);
        int off = (int)Math.Round(Off);
        if (nueva) { firma.Clear(); firmaBase = vb - off; firma.AddRange(f); return; }
        // agrega lo nuevo (lo que antes no se veia)
        int docIni = vb - off, docFin = docIni + f.Length - 1;
        int miFin = firmaBase + firma.Count - 1;
        if (docIni < firmaBase) {
            List<int[]> pre = new List<int[]>();
            for (int d = docIni; d < firmaBase; d++) pre.Add(f[d - docIni]);
            firma.InsertRange(0, pre); firmaBase = docIni;
        }
        for (int d = miFin + 1; d <= docFin; d++) firma.Add(f[d - docIni]);
        for (int d = Math.Max(docIni, firmaBase); d <= Math.Min(docFin, miFin); d++)
            if (firma[d - firmaBase] == null) firma[d - firmaBase] = f[d - docIni];
    }
    double Parecido(int[][] cur, int vb, int off, int paso, out int traslape) {
        double dot = 0, nc = 0, nf = 0; traslape = 0;
        for (int i = 0; i < cur.Length; i += paso) {
            int[] a = cur[i]; if (a == null) continue;
            int d = vb + i - off - firmaBase;
            if (d < 0 || d >= firma.Count) continue;
            int[] b = firma[d]; if (b == null) continue;
            traslape++;
            for (int k = 0; k < K; k++) { dot += a[k] * b[k]; nc += a[k] * a[k]; nf += b[k] * b[k]; }
        }
        if (nc <= 0 || nf <= 0) return 0;
        return dot / Math.Sqrt(nc * nf);
    }

    public double UltimoParecido;
    long huellaSinNada = 1;
    // Nueva foto de la pantalla: busca cuanto se movio la hoja y agrega las
    // filas que ya se ven. Devuelve true si algo cambio.
    public bool Seguir(byte[] gris) {
        g = gris;
        int vb; int[][] cur = FirmaPantalla(out vb);
        int offPrev = (int)Math.Round(Off), tr;
        double pPrev = Parecido(cur, vb, offPrev, 1, out tr);
        UltimoParecido = pPrev;
        int nuevo = offPrev;
        // si la pantalla no ha cambiado desde la ultima busqueda que no encontro nada, no busca otra vez
        long huella = 0;
        for (int i = 0; i < cur.Length; i++) { int[] a = cur[i]; if (a == null) continue; for (int k = 0; k < K; k++) huella = huella * 31 + a[k] + i; }
        if ((pPrev < 0.97 || tr < 100) && huella != huellaSinNada) {
            // busqueda gruesa (cada 3 renglones) y luego fina
            double mejor = -1; int mejorOff = offPrev;
            for (int off = offPrev - H; off <= offPrev + H; off += 2) {
                int t; double p = Parecido(cur, vb, off, 3, out t);
                if (t < 40) continue;
                if (p > mejor + 1e-9 || (Math.Abs(p - mejor) < 1e-9 && Math.Abs(off - offPrev) < Math.Abs(mejorOff - offPrev))) { mejor = p; mejorOff = off; }
            }
            double fino = -1; int fOff = mejorOff;
            for (int off = mejorOff - 3; off <= mejorOff + 3; off++) {
                int t; double p = Parecido(cur, vb, off, 1, out t);
                if (t < 100) continue;
                if (p > fino) { fino = p; fOff = off; }
            }
            // otro pico lejos casi igual de bueno = no se sabe: no se mueve
            double segundo = -1;
            for (int off = offPrev - H; off <= offPrev + H; off += 2) {
                if (Math.Abs(off - fOff) < Math.Max(6, AltoFila * 0.6)) continue;
                int t; double p = Parecido(cur, vb, off, 3, out t);
                if (t >= 40 && p > segundo) segundo = p;
            }
            UltimoParecido = fino;
            if (fino >= 0.85 && fino - pPrev >= 0.04 && fino - segundo >= 0.03) nuevo = fOff;
            else huellaSinNada = huella;
        }
        bool cambio = nuevo != offPrev;
        Off = nuevo;
        if (cambio) Firma(false);      // agrega a la firma lo que antes no se veia

        // filas nuevas que ya se ven (desde la ultima fila conocida)
        if (Filas.Count > 0) {
            int ultima = Filas.Count - 1;
            if (!Filas[ultima].Completa && ultima > 0) ultima--;     // la cortada se vuelve a medir
            int vDesde = (int)Math.Round(Filas[ultima].Top + Off);
            if (vDesde > -50 && vDesde < H) {
                bool hayMas;
                List<BandaFila> f = DetectarFilas(vDesde, false, out hayMas);
                if (f.Count > 0) {
                    if (Mezclar(f)) cambio = true;
                    HayMas = Final ? false : hayMas;
                }
            }
        }
        return cambio;
    }
    // Junta las filas medidas ahora (en pantalla) con las que ya se conocian
    bool Mezclar(List<BandaFila> nuevas) {
        bool cambio = false;
        foreach (BandaFila n in nuevas) {
            double t = n.Top - Off, b = n.Bot - Off;
            double tol = Math.Max(6, AltoFila * 0.4);
            BandaFila igual = null;
            foreach (BandaFila e in Filas) if (Math.Abs(e.Top - t) <= tol) { igual = e; break; }
            if (igual != null) {
                if (!igual.Completa && n.Completa) { igual.Bot = b; igual.Completa = true; cambio = true; }
                else if (!igual.Completa && b > igual.Bot + 1) { igual.Bot = b; cambio = true; }
            } else if (!Final && t > Filas[Filas.Count - 1].Top + tol) {
                BandaFila f = new BandaFila(); f.Top = t; f.Bot = b; f.Completa = n.Completa;
                Filas.Add(f); cambio = true;
            }
        }
        return cambio;
    }
}

// ================= LECTOR: celdas del breakdown para el OCR =================
// Se compila pegado al core (usa sus coordenadas, umbrales y filas).
// Todo en memoria: recortes en gris, nada a disco.
public class BandaCelda {
    public int Col;              // columna (0 = la de mas a la izquierda)
    public int U0, U1;           // tramo (u) entre separadores
    public bool Vacia = true;
    public int Glifos;           // manchas de tinta (= caracteres, mas o menos)
    public byte[] Img;           // recorte limpio (gris, escala 1, sin rayas)
    public int IW, IH;
    public int Y0, Y1;           // donde quedo en el mosaico (pixeles del mosaico)
    public string Texto = "";    // lo que leyo el OCR (la lectura que se queda)
    public string Texto2 = "";   // la otra lectura (otro tamano)
    public bool Seguro;          // las lecturas coinciden
    public double TU0, TU1, TV0, TV1;   // caja de la tinta (u de la hoja, v de la hoja) para pintarla
}

public partial class BandaGuia {
    // u de los separadores de columnas (rayas verticales o huecos sin tinta),
    // incluye las dos orillas. Las celdas van de un separador al siguiente.
    public List<int> Separadores = new List<int>();
    public string InfoSeparadores = "";

    // gris con interpolacion (u de la hoja, v de la PANTALLA); fuera = blanco
    double GrisFino(double u, double v) {
        double x, y; XY(u, v - Off, out x, out y); y += Off;
        int x0 = (int)Math.Floor(x), y0 = (int)Math.Floor(y);
        if (x0 < 0 || y0 < 0 || x0 + 1 >= W || y0 + 1 >= H) return 255;
        double fx = x - x0, fy = y - y0;
        int i = y0 * W + x0;
        double a = g[i] + (g[i + 1] - g[i]) * fx, b = g[i + W] + (g[i + W + 1] - g[i + W]) * fx;
        return a + (b - a) * fy;
    }

    // Esquinas en pantalla de una caja (u de la hoja, v de la hoja), como Esquinas()
    public double[] CajaPantalla(double u0, double u1, double v0, double v1) {
        double[] r = new double[8]; double x, y;
        XY(u0, v0, out x, out y); r[0] = x; r[1] = y + Off;
        XY(u1, v0, out x, out y); r[2] = x; r[3] = y + Off;
        XY(u1, v1, out x, out y); r[4] = x; r[5] = y + Off;
        XY(u0, v1, out x, out y); r[6] = x; r[7] = y + Off;
        return r;
    }

    // la fila se ve completa en la pantalla
    public bool FilaVisible(int i) {
        if (i < 0 || i >= Filas.Count) return false;
        double[] e = Esquinas(i);
        for (int k = 0; k < 8; k += 2) if (e[k] < 0 || e[k] > W - 1 || e[k + 1] < 0 || e[k + 1] > H - 1) return false;
        return true;
    }

    // gris del papel en la tabla (el Fondo del core es de toda la pantalla) y
    // gris "oscuro" para rayas: a medio camino entre la tinta y el papel
    public double PapelLocal = 255;
    double UmbralRaya() { return (T + PapelLocal) / 2.0; }
    void MedirPapel(List<int> vis) {
        List<double> m = new List<double>();
        foreach (int i in vis) {
            double t0 = Filas[i].Top + Off, t1 = Filas[i].Bot + Off;
            for (double v = t0; v <= t1; v += 2) for (int u = XA; u <= XB; u += 3) m.Add(GrisFino(u, v));
        }
        if (m.Count == 0) { PapelLocal = Fondo; return; }
        m.Sort();
        PapelLocal = m[(int)(m.Count * 0.75)];
        if (PapelLocal < T + 20) PapelLocal = Math.Min(255, T + 20);
    }

    // Separadores de columnas con todas las filas que se ven:
    //  - raya vertical: oscuro en casi toda la altura de la mayoria de las filas
    //  - hueco: ninguna fila tiene tinta en un tramo ancho (tablas sin rayas)
    public void PrepararColumnas() {
        Separadores.Clear(); InfoSeparadores = "";
        List<int> vis = new List<int>();
        for (int i = 0; i < Filas.Count; i++) if (FilaVisible(i)) vis.Add(i);
        if (vis.Count == 0) { InfoSeparadores = "sin filas visibles"; return; }
        MedirPapel(vis);
        // la tabla puede ser mas ancha que la primera fila (tablas sin rayas: una
        // columna que solo trae dato en el renglon de total, como SKIDS)
        int la = XA, lb = XB;
        for (int vuelta = 0; vuelta < 2; vuelta++) {
            // (2a vuelta: desde lo que ya se sabe que es tabla; asi una fila con un
            //  hueco grande, como el renglon de total, no se queda corta)
            int da = la, db = lb;
            foreach (int i in vis) {
                double vm = (Filas[i].Top + Filas[i].Bot) / 2 + Off;
                int pI = BordePapel(UL, vm, -1), pD = BordePapel(UR, vm, 1);
                int ta, tb;
                if (vuelta == 0) TextoFila(Filas[i].Top + Off, Filas[i].Bot + Off, pI, pD, out ta, out tb);
                else TextoFila(Filas[i].Top + Off, Filas[i].Bot + Off, pI, pD, out ta, out tb, Math.Max(pI, da), Math.Min(pD, db));
                if (ta < la) la = ta; if (tb > lb) lb = tb;
            }
        }
        int a = la - 10, b = lb + 10, n = b - a + 1;
        double thr = UmbralRaya();
        int[] raya = new int[n], tinta = new int[n];
        foreach (int i in vis) {
            double t0 = Filas[i].Top + Off, t1 = Filas[i].Bot + Off;
            int alto = Math.Max(3, (int)Math.Round(t1 - t0) + 1);
            double[,] p = new double[alto, n];
            for (int j = 0; j < alto; j++) for (int k = 0; k < n; k++) p[j, k] = GrisFino(a + k, t0 + j);
            // renglones que son raya horizontal (no cuentan como tinta)
            bool[] hor = new bool[alto];
            for (int j = 0; j < alto; j++) {
                int c = 0; for (int k = 0; k < n; k++) if (p[j, k] < thr) c++;
                hor[j] = c >= n * 0.6;
            }
            int utiles = 0; for (int j = 0; j < alto; j++) if (!hor[j]) utiles++;
            if (utiles < 3) continue;
            for (int k = 0; k < n; k++) {
                int osc = 0, tin = 0;
                for (int j = 0; j < alto; j++) {
                    if (hor[j]) continue;
                    if (p[j, k] < thr) osc++;
                    if (p[j, k] < T) tin++;
                }
                if (osc >= utiles * 0.8) raya[k]++;
                else if (tin > 0) tinta[k]++;
            }
        }
        bool[] esRaya = new bool[n];
        for (int k = 0; k < n; k++) esRaya[k] = raya[k] >= Math.Max(1, vis.Count * 0.6);
        List<int> centros = new List<int>();
        for (int k = 0; k < n; ) {
            if (!esRaya[k]) { k++; continue; }
            int e = k; while (e + 1 < n && esRaya[e + 1]) e++;
            centros.Add(a + (k + e) / 2); k = e + 1;
        }
        // huecos sin tinta en ninguna fila (las rayas cuentan como hueco)
        int minHueco = Math.Max(10, (int)(AltoTexto * 1.2));
        List<int> huecos = new List<int>();
        for (int k = 0; k < n; ) {
            if (tinta[k] > 0) { k++; continue; }
            int e = k; while (e + 1 < n && tinta[e + 1] == 0) e++;
            bool conRaya = false;
            foreach (int c in centros) if (c >= a + k && c <= a + e) { conRaya = true; break; }
            if (!conRaya && e - k + 1 >= minHueco && k > 0 && e < n - 1) huecos.Add(a + (k + e) / 2);
            k = e + 1;
        }
        List<int> s = new List<int>();
        s.Add(a); s.AddRange(centros); s.AddRange(huecos); s.Add(b);
        s.Sort();
        foreach (int u in s) if (Separadores.Count == 0 || u - Separadores[Separadores.Count - 1] > 3) Separadores.Add(u);
        InfoSeparadores = string.Format("{0} rayas, {1} huecos, {2} columnas", centros.Count, huecos.Count, Separadores.Count - 1);
    }

    // columna donde esta el peso
    public int ColumnaPeso() {
        int m = (UL + UR) / 2;
        for (int k = 0; k + 1 < Separadores.Count; k++) if (m >= Separadores[k] && m <= Separadores[k + 1]) return k;
        return -1;
    }

    // Columna bajo el mouse (pantalla), para escoger columnas a mano.
    // -1 = fuera de la tabla a los lados; -2 = muy arriba o muy abajo de las filas.
    public int ColumnaEn(int mx, int my) {
        if (Separadores.Count < 2 || Filas.Count == 0) return -1;
        double u = U(mx, my - Off), v = V(mx, my) - Off;
        double arriba = Filas[0].Top - Math.Max(AltoFila * 4, AltoTexto * 8), abajo = Filas[Filas.Count - 1].Bot + AltoFila * 2;
        if (v < arriba || v > abajo) return -2;
        for (int k = 0; k + 1 < Separadores.Count; k++) if (u >= Separadores[k] && u <= Separadores[k + 1]) return k;
        return -1;
    }

    // Celdas de la fila i: recorte enderezado de cada columna, sin rayas.
    public List<BandaCelda> Celdas(int i) {
        if (Separadores.Count < 2 || !FilaVisible(i)) return new List<BandaCelda>();
        double t0 = Filas[i].Top + Off - 1, t1 = Filas[i].Bot + Off + 1;
        // la ultima fila marcada (el total): un renglon de texto; abajo suele venir
        // una barra del formato que no es parte de la tabla
        if (Final && i == Filas.Count - 1) t1 = Math.Min(t1, t0 + AltoTexto * 2.6 + 2);
        return CeldasEn(t0, t1);
    }

    // Encabezado de la tabla: lo que esta arriba de la primera fila (hasta unos
    // 3 renglones), cortado en las mismas columnas. Sirve de pista (CLASS, NMFC...).
    public List<BandaCelda> CeldasEncabezado() {
        if (Separadores.Count < 2 || Filas.Count == 0) return new List<BandaCelda>();
        double t1 = Filas[0].Top + Off - 2;
        double t0 = Math.Max(0, t1 - Math.Max(AltoFila * 3.5, AltoTexto * 7));
        if (t1 - t0 < AltoTexto * 1.5) return new List<BandaCelda>();
        return CeldasEn(t0, t1);
    }

    // Celdas entre t0 y t1 (v de la PANTALLA), una por columna
    List<BandaCelda> CeldasEn(double t0, double t1) {
        List<BandaCelda> r = new List<BandaCelda>();
        int hc = Math.Max(4, (int)Math.Round(t1 - t0) + 1);
        double thr = UmbralRaya();
        for (int k = 0; k + 1 < Separadores.Count; k++) {
            BandaCelda c = new BandaCelda();
            c.Col = k; c.U0 = Separadores[k]; c.U1 = Separadores[k + 1];
            r.Add(c);
            int wc = c.U1 - c.U0 + 1;
            if (wc < 3) continue;
            double[] p = new double[wc * hc];
            for (int y = 0; y < hc; y++) for (int x = 0; x < wc; x++) p[y * wc + x] = GrisFino(c.U0 + x, t0 + y);
            LimpiarRayas(p, wc, hc, thr);
            // tinta que queda: manchas (8 vecinos) de 2 px o mas
            int x0, y0, x1, y1;
            c.Glifos = Manchas(p, wc, hc, out x0, out y0, out x1, out y1);
            if (c.Glifos == 0) continue;
            c.Vacia = false;
            c.TU0 = c.U0 + x0; c.TU1 = c.U0 + x1; c.TV0 = t0 - Off + y0; c.TV1 = t0 - Off + y1;
            int m = 3;
            x0 = Math.Max(0, x0 - m); y0 = Math.Max(0, y0 - m); x1 = Math.Min(wc - 1, x1 + m); y1 = Math.Min(hc - 1, y1 + m);
            c.IW = x1 - x0 + 1; c.IH = y1 - y0 + 1;
            // contraste: tinta mas oscura -> negro, papel -> blanco
            List<double> tin = new List<double>(), pap = new List<double>();
            for (int y = y0; y <= y1; y++) for (int x = x0; x <= x1; x++) { double v = p[y * wc + x]; if (v < T) tin.Add(v); else pap.Add(v); }
            tin.Sort(); pap.Sort();
            double lo = tin.Count > 0 ? tin[(int)(tin.Count * 0.05)] : 0;
            double hi = pap.Count > 0 ? pap[(int)(pap.Count * 0.6)] : 255;
            if (hi - lo < 30) hi = Math.Min(255, lo + 30);
            c.Img = new byte[c.IW * c.IH];
            for (int y = 0; y < c.IH; y++) for (int x = 0; x < c.IW; x++) {
                double v = (p[(y + y0) * wc + x + x0] - lo) * 255.0 / (hi - lo);
                c.Img[y * c.IW + x] = (byte)Math.Max(0, Math.Min(255, Math.Round(v)));
            }
        }
        return r;
    }

    // Borra (pinta de blanco) las rayas de la tabla dentro del recorte:
    //  horizontal = oscura en casi todo el ancho y llega a las dos orillas
    //  vertical   = oscura en casi toda la altura y llega arriba y abajo
    // (el texto pegado a una raya no llega a las dos orillas: ese se queda)
    void LimpiarRayas(double[] p, int w, int h, double thr) {
        bool[] fil = new bool[h], col = new bool[w];
        for (int y = 0; y < h; y++) {
            int c = 0; for (int x = 0; x < w; x++) if (p[y * w + x] < thr) c++;
            bool orillas = w < 6 || ((p[y * w] < thr || p[y * w + 1] < thr) && (p[y * w + w - 1] < thr || p[y * w + w - 2] < thr));
            fil[y] = c >= w * 0.7 && orillas;
        }
        for (int x = 0; x < w; x++) {
            int c = 0, tot = 0;
            for (int y = 0; y < h; y++) { if (fil[y]) continue; tot++; if (p[y * w + x] < thr) c++; }
            if (tot == 0) continue;
            int arriba = -1, abajo = -1;
            for (int y = 0; y < h; y++) if (!fil[y]) { arriba = y; break; }
            for (int y = h - 1; y >= 0; y--) if (!fil[y]) { abajo = y; break; }
            // (la ultima fila puede pasarse un poco de la tabla: basta con que llegue a una orilla)
            bool orillas = p[arriba * w + x] < thr || p[abajo * w + x] < thr;
            col[x] = c >= tot * 0.8 && orillas;
        }
        // orilla suave de la raya (antialias): el vecino que tambien es casi todo oscuro
        bool[] col2 = (bool[])col.Clone(), fil2 = (bool[])fil.Clone();
        double thr2 = (thr + PapelLocal) / 2.0;
        for (int x = 0; x < w; x++) {
            if (col[x]) continue;
            bool vecino = (x > 0 && col[x - 1]) || (x + 1 < w && col[x + 1]);
            if (!vecino) continue;
            int c = 0, tot = 0;
            for (int y = 0; y < h; y++) { if (fil[y]) continue; tot++; if (p[y * w + x] < thr2) c++; }
            if (tot > 0 && c >= tot * 0.7) col2[x] = true;
        }
        for (int y = 0; y < h; y++) {
            if (fil[y]) continue;
            bool vecino = (y > 0 && fil[y - 1]) || (y + 1 < h && fil[y + 1]);
            if (!vecino) continue;
            int c = 0; for (int x = 0; x < w; x++) if (p[y * w + x] < thr2) c++;
            if (c >= w * 0.6) fil2[y] = true;
        }
        for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) if (fil2[y] || col2[x]) p[y * w + x] = 255;
    }

    // manchas de tinta (8 vecinos) con 2 px o mas; caja de toda la tinta
    int Manchas(double[] p, int w, int h, out int x0, out int y0, out int x1, out int y1) {
        x0 = w; y0 = h; x1 = -1; y1 = -1;
        bool[] vis = new bool[w * h];
        int[] pila = new int[w * h];
        int n = 0;
        for (int s = 0; s < w * h; s++) {
            if (vis[s] || p[s] >= T) continue;
            int tope = 0, tam = 0, ax = w, ay = h, bx = -1, by = -1;
            pila[tope++] = s; vis[s] = true;
            while (tope > 0) {
                int q = pila[--tope]; tam++;
                int qx = q % w, qy = q / w;
                if (qx < ax) ax = qx; if (qx > bx) bx = qx; if (qy < ay) ay = qy; if (qy > by) by = qy;
                for (int dy = -1; dy <= 1; dy++) for (int dx = -1; dx <= 1; dx++) {
                    int nx = qx + dx, ny = qy + dy;
                    if (nx < 0 || ny < 0 || nx >= w || ny >= h) continue;
                    int nq = ny * w + nx;
                    if (vis[nq] || p[nq] >= T) continue;
                    vis[nq] = true; pila[tope++] = nq;
                }
            }
            if (tam < 2) continue;
            n++;
            if (ax < x0) x0 = ax; if (ay < y0) y0 = ay; if (bx > x1) x1 = bx; if (by > y1) y1 = by;
        }
        return n;
    }

    // Escala para que el texto quede de unos 36 px de alto (lo que mejor lee el OCR)
    public int EscalaOcr() { return Math.Max(1, Math.Min(4, (int)Math.Round(36.0 / Math.Max(6, AltoTexto)))); }

    // Mosaico de una fila: las celdas con tinta una debajo de otra, agrandadas
    // y con espacio entre ellas (asi el OCR no junta columnas). Gris 8 bits.
    public static byte[] Mosaico(List<BandaCelda> celdas, int escala, int maxDim, out int w, out int h, out int escUsada) {
        const int pad = 24, gap = 28;
        int esc = Math.Max(1, escala);
        while (true) {
            int mw = 0, mh = pad;
            foreach (BandaCelda c in celdas) { if (c.Vacia) continue; mw = Math.Max(mw, c.IW * esc); mh += c.IH * esc + gap; }
            w = mw + 2 * pad; h = mh - gap + pad;
            if ((w <= maxDim && h <= maxDim) || esc == 1) break;
            esc--;
        }
        escUsada = esc;
        if (w < 2 * pad + 1) w = 2 * pad + 1;
        if (h < 2 * pad + 1) h = 2 * pad + 1;
        byte[] m = new byte[w * h];
        for (int i = 0; i < m.Length; i++) m[i] = 255;
        int cy = pad;
        foreach (BandaCelda c in celdas) {
            if (c.Vacia) continue;
            int ow = c.IW * esc, oh = c.IH * esc;
            for (int oy = 0; oy < oh; oy++) {
                double sy = (oy + 0.5) / esc - 0.5; int y0 = (int)Math.Floor(sy); double fy = sy - y0;
                int ya = Math.Max(0, Math.Min(c.IH - 1, y0)), yb = Math.Max(0, Math.Min(c.IH - 1, y0 + 1));
                for (int ox = 0; ox < ow; ox++) {
                    double sx = (ox + 0.5) / esc - 0.5; int x0 = (int)Math.Floor(sx); double fx = sx - x0;
                    int xa = Math.Max(0, Math.Min(c.IW - 1, x0)), xb = Math.Max(0, Math.Min(c.IW - 1, x0 + 1));
                    double a = c.Img[ya * c.IW + xa] + (c.Img[ya * c.IW + xb] - c.Img[ya * c.IW + xa]) * fx;
                    double b = c.Img[yb * c.IW + xa] + (c.Img[yb * c.IW + xb] - c.Img[yb * c.IW + xa]) * fx;
                    int py = cy + oy, px = pad + ox;
                    if (py < h && px < w) m[py * w + px] = (byte)Math.Round(a + (b - a) * fy);
                }
            }
            c.Y0 = cy; c.Y1 = cy + oh - 1;
            cy += oh + gap;
        }
        return m;
    }

    // gris -> BGRA (lo que pide el OCR de Windows)
    public static byte[] Bgra(byte[] gris) {
        byte[] r = new byte[gris.Length * 4];
        for (int i = 0; i < gris.Length; i++) { byte v = gris[i]; r[i * 4] = v; r[i * 4 + 1] = v; r[i * 4 + 2] = v; r[i * 4 + 3] = 255; }
        return r;
    }
}
'@

$BandaCodigoWin = @'
using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.Runtime.InteropServices;

public static class BandaWin {
    [DllImport("user32.dll")] public static extern int GetSystemMetrics(int i);
    [DllImport("user32.dll")] static extern short GetAsyncKeyState(int vk);
    [DllImport("user32.dll")] static extern bool GetCursorPos(out PUNTO p);
    [DllImport("user32.dll")] static extern int GetWindowLong(IntPtr h, int i);
    [DllImport("user32.dll")] static extern int SetWindowLong(IntPtr h, int i, int v);
    [DllImport("user32.dll")] static extern bool SetWindowPos(IntPtr h, IntPtr despues, int x, int y, int cx, int cy, uint f);
    [StructLayout(LayoutKind.Sequential)] struct PUNTO { public int X; public int Y; }

    public static int[] Mouse() { PUNTO p; GetCursorPos(out p); return new int[] { p.X, p.Y }; }

    // Ventana que no recibe clicks, no sale en Alt+Tab y no quita el foco
    public static void Transparente(IntPtr h) {
        int ex = GetWindowLong(h, -20);
        SetWindowLong(h, -20, ex | 0x20 | 0x80 | 0x80000 | 0x08000000);
    }
    public static void AlFrente(IntPtr h) { SetWindowPos(h, new IntPtr(-1), 0, 0, 0, 0, 0x0001 | 0x0002 | 0x0010); }

    // Foto de la pantalla en gris (0-255)
    static Bitmap bmp; static byte[] buf;
    public static void Capturar(byte[] gris, int w, int h) {
        if (bmp == null || bmp.Width != w || bmp.Height != h) { if (bmp != null) bmp.Dispose(); bmp = new Bitmap(w, h, PixelFormat.Format32bppArgb); }
        using (Graphics g = Graphics.FromImage(bmp)) g.CopyFromScreen(0, 0, 0, 0, new Size(w, h), CopyPixelOperation.SourceCopy);
        BitmapData d = bmp.LockBits(new Rectangle(0, 0, w, h), ImageLockMode.ReadOnly, PixelFormat.Format32bppArgb);
        int stride = d.Stride;
        if (buf == null || buf.Length != stride * h) buf = new byte[stride * h];
        Marshal.Copy(d.Scan0, buf, 0, buf.Length);
        bmp.UnlockBits(d);
        for (int y = 0; y < h; y++) {
            int o = y * stride, q = y * w;
            for (int x = 0; x < w; x++, o += 4) gris[q + x] = (byte)((buf[o + 2] * 77 + buf[o + 1] * 150 + buf[o] * 29) >> 8);
        }
    }

    // Toque de Shift derecho SOLO (sin apretar otra tecla mientras estaba abajo, < 0.7 s).
    // Al apretar Shift se toma foto de las teclas que ya estaban abajo: esas no
    // cuentan (si una tecla se reporta apretada siempre, no bloquea el toque).
    static bool rAbajo, otra; static int t0;
    static bool[] yaAbajo = new bool[256];
    public static bool ToqueShiftDerecho() {
        bool r = (GetAsyncKeyState(0xA1) & 0x8000) != 0;
        if (r) {
            if (!rAbajo) {
                rAbajo = true; otra = false; t0 = Environment.TickCount;
                for (int vk = 1; vk < 255; vk++) yaAbajo[vk] = (GetAsyncKeyState(vk) & 0x8000) != 0;
            } else if (!otra && OtraTecla()) otra = true;
            return false;
        }
        if (!rAbajo) return false;
        rAbajo = false;
        return !otra && unchecked(Environment.TickCount - t0) < 700;
    }
    static bool OtraTecla() {
        for (int vk = 1; vk < 255; vk++) {
            if (vk == 0x10 || vk == 0xA0 || vk == 0xA1) continue;      // Shift (generico, izq y der)
            if (yaAbajo[vk]) continue;
            if ((GetAsyncKeyState(vk) & 0x8000) != 0) return true;
        }
        return false;
    }
    // Teclas de ESCRIBIR (numeros, letras, numpad, signos, espacio, borrar):
    // true si se apreto alguna desde la ultima vez que se pregunto
    static int[] teclasEscribir = ArmarTeclas();
    static bool[] prevTec = new bool[256];
    static int[] ArmarTeclas() {
        // (sin la tecla ` = 0xC0: la usa el otro programa para los 7 Tabs; ver Banda-Teclas)
        int[] t = new int[10 + 26 + 16 + 6 + 5 + 2];
        int n = 0;
        for (int vk = 0x30; vk <= 0x39; vk++) t[n++] = vk;      // 0-9
        for (int vk = 0x41; vk <= 0x5A; vk++) t[n++] = vk;      // A-Z
        for (int vk = 0x60; vk <= 0x6F; vk++) t[n++] = vk;      // numpad
        for (int vk = 0xBA; vk <= 0xBF; vk++) t[n++] = vk;      // signos
        for (int vk = 0xDB; vk <= 0xDF; vk++) t[n++] = vk;      // signos
        t[n++] = 0x20; t[n++] = 0x08;                            // espacio, borrar
        return t;
    }
    public static bool HuboTecleo() {
        bool hubo = false;
        for (int i = 0; i < teclasEscribir.Length; i++) {
            int vk = teclasEscribir[i];
            bool d = (GetAsyncKeyState(vk) & 0x8000) != 0;
            if (d && !prevTec[vk]) hubo = true;
            prevTec[vk] = d;
        }
        return hubo;
    }
    // Tab: true solo al apretarlo (una vez por toque)
    static bool prevTab;
    public static bool Tab() {
        bool a = (GetAsyncKeyState(0x09) & 0x8000) != 0;
        bool r = a && !prevTab;
        prevTab = a;
        return r;
    }
    // Click izquierdo: true al apretarlo (una vez por click); guarda donde fue
    static bool prevIzq; public static int ClickX, ClickY;
    public static bool ClickIzq() {
        bool a = (GetAsyncKeyState(0x01) & 0x8000) != 0;
        bool r = a && !prevIzq;
        prevIzq = a;
        if (r) { PUNTO p; GetCursorPos(out p); ClickX = p.X; ClickY = p.Y; }
        return r;
    }
    // Flecha arriba: true solo al apretarla (una vez por toque)
    static bool prevArriba;
    public static bool FlechaArriba() {
        bool a = (GetAsyncKeyState(0x26) & 0x8000) != 0;
        bool r = a && !prevArriba;
        prevArriba = a;
        return r;
    }
}
