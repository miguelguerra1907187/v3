            Abrir-TerminalAuto
        } else {
            Cerrar-LogTiempos $(if ($script:WatermarkGhost.Text -eq 'VERIFY' -or $script:WatermarkGhost.Text -eq 'CHECK') { 'OK' } else { 'ERROR' })
        }
    })
    $t.Start()
}

# ===================== BANDA BREAKDOWN (switch BAND) =====================
# Banda amarilla sobre la fila del breakdown que estas capturando.
#   Shift derecho (un toque, solo) con el mouse sobre el PESO de la primera
#   fila = prende (a un lado sale "1 of 22"). Opcional: dentro de 3 s, otro
#   toque sobre el PESO de la ULTIMA fila = solo cuenta hasta ahi. Enter = baja una fila (las
#   filas sin peso se brincan). Flecha arriba = sube. Shift derecho = apaga.
#   Si bajas la hoja (scroll) la banda la sigue y agrega las filas nuevas.
#   Se apaga sola al abrir el menu o al correr F1/F2, lookup o audit (asi los
#   Enter del motor no la mueven).
# Solo VE las teclas (no las bloquea) y toma fotos de la pantalla en memoria.
# Las filas: por el PESO (siempre viene); entre las lineas de la tabla, o de
# peso a peso si no hay lineas; aunque la hoja este chueca.
#
# Switch FILL (junto a BAND): llenado del breakdown con el OCR de Windows.
#   1) Shift derecho sobre el PRIMER peso de la tabla (arriba, aunque sea 0 o
#      la fila del pallet).  2) Shift derecho sobre el peso del GRAND TOTAL.
#   Lee todo y revisa los candados (suma de pesos = total, suma de piezas =
#   total, pallets, clases validas, NMFC). Si TODO cuadra: click en
#   Pieces del ERP y Shift derecho teclea la linea de la banda (sin Enter);
#   tu revisas y das Enter (y el de confirmar si sale): la banda pasa a la
#   siguiente. Flecha arriba = regresa una linea. Si algo no cuadra NO teclea
#   nada: sale el panel con lo que no cuadro y la banda queda de apoyo visual.
#   Columnas por lo que traen (no por el orden): clase, NMFC, cantidades, tipos
#   y descripcion pueden venir en cualquier lado; el encabezado es pista. El
#   panel dice el formato (VICS/GOJO o generic).
#   Cada fila se lee 2 veces (a dos tamanos); cada dato que se leyo seguro se
#   PINTA en el bill: QTY naranja, peso azul, descripcion cian, NMFC morado,
#   clase verde, pallets rosa, hazmat rojo. Lo que NO se pinta no es seguro.
#   HAZMAT (X en H.M. o un numero UN/NA como UN1993): esas filas se marcan en
#   ROJO y FILL no las teclea (las haces tu primero, con la linea 1: pallets
#   SKD STC); las demas las teclea todas con *. Sus pesos y piezas si cuentan
#   en la suma contra el total.
#   Linea 1: pallets SKD STC qty CTN desc peso clase NMFC; las demas: * en
#   Qualifier; al final la del pallet (peso y PALLET). No guarda nada en disco.
#   Si el automatico no cuadra, el panel trae PICK COLUMNS: tu senalas las
#   columnas con CLICK IZQUIERDO en el orden del ERP (Q pieces, descripcion,
#   peso, clase, NMFC); aviso grande arriba con la columna que falta; Shift
#   derecho = no hay esa columna; flecha arriba = regresa. Cada una se pinta.
#   Pallets: del renglon de total. Solo cuentan las filas con peso. Sin piezas:
#   la linea 1 va sin STC y las demas con *. Sin renglon de total SI teclea,
#   pero el panel avisa en naranja que no se revisaron los pesos.
$script:BandaListo  = $false
$script:BandaMotivo = ''          # por que no esta disponible (sale al prender el switch)
$script:BandaEstado = 'off'       # off / on / pend (esperando que bajes la hoja)
$script:BandaGuia   = $null
$script:BandaIdx    = 0
$script:BandaEsc    = 1.0
$script:BandaHwnd   = [IntPtr]::Zero
$script:BandaTicks  = 0
$script:BandaTecleo = $false      # se tecleo algo desde el ultimo Enter que conto
$script:BandaFinHasta = [DateTime]::MinValue   # hasta cuando el 2o toque marca la ultima fila
$script:FillFase   = ''           # '' / marcar (falta el ultimo peso) / listo (tecleando) / no (no cuadro) / columnas (las escoges tu)
$script:FillCache  = @{}          # fila -> celdas leidas (en memoria)
