# ----------------------------- basicos ---------------------------------
function Esperar([int]$ms = $Global:PausaMs) { Start-Sleep -Milliseconds $ms }
function Teclas([string]$k) { Paso "Teclas: $k"; [System.Windows.Forms.SendKeys]::SendWait($k) }
# --------------------------- coordenadas -------------------------------
# Se lee del archivo solo la 1a vez y cuando el archivo cambia (antes se
# leia en cada click, ~2 veces por click).
$script:CoordsCache = $null
$script:CoordsFecha = [datetime]::MinValue
function Leer-MisCoords {
    if (-not [System.IO.File]::Exists($Global:ArchivoCoords)) { $script:CoordsCache = $null; return @{} }
    $fecha = [System.IO.File]::GetLastWriteTimeUtc($Global:ArchivoCoords)
    if ($null -ne $script:CoordsCache -and $fecha -eq $script:CoordsFecha) { return $script:CoordsCache.Clone() }
    $r = @{}
    foreach ($l in [System.IO.File]::ReadAllLines($Global:ArchivoCoords)) {
        if ($l -match '^\s*(\w+)\s*=\s*(-?\d+)\s*,\s*(-?\d+)') {
            $r[$Matches[1]] = @([int]$Matches[2], [int]$Matches[3])
        }
    }
    $script:CoordsCache = $r
    $script:CoordsFecha = $fecha
    return $r.Clone()
}

# Devuelve @(X,Y): el mio si existe (y esta activado), si no el de la lista base
function Get-XY([string]$nombre) {
    if ($Global:Coord -eq 1) {
        $m = Leer-MisCoords
        if ($m.ContainsKey($nombre)) { return $m[$nombre] }
    }
    return $Global:Puntos[$nombre].XY
}

function DobleClickXY([string]$nombre) {
    $p = Get-XY $nombre
    Paso "Doble click $nombre en $($p[0]),$($p[1])"
    [Motor]::DoubleClick($p[0], $p[1])
}

# Espera hasta que haya texto en el portapapeles (max $ms). Devuelve el texto o ''
function Esperar-Portapapeles([int]$ms) {
    $t = 0
    while ($t -lt $ms) {
        $txt = ''
        try { $txt = [System.Windows.Forms.Clipboard]::GetText() } catch {}
        if ($txt -and $txt.Trim()) {
            Paso "Portapapeles listo a los $t ms"
            $script:UltPortaMs = $t
            return $txt.Trim()
        }
        Start-Sleep -Milliseconds 25           # revisa cada 25 ms (antes 100)
        $t += 25
    }
    Paso "Portapapeles vacio despues de $ms ms"
    return ''
}

function ClickXY([string]$nombre) {
    if (-not $Global:Puntos.Contains($nombre)) { throw "Unknown point: $nombre" }
    $p = Get-XY $nombre
    $fuente = 'base'
    if ($Global:Coord -eq 1 -and (Leer-MisCoords).ContainsKey($nombre)) { $fuente = 'mia' }
    Paso "Click $nombre en $($p[0]),$($p[1]) ($fuente)"
    [Motor]::Click($p[0], $p[1])
}

function Get-VentanaERP {
    Get-Process -Name mstsc -ErrorAction SilentlyContinue |
        Where-Object { $_.MainWindowTitle -like "*$Global:ERP_Titulo1*" -and
                       $_.MainWindowTitle -like "*$Global:ERP_Titulo2*" } |
        Select-Object -First 1
}
function Get-VentanaEdge {
    Get-Process -Name msedge -ErrorAction SilentlyContinue |
        Where-Object { $_.MainWindowHandle -ne [IntPtr]::Zero } |
        Select-Object -First 1
}

function Traer-ERP([int]$esperaMs = $Global:EsperaFocoERPms, [string]$clave = '', [switch]$Siempre) {
    Paso "Buscando ventana del ERP ('$Global:ERP_Titulo1' + '$Global:ERP_Titulo2')"
    $e = Get-VentanaERP
    if (-not $e) {
        $hay = (Get-Process -Name mstsc -ErrorAction SilentlyContinue | ForEach-Object { $_.MainWindowTitle }) -join ' | '
        if (-not $hay) { $hay = 'none' }
        throw "ERP window not found. Open remote desktops: $hay"
    }
    Paso "ERP encontrado: $($e.MainWindowTitle)"
    Paso 'Trayendo ERP al frente'
    $yaAlFrente = ([Motor]::GetForegroundWindow() -eq $e.MainWindowHandle)
    $ok = [Motor]::Traer($e.MainWindowHandle, 3)
    if (-not $ok -and [Motor]::ProcesoAlFrente() -eq 'mstsc') { $ok = $true }
    if (-not $ok) { throw "The ERP did not come to the front (in front: $([Motor]::ProcesoAlFrente()))." }
    if ($yaAlFrente -and -not $Siempre) {
        # Ya tenia el foco desde antes: no hace falta esperar
        Paso 'ERP ya estaba al frente (sin espera)'
        if ($clave) { P $clave '0' }
        return $e
    }
    Paso "ERP al frente: OK (espera foco $esperaMs ms)"
    if ($clave) { P $clave $esperaMs }
    # El Escritorio Remoto tarda en aceptar clicks/teclas despues de recibir el foco
    Esperar $esperaMs
    return $e
}
function Traer-Edge {
    # Si Edge YA esta al frente, no se toca nada (ni se minimiza el ERP)
    if ([Motor]::ProcesoAlFrente() -eq 'msedge') { Paso 'Edge ya estaba al frente: OK'; Esperar 200; return }
    $e = Get-VentanaERP
    if ($e) { Paso 'Minimizando ERP'; [Motor]::ShowWindow($e.MainWindowHandle, 6) | Out-Null; EsperarT 'D0_MinimizaERP' }
    Paso 'Buscando ventana de Edge'
    $w = Get-VentanaEdge
    if (-not $w) { throw 'Microsoft Edge (msedge) is not open.' }
    Paso "Edge encontrado: $($w.MainWindowTitle)"
    $ok = [Motor]::Traer($w.MainWindowHandle, 0)
    # Edge tiene varias ventanas internas: si la que quedo al frente es de Edge, cuenta como OK
    if (-not $ok -and [Motor]::ProcesoAlFrente() -eq 'msedge') { $ok = $true }
    if (-not $ok) { throw "Edge did not come to the front (in front: $([Motor]::ProcesoAlFrente()))." }
    Paso 'Edge al frente: OK'
}

