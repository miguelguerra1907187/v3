$script:MotorOK        = $false
$script:MotorError     = ''
$script:MotorCorriendo = $false
$script:BtnErp         = ''
$script:BtnIntra       = ''
$script:BtnForce       = ''
$script:UltimoPRO      = ''      # solo en memoria, nunca en disco
$script:PROAnterior    = ''      # PRO de la bill anterior (solo en memoria)
$script:MismoPRO       = $false  # el PRO de esta bill es igual al anterior
$script:EdgeEnIntra    = ''      # donde dejo Edge el ultimo PRO lookup: 'normal' (F1) / 'vieja' (F2)
$script:UltimoForce    = ''      # PRO lookup a usar: 'f1' (solo intra) o 'haz' (las 2 intras)

if ($UsarBotonesMotor) {
    try {
        if (-not ('Motor' -as [type])) { throw 'the motor part did not load' }
        $script:MotorOK = $true
    } catch { $script:MotorError = 'motor failed to load: ' + $_.Exception.Message }
}

# Se llama desde Finish-Notes: recuerda la ultima nota ERP y la de intra
function Set-NotasBotones([string]$intra, [string]$erp, [bool]$pendingHold, [string]$terminal = '') {
    # Que PRO lookup usar:
    #   - F2 (haz)               -> el original (las 2 intras)
    #   - F1 que lleva HOLD (cons) -> tambien el original, como F2
    #   - F1 sin hold            -> el de F1 (solo intra)
    if ($script:CurrentForce -eq 'haz') {
        $script:UltimoForce = 'haz'
    } elseif ($script:CurrentForce -eq 'f1') {
        $conHold = $pendingHold -or [bool]$terminal
        if (-not $conHold) { try { $conHold = [bool](Test-NeedsHold) } catch { } }
        $script:UltimoForce = if ($conHold) { 'haz' } else { 'f1' }
    } else {
        $script:UltimoForce = ''
    }

    # Nota nueva = se olvida la anterior (para no pegar la de otra bill)
    if ($erp -and ($script:CurrentForce -eq 'f1' -or $script:CurrentForce -eq 'haz')) {
        $script:BtnErp   = $erp.ToUpper()
        $script:BtnForce = if ($script:CurrentForce -eq 'f1') { 'FORCE1' } else { 'FORCE2' }
    } else {
        $script:BtnErp = ''; $script:BtnForce = ''
    }
    if ($terminal) {
        # Paso de terminal de la MISMA nota: si la nota ERP ya se pego, no se vuelve a ofrecer
        if ($script:BtnErp -and $script:BtnErp -eq $script:ErpYaPegada) { $script:BtnErp = ''; $script:BtnForce = '' }
    } else {
        $script:ErpYaPegada = ''      # nota nueva
    }
    if ($pendingHold) { $script:BtnIntra = '' }        # falta la terminal
    elseif ($intra)   { $script:BtnIntra = $intra.ToUpper() }
}

# Ejecuta UNA accion del motor. Devuelve $true si salio bien.
# (no revisa si el motor esta ocupado; eso lo hace quien la llama con Test-MotorListo)
function Run-Accion([string]$accion) {
    $ok = $false
    switch ($accion) {
        'pro1'  { $ok = Invoke-ProLookupF1 }
        'pro'   { $ok = Invoke-ProLookup }
        'erp'   { $ok = Invoke-NotaERP -Force $script:BtnForce -Nota $script:BtnErp }
        'intra' { $ok = Invoke-NotaIntra -Nota $script:BtnIntra }
    }
    if ($ok) {
        # Cada nota se pega UNA vez; para volver a pegarla, sacala del
        # historial (3/4/5 en la pantalla inicial) y se vuelve a cargar.
        if ($accion -eq 'erp')   { $script:ErpYaPegada = $script:BtnErp; $script:BtnErp = ''; $script:BtnForce = '' }
        if ($accion -eq 'intra') { $script:BtnIntra = '' }
        # Sin avisos de "PRO buscado" etc.: solo VERIFY AND SAVE al pegar una nota
        if ($accion -eq 'erp' -or $accion -eq 'intra') { Show-Verificar }
    }
    return [bool]$ok
}

function Test-MotorListo {
    if ($script:MotorCorriendo) { return $false }
    if (-not $script:MotorOK) { Show-Flag 'Buttons' $script:MotorError; return $false }
    if ($script:State -ne 'hidden' -and $script:State -ne 'done' -and $script:State -ne 'nivel1') {
        Show-Flag 'Buttons' 'finish the note first (or Esc to the start screen)'
        return $false
    }
    return $true
}

# Cierra el menu antes de que el motor haga clicks, SIN perder la nota
# pendiente de hold (Close-Menu normalmente la borra)
function Close-MenuParaBoton {
    if ($script:State -eq 'hidden') { return }
    $ph = $script:PendingHold
    Close-Menu
    $script:PendingHold = $ph
    Start-Sleep -Milliseconds 150
}

# ---------------------------------------------------------------------
#  Estado del flujo automatico entre la terminal y la nota intra
#  (con hold: despues del PRO pide la terminal y al dar Enter pega intra).
#  Se detiene en el primer paso que falle. Tu siempre guardas.
# ---------------------------------------------------------------------
$script:AutoTrasTerminal = $false
$script:ErpYaPegada      = ''    # nota ERP que ya se pego (para no pegarla 2 veces)

# Abre la pantalla de terminal (como Insert). Al dar Enter ahi se pega
# sola la nota de intra (y la del ERP si todavia no se habia pegado).
function Abrir-TerminalAuto {
    $script:AutoTrasTerminal = $true
    Hide-Watermark
    if ($script:State -eq 'hidden') {
        Save-PrevForeground
        $Win.Visibility = 'Visible'
        Set-MenuFocus
    }
    Enter-Terminal
}

# Se llama despues de dar la terminal (Enter) en el flujo automatico
function Start-AutoTrasTerminal {
    if (-not $script:AutoTrasTerminal) { return }
    $script:AutoTrasTerminal = $false
    # Pequena espera para que el menu termine de cerrarse
    $t = New-Object System.Windows.Threading.DispatcherTimer
    Usuario-Fin 'terminal dada'
    LogT "  espera G1_TrasTerminal = $($Global:ForceT.G1_TrasTerminal) ms"
    P 'G1_TrasTerminal' $Global:ForceT.G1_TrasTerminal
    $t.Interval = [TimeSpan]::FromMilliseconds($Global:ForceT.G1_TrasTerminal)
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if (-not (Test-MotorListo)) { return }
        $script:MotorCorriendo = $true
        Show-NoMover
        try {
            if (Run-Accion 'intra') {
                if ($script:BtnErp) { Run-Accion 'erp' | Out-Null }   # solo si no se habia pegado
            }
        } catch {
            Show-Flag 'AUTO' $_.Exception.Message
        } finally {
            $script:MotorCorriendo = $false
            Hide-NoMover
            Cerrar-LogTiempos $(if ($script:WatermarkGhost.Text -eq 'VERIFY' -or $script:WatermarkGhost.Text -eq 'CHECK') { 'OK' } else { 'ERROR' })
        }
    })
    $t.Start()
}

# ---------------------------------------------------------------------
#  FLUJO AUTOMATICO (sin botones), arranca al dar Enter en "revisar"
#   Fase 1: pega la nota ERP -> espera a que guardes (Enter / Alt+O)
#   Fase 2: F1 sin hold : PRO F1 -> intra vieja -> informational -> pega nota
#           con hold    : PRO (2 intras) -> pide terminal -> Enter pega intra
#  Se detiene en el primer paso que falle. Tu siempre guardas.
# ---------------------------------------------------------------------
$script:EsperandoGuardar = $false
$script:EsperaLimite     = Get-Date
$script:OArmed           = $true
$script:EnterArmed       = $true

function Start-FlujoAuto {
    if (-not $script:MotorOK) { Show-Flag 'Auto flow' $script:MotorError; return }
    if (-not $script:BtnErp) { return }        # solo notas F1 / F2
    $script:EsperandoGuardar = $false
    $script:MismoPRO = $false                  # bill nueva: todavia no hay PRO
    $tipoF = if ($script:UltimoForce -eq 'haz') { "$($script:BtnForce) (2 intras)" } else { "$($script:BtnForce) (intra normal)" }
    Iniciar-LogTiempos $tipoF
    LogT "  espera A1_CierraMenu = $($Global:ForceT.A1_CierraMenu) ms (se cierra el menu)"
    P 'A1_CierraMenu' $Global:ForceT.A1_CierraMenu
    $t = New-Object System.Windows.Threading.DispatcherTimer
    $t.Interval = [TimeSpan]::FromMilliseconds($Global:ForceT.A1_CierraMenu)    # que el menu termine de cerrarse
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if (-not (Test-MotorListo)) { return }
        $script:MotorCorriendo = $true
        $ok = $false
        try {
            Show-NoMover
            Paso '=== FLUJO AUTO fase 1: nota ERP ==='
            # Antes de cualquier secuencia F1/F2: click en 110,217 (punto Inicio_Click)
            # para darle el foco a esa parte del ERP (primero se asegura que el ERP este al frente)
            Traer-ERP $Global:ForceT.A2_FocoERP 'A2_FocoERP' -Siempre | Out-Null
            ClickXY 'Inicio_Click'
            EsperarT 'A0_DespuesClickInicio'
            $ok = Run-Accion 'erp'
        } catch {
            Show-Flag 'Auto flow' $_.Exception.Message
        } finally {
            $script:MotorCorriendo = $false
        }
        if (-not $ok) { Hide-NoMover; Cerrar-LogTiempos 'ERROR en la nota ERP'; return }  # el motor ya mostro donde fallo
        $script:EsperandoGuardar = $true
        $script:EsperaLimite = (Get-Date).AddMinutes($Global:EsperaMaxGuardarMin)
        # Limpia lo "apretado desde la ultima revision" de Enter / O / Alt (el
        # Enter con el que cerraste el menu, la O de FORCE1, el Alt del foco)
        foreach ($vk in 0x0D, 0x4F, 0x12) { [void][LocalKeyState]::GetAsyncKeyState($vk) }
        $script:OArmed = $false                # ignora una O que ya estuviera apretada
        $script:EnterArmed = $false            # y el Enter con el que cerraste el menu
        Show-Enter                             # verde: PRESS ENTER (o Alt+O)
        Usuario-Inicio 'des Enter / Alt+O en el ERP'
    })
    $t.Start()
}

function Stop-FlujoAuto([string]$porque) {
    $script:EsperandoGuardar = $false
    Paso "Flujo auto detenido: $porque"
    Usuario-Fin 'cancelado'
    Cerrar-LogTiempos "CANCELADO ($porque)"
    Show-Flag 'Auto flow' $porque
}

function Start-FlujoFase2([int]$esperaMs) {
    $script:EsperandoGuardar = $false
    Show-NoMover                               # rojo: DON'T MOVE
    LogT "  espera B1_DespuesGuardar = $esperaMs ms (que el ERP guarde)"
    P 'B1_DespuesGuardar' $esperaMs
    $t = New-Object System.Windows.Threading.DispatcherTimer
    $t.Interval = [TimeSpan]::FromMilliseconds([Math]::Max($esperaMs, 100))   # que el ERP termine de guardar
    $t.Add_Tick({
        param($s, $e)
        $s.Stop()
        if (-not (Test-MotorListo)) { return }
        $script:MotorCorriendo = $true
        $abrirTerminal = $false
        try {
            Paso "=== FLUJO AUTO fase 2: PRO + intra (lookup: $($script:UltimoForce)) ==="
            # Solo F2 o F1 con cons ('haz') pasan por HU status / intra vieja.
            # Cualquier otro F1 va solo a la intra normal.
            if ($script:UltimoForce -ne 'haz') {
                if (Run-Accion 'pro1') {
                    if ($script:BtnIntra) { Run-Accion 'intra' | Out-Null }
                }
            } else {
                if (Run-Accion 'pro') {
                    if ($script:BtnIntra) { Run-Accion 'intra' | Out-Null }      # terminal ya dada
                    elseif ($script:PendingHold) { $abrirTerminal = $true }
                }
            }
        } catch {
            Show-Flag 'Auto flow' $_.Exception.Message
        } finally {
            $script:MotorCorriendo = $false
        }
        Hide-NoMover                           # si fallo algo, quita el DON'T MOVE
        if ($abrirTerminal) {
