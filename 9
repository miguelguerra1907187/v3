# Busqueda en intra (normal y vieja): Enter y apunta la hora (las esperas de
# carga cuentan desde aqui). La foto de antes del Enter es para la deteccion
# por color.
function Enter-Busqueda([string]$donde, [string]$punto) {
    $kB = if ($donde -like '*vieja*') { 'E_busqueda' } else { 'D_busqueda' }
    $script:FotoBusqueda = Foto (Get-ZonaEdge)    # como se ve ANTES del Enter (color)
