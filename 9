    $SwAudit.WindowStyle        = 'None'
    $SwAudit.AllowsTransparency = $true
    $SwAudit.Background         = 'Transparent'
    $SwAudit.Topmost            = $true
    $SwAudit.ShowInTaskbar      = $false
    $SwAudit.ShowActivated      = $false
    $SwAudit.ResizeMode         = 'NoResize'
    $SwAudit.SizeToContent      = 'WidthAndHeight'
    $SwAudit.Add_SourceInitialized({
        param($s, $e)
        $h = (New-Object System.Windows.Interop.WindowInteropHelper($SwAudit)).Handle
        [LocalKeyState]::HideFromAltTab($h)
        try { [Motor]::NoActivate($h) } catch { }      # darle click no le quita el foco al ERP
    })

    $swBorde = New-Object System.Windows.Controls.Border
    $swBorde.Background      = B '#E616191D'
    $swBorde.BorderBrush     = B $C.KeyBorder
    $swBorde.BorderThickness = '1'
    $swBorde.CornerRadius    = '6'
    $swBorde.Padding         = '2,2,2,2'
    $swBorde.Cursor          = 'SizeAll'
    $swBorde.Add_MouseLeftButtonDown({ param($s, $e) if ($e.OriginalSource -eq $s) { try { $SwAudit.DragMove() } catch { } } })

    $script:SwAuditBtn = New-Object System.Windows.Controls.Border
    $script:SwAuditBtn.BorderThickness = '1'
    $script:SwAuditBtn.CornerRadius    = '4'
    $script:SwAuditBtn.Padding         = '5,1,5,1'
    $script:SwAuditBtn.Cursor          = 'Hand'
    $script:SwAuditTxt = New-Text 'AUDIT OFF' 9 $C.Dim 'Bold'
    $script:SwAuditTxt.HorizontalAlignment = 'Center'
    $script:SwAuditBtn.Child = $script:SwAuditTxt
    $script:SwAuditBtn.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        Set-AuditActivo (-not $script:AuditActivo)
    })
    # Boton BAND (banda breakdown), junto al de AUDIT
    $script:SwBandaBtn = New-Object System.Windows.Controls.Border
    $script:SwBandaBtn.BorderThickness = '1'
    $script:SwBandaBtn.CornerRadius    = '4'
    $script:SwBandaBtn.Padding         = '5,1,5,1'
    $script:SwBandaBtn.Margin          = '3,0,0,0'
    $script:SwBandaBtn.Cursor          = 'Hand'
    $script:SwBandaTxt = New-Text 'BAND OFF' 9 $C.Dim 'Bold'
    $script:SwBandaTxt.HorizontalAlignment = 'Center'
    $script:SwBandaBtn.Child = $script:SwBandaTxt
    $script:SwBandaBtn.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        Set-BandaActivo (-not $script:BandaActivo)
    })
    $swFila = New-Object System.Windows.Controls.StackPanel
    $swFila.Orientation = 'Horizontal'
    [void]$swFila.Children.Add($script:SwAuditBtn)
    [void]$swFila.Children.Add($script:SwBandaBtn)
    # Boton FILL (llenado del breakdown con OCR), junto al de BAND
    $script:SwFillBtn = New-Object System.Windows.Controls.Border
    $script:SwFillBtn.BorderThickness = '1'
    $script:SwFillBtn.CornerRadius    = '4'
    $script:SwFillBtn.Padding         = '5,1,5,1'
    $script:SwFillBtn.Margin          = '3,0,0,0'
    $script:SwFillBtn.Cursor          = 'Hand'
    $script:SwFillTxt = New-Text 'FILL OFF' 9 $C.Dim 'Bold'
    $script:SwFillTxt.HorizontalAlignment = 'Center'
    $script:SwFillBtn.Child = $script:SwFillTxt
    $script:SwFillBtn.Add_MouseLeftButtonUp({
        param($s, $e)
        $e.Handled = $true
        Set-FillActivo (-not $script:FillActivo)
    })
    [void]$swFila.Children.Add($script:SwFillBtn)
    $swBorde.Child = $swFila
    $SwAudit.Content = $swBorde

    $SwAudit.Add_Loaded({
        param($s, $e)
        $wa = [System.Windows.SystemParameters]::WorkArea
        $SwAudit.Left = $wa.Right  - $SwAudit.ActualWidth  - 16
        $SwAudit.Top  = $wa.Bottom - $SwAudit.ActualHeight - 16
    })
    Set-AuditActivo $AuditPrendidoAlInicio
    Set-BandaActivo $script:BandaActivo
    Set-FillActivo $FillPrendidoAlInicio
    $SwAudit.Show()
    $SwAudit.Visibility = 'Hidden'

    # Solo se ve mientras el menu esta abierto (no tapa la pantalla)
    $script:SwAuditTimer = New-Object System.Windows.Threading.DispatcherTimer
    $script:SwAuditTimer.Interval = [TimeSpan]::FromMilliseconds(150)
    $script:SwAuditTimer.Add_Tick({
        $quiero = if ($Win.Visibility -eq 'Visible') { 'Visible' } else { 'Hidden' }
        if ($SwAudit.Visibility -ne $quiero) { $SwAudit.Visibility = $quiero }
    })
    $script:SwAuditTimer.Start()
}



