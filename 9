function FTriple-Teclas {
    if (-not $FTriplePrendido) { return }
    $ctrlIzq = ([LocalKeyState]::GetAsyncKeyState(0xA2) -band 0x8000) -ne 0
    $shiftAlt = (([LocalKeyState]::GetAsyncKeyState(0x10) -band 0x8000) -ne 0) -or (([LocalKeyState]::GetAsyncKeyState(0x12) -band 0x8000) -ne 0)
    # (las F solo se leen con el Ctrl izq abajo o algo pendiente: asi no se le gasta a otros programas)
    if (-not $ctrlIzq -and -not $script:FTriplePend) { $script:FTripleAbajo = @($false, $false, $false, $false); return }
    $fAbajo = $false
    for ($i = 0; $i -lt 4; $i++) {
        $d = ([LocalKeyState]::GetAsyncKeyState(0x74 + $i) -band 0x8000) -ne 0
        if ($d) { $fAbajo = $true }
        if ($d -and -not $script:FTripleAbajo[$i] -and $ctrlIzq -and -not $shiftAlt) { $script:FTriplePend = "F$(5 + $i)" }
        $script:FTripleAbajo[$i] = $d
    }
    if (-not $script:FTriplePend -or $fAbajo) { return }
    # espera a que sueltes Ctrl, Shift y Alt
    foreach ($vk in 0x11, 0x10, 0x12) { if (([LocalKeyState]::GetAsyncKeyState($vk) -band 0x8000) -ne 0) { return } }
    $k = $script:FTriplePend; $script:FTriplePend = ''
    if ($Win.Visibility -eq 'Visible' -or $script:MotorCorriendo -or $script:EsperandoGuardar) { return }
    for ($n = 0; $n -lt 3; $n++) {
        [System.Windows.Forms.SendKeys]::SendWait("{$k}")
        if ($n -lt 2) { Start-Sleep -Milliseconds $FTriplePausaMs }
    }
    Paso "Ctrl izq + ${k}: $k x3"
}
