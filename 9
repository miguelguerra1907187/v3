# =================== PASOS DE CADA F1 / F2 (en memoria) ===================
# Cada paso con los segundos desde que empezo y cuanto tardaste TU aparte. Ya
# no se escribe a ningun archivo (20t): al terminar se saca lo importante para
# el DETALLE de resumen_ultimas.txt. No guarda PROs ni notas.
$Global:LogTiempos = 1                      # 1 = medir los pasos   0 = no
$script:RelojFlujo = $null
$script:TiemposBuf = $null
$script:UsuarioMs  = 0                      # lo que tardaste tu (no cuenta como motor)
$script:UsuarioT0  = -1

function LogT([string]$m) {
    if ($null -eq $script:TiemposBuf -or $null -eq $script:RelojFlujo) { return }
    if ($m -match '^(Buscando ventana|ERP encontrado|Edge encontrado|Trayendo ERP|Teclas: )') { return }
    [void]$script:TiemposBuf.Add(('{0,8:0.000} s   {1}' -f $script:RelojFlujo.Elapsed.TotalSeconds, $m))
}
# (20t) Ya no hay motor_log.txt: esto solo vacia lo que hubiera en memoria
$script:BufferFlujo = $false
function Vaciar-LogMotor {
    if ($null -ne $Global:LogBuffer) { $Global:LogBuffer.Clear() }
}

function Iniciar-LogTiempos([string]$tipo) {
    Vaciar-LogMotor
    if ($null -eq $Global:LogBuffer -and $Global:LogArchivo -eq 1) {
        $Global:LogBuffer = New-Object System.Collections.ArrayList
        $script:BufferFlujo = $true
    }
    if ($Global:LogTiempos -ne 1) { return }
    $script:RelojFlujo = [System.Diagnostics.Stopwatch]::StartNew()
    $script:TiemposBuf = New-Object System.Collections.ArrayList
    $script:UsuarioMs = 0; $script:UsuarioT0 = -1
    $script:TipoFlujo = $tipo
    $script:Pasos = [ordered]@{}
    P 'hora' (Get-Date -Format 'HH:mm')
    P 'fecha' (Get-Date -Format 'MM-dd')
    P 'tipo' $(if ($tipo -like '*2 intras*') { 'F2' } else { 'F1' })
    [void]$script:TiemposBuf.Add('')
    [void]$script:TiemposBuf.Add(('===== {0}  {1}  ({2}) =====' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $tipo, $ScriptVersion))
}
# Marca cuando empieza / termina algo que haces TU (no se cuenta como motor)
function Usuario-Inicio([string]$que) {
    if ($null -eq $script:RelojFlujo) { return }
    $script:UsuarioT0 = $script:RelojFlujo.ElapsedMilliseconds
    LogT ">>> esperando que TU: $que"
}
function Usuario-Fin([string]$que) {
    if ($null -eq $script:RelojFlujo -or $script:UsuarioT0 -lt 0) { return }
    $d = $script:RelojFlujo.ElapsedMilliseconds - $script:UsuarioT0
    $script:UsuarioMs += $d
    $script:UsuarioT0 = -1
    LogT ("<<< {0} (tardaste {1:0.0} s)" -f $que, ($d / 1000))
    $kU = if ($que -like 'terminal*') { 'TU_terminal' } else { 'TU_Enter' }
    P $kU ('{0:0.0}' -f ($d / 1000))
}
# Lo importante de un F1/F2 para el DETALLE del resumen: reintentos, color que
# no detecto, PRO que no se vio, foco perdido, errores. Sale de los pasos que
# se juntaron en memoria ($script:TiemposBuf). No lleva PROs ni notas.
function Notas-DelFlujo($buf) {
    $n = New-Object System.Collections.Generic.List[string]
    if ($null -eq $buf) { return '' }
    foreach ($l in $buf) {
        $m = ([string]$l -replace '^\s*[\d\.,]+ s\s+', '').Trim()
        $x = $null
        if ($m -match '^espera (E6|F1|F2|F3)_\w+: (\d+) ms completos \((.+)\)$') { $x = "$($Matches[1]) no detecto ($($Matches[3]))" }
        elseif ($m -match '^espera ([A-Z]\d)_\w+: LISTO .*OJO') { $x = "$($Matches[1]) quedo igual que antes" }
        elseif ($m -match '^PRO intento ([23]) de 3') { $x = "copiar PRO: intento $($Matches[1])" }
        elseif ($m -match '^PRO en (.+): cambio ([\d\.,]+) %.*NO se ve') { $x = "PRO no se vio en $($Matches[1]) ($($Matches[2]) %)" }
        elseif ($m -match '^Foco perdido \(al frente: (\S*)\)') { $x = "foco perdido (al frente: $($Matches[1]))" }
        elseif ($m -match '^AVISO: es el mismo PRO') { $x = 'mismo PRO que la bill anterior' }
        elseif ($m -match '^ERROR en \[(.+?)\] -> (.+) \(\S+ linea \d+\)$') { $x = "ERROR en [$($Matches[1])]: $($Matches[2])" }
        elseif ($m -match '^Flujo auto detenido: (.+)$') { $x = "detenido: $($Matches[1])" }
        if ($x -and -not $n.Contains($x)) { $n.Add($x) }
    }
    $s = $n -join '; '
    if ($s.Length -gt 240) { $s = $s.Substring(0, 237) + '...' }
    return $s
}
function Cerrar-LogTiempos([string]$fin) {
    Vaciar-LogMotor
    if ($script:BufferFlujo) { $Global:LogBuffer = $null; $script:BufferFlujo = $false }
    if ($null -eq $script:TiemposBuf -or $null -eq $script:RelojFlujo) { return }
    $tot = $script:RelojFlujo.ElapsedMilliseconds
    $motor = $tot - $script:UsuarioMs
    # Abajo del VERIFY, chiquito: "F1 OK IN 7.1 S" (tiempo del motor, sin lo que tardas tu)
    if ($fin -like 'OK*') {
        $tipoF = if ($script:TipoFlujo -match '^FORCE\s*(\d)') { 'F' + $Matches[1] } else { 'F' }
        try { Show-TiempoFlujo $tipoF ($motor / 1000) } catch { }
    }
    [void]$script:TiemposBuf.Add(('===== FIN: {0}  |  motor {1:0.0} s  |  tu {2:0.0} s  |  total {3:0.0} s =====' -f $fin, ($motor / 1000), ($script:UsuarioMs / 1000), ($tot / 1000)))
    $buf = $script:TiemposBuf
    $script:TiemposBuf = $null; $script:RelojFlujo = $null
    $nt = Notas-DelFlujo $buf
    if ($fin -notlike 'OK*' -and $fin -ne 'ERROR' -and $nt -notlike "*$fin*") { $nt = $(if ($nt) { "$fin; $nt" } else { $fin }) }
    P 'notas' $nt
    P 'motor_s' ('{0:0.0}' -f ($motor / 1000))
    P 'resultado' $(if ($fin -like 'OK*') { 'OK' } elseif ($fin -like 'CANCEL*') { 'CANCEL' } else { 'ERROR!' })
    Guardar-Ultimas
}
